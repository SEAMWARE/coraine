#!/usr/bin/env bash
#
# coraine-build - build your own coraine from the exact source of the installed packages
#
# Usage: coraine-build [options] <dir>
#
#   <dir>              where the source is unpacked and built - a new or empty directory, or one an
#                      earlier coraine-build unpacked into (the source is then reused, not unpacked again)
#
#   --release          optimised, traces compiled out (the default) - what the coraine package holds
#                      before profile-guiding
#   --debug            traces compiled in (--traceLevels works), for reproducing a crash report
#   --pgo              profile-guided release: built instrumented, trained here on the measured request
#                      shapes, rebuilt with the profile - what the coraine package and the image hold.
#                      A few minutes more; needs curl and wrk
#   --tune <workload>  --pgo trained on YOUR workload instead, and the knobs measured on it - the best
#                      kept in <dir>/install/etc/tune.env (doc/extreme-performance.md)
#   --features <list>  comma-separated NAME=ON|OFF, NAME without COR_FEATURE_ - e.g.
#                      --features REGISTRATIONS=OFF,SERVICE_EXECUTION=OFF,MONGOC=OFF
#   --http-server <s>  mhd (libmicrohttpd, the default) or builtin (corHttp, no external library). With
#                      builtin the switches that need libmicrohttpd are off (POLICY_API - --list-features
#                      --json says so: "requires": ["HTTP_SERVER=mhd"]); not with --pgo / --tune yet
#   --bridges <list>   the bridge plugins to build, comma-separated: mqtt, modbus, dds, ckan, opcua - or none
#                      (default mqtt,modbus). A bridge the source does not carry, or whose libraries are
#                      not installed here, stops the build and says which (--list-bridges)
#   --list-bridges     print every bridge, whether it can be built here and why not, and exit; with
#                      --json a JSON array of {name, default, description, available, why}
#   --list-features    print every feature switch, its default and what it is, and exit
#   --json             with --list-features: the same as a JSON array of {name, default, description,
#                      group, requires} - "group" the CMakeLists.txt group it is in ("# Group: <name> -
#                      ..."); "requires" names the switches it is turned off without, and a build
#                      setting as NAME=value (HTTP_SERVER=mhd: libmicrohttpd, not the built-in server)
#   --name <exe>       the broker's executable: <dir>/install/bin/<exe> (default coraine) - a broker built
#                      for one role (a cor-agent, an edge node) named after it. 1-64 of A-Z a-z 0-9 . _ -,
#                      starting with a letter or a digit; not coraine-import
#   --source <file>    the source tarball (default /usr/share/coraine/src/coraine-src.tar.xz - coraine-dev)
#   --source <dir>     instead: a directory of git clones - coraine and every Cor-Lib side by side, as
#                      corLibs/bootstrap.sh clones them (~/git). Exported as the packages' tarball is
#                      (<dir>/coraine/packaging/deb/source.sh): coraine at the commit checked out, each lib
#                      at origin/main (LIBS_REF=HEAD: the branch each clone has checked out). Committed
#                      trees only - uncommitted changes are not built. coraine-dev is not needed
#   -h, --help
#
# The result, in <dir>/install - nothing is written outside <dir>, and root is not needed:
#
#   bin/coraine (or --name's)  bin/coraine-import  plugins/...  etc/contextSourceExtras.json  [etc/tune.env]
#   [etc/bridges.json  etc/dds-types/ - with dds: its default configuration]  env
#
# `. <dir>/install/env` puts bin/ on PATH and points the broker at plugins/ and etc/ (SEAMWARE_PLUGIN_DIR,
# CORAINE_CONTEXTSOURCEEXTRAS); then `coraine -fg --database corDB` runs the broker just built (by its
# --name, when given; it reads the same CORAINE_* environment variables whatever it is called).
#
# What the switches mean: doc/building-details.md (features), doc/performance.md (pgo),
# doc/extreme-performance.md (tune) - in the source, <dir>/coraine/doc.
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
set -euo pipefail

SOURCE=/usr/share/coraine/src/coraine-src.tar.xz
MODE=release
WORKLOAD=
FEATURES=
HTTP_SERVER=mhd
DIR=
LIST=0
LISTB=0
JSON=0
BRIDGES=mqtt,modbus
NAME=coraine

die()   { echo "coraine-build: $*" >&2; exit 1; }
usage() { sed -n '3,/^# Copyright/{/^# Copyright/d;s/^# \{0,1\}//;p}' "$0"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --release)        MODE=release ;;
    --debug)          MODE=debug ;;
    --pgo)            MODE=pgo ;;
    --tune)           MODE=tune; WORKLOAD=${2:?--tune needs a workload file}; shift ;;
    --features)       FEATURES=${2:?--features needs a list}; shift ;;
    --features=*)     FEATURES=${1#--features=} ;;
    --http-server)    HTTP_SERVER=${2:?--http-server needs mhd or builtin}; shift ;;
    --http-server=*)  HTTP_SERVER=${1#--http-server=} ;;
    --list-features)  LIST=1 ;;
    --list-bridges)   LISTB=1 ;;
    --bridges)        BRIDGES=${2:?--bridges needs a list (or none)}; shift ;;
    --bridges=*)      BRIDGES=${1#--bridges=} ;;
    --json)           JSON=1 ;;
    --source)         SOURCE=${2:?--source needs a file or a directory}; shift ;;
    --name)           NAME=${2:?--name needs a name}; shift ;;
    --name=*)         NAME=${1#--name=} ;;
    -h|--help)        usage; exit 0 ;;
    -*)               die "unknown option '$1' (--help)" ;;
    *)                [ -z "$DIR" ] || die "one directory, not '$DIR' and '$1'"; DIR=$1 ;;
  esac
  shift
done

[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "--name '$NAME': 1-64 of A-Z a-z 0-9 . _ -, starting with a letter or a digit"
[ "$NAME" != coraine-import ] || die "--name coraine-import is the migration tool's"

[ -n "$DIR" ] || { { [ "$LIST" = 1 ] || [ "$LISTB" = 1 ]; } || { usage; exit 1; }; DIR=$(mktemp -d); trap 'rm -rf "$DIR"' EXIT; }

#
# The source: unpacked once
#
mkdir -p "$DIR"
DIR=$(cd "$DIR" && pwd)
if [ -f "$DIR/coraine/makefile" ] && [ -f "$DIR/SOURCE" ]; then
  echo "coraine-build: reusing the source already in $DIR"
elif [ -n "$(ls -A "$DIR")" ]; then
  die "$DIR is neither empty nor a coraine-build directory"
else
  if [ -d "$SOURCE" ] && { [ "$LIST" = 1 ] || [ "$LISTB" = 1 ]; }; then
    #
    # The lists only read the clones (CMakeLists.txt, each bridge's makefile): linked, not exported - as they
    # are checked out
    #
    [ -x "$SOURCE/coraine/packaging/deb/version.sh" ] || die "--source $SOURCE: no coraine clone in it (coraine/packaging/deb/version.sh)"
    for d in "$SOURCE"/*/; do ln -s "$(cd "$d" && pwd)" "$DIR/$(basename "$d")"; done
    echo "version=$(cd "$SOURCE/coraine" && packaging/deb/version.sh)" > "$DIR/SOURCE"
  elif [ -d "$SOURCE" ]; then
    #
    # A directory of clones: the tarball made from them, as the packages' is, then unpacked like any other
    #
    [ -x "$SOURCE/coraine/packaging/deb/source.sh" ] || die "--source $SOURCE: no coraine clone in it (coraine/packaging/deb/source.sh)"
    TARDIR=$(mktemp -d)
    BASE=$(cd "$SOURCE" && pwd) REF=${LIBS_REF:-origin/main} "$SOURCE/coraine/packaging/deb/source.sh" "$TARDIR" \
      || { rm -rf "$TARDIR"; die "--source $SOURCE: the source could not be exported from the clones (above)"; }
    tar -xJf "$TARDIR/coraine-src.tar.xz" -C "$DIR" --strip-components=1
    rm -rf "$TARDIR"
  else
    [ -f "$SOURCE" ] || die "no source tarball at $SOURCE (is coraine-dev installed? --source names another, or a directory of clones)"
    tar -xJf "$SOURCE" -C "$DIR" --strip-components=1
  fi
fi
. "$DIR/SOURCE"      # version, gitSha, commitDate

if [ "$LIST" = 1 ] && [ "$JSON" = 1 ]; then
  # requires: CMakeLists.txt turns a switch off when another is off - every set() up to the endif()
  #   if (NOT COR_FEATURE_A OR NOT COR_FEATURE_B)
  #     set(COR_FEATURE_C OFF)
  #     set(COR_FEATURE_D OFF)
  #   if (DEFINED COR_HTTP_SERVER AND NOT COR_HTTP_SERVER STREQUAL "mhd")
  #     set(COR_FEATURE_C OFF)                                  - requires HTTP_SERVER=mhd
  awk '
    /^if *\( *NOT COR_FEATURE_/ { n = split($0, w, /COR_FEATURE_/); req = "";
                                   for (i = 2; i <= n; i++) { split(w[i], x, /[^A-Z_]/); req = req (req ? " " : "") x[1] }
                                   next }
    /^if *\(.*NOT COR_HTTP_SERVER STREQUAL "[a-z]*"/ { match($0, /STREQUAL "[a-z]*"/); req = "HTTP_SERVER=" substr($0, RSTART + 10, RLENGTH - 11); next }
    req != "" && /set\(COR_FEATURE_[A-Z_]* OFF\)/ { match($0, /COR_FEATURE_[A-Z_]*/); print substr($0, RSTART + 12, RLENGTH - 12), req; next }
    /^endif/ { req = "" }
  ' "$DIR/coraine/CMakeLists.txt" > "$DIR/.requires"
  esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' <<< "$1"; }
  first=1
  echo "["
  # name, default, group (the "# Group: <name> - " above it, "" before the first) and description - tab-separated
  awk '
    /^# Group: / { g = substr($0, 10); sub(/ - .*/, "", g); next }
    match($0, /^option\(COR_FEATURE_[A-Z_]+ +"/) {
      name = substr($0, 20, RLENGTH - 20); sub(/ +$/, "", name)
      rest = substr($0, RLENGTH + 1)
      def  = (rest ~ /" *ON\)$/) ? "ON" : "OFF"; desc = rest; sub(/" *(ON|OFF)\)$/, "", desc)
      printf "%s\t%s\t%s\t%s\n", name, def, g, desc
    }
  ' "$DIR/coraine/CMakeLists.txt" \
    | while IFS=$'\t' read -r name def group desc; do
        req=$(awk -v n="$name" '$1 == n { for (i = 2; i <= NF; i++) printf "%s\"%s\"", (i > 2 ? ", " : ""), $i }' "$DIR/.requires")
        [ "$first" = 1 ] || echo ","
        first=0
        printf '  {"name": "%s", "default": %s, "description": "%s", "group": "%s", "requires": [%s]}' \
          "$name" "$([ "$def" = ON ] && echo true || echo false)" "$(esc "$desc")" "$(esc "$group")" "$req"
      done
  printf '\n]\n'
  rm -f "$DIR/.requires"
  exit 0
fi

if [ "$LIST" = 1 ]; then
  echo "coraine $version - feature switches (--features NAME=ON|OFF):"
  sed -n 's/^option(COR_FEATURE_\([A-Z_]*\) *"\(.*\)" *\(ON\|OFF\))/\1 \3 \2/p' "$DIR/coraine/CMakeLists.txt" \
    | while read -r name def desc; do printf '  %-24s %-4s %s\n' "$name" "$def" "$desc"; done
  exit 0
fi

#
# The bridges - plugins built from repositories of their own, beside the broker's. name, repository,
# default, what it is
#
BRIDGE_TABLE="mqtt	corMqttBridge	1	MQTT - NGSI-LD over MQTT topics (mqtt.so, libmosquitto)
modbus	corModbusBridge	1	Modbus TCP - values between Modbus registers and entities (modbus.so, no library)
dds	corDdsBridge	0	DDS - topics, services and actions between DDS and entities (dds.so, eProsima Fast DDS and the DDS Enabler)
ckan	corCkanBridge	0	CKAN - an open data portal's datasets, discovered and read into entities (ckan.so, no library)
opcua	corOpcuaBridge	0	OPC UA - a server's Variables as Channels, its Objects as AssetChannels (opcua.so, open62541)"

#
# bridgeWhy <name> <repository> - why it cannot be built here; nothing when it can
#
bridgeWhy() {
  [ -f "$DIR/$2/makefile" ] || { echo "not in this source"; return; }
  case "$1" in
    ckan) # its endpoints are DataChannels: a broker without them loads ckan.so and makes no entity of it
          grep -q "^option(COR_FEATURE_DATA_CHANNELS " "$DIR/coraine/CMakeLists.txt" \
            || echo "it needs DataChannels (COR_FEATURE_DATA_CHANNELS), which this source's broker does not have" ;;
    mqtt) echo '#include <mosquitto.h>' | ${CC:-cc} -E - > /dev/null 2>&1 || echo "libmosquitto's headers are not installed (libmosquitto-dev)" ;;
    opcua) echo '#include <open62541/client.h>' | ${CC:-cc} -E - > /dev/null 2>&1 \
             || echo "open62541's headers are not installed (libopen62541-1.4-dev - Ubuntu 26.04, Debian 13)" ;;
    dds)  # the bridge's own makefile decides (COR_BRIDGE_DDS=auto: the Enabler's headers and libraries)
          [ "$(make -s -C "$DIR/$2" -p -n all 2>/dev/null | awk '$1 == "COR_BRIDGE_DDS" { v = $3 } END { print v }')" = ON ] \
            || echo "the DDS Enabler and eProsima Fast DDS are not installed (doc/dds.md)" ;;
  esac
}

if [ "$LISTB" = 1 ]; then
  esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' <<< "$1"; }
  first=1
  [ "$JSON" = 1 ] && echo "[" || echo "coraine $version - bridges (--bridges NAME,...):"
  while IFS='	' read -r name repo def desc; do
    why=$(bridgeWhy "$name" "$repo")
    if [ "$JSON" = 1 ]; then
      [ "$first" = 1 ] || printf ',\n'
      first=0
      printf '  {"name": "%s", "default": %s, "description": "%s", "available": %s, "why": %s}' "$name" \
        "$([ "$def" = 1 ] && echo true || echo false)" "$(esc "$desc")" "$([ -z "$why" ] && echo true || echo false)" \
        "$([ -z "$why" ] && echo null || echo "\"$(esc "$why")\"")"
    else
      printf '  %-8s %-8s %s%s\n' "$name" "$([ "$def" = 1 ] && echo default || echo '')" "$desc" "${why:+ - not here: $why}"
    fi
  done <<< "$BRIDGE_TABLE"
  [ "$JSON" = 1 ] && printf '\n]\n'
  exit 0
fi

#
# --bridges: each one named, in the source and buildable here - or the build does not start
#
BRIDGE_REPOS=()
if [ "$BRIDGES" != none ]; then
  IFS=, read -r -a wanted <<< "$BRIDGES"
  for b in "${wanted[@]}"; do
    [ -n "$b" ] || continue
    line=$(awk -F'\t' -v n="$b" '$1 == n' <<< "$BRIDGE_TABLE")
    [ -n "$line" ] || die "--bridges: no bridge '$b' (--list-bridges)"
    repo=$(cut -f2 <<< "$line")
    why=$(bridgeWhy "$b" "$repo")
    [ -z "$why" ] || die "--bridges: $b cannot be built here - $why"
    BRIDGE_REPOS+=("$repo")
  done
fi

#
# --features NAME=ON|OFF,... -> CMAKE_FEATURES -DCOR_FEATURE_NAME=ON|OFF
#
CMAKE_FEATURES=
MONGOC=ON
ICU=0
CORP=1
GEOQ=1
IFS=, read -r -a items <<< "$FEATURES"
for item in "${items[@]}"; do
  [ -n "$item" ] || continue
  name=${item%%=*}; value=${item#*=}
  name=${name#COR_FEATURE_}
  [ "$name" != "$item" ] || die "--features: '$item' is not NAME=ON|OFF"
  case "$value" in ON|on|1) value=ON ;; OFF|off|0) value=OFF ;; *) die "--features: $name=$value - ON or OFF" ;; esac
  grep -q "^option(COR_FEATURE_$name " "$DIR/coraine/CMakeLists.txt" || die "--features: no feature '$name' (--list-features)"
  [ "$name" = MONGOC ] && MONGOC=$value
  # ICU_COLLATION is two flags - corNgsild's code path and the broker's link - and the makefile's
  # COR_WITH_ICU sets both; as a cmake -D alone the broker says ICU and sorts without it
  if [ "$name" = ICU_COLLATION ]; then
    [ "$value" = ON ] && ICU=1 || ICU=0
    continue
  fi
  # COR_PROTOCOL the same way: the makefile's COR_WITH_COR_PROTOCOL leaves cor:// out of corRest as well
  if [ "$name" = COR_PROTOCOL ]; then
    [ "$value" = ON ] && CORP=1 || CORP=0
    continue
  fi
  # GEOQ too: the makefile's COR_WITH_GEOQ builds corDB's geo matcher without GEOS as well as the broker's
  if [ "$name" = GEOQ ]; then
    [ "$value" = ON ] && GEOQ=1 || GEOQ=0
    continue
  fi
  CMAKE_FEATURES="$CMAKE_FEATURES -DCOR_FEATURE_$name=$value"
done
if [ "$ICU" = 1 ] && ! pkg-config --exists icu-i18n icu-uc; then
  die "ICU_COLLATION=ON needs ICU's headers and libraries (libicu-dev)"
fi

#
# mongo-c driver v2, for the mongoc plugin: the distribution's (Ubuntu 26.04: libmongoc-dev), or the one
# coraine-dev bundles in /opt/seamware where the distribution has only v1 (Ubuntu 24.04, Debian 13).
# The bundled one is found through pkg-config and the linker search path here, and through a RUNPATH on
# mongoc.so at run time (below).
#
BUNDLED=0
if [ "$MONGOC" = ON ] && ! pkg-config --exists mongoc2; then
  if [ -f /opt/seamware/lib/pkgconfig/mongoc2.pc ]; then
    BUNDLED=1
    export PKG_CONFIG_PATH=/opt/seamware/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
    export LIBRARY_PATH=/opt/seamware/lib${LIBRARY_PATH:+:$LIBRARY_PATH}
    export LD_LIBRARY_PATH=/opt/seamware/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    command -v patchelf > /dev/null || die "patchelf is needed to point mongoc.so at /opt/seamware/lib"
  else
    die "no mongo-c driver v2 (pkg-config mongoc2) - install it, or build without: --features MONGOC=OFF"
  fi
fi

case "$HTTP_SERVER" in mhd|builtin) ;; *) die "--http-server: '$HTTP_SERVER' - mhd or builtin" ;; esac
if [ "$HTTP_SERVER" = builtin ] && { [ "$MODE" = pgo ] || [ "$MODE" = tune ]; }; then
  die "--http-server builtin: not with --$MODE yet (its training tools are built and tried with libmicrohttpd only)"
fi

if [ "$MODE" = pgo ] || [ "$MODE" = tune ]; then
  for t in curl wrk python3; do command -v $t > /dev/null || die "--$MODE needs $t"; done
fi
if [ "$MODE" = tune ]; then
  [ -f "$WORKLOAD" ] || die "--tune: no workload file '$WORKLOAD'"
  WORKLOAD=$(cd "$(dirname "$WORKLOAD")" && pwd)/$(basename "$WORKLOAD")
fi

INST=$DIR/install
rm -rf "$INST"
mkdir -p "$INST/bin" "$INST/plugins" "$INST/etc"
C=$DIR/coraine

#
# Every make below gets PLUGIN_DIR: corDB installs its plugins as it is built (the broker's makefile
# builds it with the libraries), and without it that would be /opt/seamware/plugins. A command-line
# variable reaches every sub-make.
#
MK=(PLUGIN_DIR="$INST/plugins" CORAINE_GIT_SHA="${gitSha:0:8}" CMAKE_FEATURES="$CMAKE_FEATURES" COR_HTTP_SERVER="$HTTP_SERVER" COR_WITH_ICU="$ICU" COR_WITH_COR_PROTOCOL="$CORP" COR_WITH_GEOQ="$GEOQ")

#
# phase - one line per phase, for a front-end to show progress without parsing make's output
#
phase() { echo "coraine-build: phase $1"; }

echo "coraine-build: coraine $version ($MODE, HTTP server $HTTP_SERVER${FEATURES:+, $FEATURES}) in $DIR"
make -C "$C" clean > /dev/null
phase build

case "$MODE" in
  release) make -C "$C" "${MK[@]}" release;  B=$C/BUILD_RELEASE ;;
  debug)   make -C "$C" "${MK[@]}" debug;    B=$C/BUILD_DEBUG ;;
  pgo|tune)
    # the tools the training drives (corTestClient, corRequest; corJson) into corLibs/bin, where
    # pgoTrain.sh and perfRun.sh look: the umbrella's `all` builds them, corTools' and corJson's own
    # `install` copies them into their bin/ (nothing else), install-local gathers them. Never the
    # umbrella's `install`: it would write plugins to /opt/seamware
    phase tools
    make -C "$DIR/corLibs" BUILD=release all
    make -C "$DIR/corTools" BUILD=release install
    make -C "$DIR/corJson" BUILD=release install
    make -C "$DIR/corLibs" install-local
    for t in corTestClient corRequest; do
      [ -x "$DIR/corLibs/bin/$t" ] || die "--$MODE: $t was not built - the training needs it"
    done
    phase train
    if [ "$MODE" = pgo ]; then
      make -C "$C" "${MK[@]}" PGO_RESTORE_DEBUG=0 pgo 2>&1 | tee "$DIR/pgo.log"
    else
      (cd "$C" && make "${MK[@]}" PGO_RESTORE_DEBUG=0 tune WORKLOAD="$WORKLOAD") 2>&1 | tee "$DIR/pgo.log"
      "$C/test/perf/tune/tuneEnv.py" "$C/tune-result.json" > "$INST/etc/tune.env"
    fi
    # pgoTrain.sh goes on after a part of the training fails (the profile is then partial) - not here
    if grep 'pgoTrain: .*failed' "$DIR/pgo.log"; then
      die "a part of the training failed - the profile would lack it (the output above, $DIR/pgo.log)"
    fi
    # corDB's plugins: installed into PLUGIN_DIR by the profile-use pass of `make pgo` itself
    B=$C/BUILD_PGO ;;
esac

#
# The broker's own install target copies a FIXED set of plugins, so a build with a plugin switched off
# would fail it: the broker, coraine-import and whatever plugins this build produced, by kind -
# src/plugins/<kind>/<name>/<name>.so -> plugins/<directory the broker loads <kind> from>/<name>.so
#
# installFile <file> <dir> - a NEW file in <dir>, renamed over the old one: never cp onto it. cp rewrites
# the file in place (the same inode); a broker running from $INST has its plugins mapped, their code
# changes under it and it dies (SIGSEGV, SIGILL) - and cp onto the running coraine fails (Text file busy)
installFile()
{
  cp -p "$1" "$2/.$(basename "$1").new" && mv -f "$2/.$(basename "$1").new" "$2/$(basename "$1")"
}

phase install
installFile "$B/src/app/coraine/coraine" "$INST/bin"
[ ! -f "$B/src/app/coraineImport/coraine-import" ] || installFile "$B/src/app/coraineImport/coraine-import" "$INST/bin"
find "$B/src/plugins" -name '*.so' | while read -r so; do
  kind=$(basename "$(dirname "$(dirname "$so")")")
  case "$kind" in
    currentState) d=db/currentState ;;
    temporal)     d=troe/temporal ;;
    api|bridge|transport) d=$kind ;;
    *) continue ;;
  esac
  mkdir -p "$INST/plugins/$d"
  installFile "$so" "$INST/plugins/$d"
done

phase bridges
# the bridges that are not the broker's, as --bridges named them (default MQTT and Modbus)
for br in "${BRIDGE_REPOS[@]}"; do
  flavour=release; [ "$MODE" = debug ] && flavour=debug
  extra=(); [ "$br" = corDdsBridge ] && extra=(COR_BRIDGE_DDS=ON)
  make -C "$DIR/$br" BUILD=$flavour PLUGIN_DIR="$INST/plugins/bridge" "${extra[@]}" install > /dev/null
done

installFile "$C/etc/contextSourceExtras.json" "$INST/etc"

#
# The DDS bridge refuses to start without a configuration: with dds built, the build's etc gets the one
# the image ships (etc/dds-default.json - domain 0, no topics) as bridges.json, the file the broker reads
# when --bridgeConfig is not given; its types directory is the build's own
#
if [ -f "$INST/plugins/bridge/dds.so" ] && [ ! -f "$INST/etc/bridges.json" ]; then
  mkdir -p "$INST/etc/dds-types"
  esc=$(printf '%s' "$INST/etc/dds-types" | sed 's/[&|\\]/\\&/g')
  sed "s|/opt/seamware/etc/dds-types|$esc|" "$C/etc/dds-default.json" > "$INST/etc/.bridges.json.new" && mv -f "$INST/etc/.bridges.json.new" "$INST/etc/bridges.json"
fi

if [ "$BUNDLED" = 1 ] && [ -f "$INST/plugins/db/currentState/mongoc.so" ]; then
  patchelf --set-rpath /opt/seamware/lib "$INST/plugins/db/currentState/mongoc.so"
fi

cat > "$INST/env" <<EOF
# . this file: the coraine built in $DIR, first on PATH, with its own plugins and etc
export PATH="$INST/bin:\$PATH"
export SEAMWARE_PLUGIN_DIR="$INST/plugins"
export SEAMWARE_ETC_DIR="$INST/etc"
export CORAINE_CONTEXTSOURCEEXTRAS="$INST/etc/contextSourceExtras.json"
EOF

if [ "$NAME" != coraine ]; then
  mv -f "$INST/bin/coraine" "$INST/bin/$NAME"
fi

phase check
"$INST/bin/$NAME" --version > /dev/null || die "the broker just built does not start: $INST/bin/$NAME --version"

phase done
echo
echo "coraine-build: done - $INST"
( cd "$INST" && find bin plugins etc -type f | sort | sed 's/^/  /' )
echo
echo "Run it:"
