#!/usr/bin/env bash
#
# coraine-build - build your own coraine from the exact source of the installed packages
#
# Usage: coraine-build [options] <dir>
#
#   <dir>              where the source is unpacked and built - a new or empty directory, or one an
#                      earlier coraine-build unpacked into (the source is then reused, not unpacked again)
#
#   --release          optimised, traces compiled out (the default) - what the coraine package holds
#                      before profile-guiding
#   --debug            traces compiled in (--traceLevels works), for reproducing a crash report
#   --pgo              profile-guided release: built instrumented, trained here on the measured request
#                      shapes, rebuilt with the profile - what the coraine package and the image hold.
#                      A few minutes more; needs curl and wrk
#   --tune <workload>  --pgo trained on YOUR workload instead, and the knobs measured on it - the best
#                      kept in <dir>/install/etc/tune.env (doc/extreme-performance.md)
#   --features <list>  comma-separated NAME=ON|OFF, NAME without COR_FEATURE_ - e.g.
#                      --features REGISTRATIONS=OFF,SERVICE_EXECUTION=OFF,MONGOC=OFF
#   --http-server <s>  mhd (libmicrohttpd, the default), builtin (corHttp, no external library) or both - the
#                      broker then runs one, chosen at its start (--httpServer, libmicrohttpd by default). With
#                      builtin the switches that need libmicrohttpd are off (POLICY_API - --list-features
#                      --json says so: "requires": ["HTTP_SERVER=mhd"]; both carries libmicrohttpd, so has them,
#                      and the broker refuses to start one of them on the built-in server); --pgo / --tune
#                      with mhd only: their training runs libmicrohttpd, and a both build's built-in server
#                      would be compiled as code never run
#   --list-http-servers  print the --http-server values this source can build, and exit; with --json a JSON
#                      array - ["mhd", "builtin", "both"]
#   --optimize <o>     speed (the default) or size: what the broker's defaults spend RAM on - size runs one
#                      malloc arena for the process, for small hardware (doc/building-details.md#cor_optimize)
#   --bridges <list>   the bridge plugins to build, comma-separated: mqtt, modbus, dds, ckan, opcua, aas, cep - or none
#                      (default mqtt,modbus,cep). A bridge the source does not carry, or whose libraries are
#                      not installed here, stops the build and says which (--list-bridges)
#   --list-bridges     print every bridge, whether it can be built here and why not, and exit; with
#                      --json a JSON array of {name, default, description, available, why}
#   --list-features    print every feature switch, its default and what it is, and exit
#   --json             with --list-features: the same as a JSON array of {name, default, description,
#                      group, requires, requiresAny} - "group" the CMakeLists.txt group it is in ("# Group:
#                      <name> - ..."); "requires" names what it is turned off without - each one of them:
#                      switches, and a build setting as NAME=value (HTTP_SERVER=mhd: libmicrohttpd, not the
#                      built-in server); "requiresAny" the switches it is turned off without all of - one
#                      of them is enough (CHANNEL_WRITE_BACK: DATA_CHANNELS or ASSET_CHANNELS)
#   --name <exe>       the broker's executable: <dir>/install/bin/<exe> (default coraine) - a broker built
#                      for one role (a cor-agent, an edge node) named after it. 1-64 of A-Z a-z 0-9 . _ -,
#                      starting with a letter or a digit; not coraine-import
#   --source <file>    the source tarball (default /usr/share/coraine/src/coraine-src.tar.xz - coraine-dev)
#   --source <dir>     instead: a directory of git clones - coraine and every Cor-Lib side by side, as
#                      corLibs/bootstrap.sh clones them (~/git). Exported as the packages' tarball is
#                      (<dir>/coraine/packaging/deb/source.sh): coraine at the commit checked out, each lib
#                      at origin/main (LIBS_REF=HEAD: the branch each clone has checked out). Committed
#                      trees only - uncommitted changes are not built. coraine-dev is not needed
#   --ref <repo>=<ref> with --source <dir>: what of that clone goes in instead - a branch (feat/x), a remote's
#                      (origin/feat/x), a tag, a commit, HEAD. Once per repository, e.g. --ref coraine=origin/main
#                      --ref corNgsild=feat/x. The lists (--list-features, --list-bridges) read that ref too
#   --image <name>     a container image of the build too, <name> as repository[:tag] (e.g. localhost/coraine:mine):
#                      this distribution's base image (ID:VERSION_ID of /etc/os-release - IMAGE_BASE names
#                      another), the libraries the build links - from their packages, the ones under /usr/local or
#                      /opt copied to the same path -, install/ laid out as the published image's (bin in
#                      /usr/local/bin, plugins and etc in /opt/seamware), its entrypoint (coraine-start) and
#                      healthcheck (coraine-health). With docker, else podman (CONTAINER_ENGINE names one);
#                      Debian and Ubuntu only (dpkg names the packages). The image's context: <dir>/image
#   -h, --help
#
# The result, in <dir>/install - nothing is written outside <dir> (but --image's image, in the engine's store),
# and root is not needed:
#
#   bin/coraine (or --name's)  bin/coraine-import  plugins/...  etc/contextSourceExtras.json  [etc/tune.env]
#   [etc/bridges.json  etc/dds-types/ - with dds: its default configuration]  env
#
# `. <dir>/install/env` puts bin/ on PATH and points the broker at plugins/ and etc/ (SEAMWARE_PLUGIN_DIR,
# CORAINE_CONTEXTSOURCEEXTRAS); then `coraine --database corDB` runs the broker just built (by its
# --name, when given; it reads the same CORAINE_* environment variables whatever it is called).
#
# What the switches mean: doc/building-details.md (features), doc/performance.md (pgo),
# doc/extreme-performance.md (tune) - in the source, <dir>/coraine/doc.
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
set -euo pipefail

SOURCE=/usr/share/coraine/src/coraine-src.tar.xz
MODE=release
WORKLOAD=
FEATURES=
HTTP_SERVER=mhd
OPTIMIZE=speed
DIR=
LIST=0
LISTB=0
LISTH=0
JSON=0
BRIDGES=mqtt,modbus,cep
NAME=coraine
IMAGE=
REFS=                # --ref's: "repo=ref repo=ref ..."

die()   { echo "coraine-build: $*" >&2; exit 1; }
usage() { sed -n '3,/^# Copyright/{/^# Copyright/d;s/^# \{0,1\}//;p}' "$0"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --release)        MODE=release ;;
    --debug)          MODE=debug ;;
    --pgo)            MODE=pgo ;;
    --tune)           MODE=tune; WORKLOAD=${2:?--tune needs a workload file}; shift ;;
    --features)       FEATURES=${2:?--features needs a list}; shift ;;
    --features=*)     FEATURES=${1#--features=} ;;
    --http-server)    HTTP_SERVER=${2:?--http-server needs mhd, builtin or both}; shift ;;
    --http-server=*)  HTTP_SERVER=${1#--http-server=} ;;
    --optimize)       OPTIMIZE=${2:?--optimize needs speed or size}; shift ;;
    --optimize=*)     OPTIMIZE=${1#--optimize=} ;;
    --list-features)  LIST=1 ;;
    --list-bridges)   LISTB=1 ;;
    --list-http-servers) LISTH=1 ;;
    --bridges)        BRIDGES=${2:?--bridges needs a list (or none)}; shift ;;
    --bridges=*)      BRIDGES=${1#--bridges=} ;;
    --json)           JSON=1 ;;
    --source)         SOURCE=${2:?--source needs a file or a directory}; shift ;;
    --name)           NAME=${2:?--name needs a name}; shift ;;
    --name=*)         NAME=${1#--name=} ;;
    --image)          IMAGE=${2:?--image needs a name}; shift ;;
    --image=*)        IMAGE=${1#--image=} ;;
    --ref)            REFS="$REFS ${2:?--ref needs <repo>=<ref>}"; shift ;;
    --ref=*)          REFS="$REFS ${1#--ref=}" ;;
    -h|--help)        usage; exit 0 ;;
    -*)               die "unknown option '$1' (--help)" ;;
    *)                [ -z "$DIR" ] || die "one directory, not '$DIR' and '$1'"; DIR=$1 ;;
  esac
  shift
done

[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "--name '$NAME': 1-64 of A-Z a-z 0-9 . _ -, starting with a letter or a digit"
[ "$NAME" != coraine-import ] || die "--name coraine-import is the migration tool's"

#
# --ref: <repo>=<ref>, a repository once, and only from a directory of clones - each ref checked in its clone
# before anything is exported (a typo found by git archive halfway through the export says less)
#
for r in $REFS; do
  [[ "$r" =~ ^([A-Za-z0-9_-]+)=([A-Za-z0-9._/@^~-]+)$ ]] || die "--ref '$r': <repo>=<ref> - e.g. corNgsild=feat/x"
  [[ "${BASH_REMATCH[2]}" != *..* ]] || die "--ref '$r': a ref, not a range"
  [ "$(tr ' ' '\n' <<< "$REFS" | grep -c "^${BASH_REMATCH[1]}=")" = 1 ] || die "--ref: ${BASH_REMATCH[1]} named twice"
done
if [ -n "$REFS" ]; then
  [ -d "$SOURCE" ] || die "--ref: only with --source <dir> - a tarball's source is what it is"
  for r in $REFS; do
    repo=${r%%=*}; ref=${r#*=}
    [ -e "$SOURCE/$repo/.git" ] || die "--ref $r: no git clone at $SOURCE/$repo"
    git -C "$SOURCE/$repo" rev-parse --verify --quiet "$ref^{commit}" > /dev/null || die "--ref $r: $SOURCE/$repo has no '$ref'"
  done
fi

#
# --image: checked before anything is compiled - a missing engine or dpkg found after a 15-minute --pgo is 15 minutes lost
#
if [ -n "$IMAGE" ]; then
  [[ "$IMAGE" =~ ^([a-z0-9.-]+(:[0-9]+)?/)?[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$ ]] \
    || die "--image '$IMAGE': [registry[:port]/]repository[:tag] - the repository lower-case a-z 0-9 . _ / -"
  ENGINE=${CONTAINER_ENGINE:-}
  if [ -z "$ENGINE" ]; then
    if command -v docker > /dev/null; then ENGINE=docker; elif command -v podman > /dev/null; then ENGINE=podman; fi
  fi
  [ -n "$ENGINE" ] || die "--image: neither docker nor podman is installed (CONTAINER_ENGINE names another)"
  command -v "$ENGINE" > /dev/null || die "--image: '$ENGINE' is not installed"
  "$ENGINE" info > /dev/null 2>&1 || die "--image: '$ENGINE info' fails - is its daemon running, may this user use it?"
  command -v dpkg > /dev/null || die "--image: the image's packages are named by dpkg - Debian and Ubuntu only"
  if [ -z "${IMAGE_BASE:-}" ]; then
    # shellcheck disable=SC1091
    IMAGE_BASE=$(. /etc/os-release && echo "$ID:$VERSION_ID")
  fi
fi

[ -n "$DIR" ] || { { [ "$LIST" = 1 ] || [ "$LISTB" = 1 ] || [ "$LISTH" = 1 ]; } || { usage; exit 1; }; DIR=$(mktemp -d); trap 'rm -rf "$DIR"' EXIT; }

#
# The bridges - plugins built from repositories of their own, beside the broker's. name, repository,
# default, what it is
#
BRIDGE_TABLE="mqtt	corMqttBridge	1	MQTT - NGSI-LD over MQTT topics (mqtt.so, libmosquitto)
modbus	corModbusBridge	1	Modbus TCP - values between Modbus registers and entities (modbus.so, no library)
dds	corDdsBridge	0	DDS - topics, services and actions between DDS and entities (dds.so, eProsima Fast DDS and the DDS Enabler)
ckan	corCkanBridge	0	CKAN - an open data portal's datasets, discovered and read into entities (ckan.so, no library)
opcua	corOpcuaBridge	0	OPC UA - a server's Variables as Channels, its Objects as AssetChannels (opcua.so, open62541)
aas	corAasBridge	0	AAS - an Asset Administration Shell server's shells and submodels as AssetChannels, its Operations as services (aas.so, OpenSSL; a prototype)
cep	corCep	1	CEP - corCep's rules engine in the broker: patterns over the changes, actions back on the entities (cep.so, no library)"
#
# The repositories of the bridges --bridges names: the only bridge clones a build from clones needs
#
BRIDGE_REPO_LIST=
if [ "$BRIDGES" != none ]; then
  for b in ${BRIDGES//,/ }; do
    BRIDGE_REPO_LIST="$BRIDGE_REPO_LIST $(awk -F'\t' -v n="$b" '$1 == n { print $2 }' <<< "$BRIDGE_TABLE")"
  done
fi

#
# The source: unpacked once
#
mkdir -p "$DIR"
DIR=$(cd "$DIR" && pwd)
if [ -f "$DIR/coraine/makefile" ] && [ -f "$DIR/SOURCE" ]; then
  [ -z "$REFS" ] || die "--ref: $DIR already holds an unpacked source - the refs would not be in it (a new directory)"
  echo "coraine-build: reusing the source already in $DIR"
elif [ -n "$(ls -A "$DIR")" ]; then
  die "$DIR is neither empty nor a coraine-build directory"
else
  if [ -d "$SOURCE" ] && { [ "$LIST" = 1 ] || [ "$LISTB" = 1 ] || [ "$LISTH" = 1 ]; }; then
    #
    # The lists only read the clones (CMakeLists.txt, each bridge's makefile): linked, not exported - as they
    # are checked out; a clone --ref names is exported at that ref instead (a branch's switches are its own)
    #
    [ -x "$SOURCE/coraine/packaging/deb/version.sh" ] || die "--source $SOURCE: no coraine clone in it (coraine/packaging/deb/version.sh)"
    for d in "$SOURCE"/*/; do
      repo=$(basename "$d")
      ref=$(tr ' ' '\n' <<< "$REFS" | sed -n "s/^$repo=//p")
      if [ -n "$ref" ]; then
        mkdir "$DIR/$repo"
        git -C "$d" archive --format=tar "$ref" | tar -xf - -C "$DIR/$repo"
      else
        ln -s "$(cd "$d" && pwd)" "$DIR/$repo"
      fi
    done
    coraineRef=$(tr ' ' '\n' <<< "$REFS" | sed -n "s/^coraine=//p")
    echo "version=$(cd "$SOURCE/coraine" && CORAINE_REF=${coraineRef:-HEAD} packaging/deb/version.sh)" > "$DIR/SOURCE"
  elif [ -d "$SOURCE" ]; then
    #
    # A directory of clones: the tarball made from them, as the packages' is, then unpacked like any other
    #
    [ -x "$SOURCE/coraine/packaging/deb/source.sh" ] || die "--source $SOURCE: no coraine clone in it (coraine/packaging/deb/source.sh)"
    TARDIR=$(mktemp -d)
    VENDOR_BRIDGES="$BRIDGE_REPO_LIST" BASE=$(cd "$SOURCE" && pwd) REF=${LIBS_REF:-origin/main} REFS="$REFS" \
      "$SOURCE/coraine/packaging/deb/source.sh" "$TARDIR" \
      || { rm -rf "$TARDIR"; die "--source $SOURCE: the source could not be exported from the clones (above)"; }
    tar -xJf "$TARDIR/coraine-src.tar.xz" -C "$DIR" --strip-components=1
    rm -rf "$TARDIR"
  else
    [ -f "$SOURCE" ] || die "no source tarball at $SOURCE (is coraine-dev installed? --source names another, or a directory of clones)"
    tar -xJf "$SOURCE" -C "$DIR" --strip-components=1
  fi
fi
. "$DIR/SOURCE"      # version, gitSha, commitDate

#
# cmakeUnescape - an option()'s description as it reads, not as CMake quotes it: \" is ", \\ is \ - in
# both lists (DATA_CHANNELS' "dataChannels" showed its backslashes)
#
cmakeUnescape() { sed 's/\\\(["\\]\)/\1/g'; }

if [ "$LIST" = 1 ] && [ "$JSON" = 1 ]; then
  # requires: CMakeLists.txt turns a switch off when another is off - every set() up to the endif()
  #   if (NOT COR_FEATURE_A OR NOT COR_FEATURE_B)                 - off when A or B is: requires A and B
  #     set(COR_FEATURE_C OFF)
  #     set(COR_FEATURE_D OFF)
  #   if ((NOT COR_FEATURE_A) AND (NOT COR_FEATURE_B))            - off when both are: requiresAny A, B
  #     set(COR_FEATURE_C OFF)
  #   if (DEFINED COR_HTTP_SERVER AND COR_HTTP_SERVER STREQUAL "builtin")
  #     set(COR_FEATURE_C OFF)                                    - requires HTTP_SERVER=mhd (both has it)
  #   if (DEFINED COR_HTTP_SERVER AND NOT COR_HTTP_SERVER STREQUAL "mhd")
  #     set(COR_FEATURE_C OFF)                                    - the same, in a source from before "both"
  # One line per switch turned off: NAME all|any REQ... A condition read otherwise (a switch that is ON in
  # it, AND and OR together), or a set(COR_FEATURE_X OFF) under no condition read, stops the listing: a
  # "requires" that leaves one out says a switch can be had that cannot.
  awk '
    function bad(why) { printf "CMakeLists.txt line %d: %s - %s\n", NR, why, $0 > "/dev/stderr"; failed = 1; exit 1 }
    /^if *\(.*NOT COR_HTTP_SERVER STREQUAL "[a-z]*"/ { match($0, /STREQUAL "[a-z]*"/); kind = "all"; req = "HTTP_SERVER=" substr($0, RSTART + 10, RLENGTH - 11); next }
    /^if *\(.* COR_HTTP_SERVER STREQUAL "builtin"/    { kind = "all"; req = "HTTP_SERVER=mhd"; next }
    /^if *\(.*NOT COR_FEATURE_/ {
      c = $0; sub(/^if */, "", c)
      n = split(c, w, /COR_FEATURE_/); req = ""
      for (i = 2; i <= n; i++) { split(w[i], x, /[^A-Z_]/); req = req (req ? " " : "") x[1] }
      t = c; gsub(/NOT COR_FEATURE_[A-Z_]+/, "", t)
      if (t ~ /COR_FEATURE_/) bad("a switch that is ON in the condition")
      hasAnd = (t ~ / AND /); hasOr = (t ~ / OR /)
      if (hasAnd && hasOr) bad("AND and OR in one condition")
      kind = hasAnd ? "any" : "all"
      next }
    /^ +set\(COR_FEATURE_[A-Z_]* OFF\)/ { if (req == "") bad("a switch turned off under no condition read")
                                         match($0, /COR_FEATURE_[A-Z_]*/); print substr($0, RSTART + 12, RLENGTH - 12), kind, req; next }
    /^endif/ { req = "" }
    END { if (failed) exit 1 }
  ' "$DIR/coraine/CMakeLists.txt" > "$DIR/.requires" || die "no feature list: a condition in CMakeLists.txt that turns a switch off is not read (above)"
  esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' <<< "$1"; }
  first=1
  echo "["
  # name, default, group (the "# Group: <name> - " above it, "" before the first) and description - tab-separated
  awk '
    /^# Group: / { g = substr($0, 10); sub(/ - .*/, "", g); next }
    match($0, /^option\(COR_FEATURE_[A-Z_]+ +"/) {
      name = substr($0, 20, RLENGTH - 20); sub(/ +$/, "", name)
      rest = substr($0, RLENGTH + 1)
      def  = (rest ~ /" *ON\)$/) ? "ON" : "OFF"; desc = rest; sub(/" *(ON|OFF)\)$/, "", desc)
      printf "%s\t%s\t%s\t%s\n", name, def, g, desc
    }
  ' "$DIR/coraine/CMakeLists.txt" \
    | cmakeUnescape \
    | while IFS=$'\t' read -r name def group desc; do
        # the names after "NAME all|any" - comma-separated, quoted
        reqOf() { awk -v n="$name" -v k="$1" '$1 == n && $2 == k { for (i = 3; i <= NF; i++) printf "%s\"%s\"", (i > 3 ? ", " : ""), $i }' "$DIR/.requires"; }
        [ "$first" = 1 ] || echo ","
        first=0
        printf '  {"name": "%s", "default": %s, "description": "%s", "group": "%s", "requires": [%s], "requiresAny": [%s]}' \
          "$name" "$([ "$def" = ON ] && echo true || echo false)" "$(esc "$desc")" "$(esc "$group")" "$(reqOf all)" "$(reqOf any)"
      done
  printf '\n]\n'
  rm -f "$DIR/.requires"
  exit 0
fi

if [ "$LIST" = 1 ]; then
  echo "coraine $version - feature switches (--features NAME=ON|OFF):"
  sed -n 's/^option(COR_FEATURE_\([A-Z_]*\) *"\(.*\)" *\(ON\|OFF\))/\1 \3 \2/p' "$DIR/coraine/CMakeLists.txt" \
    | cmakeUnescape \
    | while read -r name def desc; do printf '  %-24s %-4s %s\n' "$name" "$def" "$desc"; done
  exit 0
fi

#
# bridgeWhy <name> <repository> - why it cannot be built here; nothing when it can
#
bridgeWhy() {
  [ -f "$DIR/$2/makefile" ] || { echo "not in this source"; return; }
  case "$1" in
    ckan) # its endpoints are DataChannels: a broker without them loads ckan.so and makes no entity of it
          grep -q "^option(COR_FEATURE_DATA_CHANNELS " "$DIR/coraine/CMakeLists.txt" \
            || echo "it needs DataChannels (COR_FEATURE_DATA_CHANNELS), which this source's broker does not have" ;;
    mqtt) echo '#include <mosquitto.h>' | ${CC:-cc} -E - > /dev/null 2>&1 || echo "libmosquitto's headers are not installed (libmosquitto-dev)" ;;
    aas)  echo '#include <openssl/ssl.h>' | ${CC:-cc} -E - > /dev/null 2>&1 || echo "OpenSSL's headers are not installed (libssl-dev)" ;;
    opcua) echo '#include <open62541/client.h>' | ${CC:-cc} -E - > /dev/null 2>&1 \
             || echo "open62541's headers are not installed (libopen62541-1.4-dev - Ubuntu 26.04, Debian 13)" ;;
    dds)  # the bridge's own makefile decides (COR_BRIDGE_DDS=auto: the Enabler's headers and libraries)
          [ "$(make -s -C "$DIR/$2" -p -n all 2>/dev/null | awk '$1 == "COR_BRIDGE_DDS" { v = $3 } END { print v }')" = ON ] \
            || echo "the DDS Enabler and eProsima Fast DDS are not installed (doc/dds.md)" ;;
  esac
}

if [ "$LISTB" = 1 ]; then
  esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' <<< "$1"; }
  first=1
  [ "$JSON" = 1 ] && echo "[" || echo "coraine $version - bridges (--bridges NAME,...):"
  while IFS='	' read -r name repo def desc; do
    why=$(bridgeWhy "$name" "$repo")
    if [ "$JSON" = 1 ]; then
      [ "$first" = 1 ] || printf ',\n'
      first=0
      printf '  {"name": "%s", "repository": "%s", "default": %s, "description": "%s", "available": %s, "why": %s}' "$name" "$repo" \
        "$([ "$def" = 1 ] && echo true || echo false)" "$(esc "$desc")" "$([ -z "$why" ] && echo true || echo false)" \
        "$([ -z "$why" ] && echo null || echo "\"$(esc "$why")\"")"
    else
      printf '  %-8s %-8s %s%s\n' "$name" "$([ "$def" = 1 ] && echo default || echo '')" "$desc" "${why:+ - not here: $why}"
    fi
  done <<< "$BRIDGE_TABLE"
  [ "$JSON" = 1 ] && printf '\n]\n'
  exit 0
fi

#
# --list-http-servers: the values the source's CMakeLists.txt offers for COR_HTTP_SERVER (its STRINGS property) - an
# older source offers mhd and builtin
#
if [ "$LISTH" = 1 ]; then
  servers=$(sed -n 's/^set_property(CACHE COR_HTTP_SERVER PROPERTY STRINGS \(.*\))$/\1/p' "$DIR/coraine/CMakeLists.txt")
  [ -n "$servers" ] || die "no HTTP server list in $DIR/coraine/CMakeLists.txt (set_property(CACHE COR_HTTP_SERVER PROPERTY STRINGS ...))"
  if [ "$JSON" = 1 ]; then
    printf '['; first=1
    for h in $servers; do [ "$first" = 1 ] || printf ', '; first=0; printf '"%s"' "$h"; done
    printf ']\n'
  else
    echo "coraine $version - HTTP servers (--http-server):"
    for h in $servers; do echo "  $h"; done
  fi
  exit 0
fi

#
# --bridges: each one named, in the source and buildable here - or the build does not start
#
BRIDGE_REPOS=()
if [ "$BRIDGES" != none ]; then
  IFS=, read -r -a wanted <<< "$BRIDGES"
  for b in "${wanted[@]}"; do
    [ -n "$b" ] || continue
    line=$(awk -F'\t' -v n="$b" '$1 == n' <<< "$BRIDGE_TABLE")
    [ -n "$line" ] || die "--bridges: no bridge '$b' (--list-bridges)"
    repo=$(cut -f2 <<< "$line")
    why=$(bridgeWhy "$b" "$repo")
    [ -z "$why" ] || die "--bridges: $b cannot be built here - $why"
    BRIDGE_REPOS+=("$repo")
  done
fi

#
# --features NAME=ON|OFF,... -> CMAKE_FEATURES -DCOR_FEATURE_NAME=ON|OFF
#
CMAKE_FEATURES=
MONGOC=ON
ICU=0
CORP=1
GEOQ=1
TROE_CORDB=1
IFS=, read -r -a items <<< "$FEATURES"
for item in "${items[@]}"; do
  [ -n "$item" ] || continue
  name=${item%%=*}; value=${item#*=}
  name=${name#COR_FEATURE_}
  [ "$name" != "$item" ] || die "--features: '$item' is not NAME=ON|OFF"
  case "$value" in ON|on|1) value=ON ;; OFF|off|0) value=OFF ;; *) die "--features: $name=$value - ON or OFF" ;; esac
  grep -q "^option(COR_FEATURE_$name " "$DIR/coraine/CMakeLists.txt" || die "--features: no feature '$name' (--list-features)"
  [ "$name" = MONGOC ] && MONGOC=$value
  # ICU_COLLATION is two flags - corNgsild's code path and the broker's link - and the makefile's
  # COR_WITH_ICU sets both; as a cmake -D alone the broker says ICU and sorts without it
  if [ "$name" = ICU_COLLATION ]; then
    [ "$value" = ON ] && ICU=1 || ICU=0
    continue
  fi
  # COR_PROTOCOL the same way: the makefile's COR_WITH_COR_PROTOCOL leaves cor:// out of corRest as well
  if [ "$name" = COR_PROTOCOL ]; then
    [ "$value" = ON ] && CORP=1 || CORP=0
    continue
  fi
  # GEOQ too: the makefile's COR_WITH_GEOQ builds corDB's geo matcher without GEOS as well as the broker's
  if [ "$name" = GEOQ ]; then
    [ "$value" = ON ] && GEOQ=1 || GEOQ=0
    continue
  fi
  # TROE_CORDB too: the makefile's COR_WITH_TROE_CORDB builds corDB.so without its history as well
  if [ "$name" = TROE_CORDB ]; then
    [ "$value" = ON ] && TROE_CORDB=1 || TROE_CORDB=0
    continue
  fi
  CMAKE_FEATURES="$CMAKE_FEATURES -DCOR_FEATURE_$name=$value"
done
if [ "$ICU" = 1 ] && ! pkg-config --exists icu-i18n icu-uc; then
  die "ICU_COLLATION=ON needs ICU's headers and libraries (libicu-dev)"
fi

#
# mongo-c driver v2, for the mongoc plugin: the distribution's (Ubuntu 26.04: libmongoc-dev), or the one
# coraine-dev bundles in /opt/seamware where the distribution has only v1 (Ubuntu 24.04, Debian 13).
# The bundled one is found through pkg-config and the linker search path here, and through a RUNPATH on
# mongoc.so at run time (below).
#
BUNDLED=0
if [ "$MONGOC" = ON ] && ! pkg-config --exists mongoc2; then
  if [ -f /opt/seamware/lib/pkgconfig/mongoc2.pc ]; then
    BUNDLED=1
    export PKG_CONFIG_PATH=/opt/seamware/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
    export LIBRARY_PATH=/opt/seamware/lib${LIBRARY_PATH:+:$LIBRARY_PATH}
    export LD_LIBRARY_PATH=/opt/seamware/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    command -v patchelf > /dev/null || die "patchelf is needed to point mongoc.so at /opt/seamware/lib"
  else
    die "no mongo-c driver v2 (pkg-config mongoc2) - install it, or build without: --features MONGOC=OFF"
  fi
fi

case "$HTTP_SERVER" in mhd|builtin|both) ;; *) die "--http-server: '$HTTP_SERVER' - mhd, builtin or both" ;; esac
[ "$HTTP_SERVER" != both ] || grep -q '^set_property(CACHE COR_HTTP_SERVER PROPERTY STRINGS .*both' "$DIR/coraine/CMakeLists.txt" \
  || die "--http-server both: this source has no such build (coraine-build --list-http-servers)"
case "$OPTIMIZE" in speed|size) ;; *) die "--optimize: '$OPTIMIZE' - speed or size" ;; esac
if [ "$HTTP_SERVER" != mhd ] && { [ "$MODE" = pgo ] || [ "$MODE" = tune ]; }; then
  die "--http-server $HTTP_SERVER: not with --$MODE yet (its training runs libmicrohttpd only - a both build's built-in server would be compiled as code never run)"
fi

if [ "$MODE" = pgo ] || [ "$MODE" = tune ]; then
  for t in curl wrk python3; do command -v $t > /dev/null || die "--$MODE needs $t"; done
fi
if [ "$MODE" = tune ]; then
  [ -f "$WORKLOAD" ] || die "--tune: no workload file '$WORKLOAD'"
  WORKLOAD=$(cd "$(dirname "$WORKLOAD")" && pwd)/$(basename "$WORKLOAD")
fi

INST=$DIR/install
rm -rf "$INST"
mkdir -p "$INST/bin" "$INST/plugins" "$INST/etc"
C=$DIR/coraine

#
# Every make below gets PLUGIN_DIR: corDB installs its plugins as it is built (the broker's makefile
# builds it with the libraries), and without it that would be /opt/seamware/plugins. A command-line
# variable reaches every sub-make.
#
MK=(PLUGIN_DIR="$INST/plugins" CORAINE_GIT_SHA="${gitSha:0:8}" CMAKE_FEATURES="$CMAKE_FEATURES" COR_HTTP_SERVER="$HTTP_SERVER" COR_OPTIMIZE="$OPTIMIZE" COR_WITH_ICU="$ICU" COR_WITH_COR_PROTOCOL="$CORP" COR_WITH_GEOQ="$GEOQ" COR_WITH_TROE_CORDB="$TROE_CORDB")

#
# phase - one line per phase, for a front-end to show progress without parsing make's output
#
phase() { echo "coraine-build: phase $1"; }

echo "coraine-build: coraine $version ($MODE, HTTP server $HTTP_SERVER${FEATURES:+, $FEATURES}) in $DIR"
make -C "$C" clean > /dev/null
phase build

case "$MODE" in
  release) make -C "$C" "${MK[@]}" release;  B=$C/BUILD_RELEASE ;;
  debug)   make -C "$C" "${MK[@]}" debug;    B=$C/BUILD_DEBUG ;;
  pgo|tune)
    # the tools the training drives (corTestClient, corRequest; corJson) into corLibs/bin, where
    # pgoTrain.sh and perfRun.sh look: the umbrella's `all` builds them, corTools' and corJson's own
    # `install` copies them into their bin/ (nothing else), install-local gathers them. Never the
    # umbrella's `install`: it would write plugins to /opt/seamware
    phase tools
    make -C "$DIR/corLibs" BUILD=release all
    make -C "$DIR/corTools" BUILD=release install
    make -C "$DIR/corJson" BUILD=release install
    make -C "$DIR/corLibs" install-local
    for t in corTestClient corRequest; do
      [ -x "$DIR/corLibs/bin/$t" ] || die "--$MODE: $t was not built - the training needs it"
    done
    phase train
    if [ "$MODE" = pgo ]; then
      make -C "$C" "${MK[@]}" PGO_RESTORE_DEBUG=0 pgo 2>&1 | tee "$DIR/pgo.log"
    else
      (cd "$C" && make "${MK[@]}" PGO_RESTORE_DEBUG=0 tune WORKLOAD="$WORKLOAD") 2>&1 | tee "$DIR/pgo.log"
      "$C/test/perf/tune/tuneEnv.py" "$C/tune-result.json" > "$INST/etc/tune.env"
    fi
    # pgoTrain.sh goes on after a part of the training fails (the profile is then partial) - not here
    if grep 'pgoTrain: .*failed' "$DIR/pgo.log"; then
      die "a part of the training failed - the profile would lack it (the output above, $DIR/pgo.log)"
    fi
    # corDB's plugins: installed into PLUGIN_DIR by the profile-use pass of `make pgo` itself
    B=$C/BUILD_PGO ;;
esac

#
# The broker's own install target copies a FIXED set of plugins, so a build with a plugin switched off
# would fail it: the broker, coraine-import and whatever plugins this build produced, by kind -
# src/plugins/<kind>/<name>/<name>.so -> plugins/<directory the broker loads <kind> from>/<name>.so
#
# installFile <file> <dir> - a NEW file in <dir>, renamed over the old one: never cp onto it. cp rewrites
# the file in place (the same inode); a broker running from $INST has its plugins mapped, their code
# changes under it and it dies (SIGSEGV, SIGILL) - and cp onto the running coraine fails (Text file busy)
installFile()
{
  cp -p "$1" "$2/.$(basename "$1").new" && mv -f "$2/.$(basename "$1").new" "$2/$(basename "$1")"
}

phase install
installFile "$B/src/app/coraine/coraine" "$INST/bin"
[ ! -f "$B/src/app/coraineImport/coraine-import" ] || installFile "$B/src/app/coraineImport/coraine-import" "$INST/bin"
find "$B/src/plugins" -name '*.so' | while read -r so; do
  kind=$(basename "$(dirname "$(dirname "$so")")")
  case "$kind" in
    currentState) d=db/currentState ;;
    temporal)     d=troe/temporal ;;
    api|auth|bridge|transport) d=$kind ;;
    *) continue ;;
  esac
  mkdir -p "$INST/plugins/$d"
  installFile "$so" "$INST/plugins/$d"
done

phase bridges
# the bridges that are not the broker's, as --bridges named them (default MQTT, Modbus and CEP)
for br in "${BRIDGE_REPOS[@]}"; do
  flavour=release; [ "$MODE" = debug ] && flavour=debug
  extra=(); [ "$br" = corDdsBridge ] && extra=(COR_BRIDGE_DDS=ON)
  target=install; [ "$br" = corCep ] && target=plugin-install    # corCep's install is its standalone binary
  make -C "$DIR/$br" BUILD=$flavour PLUGIN_DIR="$INST/plugins/bridge" "${extra[@]}" $target > /dev/null
done

installFile "$C/etc/contextSourceExtras.json" "$INST/etc"

#
# The DDS bridge refuses to start without a configuration: with dds built, the build's etc gets the one
# the image ships (etc/dds-default.json - domain 0, no topics) as bridges.json, the file the broker reads
# when --bridgeConfig is not given; its types directory is the build's own
#
if [ -f "$INST/plugins/bridge/dds.so" ] && [ ! -f "$INST/etc/bridges.json" ]; then
  mkdir -p "$INST/etc/dds-types"
  esc=$(printf '%s' "$INST/etc/dds-types" | sed 's/[&|\\]/\\&/g')
  sed "s|/opt/seamware/etc/dds-types|$esc|" "$C/etc/dds-default.json" > "$INST/etc/.bridges.json.new" && mv -f "$INST/etc/.bridges.json.new" "$INST/etc/bridges.json"
fi

if [ "$BUNDLED" = 1 ] && [ -f "$INST/plugins/db/currentState/mongoc.so" ]; then
  patchelf --set-rpath /opt/seamware/lib "$INST/plugins/db/currentState/mongoc.so"
fi

cat > "$INST/env" <<EOF
# . this file: the coraine built in $DIR, first on PATH, with its own plugins and etc
export PATH="$INST/bin:\$PATH"
export SEAMWARE_PLUGIN_DIR="$INST/plugins"
export SEAMWARE_ETC_DIR="$INST/etc"
export CORAINE_CONTEXTSOURCEEXTRAS="$INST/etc/contextSourceExtras.json"
EOF

if [ "$NAME" != coraine ]; then
  mv -f "$INST/bin/coraine" "$INST/bin/$NAME"
fi

phase check
"$INST/bin/$NAME" --version > /dev/null || die "the broker just built does not start: $INST/bin/$NAME --version"

#
# The image: the build's install/ on this distribution's base image, laid out as the published image's - the
# broker's own defaults (/opt/seamware/plugins, /opt/seamware/etc), no environment needed
#
if [ -n "$IMAGE" ]; then
  phase image
  CTX=$DIR/image
  R=$CTX/root
  rm -rf "$CTX"
  mkdir -p "$R/usr/local/bin" "$R/opt/seamware"
  cp -a "$INST/bin/." "$R/usr/local/bin/"
  cp -a "$INST/plugins" "$INST/etc" "$R/opt/seamware/"
  sed "s/^exec coraine /exec $NAME /" "$C/docker/coraine-start" > "$R/usr/local/bin/coraine-start"
  cp "$C/docker/coraine-health" "$R/usr/local/bin/coraine-health"
  chmod 755 "$R/usr/local/bin/coraine-start" "$R/usr/local/bin/coraine-health"
  if [ -f "$R/opt/seamware/etc/bridges.json" ]; then    # dds: the image's own paths, not the build's
    cp "$C/etc/dds-default.json" "$R/opt/seamware/etc/bridges.json"
    rm -rf "$R/opt/seamware/etc/dds-types"; mkdir -p "$R/opt/seamware/etc/dds-types"
  fi

  #
  # The libraries: every one the broker, coraine-import and the plugins link. One of this distribution's packages
  # is installed in the image; one built here (under /usr/local or /opt - libmicrohttpd, mongoc, a bundled
  # /opt/seamware/lib) is copied to the same path, under the name the loader looks for
  #
  ELFS=()
  while read -r f; do
    file -b "$f" | grep -q '^ELF' && ELFS+=("${f#"$R"}")
  done < <(find "$R/usr/local/bin" "$R/opt/seamware/plugins" -type f)
  declare -A PKGS=()
  for f in "${ELFS[@]}"; do
    ldd "$R$f" | grep -q "not found" && { ldd "$R$f" | grep "not found" >&2; die "--image: $f links a library not found here (above)"; }
    while read -r lib; do
      real=$(readlink -f "$lib")
      case "$real" in
        /usr/local/*|/opt/*)
          mkdir -p "$R$(dirname "$lib")"
          [ -e "$R$lib" ] || cp -L "$lib" "$R$lib" ;;
        *)
          pkg=$(dpkg -S "$real" 2> /dev/null || dpkg -S "$lib" 2> /dev/null) || die "--image: no package has $lib ($f links it)"
          PKGS[${pkg%%:*}]=1 ;;
      esac
    done < <(ldd "$R$f" | awk '$2 == "=>" && $3 ~ /^\// { print $3 }')
  done
  PKGS[curl]=1; PKGS[ca-certificates]=1                    # coraine-health; HTTPS to context sources, OIDC
  case $(sed -n 's/^TUNE_ALLOCATOR=//p' "$INST/etc/tune.env" 2> /dev/null) in   # what --tune chose, preloaded by coraine-start
    jemalloc)         PKGS[libjemalloc2]=1 ;;
    tcmalloc_minimal) PKGS[libtcmalloc-minimal4]=1 ;;
  esac

  CMDARGS='"--database", "corDB"'
  [ ! -f "$R/opt/seamware/plugins/db/currentState/mongoc.so" ] || CMDARGS='"--database", "mongoc", "--troe", "none"'
  [ ! -f "$R/opt/seamware/plugins/api/admin.so" ] || CMDARGS="$CMDARGS, \"--apiPlugins\", \"admin\""
  version=$("$INST/bin/$NAME" --version 2> /dev/null | head -1)

  cat > "$CTX/Dockerfile" <<EOF
# made by coraine-build --image: $DIR/install on $IMAGE_BASE
FROM $IMAGE_BASE
LABEL org.opencontainers.image.title="$NAME" \\
      org.opencontainers.image.description="coraine built by coraine-build: $MODE, bridges $BRIDGES" \\
      org.opencontainers.image.version="$version" \\
      org.opencontainers.image.vendor="Seamware" \\
      org.opencontainers.image.licenses="Apache-2.0"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends $(printf '%s ' "${!PKGS[@]}" | tr ' ' '\n' | sort | tr '\n' ' ')\\
    && rm -rf /var/lib/apt/lists/*
COPY root/ /
RUN ldconfig \\
    && if ldd ${ELFS[*]} | grep "not found"; then echo "unresolved libraries - above"; exit 1; fi \\
    && $NAME --version > /dev/null
EXPOSE 1026
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD coraine-health || exit 1
ENTRYPOINT ["coraine-start"]
CMD [$CMDARGS]
EOF
  "$ENGINE" build -t "$IMAGE" "$CTX" || die "--image: $ENGINE build failed (above) - the context is $CTX"
  size=$("$ENGINE" image inspect --format '{{.Size}}' "$IMAGE")
  echo "coraine-build: image $IMAGE - $((size / 1048576)) MiB, $ENGINE, on $IMAGE_BASE"
fi

phase done
echo
echo "coraine-build: done - $INST"
( cd "$INST" && find bin plugins etc -type f | sort | sed 's/^/  /' )
echo
echo "Run it:"
echo "  . $INST/env"
echo "  $NAME --database corDB"
[ -z "$IMAGE" ] || echo "  or: $ENGINE run --rm -p 1026:1026 $IMAGE --database corDB"
[ ! -f "$INST/etc/tune.env" ] || echo "  (what --tune chose: $INST/etc/tune.env - TUNE_DBLOCKPREFER, TUNE_ALLOCATOR: --dbLockPrefer and the allocator to preload (LD_PRELOAD), see doc/extreme-performance.md)"
