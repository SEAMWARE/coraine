#!/bin/sh
#
# coraine postinst - the system user, the state directory, the unit known to systemd
#
# The service is NOT enabled or started on install: the broker listens on every interface (port 1026)
# and has no authentication of its own, so it starts when the administrator says so -
#
#   systemctl enable --now coraine
#
# An upgrade restarts it if it is running (try-restart), with the new binary.
#
set -e

if [ "$1" = configure ]; then
  if ! getent passwd coraine > /dev/null; then
    adduser --system --group --home /var/lib/coraine --no-create-home \
            --gecos "coraine NGSI-LD context broker" coraine > /dev/null
  fi
  install -d -o coraine -g coraine -m 0750 /var/lib/coraine
fi

if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
  # known to deb-systemd-helper (so purge cleans up after it), but not enabled
  deb-systemd-helper update-state coraine.service > /dev/null || true

  if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload > /dev/null || true
    if [ -n "$2" ]; then
      deb-systemd-invoke try-restart coraine.service > /dev/null || true
    fi
  fi
fi

exit 0
