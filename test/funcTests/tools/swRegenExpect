#!/usr/bin/env python3
"""
swBroker-specific --EXPECT-- regenerator for swTest.

swTest's `--regen` mode delegates to a repo-provided regen tool at
test/funcTests/tools/swRegenExpect if present (this file); otherwise it falls
back to swTest's generic verbatim fill. This tool understands swBroker's
output (HTTP responses, NGSI-LD bodies, ftClient dumps) and rewrites the
captured .out into an --EXPECT-- block with REGEX() wrappers around the
process-/run-volatile tokens, so regenerated expectations stay stable.

Volatility rules:
  Date:                       always varies                          → REGEX(.*)
  Link:                       deterministic per broker config         → keep exact
  Content-Length (HTTP hdr):  drifts only when body has timestamp
                              fields with stripped trailing zeros    → REGEX(\\d+) iff body volatile
  User-Agent (in body):       carries broker version string           → REGEX("swBroker/.*")
  Notification id (body):     fixed length, value varies per process  → REGEX inside quotes
  ISO timestamp fields (body):variable length (zero-stripping)        → REGEX inside quotes
  Embedded "Content-Length"   inside ftClient body dumps tracks
  in JSON body:               notification body length                 → REGEX(\\d+) iff body volatile

REGEX style: "REGEX(pattern)" — inside the quoted string — to match the
convention already used by existing .test files.
"""
import re, sys, pathlib

CASES = pathlib.Path("test/funcTests/cases")

# Body fields whose VALUE varies in length across runs (zero-stripping)
TS_FIELDS = (
    "notifiedAt", "observedAt", "createdAt", "modifiedAt",
    "deletedAt", "lastNotification", "lastSuccess", "lastFailure",
    "expiresAt", "lastChange", "lastUsage", "lastUsedAt",
    "contextSourceTimeAt", "contextSourceUptime", "instanceId",
)
TS_RE = re.compile(
    r'("(?:' + "|".join(TS_FIELDS) + r')"\s*:\s*)"[^"]+"'
)

# Notification id — fixed length but value varies per process
NID_RE = re.compile(
    r'"urn:ngsi-ld:Notification:[0-9a-fA-F]+:\d+"'
)

# EntityMap id — fixed length, process-volatile hex hash. Appears both as
# JSON value ("id":"urn:ngsi-ld:EntityMap:HEX") and embedded in pagination
# Link headers (entityMap=urn:ngsi-ld:EntityMap:HEX).
EM_RE = re.compile(r'urn:ngsi-ld:EntityMap:[0-9a-fA-F]+')

# Auto-generated ContextSourceRegistration id (when the create omits an id) —
# the hex part is a process-volatile hash; the trailing counter is stable.
# Appears as a JSON value ("id":"...") and in the Location header.
CSR_RE = re.compile(r'urn:ngsi-ld:ContextSourceRegistration:[0-9a-fA-F]+:\d+')

# User-Agent in ftClient body dumps carries the broker version
UA_RE = re.compile(r'("User-Agent"\s*:\s*)"swBroker[^"]*"')

# Next File Descriptor in /admin/version — host- and run-volatile
FD_RE = re.compile(r'("Next File Descriptor"\s*:\s*)\d+')

# Embedded Content-Length inside ftClient body dumps
ECL_RE = re.compile(r'("Content-Length"\s*:\s*)"\d+"')

# Escaped-JSON forms — appear when a notification body is itself a
# JSON-encoded string (e.g. MQTT delivery: `"body": "{...escaped JSON...}"`).
# The volatile fields inside are visible as \"notifiedAt\":\"...\" etc.
ESC_NID_RE = re.compile(r'\\"urn:ngsi-ld:Notification:[0-9a-fA-F]+:\d+\\"')
ESC_TS_RE = re.compile(
    r'(\\"(?:' + "|".join(TS_FIELDS) + r')\\"\s*:\s*)\\"[^\\]+\\"'
)


def line_normalize(line, has_volatile_so_far):
    """Apply per-line normalisations. Returns (line, sets_volatile)."""
    sets_volatile = False

    # Escaped-JSON body inside a string field (MQTT-style notification
    # delivery): the line carries one nested body where notifiedAt + the
    # notification id are both volatile. Two REGEX(...) wrappers on one
    # line don't work (swDiff handles only one), so when escaped
    # occurrences are present, build a whole-line regex covering every
    # variable token in one shot.
    has_esc_nid = ESC_NID_RE.search(line) is not None
    has_esc_ts  = ESC_TS_RE.search(line) is not None
    if has_esc_nid or has_esc_ts:
        NID_HOLE = '\x01NID\x01'
        TS_HOLE  = '\x01TS\x01'
        work = ESC_NID_RE.sub(r'\\"' + NID_HOLE + r'\\"', line)
        work = ESC_TS_RE.sub(r'\1\\"' + TS_HOLE + r'\\"', work)
        escaped = re.escape(work)
        escaped = escaped.replace(re.escape(NID_HOLE),
                                  r'urn:ngsi-ld:Notification:[0-9a-f]+:\d+')
        escaped = escaped.replace(re.escape(TS_HOLE), r'[^\\]+')
        line = 'REGEX(' + escaped + ')'
        if has_esc_ts:
            sets_volatile = True
        if UA_RE.search(line):
            line = UA_RE.sub(r'\1"REGEX(swBroker/.*)"', line)
        return line, sets_volatile

    if NID_RE.search(line):
        line = NID_RE.sub(r'"REGEX(urn:ngsi-ld:Notification:.*)"', line)
    if CSR_RE.search(line):
        line = CSR_RE.sub(r'REGEX(urn:ngsi-ld:ContextSourceRegistration:[0-9a-f]+:[0-9]+)', line)
    matches = list(EM_RE.finditer(line))
    if len(matches) == 1:
        line = EM_RE.sub('REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)', line)
    elif len(matches) >= 2:
        # swDiff allows only one REGEX(...) per line. With 2+ EntityMap ids
        # on one line (typical for multi-rel pagination Link headers),
        # build a single whole-line regex that wraps the entire content.
        parts = []
        last = 0
        for m in matches:
            parts.append(re.escape(line[last:m.start()]))
            parts.append('urn:ngsi-ld:EntityMap:[0-9a-f]+')
            last = m.end()
        parts.append(re.escape(line[last:]))
        line = 'REGEX(' + ''.join(parts) + ')'
    if TS_RE.search(line):
        line = TS_RE.sub(r'\1"REGEX(.*)"', line)
        sets_volatile = True
    if UA_RE.search(line):
        line = UA_RE.sub(r'\1"REGEX(swBroker/.*)"', line)
    if FD_RE.search(line):
        line = FD_RE.sub(r'\1REGEX(\\d+)', line)
        sets_volatile = True
    return line, sets_volatile


def normalize(out_text):
    """Walk .out, splitting at HTTP responses; normalise volatile fields
    and conditionally REGEX Content-Length."""
    lines = out_text.split('\n')
    result = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith('HTTP/1.1 '):
            headers = [line]
            cl_idx = None
            i += 1
            while i < len(lines) and lines[i] != '':
                hl = lines[i]
                if hl.startswith('Date: '):
                    hl = 'Date: REGEX(.*)'
                elif hl.startswith('Content-Length: '):
                    cl_idx = len(headers)
                # Header values can also embed volatile tokens (e.g. an
                # EntityMap id in pagination Link headers).
                hl, _ = line_normalize(hl, False)
                headers.append(hl)
                i += 1
            sep = lines[i] if i < len(lines) else ''
            i += 1

            body = []
            while i < len(lines):
                if lines[i].startswith('HTTP/1.1 '):
                    break
                if lines[i] == '' and (i + 1 < len(lines) and lines[i + 1] == ''):
                    break
                body.append(lines[i])
                i += 1

            body_volatile = False
            new_body = []
            for bl in body:
                bl, sv = line_normalize(bl, body_volatile)
                if sv:
                    body_volatile = True
                new_body.append(bl)

            # Embedded Content-Length in body — REGEX iff body volatile
            if body_volatile:
                new_body = [ECL_RE.sub(r'\1"REGEX(\\d+)"', b) for b in new_body]

            # Header Content-Length — REGEX iff body volatile
            if body_volatile and cl_idx is not None:
                headers[cl_idx] = 'Content-Length: REGEX(\\d+)'

            result.extend(headers)
            result.append(sep)
            result.extend(new_body)
        else:
            # Outside an HTTP response: ftClient JSON dumps live here too.
            new_line, sv = line_normalize(line, False)
            # If this section is part of an ftClient dump with timestamps,
            # the embedded Content-Length will be REGEX'd via ECL_RE on the
            # SAME pass. Apply ECL_RE unconditionally outside HTTP responses
            # — embedded Content-Length only appears in ftClient bodies, and
            # those bodies always carry notification timestamps.
            new_line = ECL_RE.sub(r'\1"REGEX(\\d+)"', new_line)
            result.append(new_line)
            i += 1

    return '\n'.join(result)


def update_test(base):
    out_path = CASES / f"{base}.out"
    test_path = CASES / f"{base}.test"
    if not out_path.exists() or not test_path.exists():
        print(f"SKIP {base}: missing files")
        return False
    out = out_path.read_text()
    test = test_path.read_text()

    new_expect = normalize(out)

    #
    # The lookahead anchors on a section marker at the START OF A LINE, and does not
    # eat the newline before it - so an EMPTY --EXPECT-- block (what --regen is handed)
    # sitting directly above --TEARDOWN-- ends where it should. With '\n--[A-Z]+--' the
    # zero-length match was impossible and '.*?' ran on to \Z, silently swallowing every
    # section below EXPECT: the regenerated test lost its --TEARDOWN-- and from then on
    # leaked a running broker into the next test.
    #
    pattern = re.compile(r'(--EXPECT--\n)(.*?)(?=^--[A-Z]+--|\Z)', re.DOTALL | re.MULTILINE)
    if not pattern.search(test):
        print(f"SKIP {base}: no --EXPECT-- block")
        return False
    new_test = pattern.sub(lambda m: m.group(1) + new_expect, test)
    test_path.write_text(new_test)
    print(f"OK   {base}")
    return True


if __name__ == "__main__":
    for b in sys.argv[1:]:
        update_test(b)
