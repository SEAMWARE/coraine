#
# FILE            subscription_watched_vs_notification_attributes.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.6 — watchedAttributes and notification.attributes are ORTHOGONAL:
#   - watchedAttributes  : which Attribute CHANGES trigger a notification.
#   - notification.attributes (pick alias) : which Attributes appear in the
#                          notification BODY.
# Sub watches [speed] and projects body to [temperature]. A change to
# temperature must NOT notify (not watched); a change to speed MUST notify,
# and its body carries only temperature (not speed, not color).
#
--NAME--
Subscription notification — watchedAttributes (trigger) vs notification.attributes (body) (§ 5.2.6)

--TAGS--
subscription notification watchedAttributes

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

echo "01. Create Vehicle V1 (speed, temperature, color)"
echo "================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:ngsi-ld:Vehicle:V1",
  "type":"Vehicle",
  "speed":{"type":"Property","value":50},
  "temperature":{"type":"Property","value":20},
  "color":{"type":"Property","value":"red"}
}'
echo
echo


echo "02. Subscription: watchedAttributes=[speed], notification.attributes=[temperature]"
echo "================================================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:wva",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "watchedAttributes":["speed"],
  "notification":{
    "attributes":["temperature"],
    "endpoint":{"uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify"}
  }
}'
echo
echo


echo "03. Update temperature only (NOT watched) → no notification"
echo "==========================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs' -X PATCH --payload '{
  "temperature":{"type":"Property","value":22}
}'
echo
sleep 0.4
ftClientDump
ftClientReset
echo
echo


echo "04. Update speed (watched) → notification, body carries ONLY temperature"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs' -X PATCH --payload '{
  "speed":{"type":"Property","value":60}
}'
echo
sleep 0.4
ftClientDump
echo
echo


--EXPECT--
01. Create Vehicle V1 (speed, temperature, color)
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0




02. Subscription: watchedAttributes=[speed], notification.attributes=[temperature]
=================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:wva
Content-Length: 0




03. Update temperature only (NOT watched) → no notification
===========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



[]

04. Update speed (watched) → notification, body carries ONLY temperature
========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:Vehicle:V1",
          "temperature": {
            "type": "Property",
            "value": 22
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:wva",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
swBrokerStop
ftClientStop
