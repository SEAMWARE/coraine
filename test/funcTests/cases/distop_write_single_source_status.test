        "detail": "forward failed: Connection failed",
        "status": 502,
        "title": "Bad Gateway",
        "type": "https://uri.etsi.org/ngsi-ld/errors/InternalError"
      },
      "registrationId": "urn:CSR:W3"
    }
  ],
  "success": []
}



