#
# FILE            csr_subscription_on_update_notif.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.11.7 — CSR PATCH fires one of three triggerReasons per sub
# depending on the match-before / match-after state:
#   was-match && still-match    -> "updated"
#   not-match && now-match      -> "newlyMatching"
#   was-match && not-match-now  -> "noLongerMatching"
# data[] always carries the post-update CSR (most recent state).
#
--NAME--
CSR Subscription - updated / newlyMatching / noLongerMatching on CSR PATCH

--TAGS--
csr-sub subscription update

--INIT--
corDbDrop
ftClientStart
coraineStart -dist

--RUN--

#
# S-watches Vehicle (any attr). CSR-A starts as Vehicle → matches S.
# 01. Register CSR-A Vehicle/[speed]
# 02. Subscribe S → initial newlyMatching (CSR-A in data)
# 03. Dump: one notification (initial)
#
# 04. PATCH CSR-A propertyNames += color (still Vehicle → "updated")
# 05. Dump: two notifications total; second is "updated"
#
# 06. PATCH CSR-A type:=Temperature (no longer matches Vehicle)
# 07. Dump: three; third is "noLongerMatching"
#
# 08. PATCH CSR-A type:=Vehicle again (now matches again)
# 09. Dump: four; fourth is "newlyMatching"
#

echo "01. Register CSR-A (Vehicle propertyNames=[speed])"
echo "=================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:A","type":"ContextSourceRegistration","endpoint":"http://cp1.example","mode":"inclusive","information":[{"entities":[{"type":"Vehicle"}],"propertyNames":["speed"]}]}'
echo
echo


echo "02. Subscribe S (Vehicle)"
echo "========================="
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload '{"id":"urn:S","type":"Subscription","entities":[{"type":"Vehicle"}],"notification":{"endpoint":{"uri":"http://localhost:'$FT_CLIENT_PORT'/s"}}}'
echo
echo


echo "03. Dump ftClient - initial newlyMatching"
echo "========================================="
ftClientDump
echo
echo


echo "04. PATCH CSR-A propertyNames := [speed, color] (still Vehicle)"
echo "==============================================================="
corCurl -X PATCH --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:A --payload '{"information":[{"entities":[{"type":"Vehicle"}],"propertyNames":["speed","color"]}]}'
echo
echo


echo "05. Dump ftClient - + updated"
echo "============================="
ftClientDump
echo
echo


echo "06. PATCH CSR-A entities := [{type: Temperature}] (no longer Vehicle)"
echo "====================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:A --payload '{"information":[{"entities":[{"type":"Temperature"}]}]}'
echo
echo


echo "07. Dump ftClient - + noLongerMatching"
echo "======================================"
ftClientDump
echo
echo


echo "08. PATCH CSR-A entities := [{type: Vehicle}] (matches again)"
echo "============================================================="
corCurl -X PATCH --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:A --payload '{"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "09. Dump ftClient - + newlyMatching"
echo "==================================="
ftClientDump
echo
echo


--EXPECT--
01. Register CSR-A (Vehicle propertyNames=[speed])
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:A
Content-Length: 0




02. Subscribe S (Vehicle)
=========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceSubscriptions/urn:S
Content-Length: 0




03. Dump ftClient - initial newlyMatching
=========================================
[
  {
    "body": {
      "data": [
        {
          "endpoint": "http://cp1.example",
          "id": "urn:CSR:A",
          "information": [
            {
              "attributeNames": [
                "speed"
              ],
              "entities": [
                {
                  "type": "Vehicle"
                }
              ]
            }
          ],
          "mode": "inclusive",
          "type": "ContextSourceRegistration"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:S",
      "triggerReason": "newlyMatching",
      "type": "ContextSourceNotification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/s",
    "verb": "POST"
  }
]


04. PATCH CSR-A propertyNames := [speed, color] (still Vehicle)
===============================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




