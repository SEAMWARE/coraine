#
# FILE            csr_subscription_crud.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.11 Context Source Registration Subscription — CRUD surface.
# Separate cache (Tenant.regSubCacheP) so entity-sub hot path is
# untouched. Cache-only (no DB persistence in v1). timeInterval
# returns 422.
#
# REQUIRE_FEATURE: REGISTRATIONS
#
--NAME--
CSR Subscription CRUD - create, retrieve, query, update, delete

--TAGS--
csr-sub subscription

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create CSR-sub with explicit id - 201
# 02. Retrieve by id - 200
# 03. Create second CSR-sub - 201
# 04. List all - two subs
# 05. Create duplicate id - 409
# 06. PATCH - change description
# 07. Retrieve after patch - 200, new description
# 08. POST with timeInterval - 422 (deferred)
# 09. DELETE first - 204
# 10. List after delete - one sub
# 11. DELETE non-existing - 404
# 12. Retrieve deleted - 404
#

echo "01. Create CSR-sub S1"
echo "====================="
payload='{
  "id": "urn:ngsi-ld:Subscription:CSR1",
  "type": "Subscription",
  "entities": [ { "type": "Vehicle" } ],
  "notification": { "endpoint": { "uri": "http://localhost:1234/csrNotify" } }
}'
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload "$payload"
echo
echo


echo "02. Retrieve CSR-sub S1"
echo "======================="
# The on-create notification attempt is asynchronous, and this assertion reads
# the statistics it writes. Waiting for the fact rather than racing it - the
# CI runner is loaded enough to lose this race even though a workstation is not.
corAwaitBody 10 /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1 '"status": "failed"'
corCurl --url /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1
echo
echo


echo "03. Create second CSR-sub S2"
echo "============================"
payload='{
  "id": "urn:ngsi-ld:Subscription:CSR2",
  "type": "Subscription",
  "entities": [ { "type": "Temperature" } ],
  "watchedAttributes": [ "temperature" ],
  "notification": { "endpoint": { "uri": "http://localhost:1234/csrNotify2" } }
}'
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload "$payload"
echo
echo


echo "04. List all CSR-subs - two"
echo "==========================="
# Both subscriptions' statistics appear in this listing, so both attempts have
# to have been made before it is read - CSR1 was waited for above, CSR2 here.
corAwaitBody 10 /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR2 '"status": "failed"'
corCurl --url /ngsi-ld/v1/csourceSubscriptions
echo
echo


echo "05. Duplicate create - 409"
echo "=========================="
payload='{
  "id": "urn:ngsi-ld:Subscription:CSR1",
  "type": "Subscription",
  "entities": [ { "type": "Vehicle" } ],
  "notification": { "endpoint": { "uri": "http://localhost:1234/x" } }
}'
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload "$payload"
echo
echo


echo "06. PATCH - change description"
echo "==============================="
corCurl -X PATCH --url /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1 --payload '{"description": "watches all Vehicle CSRs"}'
echo
echo


echo "07. Retrieve after patch"
echo "========================"
# The on-create notification attempt is asynchronous, and this assertion reads
# the statistics it writes. Waiting for the fact rather than racing it - the
# CI runner is loaded enough to lose this race even though a workstation is not.
corAwaitBody 10 /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1 '"status": "failed"'
corCurl --url /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1
echo
echo


echo "08. POST with timeInterval - 201 (periodic CSR-sub, § 5.11.7)"
echo "=============================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:CSR3",
  "type": "Subscription",
  "timeInterval": 30,
  "entities": [ { "type": "X" } ],
  "notification": { "endpoint": { "uri": "http://localhost:1234/pernot" } }
}'
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload "$payload"
echo
echo


echo "09. DELETE CSR-sub CSR1 - 204"
echo "============================="
corCurl -X DELETE --url /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1
echo
echo


echo "10. List after delete - one"
echo "==========================="
corCurl --url /ngsi-ld/v1/csourceSubscriptions
echo
echo


echo "11. DELETE non-existing - 404"
echo "============================="
corCurl -X DELETE --url /ngsi-ld/v1/csourceSubscriptions/urn:no:such
echo
echo


echo "12. Retrieve deleted - 404"
echo "=========================="
corCurl --url /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1
echo
echo


--EXPECT--
01. Create CSR-sub S1
=====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR1
Content-Length: REGEX(\d+)




02. Retrieve CSR-sub S1
=======================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:CSR1",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:1234/csrNotify"
    },
    "lastFailure": REGEX(".*"),
    "lastNotification": REGEX(".*"),
    "status": "failed",
    "timesFailed": 1,
    "timesSent": 1
  },
  "status": "failed",
  "type": "Subscription"
}



03. Create second CSR-sub S2
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceSubscriptions/urn:ngsi-ld:Subscription:CSR2
Content-Length: REGEX(\d+)




04. List all CSR-subs - two
===========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "entities": [
      {
        "type": "Vehicle"
      }
    ],
    "id": "urn:ngsi-ld:Subscription:CSR1",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1234/csrNotify"
      },
      "lastFailure": REGEX(".*"),
      "lastNotification": REGEX(".*"),
      "status": "failed",
      "timesFailed": 1,
      "timesSent": 1
    },
    "status": "active",
    "type": "Subscription"
  },
  {
    "entities": [
      {
        "type": "Temperature"
      }
    ],
    "id": "urn:ngsi-ld:Subscription:CSR2",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1234/csrNotify2"
      },
      "lastFailure": REGEX(".*"),
      "lastNotification": REGEX(".*"),
      "status": "failed",
      "timesFailed": 1,
      "timesSent": 1
    },
    "status": "active",
    "type": "Subscription",
    "watchedAttributes": [
      "temperature"
    ]
  }
]



05. Duplicate create - 409
==========================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "CSR subscription 'urn:ngsi-ld:Subscription:CSR1' already exists",
  "status": 409,
  "title": "Already Exists",
  "type": "https://uri.etsi.org/ngsi-ld/errors/AlreadyExists"
}



06. PATCH - change description
===============================
HTTP/1.1 204 No Content
Date: REGEX(.*)




07. Retrieve after patch
========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "description": "watches all Vehicle CSRs",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:CSR1",
