    "endpoint": {
      "uri": "http://localhost:1234/csrNotify"
    },
    "lastFailure": REGEX(".*"),
    "lastNotification": REGEX(".*"),
    "status": "failed",
    "timesFailed": 1,
    "timesSent": 1
  },
  "status": "failed",
  "type": "Subscription"
}



