#
# FILE            csource_reg_discovery_filtered_info.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.10.2.5 — discovery responses must be FILTERED: each returned CSR
# carries only the RegistrationInfo entries that match the request's
# filter (type / id / idPattern / attrs|pick). Non-matching entries are
# stripped from the information[] array.
#
--NAME--
CSR discovery — filtered RegistrationInfo in response (§ 5.10.2.5)

--TAGS--
csr discovery

--INIT--
corDbDrop
coraineStart -dist

--RUN--

# A single CSR with THREE RegistrationInfo entries:
#   info[0]:  Vehicle.speed
#   info[1]:  Person.name
#   info[2]:  Building.location
echo "01. Register CSR with three RegistrationInfo entries"
echo "===================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id":"urn:ngsi-ld:CSR:Multi",
  "type":"ContextSourceRegistration",
  "endpoint":"http://localhost:9999/csource",
  "information":[
    {"entities":[{"type":"Vehicle"}],"propertyNames":["speed"]},
    {"entities":[{"type":"Person"}],"propertyNames":["name"]},
    {"entities":[{"type":"Building"}],"propertyNames":["location"]}
  ]
}' | head -1
echo
echo


echo "02. Discovery type=Vehicle — only the Vehicle RegistrationInfo entry comes back"
echo "==============================================================================="
corCurl --url '/ngsi-ld/v1/csourceRegistrations?type=Vehicle'
echo
echo


echo "03. Discovery type=Vehicle,Person — both Vehicle and Person entries come back"
echo "============================================================================="
corCurl --url '/ngsi-ld/v1/csourceRegistrations?type=Vehicle,Person'
echo
echo


echo "04. Discovery pick=speed — only the speed entry matches"
echo "======================================================="
corCurl --url '/ngsi-ld/v1/csourceRegistrations?type=Vehicle&pick=speed'
echo
echo


echo "05. Discovery type=Building — Building info entry only"
echo "======================================================"
corCurl --url '/ngsi-ld/v1/csourceRegistrations?type=Building'
echo
echo


echo "06. Register CSR:Pinned (id Vehicle:V1) and CSR:Pattern (idPattern ^urn:ngsi-ld:Vehicle:P.*)"
echo "=============================================================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id":"urn:ngsi-ld:CSR:Pinned",
  "type":"ContextSourceRegistration",
  "endpoint":"http://localhost:9999/csource",
  "information":[{"entities":[{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle"}],"propertyNames":["speed"]}]
}' | head -1
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id":"urn:ngsi-ld:CSR:Pattern",
  "type":"ContextSourceRegistration",
  "endpoint":"http://localhost:9999/csource",
  "information":[{"entities":[{"idPattern":"^urn:ngsi-ld:Vehicle:P.*","type":"Vehicle"}],"propertyNames":["speed"]}]
}' | head -1
echo
echo


echo "07. Discovery id=urn:ngsi-ld:Vehicle:V1 — Pinned + Multi match, Pattern is excluded"
echo "====================================================================================="
corCurl --url '/ngsi-ld/v1/csourceRegistrations?id=urn:ngsi-ld:Vehicle:V1'
echo
echo


echo "08. Discovery id=urn:ngsi-ld:Vehicle:P7 — Pattern + Multi match, Pinned is excluded"
echo "====================================================================================="
corCurl --url '/ngsi-ld/v1/csourceRegistrations?id=urn:ngsi-ld:Vehicle:P7'
echo
echo


echo "09. Discovery id=urn:ngsi-ld:Boat:B1 — only Multi (no id constraints) can provide it"
echo "======================================================================================"
corCurl --url '/ngsi-ld/v1/csourceRegistrations?id=urn:ngsi-ld:Boat:B1'
echo
echo


--EXPECT--
01. Register CSR with three RegistrationInfo entries
====================================================
HTTP/1.1 201 Created


02. Discovery type=Vehicle — only the Vehicle RegistrationInfo entry comes back
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 323

[
  {
    "endpoint": "http://localhost:9999/csource",
    "id": "urn:ngsi-ld:CSR:Multi",
    "information": [
      {
        "attributeNames": [
          "speed"
        ],
        "entities": [
          {
            "type": "Vehicle"
          }
        ]
      }
    ],
    "type": "ContextSourceRegistration"
  }
]



