#
# FILE            query_entities_distops_split.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Split-entities mode: entity attrs distributed across multiple sources.
# Default behavior (no --noSplitEntities).
#
--NAME--
Distributed queryEntities (split-entities mode)

--TAGS--
entity query

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# Setup: V1 has speed=80 on CB, color=red on CP1 (split entity)
#         V2 is only on CP1 (speed=120)
#
# 01. Seed: V1+speed on CB, V1+color on CP1, V2+speed on CP1
# 02. Register CB→CP1 (inclusive, type=Vehicle)
# 03. GET type=Vehicle → V1 assembled (speed+color), V2 (speed only)
# 04. splitEntities=false → no merge, just V1 from CB (speed only)
#

CB="http://localhost:${CB_PORT}"
CP1="http://localhost:${CP1_PORT}"


echo "01. Seed split entity V1 across CB + CP1"
echo "========================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":80}}'
echo
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","color":{"type":"Property","value":"red"}}'
echo
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":120}}'
echo
echo


echo "02. Register CB→CP1 (inclusive, type=Vehicle)"
echo "=============================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:CP1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "03. Split mode: GET type=Vehicle → V1 assembled with speed+color"
echo "================================================================="
swCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues"
echo
echo


echo "04. splitEntities=false → no-split, V1 from CB only (speed)"
echo "============================================================"
swCurl --url "/ngsi-ld/v1/entities?type=Vehicle&splitEntities=false&options=keyValues"
echo
echo


echo "05. q-filter post-assembly: speed>100 → only V2 (V1 has speed=80)"
echo "=================================================================="
swCurl --url "/ngsi-ld/v1/entities?type=Vehicle&q=speed%3E100&options=keyValues"
echo
echo


echo "06. q-filter on remote attr: color==red → only V1 (color from CP1)"
echo "==================================================================="
swCurl --url "/ngsi-ld/v1/entities?type=Vehicle&q=color%3D%3D%22red%22&options=keyValues"
echo
echo


--EXPECT--
01. Seed split entity V1 across CB + CP1
=========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




02. Register CB→CP1 (inclusive, type=Vehicle)
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:CP1
Content-Length: 0




03. Split mode: GET type=Vehicle → V1 assembled with speed+color
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 160

[
  {
    "color": "red",
    "id": "urn:V1",
    "speed": 80,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 120,
    "type": "Vehicle"
  }
]



04. splitEntities=false → no-split, V1 from CB only (speed)
============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 140

[
  {
    "id": "urn:V1",
    "speed": 80,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 120,
    "type": "Vehicle"
  }
]



05. q-filter post-assembly: speed>100 → only V2 (V1 has speed=80)
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 72

[
  {
    "id": "urn:V2",
    "speed": 120,
    "type": "Vehicle"
  }
