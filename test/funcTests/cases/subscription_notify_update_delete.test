#
# FILE            subscription_notify_update_delete.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription notification on entity update (PATCH) and delete

--TAGS--
delete notification subscription update

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# 01. Create subscription for Vehicle entities
# 02. Create a Vehicle entity
# 03. Dump + reset ftClient (consume create notification)
# 04. PATCH entity — change speed — should trigger update notification
# 05. Dump ftClient — 1 notification (update)
# 06. Reset ftClient
# 07. DELETE entity — should trigger delete notification
# 08. Dump ftClient — 1 notification (delete)
#

echo "01. Create subscription for Vehicle entities"
echo "============================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:UD",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  },
  "notificationTrigger": ["entityCreated", "entityUpdated", "entityDeleted"]
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create a Vehicle entity"
echo "============================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": {"type": "Property", "value": 100},
  "color": {"type": "Property", "value": "red"}
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Dump + reset ftClient (consume create notification)"
echo "========================================================"
ftClientDump
ftClientReset
echo
echo


echo "04. PATCH entity — change speed"
echo "================================="
payload='{"speed": {"type": "Property", "value": 200}}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "05. Dump ftClient — 1 update notification"
echo "==========================================="
ftClientDump
echo
echo


echo "06. Reset ftClient"
echo "==================="
ftClientReset
echo "done"
echo
echo


echo "07. DELETE entity"
echo "==================="
swCurl -X DELETE --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
echo
echo


echo "08. Dump ftClient — 1 delete notification"
echo "==========================================="
ftClientDump
echo
echo


--EXPECT--
01. Create subscription for Vehicle entities
=============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:UD
Content-Length: 0




02. Create a Vehicle entity
=============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0




03. Dump + reset ftClient (consume create notification)
========================================================
[
  {
    "body": {
      "data": [
        {
          "color": {
            "type": "Property",
            "value": "red"
          },
          "id": "urn:ngsi-ld:Vehicle:V1",
          "speed": {
            "type": "Property",
            "value": 100
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:UD",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(swBroker/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. PATCH entity — change speed
=================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. Dump ftClient — 1 update notification
===========================================
[
  {
    "body": {
      "data": [
        {
          "color": {
            "type": "Property",
            "value": "red"
          },
          "id": "urn:ngsi-ld:Vehicle:V1",
          "speed": {
            "type": "Property",
            "value": 200
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:UD",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(swBroker/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


06. Reset ftClient
===================
done


07. DELETE entity
===================
HTTP/1.1 204 No Content
Date: REGEX(.*)




08. Dump ftClient — 1 delete notification
===========================================
[
  {
    "body": {
      "data": [
        {
          "deletedAt": "REGEX(.*)",
          "id": "urn:ngsi-ld:Vehicle:V1",
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:UD",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(swBroker/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
