#
# FILE            distsub_delete_cascade.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.8.1.4 — DELETE cascade for distributed subscriptions.
#
# When a local subscription that has subordinate (derived) subs on
# remote Context Sources is deleted, the broker must walk the
# subordinate list and propagate the DELETE to every CSR. Failures
# don't block the local delete (best-effort).
#
--NAME--
DistSub - DELETE cascade to remote derivatives

--TAGS--
delete distops subscription distsub

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# 01. Register CSR on CB → CP1 (Vehicle, with createSubscription + deleteSubscription)
# 02. Create local sub urn:S1 → CB fans out urn:S1:1 to CP1
# 03. GET /subscriptions on CP1 — derived urn:S1:1 visible
# 04. DELETE urn:S1 on CB — local cache + DB removal AND cascade DELETE to CP1
# 05. GET /subscriptions on CP1 — empty (urn:S1:1 deleted)
# 06. GET /subscriptions on CB — empty
#

echo "01. Register CSR urn:CSR:Vehicle (with sub ops) → CP1"
echo "====================================================="
payload='{
  "id": "urn:CSR:Vehicle",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["createEntity", "createSubscription", "retrieveSubscription", "deleteSubscription"],
  "information": [
    { "entities": [ { "type": "Vehicle" } ] }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. Create local sub urn:S1 (Vehicle) on CB → derived sub forwarded"
echo "==================================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:S1","type":"Subscription","entities":[{"type":"Vehicle"}],"notification":{"endpoint":{"uri":"http://example.com/notify/s1"}}}'
echo
echo


echo "03. GET /subscriptions on CP1 — derived urn:S1:1 present"
echo "========================================================"
swCurl --port $CP1_PORT --url /ngsi-ld/v1/subscriptions
echo
echo


echo "04. DELETE urn:S1 on CB → cascade DELETE to CP1"
echo "==============================================="
swCurl -X DELETE --url /ngsi-ld/v1/subscriptions/urn:S1
echo
echo


echo "05. GET /subscriptions on CP1 — derived sub gone"
echo "================================================"
swCurl --port $CP1_PORT --url /ngsi-ld/v1/subscriptions
echo
echo


echo "06. GET /subscriptions on CB — local sub gone"
echo "============================================="
swCurl --url /ngsi-ld/v1/subscriptions
echo
echo


--EXPECT--
01. Register CSR urn:CSR:Vehicle (with sub ops) → CP1
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Vehicle
Link: REGEX(.*)
Content-Length: 0




02. Create local sub urn:S1 (Vehicle) on CB → derived sub forwarded
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:S1
Link: REGEX(.*)
Content-Length: 0




03. GET /subscriptions on CP1 — derived urn:S1:1 present
========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "entities": [
      {
        "type": "Vehicle"
      }
    ],
    "id": "urn:S1:1",
    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:REGEX(\d+)/ngsi-ld/ex/v1/notifications/urn:S1"
      }
    },
    "status": "active",
    "type": "Subscription"
  }
]



04. DELETE urn:S1 on CB → cascade DELETE to CP1
===============================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8




05. GET /subscriptions on CP1 — derived sub gone
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



06. GET /subscriptions on CB — local sub gone
=============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
