#
# FILE            query_entities_by_type.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?type= filters by entity type

--TAGS--
entity query

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create Vehicle V1 with speed and color
# 02. Create Building B1 with height
# 03. GET entities?type=Vehicle - only V1 returned
#

echo "01. Create Vehicle V1 with speed and color"
echo "============================================"
payload='{
  "id": "urn:v1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create Building B1 with height"
echo "===================================="
payload='{
  "id": "urn:b1",
  "type": "Building",
  "height": {
    "type": "Property",
    "value": 50
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. GET entities?type=Vehicle - only V1 returned"
echo "=================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


--EXPECT--
01. Create Vehicle V1 with speed and color
============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:v1
Content-Length: REGEX(\d+)




02. Create Building B1 with height
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:b1
Content-Length: REGEX(\d+)




03. GET entities?type=Vehicle - only V1 returned
==================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:v1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
coraineStop
corDbDrop
