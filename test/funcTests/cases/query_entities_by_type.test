#
# FILE            query_entities_by_type.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?type= filters by entity type

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle V1 with speed and color
# 02. Create Building B1 with height
# 03. GET entities?type=Vehicle - only V1 returned
#

echo "01. Create Vehicle V1 with speed and color"
echo "============================================"
payload='{
  "id": "urn:v1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create Building B1 with height"
echo "===================================="
payload='{
  "id": "urn:b1",
  "type": "Building",
  "height": {
    "type": "Property",
    "value": 50
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. GET entities?type=Vehicle - only V1 returned"
echo "=================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


--EXPECT--
01. Create Vehicle V1 with speed and color
============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:v1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create Building B1 with height
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:b1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. GET entities?type=Vehicle - only V1 returned
==================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:v1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
