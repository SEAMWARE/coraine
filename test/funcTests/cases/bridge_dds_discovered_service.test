#
# FILE            bridge_dds_discovered_service.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A REAL ROS 2 service server that the configuration does NOT name: the Enabler
# discovers it, the plugin reports it (ABI 8, endpointDiscoveredIn), and the
# broker carries it on the catch-all urn:ngsi-ld:dds:default - as Orion-LD
# does. And it is CALLABLE there, which Orion-LD's is not: writing the
# attribute asks the server, and its reply comes back into the attribute.
#
# The server is add_two_ints_server, as in bridge_dds_service_roundtrip - but
# the bridge configuration has no "services" at all. The node's parameter
# services are discovered and carried too; only 'add_two_ints' is looked at.
#
#   01  the catch-all has 'add_two_ints', "uninitialized"
#   02  PATCH it, waiting for the reply (?ddsSync=true): 204, and the attribute
#       holds the request and the server's answer, 3 + 4 = 7
#
# REQUIRE_DDS: yes
#
--NAME--
Bridges (DDS): a discovered, unconfigured ROS 2 service is carried on urn:ngsi-ld:dds:default, and callable there

--TAGS--
bridge dds service discovery

--INIT--
corDbDrop
ros2NodeStop add_two_ints_server
BRIDGE_CONFIG=$(bridgeConfig -b dds \
  --raw "\"ddsmodule\": { \"dds\": { \"domain\": $COR_DDS_DOMAIN }, \"specs\": { \"logging\": { \"verbosity\": \"warning\" } } }")
coraineStart --bridges dds --bridgeConfig $BRIDGE_CONFIG

--RUN--

echo "01. The add_two_ints server comes up - discovered, and carried on the catch-all"
echo "==============================================================================="
ros2ServiceStart add_two_ints_server add_two_ints
for i in $(seq 1 300); do
  corCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:dds:default?pick=add_two_ints' 2>/dev/null | grep -q '"add_two_ints"' && break
  sleep 0.1
done
corCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:dds:default?pick=add_two_ints'
echo
echo


echo "02. Call it: PATCH, waiting for the reply - 204, and 3 + 4 = 7 is in the attribute"
echo "=================================================================================="
corCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:dds:default/attrs/add_two_ints?ddsSync=true' -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 3, "b": 4 } }'
corCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:dds:default?pick=add_two_ints'
echo
echo


--EXPECT--
01. The add_two_ints server comes up - discovered, and carried on the catch-all
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "add_two_ints": {
    "type": "Property",
    "value": "uninitialized"
  }
}



02. Call it: PATCH, waiting for the reply - 204, and 3 + 4 = 7 is in the attribute
==================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "add_two_ints": {
    "reply": {
      "ddsDataType": {
        "type": "Property",
        "value": "example_interfaces::srv::dds_::AddTwoInts_Response_"
      },
      "instanceHandleId": {
        "type": "Property",
        "value": "REGEX(.*)"
      },
      "observedAt": "REGEX(.*)",
      "participantId": {
        "type": "Property",
        "value": "REGEX(.*)"
      },
      "publishedAt": {
        "type": "Property",
        "value": REGEX(\d+)
      },
      "requestId": {
        "type": "Property",
        "value": 1
      },
      "type": "Property",
      "value": {
        "sum": 7
      }
    },
    "request": {
      "ddsDataType": {
        "type": "Property",
        "value": "example_interfaces::srv::dds_::AddTwoInts_Request_"
      },
      "observedAt": "REGEX(.*)",
      "publishedAt": {
        "type": "Property",
        "value": REGEX(\d+)
      },
      "requestId": {
        "type": "Property",
        "value": 1
      },
      "type": "Property",
      "value": {
        "a": 3,
        "b": 4
      }
    },
    "type": "Property",
    "value": {
      "a": 3,
      "b": 4
    }
  }
}



--TEARDOWN--
ros2NodeStop add_two_ints_server
coraineStop
corDbDrop
