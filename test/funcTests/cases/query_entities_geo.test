--NAME--
Geo-query filtering (georel, geometry, coordinates, geoproperty)

--TAGS--
entity geo query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity E1 in Madrid (location: Point [-3.703, 40.417])
# 02. Create entity E2 in Barcelona (location: Point [2.154, 41.390])
# 03. Create entity E3 in Paris (location: Point [2.349, 48.864])
# 04. GET entities near Madrid within 600 km - should get E1 and E2
# 05. GET entities near Madrid within 50 km - should get only E1
# 06. GET entities within a polygon covering Iberian Peninsula - should get E1 and E2
# 07. GET entities intersecting a polygon covering France - should get E3
# 08. GET entities disjoint from a polygon covering Iberian Peninsula - should get E3
# 09. Verify GeoJSON is returned correctly (un-expansion check)
# 10. Create entity E4 with custom geoproperty "operationArea" (Polygon)
# 11. GET entities with geoproperty=operationArea, georel=intersects
# 12. GET entities near Madrid, minDistance=400000, maxDistance=600000 - E2 only (ring between 400-600km)
# 13. GET entities with georel=overlaps with polygon overlapping Iberia+France - should get E1, E2, E3
# 14. GET entities with georel=contains, operationArea contains Point [0,40] - should get E4
# 15. Create entity E5 with custom geoproperty "observationPoint" (Point)
# 16. GET entities with geoproperty=observationPoint, georel=near - should get E5 (tests dynamic index)
# 17. GET entities near Madrid, minDistance=100000 - should get E2 (not E1)
# 18. GET entities near Madrid, minDistance=100000, maxDistance=600000 - ring: E2 only
# 19. GET entities near Madrid, minDistance=600000 - should get E3 (Paris)
# 20. Create entity E6 with LineString route (Madrid to Barcelona)
# 21. Polygon-vs-Polygon: operationArea within larger polygon - should get E4
# 22. Polygon-vs-Polygon: operationArea intersects partially overlapping polygon - should get E4
# 23. LineString-vs-Polygon: route disjoint from faraway polygon - should get E6
# 24. LineString intersects polygon covering Spain - should get E6
#

echo "01. Create entity E1 in Madrid"
echo "=============================="
payload='{
  "id": "urn:e1",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.703, 40.417]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create entity E2 in Barcelona"
echo "================================="
payload='{
  "id": "urn:e2",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.154, 41.390]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E3 in Paris"
echo "============================="
payload='{
  "id": "urn:e3",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.349, 48.864]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. GET entities near Madrid within 600 km - should get E1 and E2"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D600000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "05. GET entities near Madrid within 50 km - should get only E1"
echo "=============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "06. GET entities within Iberian Peninsula polygon - should get E1 and E2"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=within&geometry=Polygon&coordinates=\[\[\[-10,35\],\[5,35\],\[5,44\],\[-10,44\],\[-10,35\]\]\]'
echo
echo


echo "07. GET entities intersecting France polygon - should get E3"
echo "============================================================"
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=intersects&geometry=Polygon&coordinates=\[\[\[-5,42\],\[9,42\],\[9,52\],\[-5,52\],\[-5,42\]\]\]'
echo
echo


echo "08. GET entities disjoint from Iberian Peninsula polygon - should get E3"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=disjoint&geometry=Polygon&coordinates=\[\[\[-10,35\],\[5,35\],\[5,44\],\[-10,44\],\[-10,35\]\]\]'
echo
echo


echo "09. Retrieve entity E1 - verify GeoJSON returned correctly"
echo "=========================================================="
swCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


echo "10. Create entity E4 with custom geoproperty operationArea (Polygon)"
echo "===================================================================="
payload='{
  "id": "urn:e4",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [0, 0]
    }
  },
  "operationArea": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [
        [[-5, 35], [5, 35], [5, 44], [-5, 44], [-5, 35]]
      ]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "11. GET entities with geoproperty=operationArea, georel=intersects with Madrid"
echo "=============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=intersects&geometry=Point&coordinates=\[0,40\]&geoproperty=operationArea'
echo
echo


echo "12. GET entities near Madrid, minDistance=400000, maxDistance=600000 - E2 only (tight ring)"
echo "========================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BminDistance%3D%3D400000%3BmaxDistance%3D%3D600000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "13. GET entities with georel=overlaps, polygon spanning Iberia+France - should get E1, E2, E3"
echo "============================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=overlaps&geometry=Polygon&coordinates=\[\[\[-10,35\],\[10,35\],\[10,52\],\[-10,52\],\[-10,35\]\]\]'
echo
echo


echo "14. GET entities with georel=contains, operationArea contains Point [0,40] - should get E4"
echo "=========================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=contains&geometry=Point&coordinates=\[0,40\]&geoproperty=operationArea'
echo
echo


echo "15. Create entity E5 with custom geoproperty observationPoint"
echo "============================================================="
payload='{
  "id": "urn:e5",
  "type": "Sensor",
  "observationPoint": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [10.0, 50.0]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "16. GET entities with geoproperty=observationPoint, georel=near - should get E5"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Sensor&georel=near%3BmaxDistance%3D%3D100000&geometry=Point&coordinates=\[10.0,50.0\]&geoproperty=observationPoint'
echo
echo


echo "17. GET entities near Madrid, minDistance=100000 - should get E2 (not E1, too close)"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BminDistance%3D%3D100000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "18. GET entities near Madrid, minDistance=100000, maxDistance=600000 - ring: E2 only"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BminDistance%3D%3D100000%3BmaxDistance%3D%3D600000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "19. GET entities near Madrid, minDistance=600000 - should get E3 (Paris)"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BminDistance%3D%3D600000&geometry=Point&coordinates=\[-3.703,40.417\]'
echo
echo


echo "20. Create entity E6 with LineString route (Madrid to Barcelona)"
echo "================================================================"
payload='{
  "id": "urn:e6",
  "type": "Route",
  "path": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.703, 40.417], [2.154, 41.390]]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "21. Polygon-vs-Polygon: operationArea within larger polygon - should get E4"
echo "==========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=within&geometry=Polygon&coordinates=\[\[\[-10,30\],\[10,30\],\[10,50\],\[-10,50\],\[-10,30\]\]\]&geoproperty=operationArea'
echo
echo


echo "22. Polygon-vs-Polygon: operationArea intersects partially overlapping polygon"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=intersects&geometry=Polygon&coordinates=\[\[\[0,38\],\[10,38\],\[10,48\],\[0,48\],\[0,38\]\]\]&geoproperty=operationArea'
echo
echo


echo "23. LineString-vs-Polygon: route disjoint from faraway polygon - should get E6"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Route&georel=disjoint&geometry=Polygon&coordinates=\[\[\[50,50\],\[60,50\],\[60,60\],\[50,60\],\[50,50\]\]\]&geoproperty=path'
echo
echo


echo "24. LineString intersects polygon covering Spain - should get E6"
echo "================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=Route&georel=intersects&geometry=Polygon&coordinates=\[\[\[-10,35\],\[5,35\],\[5,45\],\[-10,45\],\[-10,35\]\]\]&geoproperty=path'
echo
echo


--EXPECT--
