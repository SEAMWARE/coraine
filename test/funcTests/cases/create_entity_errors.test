  "title": "Unexpected @context",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



64. application/ld+json with Link header and @context in body
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 209

{
  "detail": "both @context in body and Link header not allowed with application/ld+json",
  "status": 400,
  "title": "Conflicting @context",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



