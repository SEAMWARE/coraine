#
# FILE            create_entity_errors.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
POST /ngsi-ld/v1/entities - key error cases

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Payload not a JSON object (JSON array)
# 02. Empty payload (no body)
# 03. Empty JSON object {}
#
# 04. id not a string (integer)
# 05. id is empty string
# 06. id is not a valid URI (no colon)
# 07. id has empty scheme-specific part
# 08. id URI contains spaces
#
# 09. Duplicate id field
# 10. Both id and @id present
#
# 11. Missing type (id present)
# 12. type not a string (integer)
# 13. Duplicate type field
# 14. Both type and @type present
#
# 15. scope not a string or array (integer)
#
# 16. Create entity urn:dup - 201 Created (setup for step 17)
# 17. Create entity urn:dup again - 409 Already Exists
#
# 18. Property missing value
# 19. Property with both value and object (conflicting value keys)
#
# 20. Relationship object not a string (integer)
# 21. Relationship object empty string
# 22. Relationship object not a valid URI
#
# 23. observedAt not a string (integer)
# 24. observedAt empty string
# 25. observedAt not valid ISO 8601
#
# 26. unitCode not a string (integer)
#
# 27. datasetId not a string (integer)
# 28. datasetId empty string
# 29. datasetId not a valid URI
#
# 30. Property with object inside (conflicting value keys)
# 31. Relationship with value inside (conflicting value keys)
#
# 32. Multi-attr empty array
# 33. Multi-attr element not an object (integer)
# 34. Multi-attr two defaults (no datasetId)
# 35. Multi-attr duplicate datasetId
#
# 36. GeoProperty value not an object (string)
# 37. GeoProperty missing type in GeoJSON
# 38. GeoProperty type not a string in GeoJSON (integer)
# 39. GeoProperty missing coordinates
# 40. GeoProperty unknown geometry type
#
# 41. Point with 1 coordinate
# 42. Point with 4 coordinates
# 43. Point longitude not a number (string)
# 44. Point latitude not a number (string)
# 45. Point longitude > 180
# 46. Point longitude < -180
# 47. Point latitude > 90
# 48. Point latitude < -90
#
# 49. LineString with only 1 position
# 50. LineString position not an array
#
# 51. Polygon ring with 3 positions (need >= 4)
# 52. Polygon ring not closed (first != last)
# 53. Polygon coords not array of arrays
#
# 54. languageMap not an object (string)
# 55. languageMap value not string/array (integer)
#
# 56. vocab not a string or array (integer)
#
# 57. valueList not an array (string)
# 58. objectList not an array (string)
# 59. objectList item not a string (integer)
# 60. objectList item not a valid URI
#
# 61. Unsupported Content-Type (text/plain)
# 62. application/ld+json without @context
# 63. application/json with @context in body
# 64. application/ld+json with Link header and @context in body
# 65. application/ld+json with @context - 201 Created (happy path)
#
# 66. type is empty array
# 67. type array element not a string (integer)
# 68. type array element is empty string
#

echo "01. Payload not a JSON object (JSON array)"
echo "=========================================="
swCurl -X POST --url /ngsi-ld/v1/entities --payload '[1, 2, 3]'
echo
echo


echo "02. Empty payload (no body)"
echo "==========================="
swCurl -X POST --url /ngsi-ld/v1/entities
echo
echo


echo "03. Empty JSON object {}"
echo "========================"
swCurl -X POST --url /ngsi-ld/v1/entities --payload '{}'
echo
echo


echo "04. id not a string (integer)"
echo "============================="
payload='{
  "id": 14,
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. id is empty string"
echo "======================"
payload='{
  "id": "",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "06. id is not a valid URI (no colon)"
echo "===================================="
payload='{
  "id": "not-a-uri",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "07. id has empty scheme-specific part"
echo "====================================="
payload='{
  "id": "urn:",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "08. id URI contains spaces"
echo "=========================="
payload='{
  "id": "urn:has space",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "09. Duplicate id field"
echo "======================"
payload='{
  "id": "urn:e1",
  "id": "urn:e2",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "10. Both id and @id present"
echo "==========================="
payload='{
  "id": "urn:e1",
  "@id": "urn:e2",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "11. Missing type (id present)"
echo "============================="
swCurl -X POST --url /ngsi-ld/v1/entities --payload '{"id":"urn:e1"}'
echo
echo


echo "12. type not a string (integer)"
echo "==============================="
payload='{
  "id": "urn:e1",
  "type": 42
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "13. Duplicate type field"
echo "========================"
payload='{
  "id": "urn:e1",
  "type": "T",
  "type": "T2"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "14. Both type and @type present"
echo "==============================="
payload='{
  "id": "urn:e1",
  "type": "T",
  "@type": "T2"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "15. scope not a string or array (integer)"
echo "========================================="
payload='{
  "id": "urn:e1",
  "type": "T",
  "scope": 42
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "16. Create entity urn:dup - 201 Created (setup for step 17)"
echo "==========================================================="
payload='{
  "id": "urn:dup",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "17. Create entity urn:dup again - 409 Already Exists"
echo "===================================================="
payload='{
  "id": "urn:dup",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 200
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "18. Property missing value"
echo "=========================="
payload='{
  "id": "urn:e18",
  "type": "T",
  "speed": {
    "type": "Property"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "19. Property with both value and object (conflicting value keys)"
echo "================================================================"
payload='{
  "id": "urn:e19",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "object": "urn:bad"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "20. Relationship object not a string (integer)"
echo "=============================================="
payload='{
  "id": "urn:e20",
  "type": "T",
  "rel": {
    "type": "Relationship",
    "object": 14
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "21. Relationship object empty string"
echo "===================================="
payload='{
  "id": "urn:e21",
  "type": "T",
  "rel": {
    "type": "Relationship",
    "object": ""
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "22. Relationship object not a valid URI"
echo "======================================="
payload='{
  "id": "urn:e22",
  "type": "T",
  "rel": {
    "type": "Relationship",
    "object": "not-a-uri"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "23. observedAt not a string (integer)"
echo "====================================="
payload='{
  "id": "urn:e23",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "observedAt": 42
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "24. observedAt empty string"
echo "==========================="
payload='{
  "id": "urn:e24",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "observedAt": ""
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "25. observedAt not valid ISO 8601"
echo "================================="
payload='{
  "id": "urn:e25",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "observedAt": "not-a-date"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "26. unitCode not a string (integer)"
echo "==================================="
payload='{
  "id": "urn:e26",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "unitCode": 42
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "27. datasetId not a string (integer)"
echo "===================================="
payload='{
  "id": "urn:e27",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "datasetId": 42
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "28. datasetId empty string"
echo "=========================="
payload='{
  "id": "urn:e28",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "datasetId": ""
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "29. datasetId not a valid URI"
echo "============================="
payload='{
  "id": "urn:e29",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "datasetId": "not-a-uri"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "30. Property with object inside (conflicting value keys)"
echo "========================================================"
payload='{
  "id": "urn:e30",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100,
    "object": "urn:x"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "31. Relationship with value inside (conflicting value keys)"
echo "==========================================================="
payload='{
  "id": "urn:e31",
  "type": "T",
  "rel": {
    "type": "Relationship",
    "object": "urn:target",
    "value": 42
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "32. Multi-attr empty array"
echo "=========================="
payload='{
  "id": "urn:e32",
  "type": "T",
  "speed": []
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "33. Multi-attr element not an object (integer)"
echo "=============================================="
payload='{
  "id": "urn:e33",
  "type": "T",
  "speed": [42, 43]
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "34. Multi-attr two defaults (no datasetId)"
echo "=========================================="
payload='{
  "id": "urn:e34",
  "type": "T",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "type": "Property",
      "value": 200
    }
  ]
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "35. Multi-attr duplicate datasetId"
echo "=================================="
payload='{
  "id": "urn:e35",
  "type": "T",
  "speed": [
    {
      "type": "Property",
      "value": 100,
      "datasetId": "urn:ds1"
    },
    {
      "type": "Property",
      "value": 200,
      "datasetId": "urn:ds1"
    }
  ]
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "36. GeoProperty value not an object (string)"
echo "============================================"
payload='{
  "id": "urn:e36",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": "not an object"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "37. GeoProperty missing type in GeoJSON"
echo "======================================="
payload='{
  "id": "urn:e37",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "coordinates": [1.0, 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "38. GeoProperty type not a string in GeoJSON (integer)"
echo "======================================================"
payload='{
  "id": "urn:e38",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": 42,
      "coordinates": [1.0, 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "39. GeoProperty missing coordinates"
echo "==================================="
payload='{
  "id": "urn:e39",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point"
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "40. GeoProperty unknown geometry type"
echo "====================================="
payload='{
  "id": "urn:e40",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Hexagon",
      "coordinates": [1.0, 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "41. Point with 1 coordinate"
echo "==========================="
payload='{
  "id": "urn:e41",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [1.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "42. Point with 4 coordinates"
echo "============================"
payload='{
  "id": "urn:e42",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [1.0, 2.0, 3.0, 4.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "43. Point longitude not a number (string)"
echo "========================================="
payload='{
  "id": "urn:e43",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": ["abc", 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "44. Point latitude not a number (string)"
echo "========================================"
payload='{
  "id": "urn:e44",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [1.0, "abc"]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "45. Point longitude > 180"
echo "========================="
payload='{
  "id": "urn:e45",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [181.0, 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "46. Point longitude < -180"
echo "=========================="
payload='{
  "id": "urn:e46",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-181.0, 2.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "47. Point latitude > 90"
echo "======================="
payload='{
  "id": "urn:e47",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [1.0, 91.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "48. Point latitude < -90"
echo "========================"
payload='{
  "id": "urn:e48",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [1.0, -91.0]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "49. LineString with only 1 position"
echo "==================================="
payload='{
  "id": "urn:e49",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[1.0, 2.0]]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "50. LineString position not an array"
echo "===================================="
payload='{
  "id": "urn:e50",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": ["not-array", [3.0, 4.0]]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "51. Polygon ring with 3 positions (need >= 4)"
echo "============================================="
payload='{
  "id": "urn:e51",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[0, 0], [1, 0], [0, 0]]]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "52. Polygon ring not closed (first != last)"
echo "==========================================="
payload='{
  "id": "urn:e52",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[0, 0], [1, 0], [1, 1], [0, 1]]]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "53. Polygon coords not array of arrays"
echo "======================================"
payload='{
  "id": "urn:e53",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": ["not-an-array"]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "54. languageMap not an object (string)"
echo "======================================"
payload='{
  "id": "urn:e54",
  "type": "T",
  "name": {
    "type": "LanguageProperty",
    "languageMap": "not an object"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "55. languageMap value not string/array (integer)"
echo "================================================"
payload='{
  "id": "urn:e55",
  "type": "T",
  "name": {
    "type": "LanguageProperty",
    "languageMap": {
      "en": 42
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "56. vocab not a string or array (integer)"
echo "========================================="
payload='{
  "id": "urn:e56",
  "type": "T",
  "category": {
    "type": "VocabProperty",
    "vocab": 42
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "57. valueList not an array (string)"
echo "==================================="
payload='{
  "id": "urn:e57",
  "type": "T",
  "tags": {
    "type": "ListProperty",
    "valueList": "not-an-array"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "58. objectList not an array (string)"
echo "===================================="
payload='{
  "id": "urn:e58",
  "type": "T",
  "links": {
    "type": "ListRelationship",
    "objectList": "not-an-array"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "59. objectList item not a string (integer)"
echo "=========================================="
payload='{
  "id": "urn:e59",
  "type": "T",
  "links": {
    "type": "ListRelationship",
    "objectList": [42, 43]
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "60. objectList item not a valid URI"
echo "==================================="
payload='{
  "id": "urn:e60",
  "type": "T",
  "links": {
    "type": "ListRelationship",
    "objectList": ["not-a-uri"]
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "61. Unsupported Content-Type (text/plain)"
echo "========================================="
payload='{
  "id": "urn:e61",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities -H 'Content-Type: text/plain' --payload "$payload"
echo
echo


echo "62. application/ld+json without @context"
echo "========================================"
payload='{
  "id": "urn:e62",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities -H 'Content-Type: application/ld+json' --payload "$payload"
echo
echo


echo "63. application/json with @context in body"
echo "=========================================="
payload='{
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "id": "urn:e63",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "64. application/ld+json with Link header and @context in body"
echo "============================================================="
payload='{
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "id": "urn:e64",
  "type": "T"
}'
swCurl -X POST --url /ngsi-ld/v1/entities -H 'Content-Type: application/ld+json' -H 'Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' --payload "$payload"
echo
echo


echo "65. application/ld+json with @context - 201 Created (happy path)"
echo "================================================================"
payload='{
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "id": "urn:e65",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities -H 'Content-Type: application/ld+json' --payload "$payload"
echo
echo


echo "66. type is empty array"
echo "======================="
payload='{
  "id": "urn:e66",
  "type": []
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "67. type array element not a string (integer)"
echo "============================================="
payload='{
  "id": "urn:e67",
  "type": [14]
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "68. type array element is empty string"
echo "======================================"
payload='{
  "id": "urn:e68",
  "type": [""]
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


