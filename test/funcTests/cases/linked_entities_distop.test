#
# FILE            linked_entities_distop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.5.23 / § 7.7.1 — a Relationship whose target lives on a remote
# Context Source is only FOLLOWED during a join when it carries an
# objectType: that type scopes the registration lookup (no blind fan-out),
# and a non-local target without objectType is left as a bare object URI
# (the spec's "known limitation"). This test toggles objectType on
# urn:V1's owner with a merge-PATCH and shows the join following / not
# following the link accordingly.
#
# q sub-queries (q=rel{...}, § 4.9) are NOT subject to that gate — the
# predicate can only be evaluated by following the link, so q follows by
# id regardless of objectType (steps 13/14 still match with objectType
# removed).
#
# REQUIRE_DB: mongoc
#
--NAME--
Linked entities — cross-CSR join gated by objectType (toggled via PATCH) + q={}

--TAGS--
retrieve query distops linked-entities

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# Seed:
#   CP1: urn:Alice (Person, age 35), urn:Bob (Person, age 22)
#   CB:  CSR → CP1 for type Person
#        urn:V1 → owner=urn:Alice   (no objectType initially)
#        urn:V2 → owner=urn:Bob
#

echo "01. Seed urn:Alice on CP1"
echo "========================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:Alice","type":"Person","age":{"type":"Property","value":35}}'
echo
echo


echo "02. Seed urn:Bob on CP1"
echo "======================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:Bob","type":"Person","age":{"type":"Property","value":22}}'
echo
echo


echo "03. Register CSR on CB → CP1 for Person (retrieveEntity, queryEntity)"
echo "====================================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:Persons",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["retrieveEntity", "queryEntity"],
  "information": [ { "entities": [ { "type": "Person" } ] } ]
}'
echo
echo


echo "04. Seed urn:V1 (owner=Alice, NO objectType) on CB"
echo "=================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42},"owner":{"type":"Relationship","object":"urn:Alice"}}'
echo
echo


echo "05. Seed urn:V2 (owner=Bob) on CB"
echo "================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":17},"owner":{"type":"Relationship","object":"urn:Bob"}}'
echo
echo


echo "06. GET V1?join=flat — owner has NO objectType → Alice NOT followed (gate)"
echo "=========================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=flat&joinLevel=1&local=true'
echo
echo


echo "07. GET V1?join=inline — no objectType → owner has no entity sub-attr"
echo "====================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=inline&joinLevel=1&local=true'
echo
echo


echo "08. PATCH V1 — merge objectType=Person onto owner"
echo "================================================="
payload='{ "owner": { "objectType": "Person" } }'
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X PATCH --payload "$payload"
echo
echo


echo "09. GET V1?join=flat — objectType present → V1 + Alice fetched from CP1"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=flat&joinLevel=1&local=true'
echo
echo


echo "10. GET V1?join=inline — owner.entity carries Alice fetched from CP1"
echo "===================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=inline&joinLevel=1&local=true'
echo
echo


echo "11. PATCH V1 — delete objectType from owner (urn:ngsi-ld:null sentinel)"
echo "======================================================================="
payload='{ "owner": { "objectType": "urn:ngsi-ld:null" } }'
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X PATCH --payload "$payload"
echo
echo


echo "12. GET V1?join=inline — objectType gone → Alice NOT followed again"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=inline&joinLevel=1&local=true'
echo
echo


echo "13. Query Vehicles q=owner{age>30} — V1 (q-linked follows by id, ungated)"
echo "=========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&local=true&q=owner%7Bage%3E30%7D'
echo
echo


echo "14. Query Vehicles q=owner{age<30} — V2 (q-linked follows by id, ungated)"
echo "=========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&local=true&q=owner%7Bage%3C30%7D'
echo
echo


--EXPECT--
01. Seed urn:Alice on CP1
=========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:Alice
Content-Length: 0




02. Seed urn:Bob on CP1
=======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:Bob
Content-Length: 0




03. Register CSR on CB → CP1 for Person (retrieveEntity, queryEntity)
=====================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Persons
Content-Length: 0




04. Seed urn:V1 (owner=Alice, NO objectType) on CB
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




05. Seed urn:V2 (owner=Bob) on CB
=================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




