#
# FILE            linked_entities_distop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.5.23 / § 4.9 — when a Relationship's target lives on a remote
# Context Source, follow the registration and fetch via dist-op so
# linked-entity expansion (join=flat / inline) and q sub-queries
# (q=rel{...}) work across brokers.
#
# REQUIRE_DB: mongoc
#
--NAME--
Linked entities — cross-CSR retrieval (join + q={})

--TAGS--
retrieve query distops linked-entities

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# Seed:
#   CP1: urn:Alice (Person, age 35), urn:Bob (Person, age 22)
#   CB:  CSR pointing CP1 for type Person
#        urn:V1 → owner=urn:Alice
#        urn:V2 → owner=urn:Bob
#

CP1="http://localhost:'$CP1_PORT'"


echo "01. Seed urn:Alice on CP1"
echo "========================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:Alice","type":"Person","age":{"type":"Property","value":35}}'
echo
echo


echo "02. Seed urn:Bob on CP1"
echo "======================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:Bob","type":"Person","age":{"type":"Property","value":22}}'
echo
echo


echo "03. Register CSR on CB → CP1 for Person (with retrieveEntity, queryEntities)"
echo "============================================================================"
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:Persons",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["retrieveEntity", "queryEntity"],
  "information": [ { "entities": [ { "type": "Person" } ] } ]
}'
echo
echo


echo "04. Seed urn:V1 (owner=Alice) on CB"
echo "==================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42},"owner":{"type":"Relationship","object":"urn:Alice"}}'
echo
echo


echo "05. Seed urn:V2 (owner=Bob) on CB"
echo "================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":17},"owner":{"type":"Relationship","object":"urn:Bob"}}'
echo
echo


echo "06. GET V1?join=flat — V1 + Alice fetched from CP1"
echo "=================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=flat&joinLevel=1&local=true'
echo
echo


echo "07. GET V1?join=inline — owner.entity carries Alice fetched from CP1"
echo "===================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?join=inline&joinLevel=1&local=true'
echo
echo


echo "08. Query Vehicles q=owner{age>30} — only V1 (Alice on CP1, age 35)"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&local=true&q=owner%7Bage%3E30%7D'
echo
echo


echo "09. Query Vehicles q=owner{age<30} — only V2 (Bob on CP1, age 22)"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&local=true&q=owner%7Bage%3C30%7D'
echo
echo


--EXPECT--
01. Seed urn:Alice on CP1
=========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:Alice
Content-Length: 0




02. Seed urn:Bob on CP1
=======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:Bob
Content-Length: 0




03. Register CSR on CB → CP1 for Person (with retrieveEntity, queryEntities)
============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Persons
Content-Length: 0




04. Seed urn:V1 (owner=Alice) on CB
===================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




05. Seed urn:V2 (owner=Bob) on CB
=================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




06. GET V1?join=flat — V1 + Alice fetched from CP1
==================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 317

[
  {
    "id": "urn:V1",
    "owner": {
      "object": "urn:Alice",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "age": {
      "type": "Property",
      "value": 35
    },
    "id": "urn:Alice",
    "type": "Person"
  }
]



07. GET V1?join=inline — owner.entity carries Alice fetched from CP1
====================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 315

{
  "id": "urn:V1",
  "owner": {
    "entity": {
      "age": {
        "type": "Property",
        "value": 35
      },
      "id": "urn:Alice",
      "type": "Person"
    },
    "object": "urn:Alice",
    "type": "Relationship"
  },
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



08. Query Vehicles q=owner{age>30} — only V1 (Alice on CP1, age 35)
===================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 200

[
  {
    "id": "urn:V1",
    "owner": {
      "object": "urn:Alice",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  }
]



09. Query Vehicles q=owner{age<30} — only V2 (Bob on CP1, age 22)
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 198

[
  {
    "id": "urn:V2",
    "owner": {
      "object": "urn:Bob",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 17
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
