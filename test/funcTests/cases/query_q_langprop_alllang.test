#
# FILE            query_q_langprop_alllang.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TS 104-175 § 7.2.3.4 item 5 — a q term over a LanguageProperty with NO natural
# language specified uses the "[*]" selector and matches if the value is found in
# ANY key of the languageMap, including as a single element of an array-valued
# entry. Contrast the specific-language "[lang]" form (item 4), covered by
# query_q_langprop.
#
# Two code paths are exercised: the entity query goes through the DB backend
# (mongoc compiles "[*]" to a $expr over $objectToArray; ramdb uses the in-memory
# matcher), and the subscription section drives the in-memory matcher directly
# (subscription q is evaluated in the broker on every write).
#
--NAME--
q over a LanguageProperty with the all-languages selector L[*]== / ~= / != (§ 7.2.3.4)

--TAGS--
langProp q query subscription notification

--INIT--
swDbDrop
swBrokerStart
ftClientStart

--RUN--

echo "01. Seed LanguageProperties: L1 string, L2 array in de, L3 no pain, L4 array in en"
echo "=================================================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:L1","type":"D","description":{"type":"LanguageProperty","languageMap":{"en":"pain","es":"dolor"}}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:L2","type":"D","description":{"type":"LanguageProperty","languageMap":{"fr":"douleur","de":["schmerz","pain"]}}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:L3","type":"D","description":{"type":"LanguageProperty","languageMap":{"en":"joy","es":"alegria"}}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:L4","type":"D","description":{"type":"LanguageProperty","languageMap":{"en":["pain","ache"]}}}' | head -1
echo
echo


echo "02. q=description[*]==\"pain\" — any language: L1 (en), L2 (de array), L4 (en array)"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=D&q=description%5B*%5D==%22pain%22&attrs=description&options=keyValues&orderBy=id'
echo
echo


echo "03. q=description[*]~=pain — pattern in any language: L1, L2, L4"
echo "==============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=D&q=description%5B*%5D~=pain&attrs=description&options=keyValues&orderBy=id'
echo
echo


echo "04. q=description[*]!=\"pain\" — NO language equals pain: L3 only"
echo "==============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=D&q=description%5B*%5D!=%22pain%22&attrs=description&options=keyValues&orderBy=id'
echo
echo


echo "05. q=description[en]==\"pain\" — specific language (control): L1 + L4 (en array element)"
echo "========================================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=D&q=description%5Ben%5D==%22pain%22&attrs=description&options=keyValues&orderBy=id'
echo
echo


echo "06. q=description[*]==\"nope\" — no match"
echo "======================================="
swCurl --url '/ngsi-ld/v1/entities?type=D&q=description%5B*%5D==%22nope%22'
echo
echo


echo "07. Subscription q=description[*]==\"pain\" on type W (in-memory matcher)"
echo "======================================================================="
EP='{"uri":"http://localhost:7701/notify","accept":"application/json"}'
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:Slang","type":"Subscription","entities":[{"type":"W"}],"q":"description[*]==\"pain\"","notification":{"endpoint":'"$EP"'}}' | head -1
echo
echo


echo "08. W1 (de array has pain) notifies; W2 (only joy) does not"
echo "==========================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:W1","type":"W","description":{"type":"LanguageProperty","languageMap":{"fr":"douleur","de":["schmerz","pain"]}}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:W2","type":"W","description":{"type":"LanguageProperty","languageMap":{"en":"joy"}}}' | head -1
sleep 0.3
ftClientDump
ftClientReset
echo
echo


--EXPECT--
01. Seed LanguageProperties: L1 string, L2 array in de, L3 no pain, L4 array in en
==================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. q=description[*]=="pain" — any language: L1 (en), L2 (de array), L4 (en array)
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 533

[
  {
    "description": {
      "languageMap": {
        "en": "pain",
        "es": "dolor"
      }
    },
    "id": "urn:ngsi-ld:L1",
    "type": "D"
  },
  {
    "description": {
      "languageMap": {
        "de": [
          "schmerz",
          "pain"
        ],
        "fr": "douleur"
      }
    },
