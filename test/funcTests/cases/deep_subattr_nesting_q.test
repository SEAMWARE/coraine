                  "createdAt": "REGEX(20[23]\d-.*Z)",
                  "e": {
                    "createdAt": "REGEX(20[23]\d-.*Z)",
                    "modifiedAt": "REGEX(20[23]\d-.*Z)",
                    "type": "Property",
                    "value": 4
                  },
                  "modifiedAt": "REGEX(20[23]\d-.*Z)",
                  "type": "Property",
                  "value": "D"
                },
                "modifiedAt": "REGEX(20[23]\d-.*Z)",
                "type": "Property",
                "value": "C"
              },
              "createdAt": "REGEX(20[23]\d-.*Z)",
              "modifiedAt": "REGEX(20[23]\d-.*Z)",
              "type": "Property",
              "value": "B"
            },
            "createdAt": "REGEX(20[23]\d-.*Z)",
            "modifiedAt": "REGEX(20[23]\d-.*Z)",
            "type": "Property",
            "value": "A"
          },
          "createdAt": "REGEX(20[23]\d-.*Z)",
          "id": "urn:ngsi-ld:Deep:1",
          "modifiedAt": "REGEX(20[23]\d-.*Z)",
          "type": "T"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
ftClientStop
coraineStop
corDbDrop
