#
# FILE            troe_timescale_temporal_partial.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 6.4.7.3 (TS 104-176) temporal pagination: the per-attribute page
# limit is ?firstN (ascending) / ?lastN (descending) / the configured
# default (ascending); ?offsetN skips into the sequence. When instances
# remain beyond the page, the broker emits Link page pointers:
# rel="intervalafter" → the page with LATER timestamps,
# rel="intervalbefore" → EARLIER timestamps (time-oriented, so the
# relations swap sides between ascending and descending pagination).
# Status is always 200 — the old § 6.3.10 206 + Content-Range is gone.
#
# Broker is started with --troeInstanceCap 5 so we can exceed the
# default page limit with only a handful of PATCHes.
#
--NAME--
TRoE timescale - temporal pagination Link page pointers (§ 6.4.7.3)

--TAGS--
troe timescale postgres temporal partial-content pagination

--INIT--
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_partial" >/dev/null 2>&1
psql -h localhost -p 5432 -U postgres -c "CREATE DATABASE sw_troe_partial" >/dev/null
swBrokerStart --troe timescale --troeName sw_troe_partial --troeUser postgres --troeInstanceCap 5

--RUN--

#
# 01. Seed urn:V1 with 8 speed instances (observedAt 09:00..16:00).
# 02. GET /temporal/entities/urn:V1 (no params) → 200, first 5 ascending
#     (the default page limit), Link rel="intervalafter" offsetN=5.
# 03. GET ...?lastN=3 → 200, last 3 descending, deeper page = earlier
#     timestamps → Link rel="intervalbefore" offsetN=3.
# 04. GET ...?lastN=3&offsetN=3 → 200, instances 13:00..11:00 descending,
#     both pointers: intervalafter offsetN=0 (newer), intervalbefore
#     offsetN=6 (older).
# 05. GET ...?firstN=2&offsetN=2 → 200, 11:00+12:00 ascending, both
#     pointers: intervalbefore offsetN=0, intervalafter offsetN=4.
# 06. Multi-entity GET (no firstN/lastN) → 200, capped at 5, Link
#     rel="intervalafter" carrying the original query params.
# 07. firstN=0 → 400 (must be > 0).
# 08. offsetN=-1 → 400 (must be >= 0).
# 09. firstN + lastN together → 400 (ascending vs descending).
#

echo "01. Seed urn:V1 with 8 speed instances at observedAt 09:00..16:00"
echo "================================================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10,"observedAt":"2026-04-28T09:00:00Z"}}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":20,"observedAt":"2026-04-28T10:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":30,"observedAt":"2026-04-28T11:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":40,"observedAt":"2026-04-28T12:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":50,"observedAt":"2026-04-28T13:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":60,"observedAt":"2026-04-28T14:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":70,"observedAt":"2026-04-28T15:00:00Z"}' >/dev/null
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":80,"observedAt":"2026-04-28T16:00:00Z"}' >/dev/null
echo done
echo
echo


echo "02. Single-entity GET (no params) → 200, first 5 ascending, intervalafter offsetN=5"
echo "===================================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1'
echo
echo


echo "03. Single-entity GET (lastN=3) → 200, last 3 descending, intervalbefore offsetN=3"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?lastN=3'
echo
echo


echo "04. GET lastN=3&offsetN=3 → 13:00..11:00 descending, both pointers"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?lastN=3&offsetN=3'
echo
echo


echo "05. GET firstN=2&offsetN=2 → 11:00+12:00 ascending, both pointers"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?firstN=2&offsetN=2'
echo
echo


echo "06. Multi-entity GET (no firstN/lastN) → 200, capped at 5, intervalafter"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&local=true'
echo
echo


echo "07. firstN=0 → 400"
echo "=================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?firstN=0'
echo
echo


echo "08. offsetN=-1 → 400"
echo "===================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?offsetN=-1'
echo
echo


echo "09. firstN=2&lastN=3 → 400 (contradictory directions)"
echo "====================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?firstN=2&lastN=3'
echo
echo


--EXPECT--
01. Seed urn:V1 with 8 speed instances at observedAt 09:00..16:00
================================================================
done


02. Single-entity GET (no params) → 200, first 5 ascending, intervalafter offsetN=5
====================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: </ngsi-ld/v1/temporal/entities/urn:V1?offsetN=5>;rel="intervalafter";type="application/json"
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": REGEX("urn:ngsi-ld:Instance:.*"),
      "observedAt": "2026-04-28T09:00:00Z",
      "type": "Property",
      "value": 10
    },
    {
      "instanceId": REGEX("urn:ngsi-ld:Instance:.*"),
      "observedAt": "2026-04-28T10:00:00Z",
      "type": "Property",
      "value": 20
    },
    {
      "instanceId": REGEX("urn:ngsi-ld:Instance:.*"),
      "observedAt": "2026-04-28T11:00:00Z",
      "type": "Property",
      "value": 30
    },
    {
      "instanceId": REGEX("urn:ngsi-ld:Instance:.*"),
      "observedAt": "2026-04-28T12:00:00Z",
      "type": "Property",
      "value": 40
    },
    {
      "instanceId": REGEX("urn:ngsi-ld:Instance:.*"),
      "observedAt": "2026-04-28T13:00:00Z",
      "type": "Property",
      "value": 50
    }
  ],
  "type": "Vehicle"
}



