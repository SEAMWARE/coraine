#
# FILE            head_request.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
HEAD requests (auto-generated from GET): 204 and no body on the NGSI-LD API, the GET's status elsewhere

--TAGS--
head

--INIT--
corDbDrop
coraineStart

--RUN--

# TS 104-176 § 5: a HEAD request functions as the GET request would and omits the body, and the response
# code 204 No Content is used on success - and a 204 has no Content-Length. An error keeps the GET's status.
# The broker's own endpoints are not the NGSI-LD API: a HEAD there answers what HTTP says, the GET's status
# and its Content-Length.
#
# 01. Create entity for HEAD tests
# 02. HEAD /entities/{id} - 204, no Content-Length, no body
# 03. HEAD /entities?type=T - 204, no Content-Length, no body
# 04. HEAD /nonexistent - 404, no body
# 05. HEAD /version - not the NGSI-LD API: 200 and the GET's Content-Length, no body
#

echo "01. Create entity for HEAD tests"
echo "================================"
payload='{
  "id": "urn:head:E1",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. HEAD /entities/{id} - 204, no Content-Length, no body"
echo "========================================================="
curl -s --head http://localhost:$CB_PORT/ngsi-ld/v1/entities/urn:head:E1 | tr -d '\r' | grep -v "^$"
echo
echo


echo "03. HEAD /entities?type=T - 204, no Content-Length, no body"
echo "==========================================================="
curl -s --head "http://localhost:$CB_PORT/ngsi-ld/v1/entities?type=T" | tr -d '\r' | grep -v "^$"
echo
echo


echo "04. HEAD /nonexistent - 404, no body"
echo "===================================="
curl -s --head http://localhost:$CB_PORT/nonexistent | tr -d '\r' | grep -v "^$"
echo
echo


echo "05. HEAD /version - not the NGSI-LD API: 200 and the GET's Content-Length, no body"
echo "=================================================================================="
getLength=$(curl -s http://localhost:$CB_PORT/version | wc -c)
curl -s --head http://localhost:$CB_PORT/version | tr -d '\r' | grep -v "^$" > /tmp/head_request.version
head -1 /tmp/head_request.version
headLength=$(sed -n 's/^Content-Length: //p' /tmp/head_request.version)
if [ "$headLength" = "$getLength" ]; then echo "Content-Length: the GET's"; else echo "Content-Length: $headLength, the GET has $getLength"; fi
rm -f /tmp/head_request.version
echo
echo


--EXPECT--
01. Create entity for HEAD tests
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:head:E1
Content-Length: 0




02. HEAD /entities/{id} - 204, no Content-Length, no body
=========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"


03. HEAD /entities?type=T - 204, no Content-Length, no body
===========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"


04. HEAD /nonexistent - 404, no body
====================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 172


05. HEAD /version - not the NGSI-LD API: 200 and the GET's Content-Length, no body
==================================================================================
HTTP/1.1 200 OK
Content-Length: the GET's


--TEARDOWN--
coraineStop
corDbDrop
