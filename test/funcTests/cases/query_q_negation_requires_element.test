#
# FILE            query_q_negation_requires_element.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7.2.3.3 — every NEGATING query operator still requires the element to be
# there: "A matching entity shall contain the target element and meet none of
# the conditions". So an Entity that simply hasn't got the attribute is NOT a
# match for p!=10, p!~="x", p!=1..50 or p!=10,77.
#
# The exception is the non-existence operator "!attr", which asks for exactly
# the opposite — and it is satisfied by an Entity that lacks the whole path,
# not just the last segment: an Entity without "p" at all certainly does not
# contain "p.sub".
#
# Also § 4.9: a range is only meaningful for == and !=, and the negation has to
# be built into the query. "p!=1..50" is the one shape where getting it wrong
# is invisible — it silently selects the exact complement of what was asked.
#
# Seed:
#   urn:E1  p=10   p.sub=1
#   urn:E2  p=99   p.sub=9
#   urn:E3  no p at all
#
--NAME--
q negation - a negated term still requires the element (§ 7.2.3.3), !attr is the exception

--TAGS--
q query negation range valueList pattern

--INIT--
swDbDrop
swBrokerStart

--RUN--

payload='{
  "id": "urn:E1",
  "type": "T",
  "p": { "type": "Property", "value": 10, "sub": { "type": "Property", "value": 1 } },
  "s": { "type": "Property", "value": "alpha" }
}'
echo "01. Seed urn:E1 (p=10)"
echo "======================"
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


payload='{
  "id": "urn:E2",
  "type": "T",
  "p": { "type": "Property", "value": 99, "sub": { "type": "Property", "value": 9 } },
  "s": { "type": "Property", "value": "beta" }
}'
echo "02. Seed urn:E2 (p=99)"
echo "======================"
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


payload='{
  "id": "urn:E3",
  "type": "T",
  "other": { "type": "Property", "value": 1 }
}'
echo "03. Seed urn:E3 (no p, no s)"
echo "============================"
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. q=p==1..50 selects urn:E1"
echo "============================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p==1..50&format=simplified'
echo
echo


echo "05. q=p!=1..50 selects urn:E2 — the COMPLEMENT of 04, and never urn:E3"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p!=1..50&format=simplified'
echo
echo


echo "06. q=p!=200..300 selects urn:E1 and urn:E2 — both are outside, urn:E3 has no p"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p!=200..300&format=simplified'
echo
echo


echo "07. q=p!=10 selects urn:E2 only — urn:E3 has no p to be unequal with"
echo "===================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p!=10&format=simplified'
echo
echo


echo "08. q=p!=10,77 (value list) selects urn:E2 only"
echo "=============================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p!=10,77&format=simplified'
echo
echo


echo "09. q=s!=\"alpha\" selects urn:E2 only"
echo "===================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=s!=%22alpha%22&format=simplified'
echo
echo


echo "10. q=s!~=\"^al\" (do-not-match-pattern) selects urn:E2 only"
echo "=========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=s!~=%22^al%22&format=simplified'
echo
echo


echo "11. q=!p (non-existence) selects urn:E3 — the exception to the rule"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=!p&format=simplified'
echo
echo


echo "12. q=!p.sub selects urn:E3 — no 'p' at all means no 'p.sub' either"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=!p.sub&format=simplified'
echo
echo


echo "13. q=p.sub (existence through a path) selects urn:E1 and urn:E2"
echo "================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=T&q=p.sub&format=simplified'
echo
echo


--EXPECT--
01. Seed urn:E1 (p=10)
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1
Content-Length: 0




02. Seed urn:E2 (p=99)
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2
Content-Length: 0




03. Seed urn:E3 (no p, no s)
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E3
Content-Length: 0




04. q=p==1..50 selects urn:E1
=============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 79

[
  {
    "id": "urn:E1",
    "p": 10,
    "s": "alpha",
    "type": "T"
  }
]



05. q=p!=1..50 selects urn:E2 — the COMPLEMENT of 04, and never urn:E3
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 78

[
  {
    "id": "urn:E2",
    "p": 99,
    "s": "beta",
    "type": "T"
  }
]



06. q=p!=200..300 selects urn:E1 and urn:E2 — both are outside, urn:E3 has no p
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 154

[
  {
    "id": "urn:E1",
    "p": 10,
    "s": "alpha",
    "type": "T"
  },
  {
    "id": "urn:E2",
    "p": 99,
    "s": "beta",
    "type": "T"
  }
]



07. q=p!=10 selects urn:E2 only — urn:E3 has no p to be unequal with
====================================================================
HTTP/1.1 200 OK
