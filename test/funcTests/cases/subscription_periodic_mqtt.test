#
# FILE            subscription_periodic_mqtt.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A periodic subscription (timeInterval) with an mqtt:// endpoint: published once per interval, the
# matching entities as they are then, wrapped { metadata, body } as a change-driven one's (§ 7).
#
# Test rig: a private mosquitto on port 11890 (anonymous, runtime config), ftClient subscribed to the
# topic ngsild/pernot.
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Periodic subscription - MQTT delivery, once per interval

--TAGS--
subscription periodic mqtt

--INIT--
corDbDrop
echo "listener 11890
allow_anonymous true" > /tmp/mqtt-pernot.conf
mosquitto -d -c /tmp/mqtt-pernot.conf
mosquittoWait 11890
ftClientStart --mqttPort 11890 --mqttTopic ngsild/pernot
coraineStart --bridges mqtt

--RUN--

#
# 01. An entity of the type
# 02. The periodic subscription, timeInterval 2, endpoint mqtt://localhost:11890/ngsild/pernot
# 03. 5.5 s later: 2 or 3 publishes, 2 s apart or more, each with the entity
#

echo "01. An entity of the type"
echo "========================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' | head -1
echo
echo


echo "02. The periodic subscription, timeInterval 2, endpoint mqtt://localhost:11890/ngsild/pernot"
echo "============================================================================================"
payload='{
  "id":"urn:ngsi-ld:Subscription:P1",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "timeInterval":2,
  "notification":{ "endpoint":{ "uri":"mqtt://localhost:11890/ngsild/pernot" } }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | head -1
echo
echo


echo "03. 5.5 s later: 2 or 3 publishes, 2 s apart or more, each with the entity"
echo "=========================================================================="
sleep 5.5
ftClientDump | python3 -c '
import json,sys,datetime
v = []
for e in json.load(sys.stdin):
  if e.get("verb") != "MQTT" or e.get("url") != "ngsild/pernot":
    continue
  m = e.get("body", e.get("payload"))
  if isinstance(m, str):
    m = json.loads(m)
  b = m["body"]
  if isinstance(b, str):
    b = json.loads(b)
  if b.get("subscriptionId") != "urn:ngsi-ld:Subscription:P1":
    continue
  t = datetime.datetime.fromisoformat(b["notifiedAt"].replace("Z", "+00:00"))
  v.append((t, [x["id"] for x in b["data"]]))
v.sort()
gaps = [(b[0] - a[0]).total_seconds() for a, b in zip(v, v[1:])]
ok   = (2 <= len(v) <= 3) and all(g >= 1.9 for g in gaps) and all(d == ["urn:ngsi-ld:Vehicle:V1"] for _, d in v)
print("yes" if ok else "no: %d publishes, gaps %s" % (len(v), gaps))
'
echo
echo


--EXPECT--
01. An entity of the type
=========================
HTTP/1.1 201 Created


02. The periodic subscription, timeInterval 2, endpoint mqtt://localhost:11890/ngsild/pernot
============================================================================================
HTTP/1.1 201 Created


03. 5.5 s later: 2 or 3 publishes, 2 s apart or more, each with the entity
==========================================================================
yes


--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
mosquittoStop /tmp/mqtt-pernot.conf 11890
\rm -f /tmp/mqtt-pernot.conf
