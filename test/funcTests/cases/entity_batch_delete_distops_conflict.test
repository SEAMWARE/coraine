#
# FILE            entity_batch_delete_distops_conflict.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Delete (§ 5.6.11) — exclusive CSR without deleteBatch op.
# Forward cannot proceed; errors[] carries a Conflict with the reg id.
# Local delete still proceeds for ids that exist locally.
#
--NAME--
Batch Entity Delete — exclusive CSR without deleteBatch op (207 conflict)

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities
swBrokerStart -role CP1 --noSplitEntities

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Seed V1 on CB only"
echo "======================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo


echo "02. Register CB→CP1 exclusive but WITHOUT deleteBatch"
echo "====================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:EX","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"exclusive","operations":["retrieveEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "03. Batch Delete [V1] → 207 (local deletes; CSR conflict)"
echo "========================================================="
# Local V1 gets deleted; CSR reports conflict because exclusive reg
# doesn't support deleteBatch — we still report the conflict alongside
# the local success.
swCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1"]'
echo
echo


echo "04. GET CB V1 → 404 (local delete happened)"
echo "==========================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


--EXPECT--
01. Seed V1 on CB only
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




02. Register CB→CP1 exclusive but WITHOUT deleteBatch
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:EX
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




03. Batch Delete [V1] → 207 (local deletes; CSR conflict)
=========================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 323

{
  "errors": [
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "exclusive registration does not support deleteBatch",
        "title": "Conflict",
        "type": "https://uri.etsi.org/ngsi-ld/errors/Conflict"
      },
      "registrationId": "urn:CSR:EX"
    }
  ],
  "success": [
    "urn:V1"
  ]
}



04. GET CB V1 → 404 (local delete happened)
===========================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 134

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
