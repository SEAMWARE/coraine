#
# FILE            entity_batch_delete_distops_conflict.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Delete (§ 5.6.11) — exclusive CSR without deleteBatch op.
# The covered id's forward cannot proceed; errors[] carries a Conflict
# with the reg id and the CS copy stays untouched (exclusive = chopped
# and forwarded, never local). Uncovered ids delete locally as usual.
#
# REQUIRE_FEATURE: REGISTRATIONS
#
--NAME--
Batch Entity Delete — exclusive CSR without deleteBatch op (207 conflict)

--TAGS--
batch delete entity

--INIT--
corDbDrop
corDbDrop -role CP1
coraineStart --noSplitEntities -dist
coraineStart -role CP1 --noSplitEntities -dist

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Seed V1 on CP1 only (CB has no V1)"
echo "======================================"
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo


echo "02. Seed V2 on CB only"
echo "======================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}'
echo
echo


echo "03. Register CB→CP1 exclusive (V1/speed) but WITHOUT deleteBatch"
echo "================================================================"
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:EX","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"exclusive","operations":["retrieveEntity"],"information":[{"entities":[{"id":"urn:V1","type":"Vehicle"}],"propertyNames":["speed"]}]}'
echo
echo


echo "04. Batch Delete [V1, V2] → 207 (V2 deleted locally; V1 CSR conflict)"
echo "====================================================================="
# V1 is exclusively the CSR's; the reg doesn't support deleteBatch, so
# the forward cannot proceed → Conflict in errors[], nothing happens to
# the CP1 copy. V2 is uncovered → plain local delete → success[].
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1", "urn:V2"]'
echo
echo


echo "05. GET CB V2 → 404 (deleted locally)"
echo "====================================="
corCurl --url /ngsi-ld/v1/entities/urn:V2
echo
echo


echo "06. GET CP1 V1 → 200 (untouched — the conflict blocked the forward)"
echo "===================================================================="
corCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V1?format=simplified'
echo
echo


--EXPECT--
01. Seed V1 on CP1 only (CB has no V1)
======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed V2 on CB only
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




03. Register CB→CP1 exclusive (V1/speed) but WITHOUT deleteBatch
================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:EX
Content-Length: 0




04. Batch Delete [V1, V2] → 207 (V2 deleted locally; V1 CSR conflict)
=====================================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 579

{
  "errors": [
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "exclusive registration does not support deleteBatch",
        "status": 409,
        "title": "Conflict",
        "type": "https://uri.etsi.org/ngsi-ld/errors/Conflict"
      },
      "registrationId": "urn:CSR:EX"
    },
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "entity does not exist",
        "status": 404,
        "title": "Not Found",
        "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
      }
    }
  ],
  "success": [
    "urn:V2"
  ]
}



05. GET CB V2 → 404 (deleted locally)
=====================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 151

{
  "detail": "entity 'urn:V2' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



06. GET CP1 V1 → 200 (untouched — the conflict blocked the forward)
====================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 57

{
  "id": "urn:V1",
  "speed": 10,
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
coraineStop -role CP1
corDbDrop
corDbDrop -role CP1
