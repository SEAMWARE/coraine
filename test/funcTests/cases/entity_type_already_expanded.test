#
# FILE            entity_type_already_expanded.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Ported from orion-ld ngsild_entity_creation_with_expanded_type. An entity type
# given already-expanded as a full IRI is accepted and round-trips unchanged.
#
--NAME--
Entity type given as an already-expanded IRI round-trips

--TAGS--
entity create types

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create an entity whose type is already a full IRI
# 02. GET the entity — the type renders back as the same IRI
#

echo "01. Create entity with an already-expanded type IRI"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entities -X POST --payload '{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "https://uri.fiware.org/ns/data-models#AirQualityObserved",
  "name": { "type": "Property", "value": "John 2" }
}'
echo
echo


echo "02. GET the entity — type is the same IRI"
echo "========================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
echo
echo


--EXPECT--
01. Create entity with an already-expanded type IRI
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
Content-Length: 0




02. GET the entity — type is the same IRI
=========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 171

{
  "id": "urn:ngsi-ld:entities:E1",
  "name": {
    "type": "Property",
    "value": "John 2"
  },
  "type": "https://uri.fiware.org/ns/data-models#AirQualityObserved"
}



--TEARDOWN--
coraineStop
corDbDrop
