#
# FILE            metrics_prometheus_default_path.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Prometheus scrapes its default metrics_path of /metrics. The broker serves the
# same Prometheus exposition at /metrics as at /admin/metrics, so a scrape config
# works out of the box with no metrics_path override.
#
--NAME--
Prometheus metrics also served at the default /metrics path

--TAGS--
admin metrics

--INIT--
corDbDrop
coraineStart --apiPlugins admin

--RUN--

echo "01. GET /metrics — 200 + Prometheus exposition content-type"
echo "==========================================================="
corCurl --url /metrics --out raw | grep -E "^HTTP/1.1 |^Content-Type:"
echo
echo


echo "02. GET /admin/metrics — same status + content-type"
echo "===================================================="
corCurl --url /admin/metrics --out raw | grep -E "^HTTP/1.1 |^Content-Type:"
echo
echo


echo "03. /metrics and /admin/metrics expose the same metric set"
echo "=========================================================="
a=$(corCurl --url /metrics --out raw       | grep -oE "^ngsild_[a-z_]+" | sort -u)
b=$(corCurl --url /admin/metrics --out raw | grep -oE "^ngsild_[a-z_]+" | sort -u)
[ "$a" = "$b" ] && echo "same metric set" || echo "DIFFERENT metric set"
echo
echo


echo "04. A known counter line is present at /metrics"
echo "==============================================="
corCurl --url /metrics --out raw | grep -E "^ngsild_entity_create_total "
echo
echo


#
# 05-07 exist because this payload was, for a while, not text at all. The render
# buffer was allocated at exactly kpromRenderSize(), which reports the length
# WITHOUT the terminating NUL, so snprintf overwrote the final byte - the newline
# ending the last metric - with a NUL, and Content-Length counted it.
#
# 01-04 all passed straight through that: none of them looks at the last line, and
# the greps carried a `-a` telling grep to treat the binary payload as text. A
# Prometheus scraper would not have been so forgiving. Bare curl here, because the
# assertion is about bytes and corCurl formats.
#
echo "05. The payload is text - no NUL bytes anywhere"
echo "==============================================="
curl -s "http://$COR_HOST:$COR_PORT/metrics" -o /tmp/metricsBody.$$
echo "NUL bytes: $(tr -dc '\0' < /tmp/metricsBody.$$ | wc -c)"
echo
echo


echo "06. The payload ends with a newline, as the exposition format requires"
echo "======================================================================"
if [ "$(tail -c 1 /tmp/metricsBody.$$)" = "" ] && [ "$(tail -c 1 /tmp/metricsBody.$$ | od -An -tx1 | tr -d ' ')" = "0a" ]; then
  echo "ends with a newline"
else
  echo "DOES NOT end with a newline: $(tail -c 1 /tmp/metricsBody.$$ | od -An -tx1 | tr -d ' ')"
fi
echo
echo


echo "07. The LAST metric line is complete - the one the truncation ate"
echo "================================================================="
tail -1 /tmp/metricsBody.$$
\rm -f /tmp/metricsBody.$$
echo
echo


--EXPECT--
01. GET /metrics — 200 + Prometheus exposition content-type
===========================================================
HTTP/1.1 200 OK
Content-Type: text/plain; version=0.0.4


02. GET /admin/metrics — same status + content-type
====================================================
HTTP/1.1 200 OK
Content-Type: text/plain; version=0.0.4


03. /metrics and /admin/metrics expose the same metric set
==========================================================
same metric set


04. A known counter line is present at /metrics
===============================================
ngsild_entity_create_total 0


05. The payload is text - no NUL bytes anywhere
===============================================
NUL bytes: 0


06. The payload ends with a newline, as the exposition format requires
======================================================================
ends with a newline


07. The LAST metric line is complete - the one the truncation ate
=================================================================
ngsild_batch_item_count_count 0


--TEARDOWN--
coraineStop
