#
# FILE            troe_timescale_indexes.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE timescale plugin: --troeSqlIndexes - the indexes of the history beyond the basic ones are the
# operator's choice, made at the start: an index chosen is created, one not chosen is dropped.
#   - the default: the basic indexes only (and troe_entities_id_modified gone - its primary key serves it)
#   - --troeSqlIndexes attrObserved,geo: those two as well
#   - started again without them: dropped
#   - an index it does not know: the broker does not start
#
# Reads timescale's own tables (psql) - not a store-independent check:
# REQUIRE_TROEDB: timescale
#
--NAME--
TRoE timescale - --troeSqlIndexes: the indexes beyond the basic ones

--TAGS--
troe timescale postgres

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--
PSQL="psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U postgres -d $COR_TROE_DB -tA -F|"
indexes() {
  $PSQL -c "SELECT indexname FROM pg_indexes WHERE tablename IN ('troe_attrs', 'troe_entities') ORDER BY indexname"
}

echo "01. The default: the basic indexes"
echo "=================================="
indexes
echo
echo


echo "02. --troeSqlIndexes attrObserved,geo"
echo "=================================="
coraineStop
coraineStart --troe timescale --troeSqlIndexes attrObserved,geo
indexes
echo
echo


echo "03. Started again with --troeSqlIndexes time - attrObserved and geo dropped, time created"
echo "======================================================================================"
coraineStop
coraineStart --troe timescale --troeSqlIndexes time
indexes
coraineStop
echo
echo


echo "04. --troeSqlIndexes nope - the broker does not start, and says why"
echo "================================================================"
timeout 10 $COR_BROKER -fg --port 9 --database corDB --troe timescale --troeHost "$COR_TROE_HOST" --troePort "$COR_TROE_PORT" --troeName "$COR_TROE_DB" --troeSqlIndexes attrObserved,nope > /tmp/troeIndexes.$$ 2>&1
echo "exit: $?"
grep -o "unknown index 'nope'.*" /tmp/troeIndexes.$$ | head -1
rm -f /tmp/troeIndexes.$$
echo
echo


--EXPECT--
01. The default: the basic indexes
==================================
troe_attrs_id_attr_modified
troe_attrs_id_attr_observed
troe_attrs_pkey
troe_attrs_type
troe_entities_pkey
troe_entities_type


02. --troeSqlIndexes attrObserved,geo
==================================
troe_attrs_attr_observed
troe_attrs_geo
troe_attrs_id_attr_modified
troe_attrs_id_attr_observed
troe_attrs_pkey
troe_attrs_type
troe_entities_pkey
troe_entities_type


03. Started again with --troeSqlIndexes time - attrObserved and geo dropped, time created
======================================================================================
troe_attrs_id_attr_modified
troe_attrs_id_attr_observed
troe_attrs_modified_at_idx
troe_attrs_pkey
troe_attrs_type
troe_entities_pkey
troe_entities_type


04. --troeSqlIndexes nope - the broker does not start, and says why
================================================================
exit: 1
unknown index 'nope' (the choice: attrObserved, geo, time)


--TEARDOWN--
coraineStop
corDbDrop
corTroeDrop
