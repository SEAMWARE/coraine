#
# FILE            query_q_jsonproperty.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# q with a trailing path into a JsonProperty (§ 7.2.3.4 item 8). Every segment of a q path is a term,
# expanded with the @context - right for a compound Property, whose value keys are stored expanded,
# while a JsonProperty's json is stored as sent. q cannot tell the two apart; the query says it, in
# jsonKeys (§ 7.2.3.1, Example 12 - a URL param, a Query body member, a Subscription member): under
# an attribute it names, the path is walked as sent. `id` and `type` are the sharp cases (@id, @type).
#
# jsonKeys was parsed and never used: no path into a json ever matched. Without it, none does still
# (step 02) - that is the spec's answer, not a gap.
#
--NAME--
q into a JsonProperty's json - jsonKeys says the trailing path is not expanded (URL, Query body, Subscription)

--TAGS--
q query jsonProperty jsonKeys subscription notification

--INIT--
corDbDrop
coraineStart
ftClientStart

--RUN--

echo "01. J1, J2: JsonProperty jp (json with id, type, a nested member); P3: jp a Property with a compound value"
echo "=========================================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:JQ:J1","type":"T","jp":{"type":"JsonProperty","json":{"id":"some-id","type":"some-type","null":null,"other":"x","deep":{"k":"v"}}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:JQ:J2","type":"T","jp":{"type":"JsonProperty","json":{"id":"another-id","type":"some-type"}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:JQ:P3","type":"T","jp":{"type":"Property","value":{"k":"v"}}}' | head -1
echo
echo


echo "02. Without jsonKeys: jp[other]==\"x\" - [other] is a term, expanded: nothing; jp[k]==\"v\": P3's compound value"
echo "=============================================================================================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=jp%5Bother%5D==%22x%22' | grep -E '^HTTP|"id": "urn'
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=jp%5Bk%5D==%22v%22' | grep -E '^HTTP|"id": "urn'
echo
echo


echo "03. jsonKeys=jp: jp[id]==\"some-id\": J1 - jp[type]==\"some-type\": J1, J2 - jp[id]==\"wrong-id\": none"
echo "======================================================================================================"
for q in 'jp%5Bid%5D==%22some-id%22' 'jp%5Btype%5D==%22some-type%22' 'jp%5Bid%5D==%22wrong-id%22'; do
  echo "$q:"
  corCurl --url /ngsi-ld/v1/entities --urlParams "type=T&orderBy=id&jsonKeys=jp&q=$q" | grep '"id": "urn'
done
echo
echo


echo "04. jsonKeys=jp: jp[id]!=\"wrong-id\": J1, J2 - jp[other]==\"x\" and jp[deep.k]==\"v\": J1"
echo "=========================================================================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&orderBy=id&jsonKeys=jp&q=jp%5Bid%5D!=%22wrong-id%22' | grep '"id": "urn'
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&jsonKeys=jp&q=jp%5Bother%5D==%22x%22' | grep '"id": "urn'
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&jsonKeys=jp&q=jp%5Bdeep.k%5D==%22v%22' | grep '"id": "urn'
echo
echo


echo "05. jsonKeys=jp: jp[id]~=some.*: J1 - jp[id]!~=some.*: J2"
echo "=========================================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&jsonKeys=jp&q=jp%5Bid%5D~=some.*' | grep '"id": "urn'
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&jsonKeys=jp&q=jp%5Bid%5D!~=some.*' | grep '"id": "urn'
echo
echo


echo "06. POST Query body with jsonKeys: J1"
echo "====================================="
corCurl --url /ngsi-ld/v1/entityOperations/query -X POST --payload '{"type":"Query","entities":[{"type":"T"}],"q":"jp[id]==\"some-id\"","jsonKeys":"jp"}' | grep -E '^HTTP|"id": "urn'
echo
echo


echo "07. Subscription on type W with q=jp[id]==\"some-id\" and jsonKeys - GET keeps both as sent"
echo "=========================================================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:JQ:S","type":"Subscription","entities":[{"type":"W"}],"q":"jp[id]==\"some-id\"","jsonKeys":"jp","notification":{"endpoint":{"uri":"http://localhost:'$FT_CLIENT_PORT'/jk"}}}' | head -1
corCurl --url /ngsi-ld/v1/subscriptions/urn:JQ:S | grep -E '"q"|"jsonKeys"'
echo
echo


echo "08. W1 (json id some-id) and W2 (json id another-id) - one notification, for W1"
echo "==============================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:JQ:W1","type":"W","jp":{"type":"JsonProperty","json":{"id":"some-id"}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:JQ:W2","type":"W","jp":{"type":"JsonProperty","json":{"id":"another-id"}}}' | head -1
ftClientWait 1
ftClientDump | python3 -c 'import sys, json
for n in json.load(sys.stdin):
  print(n["url"], n["body"]["subscriptionId"], [e["id"] for e in n["body"]["data"]])'
echo
echo


--TEARDOWN--
coraineStop
ftClientStop
corDbDrop

--EXPECT--
01. J1, J2: JsonProperty jp (json with id, type, a nested member); P3: jp a Property with a compound value
==========================================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. Without jsonKeys: jp[other]=="x" - [other] is a term, expanded: nothing; jp[k]=="v": P3's compound value
==============================================================================================================
HTTP/1.1 200 OK
HTTP/1.1 200 OK
    "id": "urn:JQ:P3",


03. jsonKeys=jp: jp[id]=="some-id": J1 - jp[type]=="some-type": J1, J2 - jp[id]=="wrong-id": none
======================================================================================================
jp%5Bid%5D==%22some-id%22:
    "id": "urn:JQ:J1",
jp%5Btype%5D==%22some-type%22:
    "id": "urn:JQ:J1",
    "id": "urn:JQ:J2",
jp%5Bid%5D==%22wrong-id%22:


04. jsonKeys=jp: jp[id]!="wrong-id": J1, J2 - jp[other]=="x" and jp[deep.k]=="v": J1
==========================================================================================
    "id": "urn:JQ:J1",
    "id": "urn:JQ:J2",
    "id": "urn:JQ:J1",
    "id": "urn:JQ:J1",


05. jsonKeys=jp: jp[id]~=some.*: J1 - jp[id]!~=some.*: J2
==========================================================
    "id": "urn:JQ:J1",
    "id": "urn:JQ:J2",


06. POST Query body with jsonKeys: J1
=====================================
HTTP/1.1 200 OK
    "id": "urn:JQ:J1",


07. Subscription on type W with q=jp[id]=="some-id" and jsonKeys - GET keeps both as sent
==========================================================================================
HTTP/1.1 201 Created
  "jsonKeys": "jp",
  "q": "jp[id]==\"some-id\"",


08. W1 (json id some-id) and W2 (json id another-id) - one notification, for W1
===============================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
/jk urn:JQ:S ['urn:JQ:W1']


