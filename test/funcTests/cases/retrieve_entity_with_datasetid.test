#
# FILE            retrieve_entity_with_datasetid.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET entity with single attribute with datasetId returns object with datasetId

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with speed having a named datasetId
# 02. GET entity E1 - speed with datasetId returned
#

echo "01. Create entity with speed having a named datasetId"
echo "======================================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100,
    "datasetId": "urn:sensor:radar"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity E1 - speed with datasetId returned"
echo "==================================================="
swCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


--EXPECT--
01. Create entity with speed having a named datasetId
=======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entity E1 - speed with datasetId returned
===================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "datasetId": "urn:sensor:radar",
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swDbDrop
