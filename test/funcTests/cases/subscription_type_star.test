#
# FILE            subscription_type_star.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.6.6.3 (EntitySelector) — type "*" "is allowed as a value … to indicate
# a request for all Entities (with implied local scope)". A subscription with
# entities:[{type:"*"}] therefore matches entities of EVERY type. "*" must be
# accepted (not @vocab-expanded into a polluted IRI), round-trip on GET, and
# fire notifications regardless of the entity's type.
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Subscription entities type "*" — match-any wildcard fires for every entity type

--TAGS--
subscription notification

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

#
# 01. Create subscription S1 with entities:[{type:"*"}]
# 02. GET S1 — entities round-trips as {type:"*"}
# 03. Create entity of type A — notification expected
# 04. Create entity of type B (different type) — notification expected
# 05. Dump ftClient — 2 notifications (one per type)
#

echo "01. Create subscription S1 with entities type \"*\""
echo "==================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [{"type": "*"}],
  "notification": {
    "endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/notify"}
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. GET S1 — entities round-trips as {type:\"*\"}"
echo "================================================"
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "03. Create entity of type A — notification expected"
echo "==================================================="
payload='{"id": "urn:ngsi-ld:A:1", "type": "A", "p": {"type": "Property", "value": 1}}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


# The two notifications are sent post-response, each on its own request thread,
# so their ARRIVAL order at ftClient is a race - and step 05 dumps them in
# arrival order. Wait for A's to land before triggering B's, or the dump is a
# coin flip that comes up tails under valgrind.
ftClientWait 1

echo "04. Create entity of type B — notification expected"
echo "==================================================="
payload='{"id": "urn:ngsi-ld:B:1", "type": "B", "q": {"type": "Property", "value": 2}}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Dump ftClient — 2 notifications (type A and type B)"
echo "======================================================="
ftClientDump
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Create subscription S1 with entities type "*"
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
Content-Length: 0




02. GET S1 — entities round-trips as {type:"*"}
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 400

{
  "entities": [
    {
      "type": "*"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:S1",
  "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "type": "Subscription"
}



03. Create entity of type A — notification expected
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:A:1
Content-Length: 0




04. Create entity of type B — notification expected
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:B:1
Content-Length: 0




05. Dump ftClient — 2 notifications (type A and type B)
=======================================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:A:1",
          "p": {
            "type": "Property",
            "value": 1
          },
          "type": "A"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  },
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:B:1",
          "q": {
            "type": "Property",
            "value": 2
          },
          "type": "B"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


[]
--TEARDOWN--
coraineStop
ftClientStop
