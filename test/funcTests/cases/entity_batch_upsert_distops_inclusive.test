#
# FILE            entity_batch_upsert_distops_inclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Upsert (§ 5.6.9) — inclusive CSR mode.
#
# An inclusive registration mirrors every upsert to the registered
# Context Source. The forward is a SINGLE POST /entityOperations/upsert
# per CSR, URL unchanged (minimal-changes rule). The ?options=update
# mode, if present on the incoming request, is relayed in the forward
# so the remote reaches the same create/update decision.
#
--NAME--
Batch Entity Upsert — inclusive CSR, local + forwarded

--TAGS--
batch entity

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities
swBrokerStart -role CP1 --noSplitEntities

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Register CB→CP1 inclusive (Vehicle, upsertBatch)"
echo "===================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:R1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","operations":["upsertBatch"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "02. Upsert new V1+V2 on CB → 201 (local + forwarded to CP1)"
echo "==========================================================="
swCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10},"color":{"type":"Property","value":"red"}},
  {"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}
]'
echo
echo


echo "03. GET CB V1 local-only — created locally"
echo "=========================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues&local=true'
echo
echo


echo "04. GET CP1 V1 — created remote (forwarded)"
echo "==========================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues'
echo
echo


echo "05. Upsert existing V1 — default REPLACE mode → 204 (local + forward)"
echo "====================================================================="
swCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99}}
]'
echo
echo


echo "06. GET CB V1 — color gone (replaced by first fragment)"
echo "======================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues&local=true'
echo
echo


echo "07. GET CP1 V1 — color gone too (remote also did a replace)"
echo "==========================================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues'
echo
echo


echo "08. Upsert existing V2 ?options=update → 204 (local MERGE + forward update)"
echo "==========================================================================="
# Update mode on CB: V2.color=cyan merges with existing. The forward
# relays ?options=update so CP1 also merges rather than replacing.
swCurl --url '/ngsi-ld/v1/entityOperations/upsert?options=update' --payload '[
  {"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"cyan"}}
]'
echo
echo


echo "09. GET CB V2 — speed=20 (kept) AND color=cyan"
echo "=============================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V2?options=keyValues&local=true'
echo
echo


echo "10. GET CP1 V2 — speed=20 AND color=cyan (remote merged, too)"
echo "============================================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V2?options=keyValues'
echo
echo


echo "11. Multi-instance same id V3 (new) — first creates, rest fully REPLACE (§ 5.5.11.2)"
echo "======================================================================================"
swCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[
  {"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":100}},
  {"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"pink"}},
  {"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":300}}
]'
echo
echo


echo "12. GET CB V3 local-only — only speed=300 (last instance fully replaced)"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:V3?options=keyValues&local=true'
echo
echo


echo "13. GET CP1 V3 — only speed=300 (CP1 also did 3 replaces in order)"
echo "==================================================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V3?options=keyValues'
echo
echo


--EXPECT--
