#
# FILE            query_geo_equals_multigeoprop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.10 + § 5.7.3 — POST /entityOperations/query geo-query with georel=equals,
# and an entity carrying MORE THAN ONE GeoProperty queried independently by the
# geoQ.geoproperty selector:
#   - one entity has both "location" (Point) and "observationSpace" (Polygon)
#   - georel=equals on the Point geoproperty (exact match vs a non-match)
#   - georel=equals on the Polygon geoproperty (the second geoproperty)
#   - georel=within selecting the Polygon geoproperty (per-geoproperty selection)
#
--NAME--
POST query — georel=equals (Point/Polygon) and an entity with multiple GeoProperties

--TAGS--
geo query georel batch

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create E1 with two GeoProperties: location (Point) + observationSpace (Polygon)"
echo "==================================================================================="
payload='{
  "id": "urn:ngsi-ld:geo:E1",
  "type": "Geo",
  "location": {
    "type": "GeoProperty",
    "value": {"type": "Point", "coordinates": [13.5, 52.5]}
  },
  "observationSpace": {
    "type": "GeoProperty",
    "value": {"type": "Polygon", "coordinates": [[ [0,0], [4,0], [4,4], [0,4], [0,0] ]]}
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. equals on 'location' Point at 13.5,52.5 — exact match, see E1"
echo "================================================================"
payload='{"type":"Query","entities":[{"type":"Geo"}],"geoQ":{"georel":"equals","geometry":"Point","coordinates":[13.5,52.5],"geoproperty":"location"}}'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" | grep -E "HTTP|\"id\"|^\[|^\]"
echo
echo


echo "03. equals on 'location' Point at 0,0 — no match, empty"
echo "======================================================="
payload='{"type":"Query","entities":[{"type":"Geo"}],"geoQ":{"georel":"equals","geometry":"Point","coordinates":[0,0],"geoproperty":"location"}}'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" | grep -E "HTTP|\"id\"|^\[|^\]"
echo
echo


echo "04. equals on the SECOND geoproperty 'observationSpace' with the exact Polygon — see E1"
echo "======================================================================================="
payload='{"type":"Query","entities":[{"type":"Geo"}],"geoQ":{"georel":"equals","geometry":"Polygon","coordinates":[[ [0,0],[4,0],[4,4],[0,4],[0,0] ]],"geoproperty":"observationSpace"}}'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" | grep -E "HTTP|\"id\"|^\[|^\]"
echo
echo


echo "05. within selecting 'observationSpace' (Polygon contains a small box) — see E1"
echo "==============================================================================="
payload='{"type":"Query","entities":[{"type":"Geo"}],"geoQ":{"georel":"within","geometry":"Polygon","coordinates":[[ [-1,-1],[5,-1],[5,5],[-1,5],[-1,-1] ]],"geoproperty":"observationSpace"}}'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" | grep -E "HTTP|\"id\"|^\[|^\]"
echo
echo


echo "06. equals on 'location' but selecting 'observationSpace' geometry — no match (wrong geoproperty)"
echo "================================================================================================="
payload='{"type":"Query","entities":[{"type":"Geo"}],"geoQ":{"georel":"equals","geometry":"Point","coordinates":[13.5,52.5],"geoproperty":"observationSpace"}}'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" | grep -E "HTTP|\"id\"|^\[|^\]"
echo


--EXPECT--
01. Create E1 with two GeoProperties: location (Point) + observationSpace (Polygon)
===================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:geo:E1
Content-Length: 0




02. equals on 'location' Point at 13.5,52.5 — exact match, see E1
================================================================
HTTP/1.1 200 OK
[
    "id": "urn:ngsi-ld:geo:E1",
]


03. equals on 'location' Point at 0,0 — no match, empty
=======================================================
HTTP/1.1 200 OK
[]


04. equals on the SECOND geoproperty 'observationSpace' with the exact Polygon — see E1
=======================================================================================
HTTP/1.1 200 OK
[
    "id": "urn:ngsi-ld:geo:E1",
]


05. within selecting 'observationSpace' (Polygon contains a small box) — see E1
===============================================================================
HTTP/1.1 200 OK
[
    "id": "urn:ngsi-ld:geo:E1",
]


06. equals on 'location' but selecting 'observationSpace' geometry — no match (wrong geoproperty)
=================================================================================================
HTTP/1.1 200 OK
[]

--TEARDOWN--
coraineStop
