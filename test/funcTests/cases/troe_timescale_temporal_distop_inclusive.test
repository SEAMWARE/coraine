#
# FILE            troe_timescale_temporal_distop_inclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Distop dispatch on the single-entity temporal GET (§ 5.7.3 / § 5.7.5).
#
# CB has an INCLUSIVE registration pointing at CP1 covering urn:V1's
# retrieveTemporal op. Both brokers run independent TRoE postgres
# databases. After populating each with their own speed instances, a
# GET temporal/urn:V1 on CB unions the per-attr instance arrays.
#
# Inclusive (§ 4.3.6.2) keeps the local result AND merges CP1's — a
# 4-instance response.
#
# REQUIRE_FEATURE: REGISTRATIONS
#
--NAME--
TRoE timescale - temporal distop, inclusive

--TAGS--
troe timescale postgres temporal distops registration

--INIT--
corDbDrop
corDbDrop -role CP1
corTroeInit
corTroeInit -role CP1
coraineStart        --troe timescale -dist --troeSync
coraineStart -role CP1 --troe timescale -dist --troeSync

--RUN--

echo "01. Register CB → CP1 (inclusive, retrieveTemporal) for urn:V1"
echo "=============================================================="
payload='{
  "id":         "urn:CSR:CB-CP1",
  "type":       "ContextSourceRegistration",
  "endpoint":   "http://localhost:'"$CP1_PORT"'",
  "mode":       "inclusive",
  "operations": ["retrieveTemporal"],
  "information":[
    {
      "entities":   [{"id":"urn:V1","type":"Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. Seed urn:V1 on CB with speed=10 and PATCH speed=20 (2 local instances)"
echo "=========================================================================="
payload='{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10,"observedAt":"2026-04-28T09:00:00Z"}}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":20,"observedAt":"2026-04-28T10:00:00Z"}' >/dev/null
echo done
echo
echo


echo "03. Seed urn:V1 on CP1 with speed=30 and PATCH speed=40 (2 remote instances)"
echo "============================================================================"
payload='{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":30,"observedAt":"2026-04-28T11:00:00Z"}}'
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":40,"observedAt":"2026-04-28T12:00:00Z"}' >/dev/null
echo done
echo
echo


echo "04. GET temporal/urn:V1 on CB — 4 instances merged from local + CP1"
echo "==================================================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


--EXPECT--
01. Register CB → CP1 (inclusive, retrieveTemporal) for urn:V1
==============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:CB-CP1
Content-Length: REGEX(\d+)




02. Seed urn:V1 on CB with speed=10 and PATCH speed=20 (2 local instances)
==========================================================================
done


03. Seed urn:V1 on CP1 with speed=30 and PATCH speed=40 (2 remote instances)
============================================================================
done


04. GET temporal/urn:V1 on CB — 4 instances merged from local + CP1
===================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
      "observedAt": "2026-04-28T09:00:00Z",
      "type": "Property",
      "value": 10
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
      "observedAt": "2026-04-28T10:00:00Z",
      "type": "Property",
      "value": 20
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
      "observedAt": "2026-04-28T11:00:00Z",
      "type": "Property",
      "value": 30
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
      "observedAt": "2026-04-28T12:00:00Z",
      "type": "Property",
      "value": 40
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
coraineStop -role CP1
corDbDrop
corDbDrop -role CP1
corTroeDrop
corTroeDrop -role CP1
