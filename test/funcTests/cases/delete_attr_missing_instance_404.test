#
# FILE            delete_attr_missing_instance_404.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TS 104-175 § 5.6.5 — DELETE /entities/{id}/attrs/{attr} on an existing entity
# whose attribute has ONLY datasetId-bearing instances (no default "@none"
# instance) must return 404 — but the entity AND the attribute both exist, so
# the ProblemDetails detail must name the missing instance, not claim the whole
# entity is absent. Likewise for a datasetId that no instance carries. The
# genuine "entity not found" and "attribute not found" details are unchanged.
#
--NAME--
Delete attribute instance-not-found reports the instance, not the entity (§ 5.6.5)

--TAGS--
delete attribute datasetId

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create entity whose 'temp' attr has ONLY a datasetId instance"
echo "================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T","temp":{"type":"Property","value":5,"datasetId":"urn:ds:1"}}' | head -1
echo
echo


echo "02. DELETE temp with no datasetId — default instance absent → 404 (names the instance)"
echo "======================================================================================"
corCurl -X DELETE --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp'
echo
echo


echo "03. DELETE temp with a datasetId no instance carries → 404 (names the datasetId)"
echo "================================================================================"
corCurl -X DELETE --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp?datasetId=urn:ds:9'
echo
echo


echo "04. DELETE on a genuinely absent entity → 404 entity not found (unchanged)"
echo "========================================================================="
corCurl -X DELETE --url '/ngsi-ld/v1/entities/urn:ngsi-ld:NOPE/attrs/temp'
echo
echo


echo "05. DELETE a genuinely absent attribute → 404 attribute not found (unchanged)"
echo "============================================================================="
corCurl -X DELETE --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/nosuch'
echo
echo


echo "06. DELETE the datasetId instance that DOES exist → 204 (control)"
echo "================================================================="
corCurl -X DELETE --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp?datasetId=urn:ds:1' | head -1
echo
echo


--EXPECT--
01. Create entity whose 'temp' attr has ONLY a datasetId instance
=================================================================
HTTP/1.1 201 Created


02. DELETE temp with no datasetId — default instance absent → 404 (names the instance)
======================================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 193

{
  "detail": "attribute 'temp' has no default instance in entity 'urn:ngsi-ld:E1'",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



03. DELETE temp with a datasetId no instance carries → 404 (names the datasetId)
================================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 211

{
  "detail": "attribute 'temp' has no instance with datasetId 'urn:ds:9' in entity 'urn:ngsi-ld:E1'",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



04. DELETE on a genuinely absent entity → 404 entity not found (unchanged)
=========================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 161

{
  "detail": "entity 'urn:ngsi-ld:NOPE' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



05. DELETE a genuinely absent attribute → 404 attribute not found (unchanged)
=============================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 181

{
  "detail": "attribute 'nosuch' not found in entity 'urn:ngsi-ld:E1'",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



06. DELETE the datasetId instance that DOES exist → 204 (control)
=================================================================
HTTP/1.1 204 No Content


--TEARDOWN--
coraineStop
corDbDrop
