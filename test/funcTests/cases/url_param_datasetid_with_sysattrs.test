#
# FILE            url_param_datasetid_with_sysattrs.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET with sysAttrs=true and datasetId filter skips timestamps during filtering

--TAGS--
datasetid sysattrs url-param

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with multi-instance speed (default + urn:sensor:radar)
# 02. GET entity with sysAttrs=true and datasetId=@none - timestamps preserved, filter works
# 03. GET entities with sysAttrs=true and datasetId=urn:sensor:radar - array path
#

echo "01. Create entity with multi-instance speed (default + urn:sensor:radar)"
echo "========================================================================"
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "type": "Property",
      "value": 98,
      "datasetId": "urn:sensor:radar"
    }
  ]
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity with sysAttrs=true and datasetId=@none - timestamps preserved, filter works"
echo "=========================================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?sysAttrs=true&datasetId=@none'
echo
echo


echo "03. GET entities with sysAttrs=true and datasetId=urn:sensor:radar - array path"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&sysAttrs=true&datasetId=urn:sensor:radar'
echo
echo


--EXPECT--
01. Create entity with multi-instance speed (default + urn:sensor:radar)
========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. GET entity with sysAttrs=true and datasetId=@none - timestamps preserved, filter works
==========================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "createdAt": REGEX(".*"),
  "id": "urn:e1",
  "modifiedAt": REGEX(".*"),
  "speed": {
    "createdAt": REGEX(".*"),
    "modifiedAt": REGEX(".*"),
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



03. GET entities with sysAttrs=true and datasetId=urn:sensor:radar - array path
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "createdAt": REGEX(".*"),
    "id": "urn:e1",
    "modifiedAt": REGEX(".*"),
    "speed": {
      "createdAt": REGEX(".*"),
      "datasetId": "urn:sensor:radar",
      "modifiedAt": REGEX(".*"),
      "type": "Property",
      "value": 98
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
