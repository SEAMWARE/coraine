#
# FILE            entitymap_create_with_filter.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 9 / § 5.7.2.4 — symmetric case to entitymap_paginate_with_filter.
#
# When a query carries `?entityMap=true` AND filter URL params (q, geoQ,
# scopeQ, type), the resulting EntityMap reflects ONLY entities matching
# the filters AND binds those params. Subsequent paginations may omit them
# (the broker re-applies the bound values) or re-send the same values, but
# may not modify them (→ 400).
#
--NAME--
EntityMap creation — filter params shape the map at create time

--TAGS--
entitymap query pagination distops

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Seed urn:V1 (color=red)"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","color":{"type":"Property","value":"red"}}'
echo
echo


echo "02. Seed urn:V2 (color=blue)"
echo "============================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"blue"}}'
echo
echo


echo "03. Seed urn:V3 (color=green)"
echo "============================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"green"}}'
echo
echo


echo "04. Seed urn:V4 (color=blue) — second blue, expect both in filtered map"
echo "======================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V4","type":"Vehicle","color":{"type":"Property","value":"blue"}}'
echo
echo


echo "05a. Create EntityMap with q=color==\"blue\" — page 1 = V2 + V4 only"
echo "==================================================================="
echo "     Response is page 1 of the filtered set; the map being created"
echo "     is the filtered set, NOT the universe of Vehicles."
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&entityMap=true&orderBy=id&q=color%3D%3D%22blue%22'
echo
echo


echo "05b. Capture the EntityMap id from the same request (separate call)"
echo "==================================================================="
MAP_ID=$(corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&entityMap=true&orderBy=id&q=color%3D%3D%22blue%22' 2>/dev/null | grep -i 'NGSILD-EntityMap:' | sed -E 's|.*entityMaps/([^[:space:]]*).*|\1|' | tr -d '\r')
if [ -n "$MAP_ID" ]; then echo "Map captured (id present): yes"; else echo "Map captured (id present): no"; fi
echo
echo


echo "06. GET /entityMaps/<id> — map's entryList holds V2 + V4 only"
echo "============================================================="
corCurl --url "/ngsi-ld/v1/entityMaps/$MAP_ID"
echo
echo


echo "07. Paginate same map OMITTING the filters — bound type+q re-applied, V2 + V4"
echo "============================================================================="
echo "    The map binds type=Vehicle & q=color==blue; omitting them re-applies the"
echo "    bound values, and the entry set is already only V2 + V4 anyway."
corCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&orderBy=id"
echo
echo


echo "08. Paginate same map MODIFYING q (color==\"red\") — 400 (bound q may not change)"
echo "================================================================================"
echo "    The bound q is color==blue; sending a different q is rejected, not narrowed."
corCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=color%3D%3D%22red%22"
echo
echo


--EXPECT--
01. Seed urn:V1 (color=red)
===========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed urn:V2 (color=blue)
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




03. Seed urn:V3 (color=green)
=============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V3
Content-Length: 0




04. Seed urn:V4 (color=blue) — second blue, expect both in filtered map
=======================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V4
Content-Length: 0




05a. Create EntityMap with q=color=="blue" — page 1 = V2 + V4 only
===================================================================
     Response is page 1 of the filtered set; the map being created
     is the filtered set, NOT the universe of Vehicles.
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-EntityMap: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 245

[
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:V2",
    "type": "Vehicle"
  },
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:V4",
    "type": "Vehicle"
  }
]



05b. Capture the EntityMap id from the same request (separate call)
===================================================================
Map captured (id present): yes


06. GET /entityMaps/<id> — map's entryList holds V2 + V4 only
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 230

{
  "entityMap": {
    "urn:V2": [
      "@none"
    ],
    "urn:V4": [
      "@none"
    ]
  },
  "expiresAt": "REGEX(.*)",
  "id": "REGEX(.*)",
  "linkedMaps": {},
  "type": "EntityMap"
}



07. Paginate same map OMITTING the filters — bound type+q re-applied, V2 + V4
=============================================================================
    The map binds type=Vehicle & q=color==blue; omitting them re-applies the
    bound values, and the entry set is already only V2 + V4 anyway.
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 245

[
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:V2",
    "type": "Vehicle"
  },
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:V4",
    "type": "Vehicle"
  }
]



08. Paginate same map MODIFYING q (color=="red") — 400 (bound q may not change)
================================================================================
    The bound q is color==blue; sending a different q is rejected, not narrowed.
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 227

{
  "detail": "URL parameter 'q' differs from the query that created entity map 'REGEX(.*)'",
  "status": 400,
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
coraineStop
corDbDrop
