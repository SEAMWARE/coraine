#
# FILE            query_geo_disjoint.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Entity geo-query with georel=disjoint against a rectangular Polygon GeoProperty,
# probed with Point / LineString / Polygon query geometries inside, outside, on the
# border, and partially overlapping the rectangle.
#
# Note on the border semantics: a Point ON the border intersects the Polygon, so it
# does NOT match disjoint (step 04); a LineString lying along the border is treated
# as disjoint and DOES match (step 07). The latter is a mongo/S2 boundary quirk —
# the in-memory GEOS engine is OGC-consistent (boundary contact = not disjoint), so
# this test is mongoc-only; the GEOS behaviour is covered by
# query_geo_disjoint_ramdb.test.
#
# REQUIRE_DB: mongoc
#
--NAME--
Entity geo-query — georel=disjoint (Point / LineString / Polygon vs a rectangle)

--TAGS--
geo query georel

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create entity E1 with a location GeoProperty — a rectangle 0,0 -> 4,0 -> 4,4 -> 0,4 -> 0,0"
echo "=============================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:ngsi-ld:geo:E1",
  "type": "Geo",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[ [0,0], [4,0], [4,4], [0,4], [0,0] ]]
    }
  }
}'
echo
echo


echo "02. Disjoint for a Point outside the rectangle, at 5,5 - see E1"
echo "=============================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Point&coordinates=%5B5,5%5D&georel=disjoint'
echo
echo


echo "03. Disjoint for a Point inside the rectangle, at 3,3 - see nothing"
echo "=================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Point&coordinates=%5B3,3%5D&georel=disjoint'
echo
echo


echo "04. Disjoint for a Point on the border, at 4,4 - see nothing"
echo "============================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Point&coordinates=%5B4,4%5D&georel=disjoint'
echo
echo


echo "05. Disjoint for a LineString outside the rectangle: 5,5 -> 6,6 - see E1"
echo "======================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=LineString&coordinates=%5B%5B5,5%5D,%5B6,6%5D%5D&georel=disjoint'
echo
echo


echo "06. Disjoint for a LineString inside the rectangle: 2,2 -> 3,3 - see nothing"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=LineString&coordinates=%5B%5B2,2%5D,%5B3,3%5D%5D&georel=disjoint'
echo
echo


echo "07. Disjoint for a LineString touching the border: 0,0 -> 0,1 - see E1"
echo "====================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=LineString&coordinates=%5B%5B0,0%5D,%5B0,1%5D%5D&georel=disjoint'
echo
echo


echo "08. Disjoint for a LineString inside and outside: -1,-1 -> 1,1 - see nothing"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=LineString&coordinates=%5B%5B-1,-1%5D,%5B1,1%5D%5D&georel=disjoint'
echo
echo


echo "09. Disjoint for a Polygon inside the rectangle - see nothing"
echo "============================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Polygon&georel=disjoint&coordinates=%5B%5B%5B1,1%5D,%5B2,1%5D,%5B2,2%5D,%5B1,2%5D,%5B1,1%5D%5D%5D'
echo
echo


echo "10. Disjoint for a Polygon outside the rectangle - see E1"
echo "========================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Polygon&georel=disjoint&coordinates=%5B%5B%5B11.1,11.1%5D,%5B12.1,11.1%5D,%5B12.1,12.1%5D,%5B11.1,12.1%5D,%5B11.1,11.1%5D%5D%5D'
echo
echo


echo "11. Disjoint for a Polygon partially inside the rectangle - see nothing"
echo "======================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Geo&geometry=Polygon&georel=disjoint&coordinates=%5B%5B%5B1,1%5D,%5B5,1%5D,%5B5,5%5D,%5B1,5%5D,%5B1,1%5D%5D%5D'
echo
echo

--EXPECT--
01. Create entity E1 with a location GeoProperty — a rectangle 0,0 -> 4,0 -> 4,4 -> 0,4 -> 0,0
==============================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:geo:E1
Content-Length: 0




02. Disjoint for a Point outside the rectangle, at 5,5 - see E1
==============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 536

[
  {
    "id": "urn:ngsi-ld:geo:E1",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          [
            [
              0,
              0
            ],
            [
              4,
              0
            ],
            [
              4,
              4
            ],
            [
              0,
              4
            ],
            [
              0,
              0
            ]
          ]
        ],
        "type": "Polygon"
      }
    },
    "type": "Geo"
  }
]



