#
# FILE            optional_fields_omitted_no_error.test
# Copyright 2026 Seamware
# Creating a subscription / registration / entity with ONLY the mandatory
# fields succeeds (no false error) and each is retrievable — the API success
# is the oracle.
#
# REQUIRE_FEATURE: REGISTRATIONS
#
--NAME--
Subscription / registration / entity with only mandatory fields create cleanly
--TAGS--
subscription registration entity error
--INIT--
corDbDrop
coraineStart -dist
--RUN--

echo "01. Create subscription (minimal fields)"
echo "========================================"
corCurl --url /ngsi-ld/v1/subscriptions -X POST --payload '{ "type": "Subscription", "entities": [ { "type": "FillingSensor" } ], "notification": { "endpoint": { "uri": "http://receiver.example.org/notify" } } }' | head -1
echo
echo

echo "02. Create registration (minimal fields)"
echo "========================================"
corCurl --url /ngsi-ld/v1/csourceRegistrations -X POST --payload '{ "type": "ContextSourceRegistration", "information": [ { "entities": [ { "type": "Vehicle" } ] } ], "endpoint": "http://my.csource.org:1026" }' | head -1
echo
echo

echo "03. Create entity (minimal fields)"
echo "=================================="
corCurl --url /ngsi-ld/v1/entities -X POST --payload '{ "id": "urn:E1", "type": "T" }' | head -1
echo
echo

# The retrieve-by-id fans out to the step-02 registration (endpoint
# my.csource.org:1026, unreachable); it never answers, so § 6.3.5 adds an
# NGSILD-Warning 199 alongside the locally-served entity.
echo "04. GET the entity back"
echo "======================="
corCurl --url '/ngsi-ld/v1/entities/urn:E1'
echo
echo

--EXPECT--
01. Create subscription (minimal fields)
========================================
HTTP/1.1 201 Created


02. Create registration (minimal fields)
========================================
HTTP/1.1 201 Created


03. Create entity (minimal fields)
==================================
HTTP/1.1 201 Created


04. GET the entity back
=======================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Warning: 199 my.csource.org:1026 "No response was received from the registration endpoint within the timeout period"
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 36

{
  "id": "urn:E1",
  "type": "T"
}



--TEARDOWN--
coraineStop
corDbDrop
