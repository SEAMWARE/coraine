#
# FILE            http_route_param_one_segment.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
A route parameter is one path segment; a trailing '/' is ignored, it never adds an empty segment

--TAGS--
http routing temporal

--INIT--
corDbDrop
coraineStart

--RUN--

payload='{
  "id": "urn:E1",
  "type": "T",
  "speed": { "type": "Property", "value": 1 }
}'
echo "01. Create urn:E1 with an attribute 'speed' - 201"
echo "================================================="
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


payload='{
  "speed": { "type": "Property", "value": 2 }
}'
echo "02. PATCH /temporal/entities/urn:E1/attrs/speed/ - the '/' is ignored: Attribute by id (DELETE only) - 405"
echo "======================================================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/temporal/entities/urn:E1/attrs/speed/ --payload "$payload"
echo
echo


echo "03. GET /entities/urn:E1/attrs/ - the attrs collection (POST, PATCH), not attribute-by-id - 405"
echo "==============================================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/
echo
echo


payload='{
  "speed": { "type": "Property", "value": 3 }
}'
echo "04. PATCH /entities/urn:E1/attrs/ - the attrs collection - 204"
echo "=============================================================="
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:E1/attrs/ --payload "$payload"
echo
echo


echo "05. GET /entities/urn:E1/ - the '/' is ignored - 200, speed == 3"
echo "================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:E1/
echo
echo


echo "06. PUT /entities/ - the Entity List: 405"
echo "========================================="
corCurl -X PUT --url /ngsi-ld/v1/entities/ --payload '{}'
echo
echo


echo "07. GET /entities/urn:E1/attrs/a/b - attrId is one segment: no route - 404"
echo "==========================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/a/b
echo
echo


echo "08. GET /entities/a/b/attrs/speed/value - no route, the 404 names the whole path"
echo "================================================================================"
corCurl --url /ngsi-ld/v1/entities/a/b/attrs/speed/value
echo
echo


--EXPECT--
01. Create urn:E1 with an attribute 'speed' - 201
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1
Content-Length: 0




02. PATCH /temporal/entities/urn:E1/attrs/speed/ - the '/' is ignored: Attribute by id (DELETE only) - 405
=======================================================================================================
HTTP/1.1 405 Method Not Allowed
Date: REGEX(.*)
Content-Type: application/json
Allow: DELETE, OPTIONS
Content-Length: 228

{
  "detail": "PATCH /ngsi-ld/v1/temporal/entities/urn:E1/attrs/speed — supported methods: DELETE, OPTIONS",
  "status": 405,
  "title": "Method Not Allowed",
  "type": "https://uri.etsi.org/ngsi-ld/errors/MethodNotAllowed"
}



03. GET /entities/urn:E1/attrs/ - the attrs collection (POST, PATCH), not attribute-by-id - 405
===============================================================================================
HTTP/1.1 405 Method Not Allowed
Date: REGEX(.*)
Content-Type: application/json
Allow: POST, PATCH, OPTIONS
Content-Length: 216

{
  "detail": "GET /ngsi-ld/v1/entities/urn:E1/attrs — supported methods: POST, PATCH, OPTIONS",
  "status": 405,
  "title": "Method Not Allowed",
  "type": "https://uri.etsi.org/ngsi-ld/errors/MethodNotAllowed"
}



04. PATCH /entities/urn:E1/attrs/ - the attrs collection - 204
==============================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET /entities/urn:E1/ - the '/' is ignored - 200, speed == 3
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 93

{
  "id": "urn:E1",
  "speed": {
    "type": "Property",
    "value": 3
  },
  "type": "T"
}



06. PUT /entities/ - the Entity List: 405
=========================================
HTTP/1.1 405 Method Not Allowed
Date: REGEX(.*)
Content-Type: application/json
Allow: GET, POST, DELETE, HEAD, OPTIONS
Content-Length: 215

{
  "detail": "PUT /ngsi-ld/v1/entities — supported methods: GET, POST, DELETE, HEAD, OPTIONS",
  "status": 405,
  "title": "Method Not Allowed",
  "type": "https://uri.etsi.org/ngsi-ld/errors/MethodNotAllowed"
}



07. GET /entities/urn:E1/attrs/a/b - attrId is one segment: no route - 404
===========================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 203

{
  "detail": "GET /ngsi-ld/v1/entities/urn:E1/attrs/a/b is not a recognized resource",
  "status": 404,
  "title": "Unknown resource",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



08. GET /entities/a/b/attrs/speed/value - no route, the 404 names the whole path
================================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 208

{
  "detail": "GET /ngsi-ld/v1/entities/a/b/attrs/speed/value is not a recognized resource",
  "status": 404,
  "title": "Unknown resource",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
coraineStop
