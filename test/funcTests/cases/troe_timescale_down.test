#
# FILE            troe_timescale_down.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE timescale plugin: the history database down. The broker keeps serving the current state; the
# history is held in memory and retried, and recorded once the database is back; past the cap of what
# is held (8 MiB) it is lost - counted in the health report, and logged. With --troeDownExit the broker
# exits instead.
#
# The database is taken away for real: ALLOW_CONNECTIONS false, and every connection to it terminated.
#
#   - writes go on (201), /ready stays 200, the report says "degraded", not recording, held
#   - a temporal query does not wait for the held history - it is answered
#   - back: what was held is recorded, the log says nothing was lost
#   - 12 MiB of history while down: some of it lost - every row either recorded or counted lost
#   - --troeSync: a request does not wait for a commit that is not coming
#   - --troeDownExit 3: the broker exits, code 1
#   - a start while the database is down waits for it (--troeConnectTimeout), and serves once it is back
#   - --troeConnectTimeout 2, the database still down: the start fails, code 1
#
# Reads timescale's own tables (psql) - not a store-independent check:
# REQUIRE_TROEDB: timescale
#
--NAME--
TRoE timescale - the history database down: served, held, recorded or counted lost; --troeDownExit

--TAGS--
troe timescale postgres health

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale --troeWriters 2 --healthPort $((CB_PORT + 2000))

--RUN--
HP=$((CB_PORT + 2000))
PSQL="psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U postgres -d $COR_TROE_DB -tA -F|"
PSQLA="psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U postgres -d postgres -tA -q"

#
# client_min_messages: a connection that ends between pg_stat_activity and pg_terminate_backend gets
# "WARNING: PID N is not a PostgreSQL backend process" on stderr - and a step's stderr fails the test.
# An error still shows.
#
dbBlock() {
  $PSQLA -c "SET client_min_messages = error" -c "ALTER DATABASE \"$COR_TROE_DB\" ALLOW_CONNECTIONS false" -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$COR_TROE_DB'" > /dev/null
}
dbUnblock() {
  $PSQLA -c "ALTER DATABASE \"$COR_TROE_DB\" ALLOW_CONNECTIONS true" > /dev/null
}

#
# history <jq filter> - from the health report
#
history() {
  curl -s "http://localhost:$HP/live" | jq -r "$1"
}

#
# recordingWait <true|false> - until the report says so, at most 30 s
#
recordingWait() {
  for _ in $(seq 1 300); do
    [ "$(history .troe.history.recording)" == "$1" ] && return 0
    sleep 0.1
  done
  echo "recording never turned $1"
}

#
# historyWritten - until the report says recording and nothing held: every row held is recorded (or
# counted lost) - "recording" alone is the first try that went through, not the last; at most 30 s
#
historyWritten() {
  for _ in $(seq 1 300); do
    [ "$(history '"\(.troe.history.recording) \(.troe.history.heldBytes)"')" == "true 0" ] && return 0
    sleep 0.1
  done
  echo "the history held was never all written"
}

for _ in $(seq 1 50); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$HP/ready")" = 200 ] && break
  sleep 0.1
done


echo "01. The history database taken away - five Entities created, the broker serving"
echo "================================================================================"
dbBlock
for i in 1 2 3 4 5
do
  corCurl --url /ngsi-ld/v1/entities --payload "{\"id\":\"urn:D$i\",\"type\":\"T\",\"p\":{\"type\":\"Property\",\"value\":$i}}" | head -1
done | sort | uniq -c
recordingWait false
echo "/ready: $(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$HP/ready")"
history '"status: \(.status)"'
history '.troe.history | "recording: \(.recording), held: \(.heldBytes > 0), lost: \(.lostRows)"'
corCurl --url /ngsi-ld/v1/entities/urn:D1 | head -1
echo
echo


echo "02. A temporal query is answered - it does not wait for the held history"
echo "========================================================================"
curl -s -m 20 -o /dev/null -w "%{http_code}\n" "http://localhost:$CB_PORT/ngsi-ld/v1/temporal/entities/urn:D1"
echo
echo


echo "03. The database back - the five recorded, nothing lost"
echo "======================================================="
dbUnblock
historyWritten
history '.troe.history | "recording: \(.recording), held: \(.heldBytes), lost: \(.lostRows)"'
history '"status: \(.status)"'
$PSQL -c "SELECT (SELECT count(*) FROM troe_entities WHERE entity_id LIKE 'urn:D%'), (SELECT count(*) FROM troe_attrs WHERE entity_id LIKE 'urn:D%')"
grep -c "the history database '$COR_TROE_DB' cannot be reached - THE HISTORY IS NOT BEING RECORDED" /tmp/coraine.CB.log
grep -c "the history database '$COR_TROE_DB' is back after [0-9]* s - recording again, nothing lost" /tmp/coraine.CB.log
echo
echo


echo "04. Taken away again - 200 Entities of 60 KiB each (12 MiB): every row recorded or counted lost"
echo "==============================================================================================="
dbBlock
big=$(head -c 61440 /dev/zero | tr '\0' 'x')
for i in $(seq 1 200)
do
  corCurl --url /ngsi-ld/v1/entities --payload "{\"id\":\"urn:L$i\",\"type\":\"T\",\"p\":{\"type\":\"Property\",\"value\":\"$big\"}}" | head -1
done | sort | uniq -c
lost=$(history .troe.history.lostRows)
echo "lost: $([ "$lost" -gt 0 ] && echo some || echo none)"
dbUnblock
historyWritten
lost=$(history .troe.history.lostRows)
recorded=$($PSQL -c "SELECT (SELECT count(*) FROM troe_entities WHERE entity_id LIKE 'urn:L%') + (SELECT count(*) FROM troe_attrs WHERE entity_id LIKE 'urn:L%')")
echo "recorded + lost rows: $((recorded + lost))"
grep -c "HISTORY LOST in db '$COR_TROE_DB': the database cannot be reached and the history held in memory is at its cap" /tmp/coraine.CB.log
grep -c "the history database '$COR_TROE_DB' is back after [0-9]* s - recording again. $lost row(s) of history were LOST meanwhile" /tmp/coraine.CB.log
echo
echo


echo "05. --troeSync, the database taken away: the request is answered, its history recorded once it is back"
echo "======================================================================================================"
coraineStop
coraineStart --troe timescale --troeSync --healthPort $HP
for _ in $(seq 1 50); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$HP/ready")" = 200 ] && break
  sleep 0.1
done
dbBlock
curl -s -m 20 -o /dev/null -w "%{http_code}\n" "http://localhost:$CB_PORT/ngsi-ld/v1/entities" -H 'Content-Type: application/json' -d '{"id":"urn:S1","type":"T","p":{"type":"Property","value":1}}'
recordingWait false
dbUnblock
historyWritten
$PSQL -c "SELECT (SELECT count(*) FROM troe_entities WHERE entity_id = 'urn:S1'), (SELECT count(*) FROM troe_attrs WHERE entity_id = 'urn:S1')"
coraineStop
echo
echo


echo "06. --troeDownExit 3, the database taken away: the broker exits, code 1"
echo "======================================================================="
XP=$((CB_PORT + 3))
XLOG=/tmp/troeDownExit.$$
$COR_BROKER --foreground --port $XP --database corDB --troe timescale --troeHost "$COR_TROE_HOST" --troePort "$COR_TROE_PORT" --troeName "$COR_TROE_DB" --troeWriters 1 --troeDownExit 3 > $XLOG 2>&1 &
xpid=$!
for _ in $(seq 1 100); do
  curl -s -o /dev/null "http://localhost:$XP/version" && break
  sleep 0.1
done
dbBlock
curl -s -o /dev/null -w "%{http_code}\n" "http://localhost:$XP/ngsi-ld/v1/entities" -H 'Content-Type: application/json' -d '{"id":"urn:X1","type":"T","p":{"type":"Property","value":1}}'
( sleep 30; kill -9 $xpid 2>/dev/null ) &
watchdog=$!
wait $xpid
echo "exit: $?"
kill $watchdog 2>/dev/null
grep -c "the history database '$COR_TROE_DB' has been unreachable for 3 s; --troeDownExit: the broker exits" $XLOG
rm -f $XLOG
dbUnblock
echo
echo


echo "07. A start while the database is down - it waits, the database back after 2 s, it serves"
echo "============================================================================================"
dbBlock
$COR_BROKER --foreground --port $XP --database corDB --troe timescale --troeHost "$COR_TROE_HOST" --troePort "$COR_TROE_PORT" --troeName "$COR_TROE_DB" --troeConnectTimeout 15 > $XLOG 2>&1 &
xpid=$!
sleep 2
echo "serving while down: $(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$XP/version")"
dbUnblock
for _ in $(seq 1 150); do
  curl -s -o /dev/null "http://localhost:$XP/version" && break
  sleep 0.1
done
curl -s -o /dev/null -w "%{http_code}\n" "http://localhost:$XP/ngsi-ld/v1/entities" -H 'Content-Type: application/json' -d '{"id":"urn:X7","type":"T","p":{"type":"Property","value":7}}'
kill $xpid
wait $xpid
echo "exit: $?"
$PSQL -c "SELECT (SELECT count(*) FROM troe_entities WHERE entity_id = 'urn:X7'), (SELECT count(*) FROM troe_attrs WHERE entity_id = 'urn:X7')"
grep -c "the history database cannot be reached - trying again once a second, for 15 s (--troeConnectTimeout)" $XLOG
rm -f $XLOG
echo
echo


echo "08. --troeConnectTimeout 2, the database still down - the start fails, code 1"
echo "======================================================================"
dbBlock
timeout 20 $COR_BROKER --foreground --port $XP --database corDB --troe timescale --troeHost "$COR_TROE_HOST" --troePort "$COR_TROE_PORT" --troeName "$COR_TROE_DB" --troeConnectTimeout 2 > $XLOG 2>&1
echo "exit: $?"
grep -c "failed to initialise the default-tenant database (2 s, --troeConnectTimeout)" $XLOG
rm -f $XLOG
dbUnblock
echo
echo


--EXPECT--
01. The history database taken away - five Entities created, the broker serving
================================================================================
      5 HTTP/1.1 201 Created
/ready: 200
status: degraded
recording: false, held: true, lost: 0
HTTP/1.1 200 OK


02. A temporal query is answered - it does not wait for the held history
========================================================================
500


03. The database back - the five recorded, nothing lost
=======================================================
recording: true, held: 0, lost: 0
status: ok
5|5
1
1


04. Taken away again - 200 Entities of 60 KiB each (12 MiB): every row recorded or counted lost
===============================================================================================
    200 HTTP/1.1 201 Created
lost: some
recorded + lost rows: 400
1
1


05. --troeSync, the database taken away: the request is answered, its history recorded once it is back
======================================================================================================
201
1|1


06. --troeDownExit 3, the database taken away: the broker exits, code 1
=======================================================================
201
exit: 1
1


07. A start while the database is down - it waits, the database back after 2 s, it serves
============================================================================================
serving while down: 000
201
exit: 0
1|1
1


08. --troeConnectTimeout 2, the database still down - the start fails, code 1
======================================================================
exit: 1
1


--TEARDOWN--
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U postgres -d postgres -tA -q -c "ALTER DATABASE \"$COR_TROE_DB\" ALLOW_CONNECTIONS true" > /dev/null 2>&1
coraineStop
corDbDrop
corTroeDrop
