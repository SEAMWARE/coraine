#
# FILE            query_entities_pick_advanced.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /ngsi-ld/v1/entities - Advanced pick/omit combinations

--TAGS--
entity query

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create Vehicle E1 with speed, color, temperature
# 02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted
# 03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs (just id/type)
# 04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering
# 05. omit multiple attrs: ?omit=speed,color - only temperature returned
# 06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged
# 07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)
#

echo "01. Create Vehicle E1 with speed, color, temperature"
echo "===================================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  },
  "temperature": {
    "type": "Property",
    "value": 25
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted"
echo "==============================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed,color'
echo
echo


echo "03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs"
echo "========================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=nonexistent'
echo
echo


echo "04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering"
echo "=============================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed,color'
echo
echo


echo "05. omit multiple attrs: ?omit=speed,color - only temperature returned"
echo "======================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&omit=speed,color'
echo
echo


echo "06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&omit=nonexistent'
echo
echo


echo "07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)"
echo "===================================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed,color&omit=speed'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed, color, temperature
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 147

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "speed": {
      "type": "Property",
      "value": 100
    }
  }
]



03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs
=========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering
==============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 147

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "speed": {
      "type": "Property",
      "value": 100
    }
  }
]



05. omit multiple attrs: ?omit=speed,color - only temperature returned
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 126

[
  {
    "id": "urn:e1",
    "temperature": {
      "type": "Property",
      "value": 25
    },
    "type": "Vehicle"
  }
]



06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged
============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 262

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "temperature": {
      "type": "Property",
      "value": 25
    },
    "type": "Vehicle"
  }
]



07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)
====================================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 212

{
  "detail": "'https://uri.etsi.org/ngsi-ld/default-context/speed' appears in both pick and omit",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
coraineStop
corDbDrop
