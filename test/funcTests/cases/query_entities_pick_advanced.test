#
# FILE            query_entities_pick_advanced.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /ngsi-ld/v1/entities - Advanced pick/omit combinations

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed, color, temperature
# 02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted
# 03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs (just id/type)
# 04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering
# 05. omit multiple attrs: ?omit=speed,color - only temperature returned
# 06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged
# 07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)
#

echo "01. Create Vehicle E1 with speed, color, temperature"
echo "===================================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  },
  "temperature": {
    "type": "Property",
    "value": 25
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?pick=speed,color'
echo
echo


echo "03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs"
echo "========================================================================="
swCurl --url '/ngsi-ld/v1/entities?pick=nonexistent'
echo
echo


echo "04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering"
echo "=============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed,color'
echo
echo


echo "05. omit multiple attrs: ?omit=speed,color - only temperature returned"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/entities?omit=speed,color'
echo
echo


echo "06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged"
echo "============================================================================"
swCurl --url '/ngsi-ld/v1/entities?omit=nonexistent'
echo
echo


echo "07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)"
echo "===================================================================================="
swCurl --url '/ngsi-ld/v1/entities?pick=speed,color&omit=speed'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed, color, temperature
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:e1
Content-Length: 0




02. pick multiple attrs: ?pick=speed,color - both returned, temperature omitted
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 190

[
  {
    "id": "urn:e1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "color": {
      "type": "Property",
      "value": "red"
    }
  }
]



03. pick non-existent attr: ?pick=nonexistent - entity with no user attrs
=========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 54

[
  {
    "id": "urn:e1",
    "type": "Vehicle"
  }
]



04. pick with type filter: ?type=Vehicle&pick=speed,color - combined filtering
==============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 190

[
  {
    "id": "urn:e1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "color": {
      "type": "Property",
      "value": "red"
    }
  }
]



05. omit multiple attrs: ?omit=speed,color - only temperature returned
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 126

[
  {
    "id": "urn:e1",
    "type": "Vehicle",
    "temperature": {
      "type": "Property",
      "value": 25
    }
  }
]



06. omit non-existent attr: ?omit=nonexistent - all attrs returned unchanged
============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 262

[
  {
    "id": "urn:e1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "color": {
      "type": "Property",
      "value": "red"
    },
    "temperature": {
      "type": "Property",
      "value": 25
    }
  }
]



07. pick+omit together: ?pick=speed,color&omit=speed - document behavior (pick wins)
====================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 123

[
  {
    "id": "urn:e1",
    "type": "Vehicle",
    "color": {
      "type": "Property",
      "value": "red"
    }
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
