#
# FILE            subscription_expiration.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription expiration — past expiresAt rejected, dynamic expiration

--TAGS--
expiration subscription

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# 01. Create subscription with expiresAt in the past — 400
# 02. Create subscription with expiresAt 2 seconds in the future
# 03. Create matching entity immediately — should trigger (not yet expired)
# 04. Dump ftClient — 1 notification
# 05. Retrieve subscription — status should be "active"
#

echo "01. Create subscription with expiresAt in the past — 400"
echo "=========================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:PastExpiry",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "expiresAt": "2020-01-01T00:00:00Z",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create subscription with expiresAt far in the future"
echo "=========================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:FutureExpiry",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "expiresAt": "2099-12-31T23:59:59Z",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "03. Create matching entity — should trigger"
echo "=============================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 120
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Dump ftClient — 1 notification"
echo "===================================="
ftClientDump
echo
echo


echo "05. Retrieve subscription — status should be active"
echo "====================================================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:FutureExpiry
echo
echo


--EXPECT--
01. Create subscription with expiresAt in the past — 400
==========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 168

{
  "detail": "'expiresAt' must be in the future",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. Create subscription with expiresAt far in the future
==========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:FutureExpiry
Content-Length: 0




03. Create matching entity — should trigger
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0




04. Dump ftClient — 1 notification
====================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:Vehicle:V1",
          "speed": {
            "type": "Property",
            "value": 120
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:FutureExpiry",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(swBroker/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


05. Retrieve subscription — status should be active
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "expiresAt": "REGEX(.*)",
  "id": "urn:ngsi-ld:Subscription:FutureExpiry",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    },
    "lastNotification": "REGEX(.*)",
    "lastSuccess": "REGEX(.*)",
    "status": "ok",
    "timesSent": 1
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "type": "Subscription"
}



--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
