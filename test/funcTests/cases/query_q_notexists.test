#
# FILE            query_q_notexists.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The unary not-exists q operator: q=!attr selects entities that do NOT have the
# attribute (the mirror of the existence check q=attr). It cannot be combined
# with a comparison.
#
--NAME--
q not-exists operator (q=!attr) on GET

--TAGS--
q query validation

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Seed E1 {P}, E2 {Q} (no P), E3 {P,R}"
echo "========================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T","P":{"type":"Property","value":1}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E2","type":"T","Q":{"type":"Property","value":1}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E3","type":"T","P":{"type":"Property","value":1},"R":{"type":"Property","value":1}}' | head -1
echo
echo


echo "02. q=!P — only E2 (the one without P)"
echo "======================================"
corCurl --url '/ngsi-ld/v1/entities?type=T&q=%21P'
echo
echo


echo "03. q=P — E1 and E3 (sanity, the ones with P)"
echo "============================================="
corCurl --url '/ngsi-ld/v1/entities?type=T&q=P'
echo
echo


echo "04. q=!R — E1 and E2 (the ones without R)"
echo "========================================="
corCurl --url '/ngsi-ld/v1/entities?type=T&q=%21R'
echo
echo


echo "05. q=!P==5 — not-exists cannot take a comparison — 400"
echo "======================================================"
corCurl --url '/ngsi-ld/v1/entities?type=T&q=%21P==5'
echo
echo


--EXPECT--
01. Seed E1 {P}, E2 {Q} (no P), E3 {P,R}
========================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. q=!P — only E2 (the one without P)
======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 117

[
  {
    "Q": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E2",
    "type": "T"
  }
]



03. q=P — E1 and E3 (sanity, the ones with P)
=============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 292

[
  {
    "P": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E1",
    "type": "T"
  },
  {
    "P": {
      "type": "Property",
      "value": 1
    },
    "R": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E3",
    "type": "T"
  }
]



04. q=!R — E1 and E2 (the ones without R)
=========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 231

[
  {
    "P": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E1",
    "type": "T"
  },
  {
    "Q": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E2",
    "type": "T"
  }
]



05. q=!P==5 — not-exists cannot take a comparison — 400
======================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 198

{
  "detail": "the '!' not-exists operator cannot be combined with a comparison",
  "status": 400,
  "title": "Invalid q parameter",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
coraineStop
