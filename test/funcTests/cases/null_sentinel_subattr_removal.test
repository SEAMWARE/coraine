#
# FILE            null_sentinel_subattr_removal.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.4.1 — in a Merge Entity / Partial Attribute Update fragment, an OPTIONAL
# sub-attribute (observedAt, unitCode, a user sub-Property/Relationship) whose
# value is the NGSI-LD Null "urn:ngsi-ld:null" is removed from the target ->
# 204. observedAt accepts the marker (not run through the DateTime check) and
# is removed rather than stored as epoch 0. A real observedAt still round-trips.
#
# REQUIRE_DB: mongoc
#
--NAME--
NGSI-LD Null removes an optional sub-attribute on merge/partial-update (§ 5.4.1)

--TAGS--
entity merge partial-update validation

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed AQ:1 — airQualityLevel with observedAt, unitCode and a sub-Relationship"
echo "================================================================================"
swCurl --url /ngsi-ld/v1/entities -X POST --header 'Content-Type: application/json' --payload '{"id":"urn:ngsi-ld:AQ:1","type":"AQ","airQualityLevel":{"type":"Property","value":3,"observedAt":"2020-01-01T00:00:00Z","unitCode":"C62","hasWeatherObserved":{"type":"Relationship","object":"urn:ngsi-ld:W:1"}}}' | head -1
echo
echo


echo "02. Partial update: observedAt = null -> 204, observedAt removed (NOT epoch 0)"
echo "=============================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1/attrs/airQualityLevel' -X PATCH --header 'Content-Type: application/json' --payload '{"type":"Property","value":4,"observedAt":"urn:ngsi-ld:null"}'
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1'
echo
echo


echo "03. Partial update: verbose sub-Relationship object = null -> 204, sub-attr removed"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1/attrs/airQualityLevel' -X PATCH --header 'Content-Type: application/json' --payload '{"type":"Property","value":5,"hasWeatherObserved":{"type":"Relationship","object":"urn:ngsi-ld:null"}}'
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1'
echo
echo


echo "04. Merge Entity: unitCode = null (bare marker) -> 204, unitCode removed"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1' -X PATCH --header 'Content-Type: application/json' --payload '{"airQualityLevel":{"type":"Property","value":6,"unitCode":"urn:ngsi-ld:null"}}'
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1'
echo
echo


echo "05. A real observedAt still round-trips as a DateTime (no regression)"
echo "===================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1/attrs/airQualityLevel' -X PATCH --header 'Content-Type: application/json' --payload '{"type":"Property","value":7,"observedAt":"2021-06-15T10:00:00Z"}'
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:AQ:1'
echo
echo


echo "06. Nulling a KEY inside a JsonProperty object removes the key, NOT the attribute"
echo "================================================================================="
swCurl --url /ngsi-ld/v1/entities -X POST --header 'Content-Type: application/json' --payload '{"id":"urn:ngsi-ld:J:1","type":"T","jp":{"type":"JsonProperty","json":{"type":"some-type","other":"y"}}}' | head -1
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:J:1' -X PATCH --header 'Content-Type: application/json' --payload '{"jp":{"type":"JsonProperty","json":{"other":"urn:ngsi-ld:null"}}}'
echo
swCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:J:1'
echo
echo


--EXPECT--
01. Seed AQ:1 — airQualityLevel with observedAt, unitCode and a sub-Relationship
================================================================================
HTTP/1.1 201 Created


02. Partial update: observedAt = null -> 204, observedAt removed (NOT epoch 0)
==============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 236

{
  "airQualityLevel": {
    "hasWeatherObserved": {
      "object": "urn:ngsi-ld:W:1",
      "type": "Relationship"
    },
    "type": "Property",
    "unitCode": "C62",
    "value": 4
  },
  "id": "urn:ngsi-ld:AQ:1",
  "type": "AQ"
}



03. Partial update: verbose sub-Relationship object = null -> 204, sub-attr removed
===================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 137

{
  "airQualityLevel": {
    "type": "Property",
    "unitCode": "C62",
    "value": 5
  },
  "id": "urn:ngsi-ld:AQ:1",
  "type": "AQ"
}



04. Merge Entity: unitCode = null (bare marker) -> 204, unitCode removed
=======================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 114

{
  "airQualityLevel": {
    "type": "Property",
    "value": 6
  },
  "id": "urn:ngsi-ld:AQ:1",
  "type": "AQ"
}



05. A real observedAt still round-trips as a DateTime (no regression)
====================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "airQualityLevel": {
    "observedAt": "2021-06-15T10:00:00Z",
    "type": "Property",
    "value": 7
  },
  "id": "urn:ngsi-ld:AQ:1",
  "type": "AQ"
}



06. Nulling a KEY inside a JsonProperty object removes the key, NOT the attribute
=================================================================================
HTTP/1.1 201 Created

HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 134

{
  "id": "urn:ngsi-ld:J:1",
  "jp": {
    "json": {
      "type": "some-type"
    },
    "type": "JsonProperty"
  },
  "type": "T"
}



--TEARDOWN--
swBrokerStop
swDbDrop
