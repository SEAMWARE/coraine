#
# FILE            query_entities_with_omit.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?omit= excludes specified attributes

--TAGS--
entity query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed and color
# 02. GET entities?omit=speed - speed omitted, color returned
#

echo "01. Create Vehicle E1 with speed and color"
echo "=========================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entities?omit=speed - speed omitted, color returned"
echo "==========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&omit=speed'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed and color
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. GET entities?omit=speed - speed omitted, color returned
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:e1",
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
