#
# FILE            troe_corDB_create.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE in corDB (--troe corDB): one instance per attribute of a created entity.
# The history is read back through the temporal API (§ 5.7.3).
#
# --troe corDB is the history inside the corDB store:
# REQUIRE_DB: corDB
#
--NAME--
TRoE corDB - a created entity has one instance per attribute

--TAGS--
troe create

--INIT--
corDbDrop
coraineStart --troe corDB

--RUN--

echo "01. POST entity urn:V1"
echo "======================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
echo

echo "02. GET /temporal/entities/urn:V1"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


--EXPECT--
01. POST entity urn:V1
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. GET /temporal/entities/urn:V1
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 42
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
corDbDrop
