--NAME--
PATCH /entities/{id} - format/lang/observedAt URL params

--TAGS--
entity patch url-param

--INIT--
corDbDrop
coraineStart

--RUN--

#
# Setup entity with three kinds of attribute:
#   - Relationship (owner → urn:alice)
#   - LanguageProperty (name → languageMap{en,fr})
#   - Property with observedAt sub-attribute (temp → 20 @ 2026-01-01)
#
# Simplified input is a DECLARED format, not a guessed one. § 10.2.9.3 lists "a flag
# indicating whether the JSON-LD document contains a simplified representation" among
# Merge Entity's input data, and the HTTP binding binds that flag to ?format=simplified
# (?options=keyValues being the deprecated spelling). Only under the flag does
# § 10.2.9.4 apply — "the type of any pre-existing Attribute in the target entity shall
# be preserved". Undeclared, the body is concise, and § 5.3.2.3 step 3 is unconditional:
# a JSON primitive is a Property, so it lands on a Relationship as a type change.
#
# 01. Create the entity
# 02. PATCH owner with simplified scalar "urn:bob" + format=simplified — Relationship type preserved, object updated
# 03. GET — verify owner.object == "urn:bob", type still Relationship
# 04. PATCH name with simplified string "Hola" and ?format=simplified&lang=es — only languageMap.es added/updated, en+fr preserved
# 05. GET — verify languageMap has en, fr, es
# 06. PATCH temp with simplified scalar 25 and ?observedAt=2026-06-01T12:00:00Z — observedAt sub-attr updated from URL param
# 07. GET with sysAttrs — verify temp.value=25 and temp.observedAt=2026-06-01...
# 08. PATCH temp with simplified scalar 30 and no observedAt URL param — observedAt should stay (not reset)
# 09. GET sysAttrs — temp.value=30, temp.observedAt still at 2026-06-01
# 10. Simplified PATCH on LanguageProperty with the flag but no lang URL param — 400 Missing lang
# 11. The SAME scalar onto the Relationship without the flag — 400 Attribute Type Change
# 12. options=keyValues is the deprecated spelling of the same flag — preserved again
# 13. GET — the two refusals left the Entity exactly as step 12 wrote it
#

echo "01. Create entity with Relationship, LanguageProperty, and Property with observedAt"
echo "==================================================================================="
payload='{
  "id": "urn:e1",
  "type": "E",
  "owner": {
    "type": "Relationship",
    "object": "urn:alice"
  },
  "name": {
    "type": "LanguageProperty",
    "languageMap": {
      "en": "Hello",
      "fr": "Bonjour"
    }
  },
  "temp": {
    "type": "Property",
    "value": 20,
    "observedAt": "2026-01-01T00:00:00Z"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. PATCH owner with simplified URI — Relationship type must be preserved"
echo "========================================================================="
corCurl -X PATCH --url '/ngsi-ld/v1/entities/urn:e1?format=simplified' --payload '{"owner":"urn:bob"}'
echo
echo


echo "03. GET — owner.object updated, type still Relationship"
echo "========================================================"
corCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


echo "04. PATCH name with lang=es — add Spanish entry, preserve en/fr"
echo "==============================================================="
corCurl -X PATCH --url '/ngsi-ld/v1/entities/urn:e1?format=simplified&lang=es' --payload '{"name":"Hola"}'
echo
echo


echo "05. GET — languageMap has en, fr, es"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


echo "06. PATCH temp with observedAt URL param — sub-attr updated from URL"
echo "===================================================================="
corCurl -X PATCH --url '/ngsi-ld/v1/entities/urn:e1?observedAt=2026-06-01T12:00:00Z' --payload '{"temp":25}'
echo
echo


echo "07. GET with sysAttrs — temp.value=25 and temp.observedAt=2026-06-01..."
echo "======================================================================="
corCurl --url '/ngsi-ld/v1/entities/urn:e1?options=sysAttrs'
echo
echo


echo "08. PATCH temp with no observedAt URL param — stored observedAt is preserved"
echo "============================================================================"
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:e1 --payload '{"temp":30}'
echo
echo


echo "09. GET sysAttrs — temp.value=30, observedAt still 2026-06-01..."
echo "================================================================"
corCurl --url '/ngsi-ld/v1/entities/urn:e1?options=sysAttrs'
echo
echo


echo "10. Simplified PATCH on LanguageProperty without lang URL param — 400"
echo "====================================================================="
corCurl -X PATCH --url '/ngsi-ld/v1/entities/urn:e1?format=simplified' --payload '{"name":"nope"}'
echo
echo


echo "11. The same scalar WITHOUT the flag — a concise body, so it is a Property"
echo "=========================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:e1 --payload '{"owner":"urn:carol"}'
echo
echo


echo "12. options=keyValues is the deprecated spelling of the same flag"
echo "================================================================="
corCurl -X PATCH --url '/ngsi-ld/v1/entities/urn:e1?options=keyValues' --payload '{"owner":"urn:dave"}'
echo
echo


echo "13. GET — neither refusal touched the Entity, and step 12 did"
echo "============================================================="
corCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


--EXPECT--
01. Create entity with Relationship, LanguageProperty, and Property with observedAt
===================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




02. PATCH owner with simplified URI — Relationship type must be preserved
=========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET — owner.object updated, type still Relationship
========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 324

{
  "id": "urn:e1",
  "name": {
    "languageMap": {
      "en": "Hello",
      "fr": "Bonjour"
    },
    "type": "LanguageProperty"
  },
  "owner": {
    "object": "urn:bob",
    "type": "Relationship"
  },
  "temp": {
    "observedAt": "2026-01-01T00:00:00Z",
    "type": "Property",
    "value": 20
  },
  "type": "E"
}



04. PATCH name with lang=es — add Spanish entry, preserve en/fr
===============================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET — languageMap has en, fr, es
====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 344

{
  "id": "urn:e1",
  "name": {
    "languageMap": {
      "en": "Hello",
      "es": "Hola",
      "fr": "Bonjour"
    },
    "type": "LanguageProperty"
  },
  "owner": {
    "object": "urn:bob",
    "type": "Relationship"
  },
  "temp": {
    "observedAt": "2026-01-01T00:00:00Z",
    "type": "Property",
    "value": 20
  },
  "type": "E"
}



06. PATCH temp with observedAt URL param — sub-attr updated from URL
====================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




07. GET with sysAttrs — temp.value=25 and temp.observedAt=2026-06-01...
=======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "createdAt": "REGEX(20[23]\d-.*Z)",
  "id": "urn:e1",
  "modifiedAt": "REGEX(20[23]\d-.*Z)",
  "name": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "languageMap": {
      "en": "Hello",
      "es": "Hola",
      "fr": "Bonjour"
    },
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "type": "LanguageProperty"
  },
  "owner": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "object": "urn:bob",
    "type": "Relationship"
  },
  "temp": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "observedAt": "2026-06-01T12:00:00Z",
    "type": "Property",
    "value": 25
  },
  "type": "E"
}



08. PATCH temp with no observedAt URL param — stored observedAt is preserved
============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




09. GET sysAttrs — temp.value=30, observedAt still 2026-06-01...
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "createdAt": "REGEX(20[23]\d-.*Z)",
  "id": "urn:e1",
  "modifiedAt": "REGEX(20[23]\d-.*Z)",
  "name": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "languageMap": {
      "en": "Hello",
      "es": "Hola",
      "fr": "Bonjour"
    },
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "type": "LanguageProperty"
  },
  "owner": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "object": "urn:bob",
    "type": "Relationship"
  },
  "temp": {
    "createdAt": "REGEX(20[23]\d-.*Z)",
    "modifiedAt": "REGEX(20[23]\d-.*Z)",
    "observedAt": "2026-06-01T12:00:00Z",
    "type": "Property",
    "value": 30
  },
  "type": "E"
}



10. Simplified PATCH on LanguageProperty without lang URL param — 400
=====================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 250

{
  "detail": "simplified value for LanguageProperty 'https://uri.etsi.org/ngsi-ld/default-context/name' requires the 'lang' URL parameter",
  "status": 400,
  "title": "Missing lang",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



11. The same scalar WITHOUT the flag — a concise body, so it is a Property
==========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 279

{
  "detail": "cannot change attribute 'https://uri.etsi.org/ngsi-ld/default-context/owner' type from 'Relationship' to 'Property' in a Merge Entity operation",
  "status": 400,
  "title": "Attribute Type Change",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



12. options=keyValues is the deprecated spelling of the same flag
=================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




13. GET — neither refusal touched the Entity, and step 12 did
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 345

{
  "id": "urn:e1",
  "name": {
    "languageMap": {
      "en": "Hello",
      "es": "Hola",
      "fr": "Bonjour"
    },
    "type": "LanguageProperty"
  },
  "owner": {
    "object": "urn:dave",
    "type": "Relationship"
  },
  "temp": {
    "observedAt": "2026-06-01T12:00:00Z",
    "type": "Property",
    "value": 30
  },
  "type": "E"
}



--TEARDOWN--
coraineStop
