#
# FILE            batch_upsert_replace_changes_type.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Ported from orion-ld ngsild_new_issue_1593. A batch upsert in REPLACE mode may
# change an existing entity's type. (Orion noted a mongoc driver limitation here;
# sw — also on mongoc — performs the replace cleanly.)
#
--NAME--
Batch upsert (replace) may change an existing entity's type

--TAGS--
batch upsert replace entity

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create urn:E1 of type T1 (P=1)
# 02. Batch upsert REPLACE urn:E1 as type T2 (P=2)
# 03. GET — entity is now type T2 with P=2
#

echo "01. Create urn:E1 of type T1"
echo "============================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T1","P":{"type":"Property","value":1}}'
echo
echo


echo "02. Batch upsert REPLACE urn:E1 as type T2"
echo "=========================================="
corCurl --url '/ngsi-ld/v1/entityOperations/upsert' --urlParams 'options=replace' -X POST --payload '[{"id":"urn:ngsi-ld:E1","type":"T2","P":{"type":"Property","value":2}}]'
echo
echo


echo "03. GET — now type T2, P=2"
echo "=========================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1
echo
echo


--EXPECT--
01. Create urn:E1 of type T1
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1
Content-Length: 0




02. Batch upsert REPLACE urn:E1 as type T2
==========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET — now type T2, P=2
==========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 98

{
  "P": {
    "type": "Property",
    "value": 2
  },
  "id": "urn:ngsi-ld:E1",
  "type": "T2"
}



--TEARDOWN--
coraineStop
corDbDrop
