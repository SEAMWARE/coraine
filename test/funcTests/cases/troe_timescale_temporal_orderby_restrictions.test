#
# FILE            troe_timescale_temporal_orderby_restrictions.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.4.4: GET /temporal/entities orderBy is restricted to:
#   - local scope only (?local=true)
#   - ordering by "id" only (no other entity members or attributes)
#
--NAME--
TRoE timescale - GET /temporal/entities orderBy restrictions (§ 5.7.4.4)

--TAGS--
troe timescale postgres temporal query orderby validation

--INIT--
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_orderby" >/dev/null 2>&1
psql -h localhost -p 5432 -U postgres -c "CREATE DATABASE sw_troe_orderby" >/dev/null
swBrokerStart --troe timescale --troeName sw_troe_orderby --troeUser postgres

--RUN--

echo "01. orderBy=id without local=true - 400"
echo "======================================="
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=id'
echo
echo


echo "02. orderBy=speed (non-id) with local=true - 400"
echo "================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=speed&local=true'
echo
echo


echo "03. orderBy=id with local=true - 200"
echo "===================================="
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=id&local=true'
echo
echo


--EXPECT--
01. orderBy=id without local=true - 400
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "orderBy on temporal queries requires 'local=true' (cannot order across federated sources)",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. orderBy=speed (non-id) with local=true - 400
================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "orderBy on temporal queries may only refer to 'id' (got 'https://uri.etsi.org/ngsi-ld/default-context/speed')",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. orderBy=id with local=true - 200
====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
swBrokerStop
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_orderby" >/dev/null 2>&1
