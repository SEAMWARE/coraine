#
# FILE            troe_timescale_temporal_orderby_restrictions.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.4.4 / § 4.23 — GET /temporal/entities accepts orderBy on any
# entity member (id, type, scope, attribute, attribute sub-property).
# Spec § 4.23: "Sort ordering is never applied to distributed
# operations" — for a single-broker setup with no peers the broker
# applies the order locally and returns 200.
#
--NAME--
TRoE timescale - GET /temporal/entities orderBy accepted on any member (§ 5.7.4.4 / § 4.23)

--TAGS--
troe timescale postgres temporal query orderby validation

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. orderBy=id (no local flag) -> 200"
echo "====================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=id'
echo
echo


echo "02. orderBy=speed (attribute name) -> 200"
echo "========================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=speed'
echo
echo


echo "03. orderBy=id with local=true -> 200"
echo "====================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=id&local=true'
echo
echo


echo "04. orderBy=name.createdAt (sub-property) -> 200"
echo "================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&orderBy=name.createdAt'
echo
echo


--EXPECT--
01. orderBy=id (no local flag) -> 200
=====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



02. orderBy=speed (attribute name) -> 200
=========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



03. orderBy=id with local=true -> 200
=====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



04. orderBy=name.createdAt (sub-property) -> 200
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
coraineStop
corDbDrop
corTroeDrop
