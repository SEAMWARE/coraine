#
--NAME--
PATCH /entities/{id} - attribute type change is forbidden (§ 5.6.4.4)

--TAGS--
entity patch

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with a Property named "owner"
# 02. PATCH attempting to change owner to a Relationship — 400 BadRequestData
# 03. GET — entity unchanged (owner still a Property)
#

echo "01. Create entity with Property 'owner'"
echo "======================================="
payload='{
  "id": "urn:e1",
  "type": "E",
  "owner": {
    "type": "Property",
    "value": "Alice"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. PATCH trying to flip owner to Relationship — 400"
echo "====================================================="
payload='{
  "owner": {
    "type": "Relationship",
    "object": "urn:alice"
  }
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:e1 --payload "$payload"
echo
echo


echo "03. GET — owner unchanged (still Property with value 'Alice')"
echo "============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


--EXPECT--
01. Create entity with Property 'owner'
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. PATCH trying to flip owner to Relationship — 400
=====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "cannot change attribute 'https://uri.etsi.org/ngsi-ld/default-context/owner' type from 'Property' to 'Relationship' in a Merge Entity operation",
  "title": "Attribute Type Change",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. GET — owner unchanged (still Property with value 'Alice')
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "owner": {
    "type": "Property",
    "value": "Alice"
  },
  "type": "E"
}



--TEARDOWN--
swBrokerStop
swDbDrop
