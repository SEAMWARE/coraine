#
# FILE            geojson_prefer_context_placement.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# GeoJSON @context placement is steered by the HTTP Prefer header
# (TS 104-176 § 6.3, RFC 7240):
#   - Prefer omitted OR "body=ld+json": @context is included in the response
#     payload body (the GeoJSON Feature).
#   - Prefer "body=json": @context is OMITTED from the body and served via the
#     Link header instead.
#
--NAME--
GeoJSON @context placement steered by the Prefer header (body=json vs body=ld+json)

--TAGS--
entity query geojson prefer context

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create City:1 with location + name"
echo "======================================"
payload='{ "id": "urn:ngsi-ld:City:1", "type": "City", "location": { "type": "GeoProperty", "value": { "type": "Point", "coordinates": [13.4, 52.5] } }, "name": { "type": "Property", "value": "Berlin" } }'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. geo+json, no Prefer → @context in body (default = body=ld+json)"
echo "=================================================================="
corCurl --out geojson --url '/ngsi-ld/v1/entities/urn:ngsi-ld:City:1'
echo
echo


echo "03. geo+json, Prefer: body=ld+json → @context in body"
echo "====================================================="
corCurl --out geojson --url '/ngsi-ld/v1/entities/urn:ngsi-ld:City:1' -H 'Prefer: body=ld+json'
echo
echo


echo "04. geo+json, Prefer: body=json → @context omitted from body, Link header instead"
echo "================================================================================="
corCurl --out geojson --url '/ngsi-ld/v1/entities/urn:ngsi-ld:City:1' -H 'Prefer: body=json'

--EXPECT--
01. Create City:1 with location + name
======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:1
Content-Length: 0




02. geo+json, no Prefer → @context in body (default = body=ld+json)
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/geo+json
Content-Length: 511

{
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "geometry": {
    "coordinates": [
      13.4,
      52.5
    ],
    "type": "Point"
  },
  "id": "urn:ngsi-ld:City:1",
  "properties": {
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          13.4,
          52.5
        ],
        "type": "Point"
      }
    },
    "name": {
      "type": "Property",
      "value": "Berlin"
    },
    "type": "City"
  },
  "type": "Feature"
}



03. geo+json, Prefer: body=ld+json → @context in body
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/geo+json
Content-Length: 511

{
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "geometry": {
    "coordinates": [
      13.4,
      52.5
    ],
    "type": "Point"
  },
  "id": "urn:ngsi-ld:City:1",
  "properties": {
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          13.4,
          52.5
        ],
        "type": "Point"
      }
    },
    "name": {
      "type": "Property",
      "value": "Berlin"
    },
    "type": "City"
  },
  "type": "Feature"
}



04. geo+json, Prefer: body=json → @context omitted from body, Link header instead
=================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/geo+json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 429

{
  "geometry": {
    "coordinates": [
      13.4,
      52.5
    ],
    "type": "Point"
  },
  "id": "urn:ngsi-ld:City:1",
  "properties": {
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          13.4,
          52.5
        ],
        "type": "Point"
      }
    },
    "name": {
      "type": "Property",
      "value": "Berlin"
    },
    "type": "City"
  },
  "type": "Feature"
}

--TEARDOWN--
coraineStop
