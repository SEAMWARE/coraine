#
# FILE            entity_batch_ldjson_missing_context.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 6.14.3.1 — A batch operation with Content-Type application/ld+json
# in which an element lacks @context produces a per-entity BadRequestData
# error in errors[] and a 207 Multi-Status response (NOT a global 400).
#
# Mixed batches (some elements with @context, some without) commit the
# valid ones and surface the invalid ones in errors[], yielding 207.
#
--NAME--
Batch ops: per-element missing @context with ld+json → 207 (§ 6.14.3.1)

--TAGS--
batch
context
error
ld-json

--INIT--
swDbDrop
swDbDrop -db swBroker
swBrokerStart

--RUN--

#
# 01. Batch CREATE all-missing-@context, ld+json    → 207, all errors[]
# 02. Batch UPSERT all-missing-@context, ld+json    → 207, all errors[]
# 03. Batch UPDATE all-missing-@context, ld+json    → 207, all errors[]
# 04. Batch MERGE  all-missing-@context, ld+json    → 207, all errors[]
# 05. Batch CREATE mixed (one good + one bad), ld+json → 207, success[V1] + errors[V2]
# 06. Batch CREATE app/json (no @context required)  → 201 ["urn:V3"]
#

echo "01. CREATE: all elements missing @context (ld+json) → 207"
echo "========================================================="
swCurl --in jsonld --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V1","type":"Vehicle"}
]'
echo
echo


echo "02. UPSERT: all elements missing @context (ld+json) → 207"
echo "========================================================="
swCurl --in jsonld --url /ngsi-ld/v1/entityOperations/upsert --payload '[
  {"id":"urn:V1","type":"Vehicle"}
]'
echo
echo


echo "03. UPDATE: all elements missing @context (ld+json) → 207"
echo "========================================================="
swCurl --in jsonld --url /ngsi-ld/v1/entityOperations/update --payload '[
  {"id":"urn:V1","type":"Vehicle"}
]'
echo
echo


echo "04. MERGE: all elements missing @context (ld+json) → 207"
echo "========================================================"
swCurl --in jsonld --url /ngsi-ld/v1/entityOperations/merge --payload '[
  {"id":"urn:V1","type":"Vehicle"}
]'
echo
echo


echo "05. CREATE mixed (V1 has @context, V2 missing) → 207 success+errors"
echo "==================================================================="
swCurl --in jsonld --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V1","type":"Vehicle","@context":"https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld"},
  {"id":"urn:V2","type":"Vehicle"}
]'
echo
echo


echo "06. CREATE app/json — no @context required → 201 array"
echo "======================================================="
swCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V3","type":"Vehicle"}
]'
echo
echo


--EXPECT--
01. CREATE: all elements missing @context (ld+json) → 207
=========================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "errors": [
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "@context is mandatory on every element of an application/ld+json array body",
        "title": "Missing @context",
        "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
      }
    }
  ],
  "success": []
}



02. UPSERT: all elements missing @context (ld+json) → 207
=========================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "errors": [
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "@context is mandatory on every element of an application/ld+json array body",
        "title": "Missing @context",
        "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
      }
    }
  ],
  "success": []
}



