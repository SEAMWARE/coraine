#
# FILE            expanded_core_terms_input.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A core-context term may arrive in EITHER spelling. After JSON-LD expansion
# "observedAt" and "https://uri.etsi.org/ngsi-ld/observedAt" are the same thing,
# and TS 104-175 § 4.3.4.2 only ALLOWS the short form ("NGSI-LD API operations
# allow clients to use short-hand strings as non-qualified names") - it does not
# mandate it, and nothing in the spec forbids the long one.
#
# coraine keeps core terms SHORT internally (coreContextRewriteToShort), so the
# long spelling has to land on the short name or the two diverge. It used to:
#
#   - observedAt / unitCode / datasetId sent expanded became ordinary user
#     Properties - the timestamp stopped being a timestamp
#   - an attribute "type" sent expanded produced TWO "type" members in one
#     object, i.e. INVALID JSON on the wire
#   - hasValue / hasObject sent expanded were not recognised as value keys, so
#     the attribute was refused for having none
#
# Recognition is a reverse lookup in a snapshot of the core context's expanded
# IRIs, taken at init before the rewrite (corLdCoreItemByIri).
#
# ⚠️ Steps 08-09 are the REGRESSION GUARD. An earlier attempt at this used a
# prefix test on "https://uri.etsi.org/ngsi-ld/", which also matched the @vocab
# expansions and swallowed a misspelled geometry - "Poinxt" arriving as
# .../default-context/Poinxt was stored as junk instead of being rejected. The
# snapshot holds term DEFINITIONS only, so a @vocab expansion cannot match it.
#
--NAME--
Core terms sent in their expanded spelling are recognised (§ 4.3.4.2)

--TAGS--
entity validation create context expandValues

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. observedAt sent EXPANDED - is the timestamp, not a Property
# 02. unitCode sent EXPANDED
# 03. datasetId sent EXPANDED
# 04. attribute "type" sent EXPANDED - ONE type member, valid JSON
# 05. hasValue sent EXPANDED - is the value
# 06. hasObject sent EXPANDED - is the object
# 07. observedAt EXPANDED at SUB-attribute level
# 08. GUARD: a misspelled geometry as a @vocab IRI is still REJECTED
# 09. GUARD: a user attribute name as a @vocab IRI still round-trips
#

echo "01. observedAt sent expanded"
echo "============================"
payload='{
  "id": "urn:CT1",
  "type": "T",
  "P": {
    "type": "Property",
    "value": 1,
    "https://uri.etsi.org/ngsi-ld/observedAt": "2026-01-01T00:00:00Z"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT1
echo
echo


echo "02. unitCode sent expanded"
echo "=========================="
payload='{
  "id": "urn:CT2",
  "type": "T",
  "P": {
    "type": "Property",
    "value": 1,
    "https://uri.etsi.org/ngsi-ld/unitCode": "CEL"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT2
echo
echo


echo "03. datasetId sent expanded"
echo "==========================="
payload='{
  "id": "urn:CT3",
  "type": "T",
  "P": {
    "type": "Property",
    "value": 1,
    "https://uri.etsi.org/ngsi-ld/datasetId": "urn:ds1"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT3
echo
echo


echo "04. attribute type sent expanded - ONE type member"
echo "=================================================="
payload='{
  "id": "urn:CT4",
  "type": "T",
  "P": {
    "type": "https://uri.etsi.org/ngsi-ld/Property",
    "value": 1
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT4
echo
echo


echo "05. hasValue sent expanded"
echo "=========================="
payload='{
  "id": "urn:CT5",
  "type": "T",
  "P": {
    "type": "Property",
    "https://uri.etsi.org/ngsi-ld/hasValue": 42
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT5
echo
echo


echo "06. hasObject sent expanded"
echo "==========================="
payload='{
  "id": "urn:CT6",
  "type": "T",
  "R": {
    "type": "Relationship",
    "https://uri.etsi.org/ngsi-ld/hasObject": "urn:ngsi-ld:E:1"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT6
echo
echo


echo "07. observedAt expanded on a sub-attribute"
echo "=========================================="
payload='{
  "id": "urn:CT7",
  "type": "T",
  "P": {
    "type": "Property",
    "value": 1,
    "sub": {
      "type": "Property",
      "value": 2,
      "https://uri.etsi.org/ngsi-ld/observedAt": "2026-01-01T00:00:00Z"
    }
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT7
echo
echo


echo "08. GUARD - a misspelled geometry as a @vocab IRI is still rejected"
echo "=================================================================="
payload='{
  "id": "urn:CT8",
  "type": "T",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "https://uri.etsi.org/ngsi-ld/default-context/Poinxt",
      "coordinates": [ 1, 2 ]
    }
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "09. GUARD - a user attribute name as a @vocab IRI still round-trips"
echo "==================================================================="
payload='{
  "id": "urn:CT9",
  "type": "T",
  "https://uri.etsi.org/ngsi-ld/default-context/myAttr": {
    "type": "Property",
    "value": 1
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
corCurl --url /ngsi-ld/v1/entities/urn:CT9
echo
echo


--EXPECT--
01. observedAt sent expanded
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:CT1
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 132

{
  "P": {
    "observedAt": "2026-01-01T00:00:00Z",
    "type": "Property",
    "value": 1
  },
  "id": "urn:CT1",
  "type": "T"
}



