#
# FILE            troe_ramdb_full_lifecycle.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE: full single-entity lifecycle event capture.
#   POST entity            → entityCreated
#   PATCH /entities/{id}   → attrCreated (added 'color')
#                          + attrModified (changed 'speed')
#   PUT   /attrs/speed     → attrReplaced
#   DELETE /attrs/color    → attrDeleted
#   DELETE entity          → entityDeleted
#
--NAME--
TRoE - full lifecycle: create / patch entity / put attr / delete attr / delete entity

--TAGS--
troe lifecycle

--INIT--
corDbDrop
coraineStart --troe ramdb --apiPlugins admin --troeSync

--RUN--

echo "01. POST entity urn:V1 with speed=42"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
echo
echo
echo


echo "02. PATCH /entities/urn:V1 — add color, change speed"
echo "===================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X PATCH --payload '{"speed":{"type":"Property","value":80},"color":{"type":"Property","value":"red"}}' | head -1
echo


echo "03. PUT /entities/urn:V1/attrs/speed — wholesale replace"
echo "========================================================"
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PUT --payload '{"type":"Property","value":120}' | head -1
echo


echo "04. DELETE /entities/urn:V1/attrs/color"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/color -X DELETE | head -1
echo


echo "05. DELETE /entities/urn:V1"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X DELETE | head -1
echo
echo


echo "06. GET /admin/troe/dump — six events in order"
echo "=============================================="
corCurl --url /admin/troe/dump | python3 -c "
import sys, json, re
hdr = ''
body = ''
for line in sys.stdin:
    if hdr == '' and line.strip() == '':
        hdr = 'done'
        continue
    if hdr == 'done':
        body += line
d = json.loads(body) if body.strip() else {}
events = d.get('events', [])
print('  count:', len(events))
for e in events:
    a = e.get('attrName', '')
    a = re.sub(r'https://uri\.etsi\.org/ngsi-ld/default-context/', '', a)
    print('  op=%s entityId=%s attrName=%s' % (e.get('op'), e.get('entityId'), a))
"
echo
echo


--EXPECT--
01. POST entity urn:V1 with speed=42
====================================



02. PATCH /entities/urn:V1 — add color, change speed
====================================================
HTTP/1.1 204 No Content

03. PUT /entities/urn:V1/attrs/speed — wholesale replace
========================================================
HTTP/1.1 204 No Content

04. DELETE /entities/urn:V1/attrs/color
=======================================
HTTP/1.1 204 No Content

05. DELETE /entities/urn:V1
===========================
HTTP/1.1 204 No Content


06. GET /admin/troe/dump — six events in order
==============================================
  count: 6
  op=entityCreated entityId=urn:V1 attrName=
  op=attrModified entityId=urn:V1 attrName=speed
  op=attrCreated entityId=urn:V1 attrName=color
  op=attrReplaced entityId=urn:V1 attrName=speed
  op=attrDeleted entityId=urn:V1 attrName=color
  op=entityDeleted entityId=urn:V1 attrName=


--TEARDOWN--
coraineStop
corDbDrop
