#
# FILE            name_content_validation.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TS 104-175 § 5.2.2.3 (was CIM 009 § 4.6.2) — names (Type / Property /
# Relationship) shall match the unicodeLetter (unicodeLetter | unicodeNumber |
# "_")* grammar, with an optional "prefix:name" form.
#
# ⚠️ The VALUE half of this test is gone, and steps 07-12 now assert the
# opposite of what they used to.
#
# § 5.2.2.5 "Supported content" lists < > " ' = ; ( ) as a hazard in the
# content of VALUES and says implementations "should decide how to resolve" it -
# while requiring, in the same paragraph, that they "shall preserve the
# representation of the content of the values ... and return the original
# content". Refusing with BadRequestData is one permitted resolution and we took
# it. The cost: `Beany's Animal Collar` was not storable, and 81 rows of the
# FIWARE tutorials' own seed data would not load.
#
# KZ 2026-09-18: the restrictions belong on NAMES. The name grammar excludes
# every one of those characters by construction, so nothing is lost there, and
# injection safety never depended on the value scan - every place a value can
# become query TEXT escapes it at that boundary (jsonStrEscape for the mongoc
# $expr JSON, mongocEscapeDotsInKey for field names, PQexecParams for timescale
# writes, escapeSqlLit for the TRoE q-to-SQL). Nothing is stored escaped.
#
# So steps 07-12 are now the § 5.2.2.5 round-trip proof: all eight characters,
# in a string, in an array element, in a sub-attribute, byte-identical out.
#
--NAME--
Name regex (§ 4.6.2) + content sanitizer (§ 4.6.4) on entity payloads

--TAGS--
entity validation create

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Valid name + clean value
# 02. Type starts with digit                  → 400 Invalid Attribute Name
# 03. Attribute name contains '!'             → 400 Invalid Attribute Name
# 04. Attribute name has consecutive colons   → 201 (URI-style identifiers tolerated)
# 05. Sub-attribute name with space           → 400 Invalid Attribute Name
# 06. prefix:name form (valid)
# 07. All eight characters in one string value - 201, byte-identical
# 08. The tutorials' own case: "Beany's Animal Collar"
# 09. A quote and a semicolon - 201
# 10. Property numeric value
# 11. All eight inside an array element - 201, byte-identical
# 12. All eight inside a sub-attribute - 201, byte-identical
# 13. A SQL-injection shaped value round-trips and matches on q
#

echo "01. Valid name + clean value"
echo "============================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
echo


echo "02. Type starts with digit"
echo "=========================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e2","type":"3Vehicle","speed":{"type":"Property","value":42}}'
echo
echo


echo "03. Attribute name contains '!'"
echo "==============================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e3","type":"V","spe!ed":{"type":"Property","value":42}}'
echo
echo


echo "04. Attribute name has consecutive colons (URI-style, tolerated)"
echo "================================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e4","type":"V","a::b":{"type":"Property","value":42}}'
echo
echo


echo "04b. Multi-colon URN-style attribute name (valid)"
echo "================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e4b","type":"V","urn:attributes:speed":{"type":"Property","value":42}}'
echo
echo


echo "05. Sub-attribute name with space"
echo "================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e5","type":"V","speed":{"type":"Property","value":42,"bad name":{"type":"Property","value":1}}}'
echo
echo


echo "06. prefix:name form (valid)"
echo "============================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e6","type":"V","ngsi:speed":{"type":"Property","value":42}}'
echo
echo


echo "07. All eight forbidden characters in one string value"
echo "======================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e7","type":"V","label":{"type":"Property","value":"a<b>c\"d'"'"'e=f;g(h)i"}}'
corCurl --url /ngsi-ld/v1/entities/urn:e7
echo
echo


echo "08. The tutorials' own case - an English possessive"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e8","type":"V","label":{"type":"Property","value":"Beany'"'"'s Animal Collar"}}'
corCurl --url /ngsi-ld/v1/entities/urn:e8
echo
echo


echo "09. A quote and a semicolon"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e9","type":"V","label":{"type":"Property","value":"DROP TABLE; --"}}'
corCurl --url /ngsi-ld/v1/entities/urn:e9
echo
echo


echo "10. Numeric value (sanitizer only checks strings)"
echo "================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e10","type":"V","speed":{"type":"Property","value":99}}'
echo
echo


echo "11. All eight inside an array element"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e11","type":"V","tags":{"type":"Property","value":["ok","a<b>c\"d'"'"'e=f;g(h)i"]}}'
corCurl --url /ngsi-ld/v1/entities/urn:e11
echo
echo


echo "12. All eight inside a sub-attribute value"
echo "=========================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e12","type":"V","speed":{"type":"Property","value":42,"note":{"type":"Property","value":"a<b>c\"d'"'"'e=f;g(h)i"}}}'
corCurl --url /ngsi-ld/v1/entities/urn:e12
echo
echo


echo "13. An injection-shaped value round-trips AND is matchable by q"
echo "=============================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:e13","type":"V","label":{"type":"Property","value":"x'"'"'; DROP TABLE troe_attrs; --"}}'
corCurl --url /ngsi-ld/v1/entities/urn:e13
corCurl --url '/ngsi-ld/v1/entities?type=V&q=label==%22x%27;%20DROP%20TABLE%20troe_attrs;%20--%22'
echo
echo


--EXPECT--
01. Valid name + clean value
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




02. Type starts with digit
==========================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 198

{
  "detail": "attribute name '3Vehicle' must start with a letter (§ 4.6.2)",
  "status": 400,
  "title": "Invalid Attribute Name",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. Attribute name contains '!'
===============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 211

{
  "detail": "attribute name 'spe!ed' contains a forbidden character (0x21) — § 4.6.2",
  "status": 400,
  "title": "Invalid Attribute Name",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. Attribute name has consecutive colons (URI-style, tolerated)
================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e4
Content-Length: 0




04b. Multi-colon URN-style attribute name (valid)
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e4b
Content-Length: 0




05. Sub-attribute name with space
=================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 213

{
  "detail": "attribute name 'bad name' contains a forbidden character (0x20) — § 4.6.2",
  "status": 400,
  "title": "Invalid Attribute Name",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. prefix:name form (valid)
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e6
Content-Length: 0




07. All eight forbidden characters in one string value
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e7
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 112

{
  "id": "urn:e7",
  "label": {
    "type": "Property",
    "value": "a<b>c\"d'e=f;g(h)i"
  },
  "type": "V"
}



08. The tutorials' own case - an English possessive
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e8
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 115

{
  "id": "urn:e8",
  "label": {
    "type": "Property",
    "value": "Beany's Animal Collar"
  },
  "type": "V"
}



09. A quote and a semicolon
===========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e9
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 108

{
  "id": "urn:e9",
  "label": {
    "type": "Property",
    "value": "DROP TABLE; --"
  },
  "type": "V"
}



10. Numeric value (sanitizer only checks strings)
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e10
Content-Length: 0




11. All eight inside an array element
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e11
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 138

{
  "id": "urn:e11",
  "tags": {
    "type": "Property",
    "value": [
      "ok",
      "a<b>c\"d'e=f;g(h)i"
    ]
  },
  "type": "V"
}



12. All eight inside a sub-attribute value
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e12
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 178

{
  "id": "urn:e12",
  "speed": {
    "note": {
      "type": "Property",
      "value": "a<b>c\"d'e=f;g(h)i"
    },
    "type": "Property",
    "value": 42
  },
  "type": "V"
}



13. An injection-shaped value round-trips AND is matchable by q
==============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e13
Content-Length: 0


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 124

{
  "id": "urn:e13",
  "label": {
    "type": "Property",
    "value": "x'; DROP TABLE troe_attrs; --"
  },
  "type": "V"
}

HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 144

[
  {
    "id": "urn:e13",
    "label": {
      "type": "Property",
      "value": "x'; DROP TABLE troe_attrs; --"
    },
    "type": "V"
  }
]



--TEARDOWN--
coraineStop
corDbDrop
