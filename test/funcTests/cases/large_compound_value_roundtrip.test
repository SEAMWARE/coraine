#
# FILE            large_compound_value_roundtrip.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A very large compound attribute value is a historical crash case. Create an
# entity whose Property value is a large JSON array (~5000
# objects, ~250 KB) and confirm the broker accepts it, stays alive, and round-trips
# every element. Responses are filtered to status + element count to keep EXPECT small.
#
--NAME--
Very large compound attribute value is accepted, round-trips

--TAGS--
attr value-type entity

--INIT--
corDbDrop
coraineStart

--RUN--

# Build {id,type, buildings: Property whose value is an array of 5000 objects}
payload=$(python3 -c 'import json; print(json.dumps({"id":"urn:ngsi-ld:Mega:1","type":"M","buildings":{"type":"Property","value":[{"buildingNo":i,"x":i*2,"label":"b"+str(i)} for i in range(5000)]}}))')

#
# 01. Create the entity with the large compound value -> 201 (no crash)
# 02. GET the entity -> 200, broker alive, all 5000 elements present
# 03. Query all entities -> the entity is listed (count 1)
#

echo "01. Create entity with a large compound value"
echo "============================================="
out=$(corCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload")
echo "$out" | grep "^HTTP/"
echo
echo


echo "02. GET — broker alive, all 5000 array elements stored"
echo "======================================================"
out=$(corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Mega:1)
echo "$out" | grep "^HTTP/"
echo "buildingNo count: $(echo "$out" | grep -c '"buildingNo"')"
echo
echo


echo "03. Query all entities — one entity, broker alive"
echo "================================================="
out=$(corCurl --url '/ngsi-ld/v1/entities' --urlParams 'type=M&limit=1&count=true')
echo "$out" | grep -iE "^HTTP/|NGSILD-Results-Count"
echo
echo


--EXPECT--
01. Create entity with a large compound value
=============================================
HTTP/1.1 201 Created


02. GET — broker alive, all 5000 array elements stored
======================================================
HTTP/1.1 200 OK
buildingNo count: 5000


03. Query all entities — one entity, broker alive
=================================================
HTTP/1.1 200 OK
NGSILD-Results-Count: 1


--TEARDOWN--
coraineStop
corDbDrop
