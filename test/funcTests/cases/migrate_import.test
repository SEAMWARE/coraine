#
# FILE            migrate_import.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --importFile (doc/migration.md): a migration stream written into the stores the broker is started
# with, and read back through the API by the broker started on them.
#
# The stream is fixtures/migrate/orionld-stream.ndjson - what tools/migrate/orionldExport.py reads out
# of the made-up Orion-LD deployment of tools/migrate/test/orionldE2E.sh: entities of every attribute
# type, a multi-instance attribute, Sub-Attributes, a name with dots in it, two tenants, subscriptions
# with counters, a registration, and the history (a deleted entity's included). What has to come back
# is what the source had: the ids, every createdAt/modifiedAt (entity, attribute instance, Sub-
# Attribute, subscription, registration), the counters, the history's instanceIds.
#
# Then a stream whose names are NOT expanded, as an NGSIv2 source gives them: refused without the
# @context that defines them (--importContext), and with it every name the context does not define is
# an error - never left to the default @vocab.
#
# And an import into a store that already holds the data: everything refused, nothing overwritten.
#
# REQUIRE_DB: mongoc corDB
# REQUIRE_TROEDB: timescale
#
--NAME--
Migration import - a stream written into the stores, ids and system timestamps as they were

--TAGS--
migrate troe subscription registration

--INIT--
corDbDrop
corTroeInit
rm -rf /tmp/corTest-migrate
mkdir -p /tmp/corTest-migrate
cp "$REPO_ROOT"/test/funcTests/fixtures/migrate/* /tmp/corTest-migrate/

--RUN--

#
# 01. Import the stream - current state and history
# 02. Start the broker on the migrated stores
# 03. GET the entities of the default tenant, with their system attributes
# 04. GET the entities of tenant t1
# 05. GET the subscriptions - counters, createdAt, modifiedAt; S2 paused, with a geoQ
# 06. GET the subscription of tenant t1
# 07. GET the registration
# 08. GET the history of V1 - the source's instanceIds and times
# 09. GET the history of V9 - deleted, its history kept
# 10. GET the history of R1 in tenant t1
# 11. Import a stream whose names are not expanded, with no --importContext - all refused
# 12. Import it with --importContext - a name the context does not define is an error
# 13. GET R2 - its names expanded by the context, its times as they were
# 14. Import the first stream again - everything is there already: refused, nothing overwritten
#

D=/tmp/corTest-migrate

echo "01. Import the stream - current state and history"
echo "================================================="
coraineStart --troe timescale --importFile $D/orionld-stream.ndjson
echo "exit code: $?"
echo
echo


echo "02. Start the broker on the migrated stores"
echo "==========================================="
coraineStart --troe timescale
echo "started"
echo
echo


echo "03. GET the entities of the default tenant, with their system attributes"
echo "========================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle,https://example.org/Parking&options=sysAttrs'
echo
echo


echo "04. GET the entities of tenant t1"
echo "================================="
corCurl --url '/ngsi-ld/v1/entities?type=https://example.org/Room&options=sysAttrs' -H "NGSILD-Tenant: t1"
echo
echo


echo "05. GET the subscriptions - counters, createdAt, modifiedAt; S2 paused, with a geoQ"
echo "==================================================================================="
corCurl --url '/ngsi-ld/v1/subscriptions?options=sysAttrs'
echo
echo


echo "06. GET the subscription of tenant t1"
echo "====================================="
corCurl --url '/ngsi-ld/v1/subscriptions?options=sysAttrs' -H "NGSILD-Tenant: t1"
echo
echo


echo "07. GET the registration"
echo "========================"
corCurl --url '/ngsi-ld/v1/csourceRegistrations/urn:ngsi-ld:ContextSourceRegistration:R1?options=sysAttrs'
echo
echo


echo "08. GET the history of V1 - the source's instanceIds and times"
echo "=============================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?options=sysAttrs'
echo
echo


echo "09. GET the history of V9 - deleted, its history kept"
echo "====================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V9?options=sysAttrs'
echo
echo


echo "10. GET the history of R1 in tenant t1"
echo "======================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Room:R1?options=sysAttrs' -H "NGSILD-Tenant: t1"
echo
echo


echo "11. Import a stream whose names are not expanded, with no --importContext - all refused"
echo "======================================================================================="
coraineStart --troe timescale --importFile $D/unexpanded-stream.ndjson
echo "exit code: $?"
echo
echo


echo "12. Import it with --importContext - a name the context does not define is an error"
echo "==================================================================================="
coraineStart --troe timescale --importFile $D/unexpanded-stream.ndjson --importContext $D/unexpanded-context.jsonld
echo "exit code: $?"
echo
echo


echo "13. GET R2 - its names expanded by the context, its times as they were"
echo "======================================================================"
coraineStart --troe timescale
corCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:Room:R2?options=sysAttrs'
echo
echo


echo "14. Import the first stream again - everything is there already: refused, nothing overwritten"
echo "============================================================================================="
coraineStart --troe timescale --importFile $D/orionld-stream.ndjson
echo "exit code: $?"
echo
echo


--EXPECT--
01. Import the stream - current state and history
=================================================
