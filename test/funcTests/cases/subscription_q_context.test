#
# FILE            subscription_q_context.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription q-filter with different @contexts for create and GET

--TAGS--
context q subscription

--INIT--
corDbDrop
corDbDrop -db coraine
contextServerStart
coraineStart

#
# Context A: maps short names 'a' and 'b' to IRIs with problematic characters
# Context B: maps the same IRIs to different short names 'a2' and 'b2'
#
contextServerPush /jsonldContexts/ctxA '{
  "@context": {
    "a": "https://example.org/speed.max",
    "b": "https://example.org/temp-unit",
    "c": "https://example.org/cargo.volume"
  }
}'

contextServerPush /jsonldContexts/ctxB '{
  "@context": {
    "a2": "https://example.org/speed.max",
    "b2": "https://example.org/temp-unit"
  }
}'


--RUN--

#
# 01. Create subscription with q=a>5;b<10, using context A (a->speed.max, b->temp-unit)
# 02. GET subscription with context A — q should show a>5;b<10;c
# 03. GET subscription with context B — B has no alias for cargo.volume: a2>5;b2<10;<encoded IRI>
# 04. GET subscription without user context — q should show URL-encoded IRIs
#

echo "01. Create subscription with q=a>5;b<10;c using context A"
echo "========================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:Qctx",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "q": "a>5;b<10;c",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" \
  -H 'Link: <http://localhost:7080/jsonldContexts/ctxA>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "02. GET subscription with context A — q should show a>5;b<10;c"
echo "=============================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Qctx \
  -H 'Link: <http://localhost:7080/jsonldContexts/ctxA>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "03. GET subscription with context B — B has no alias for cargo.volume: a2>5;b2<10;<encoded IRI>"
echo "================================================================"
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Qctx \
  -H 'Link: <http://localhost:7080/jsonldContexts/ctxB>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "04. GET subscription without user context — q should show URL-encoded IRIs"
echo "==========================================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Qctx
echo
echo


--EXPECT--
01. Create subscription with q=a>5;b<10;c using context A
========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Qctx
Content-Length: 0




02. GET subscription with context A — q should show a>5;b<10;c
==============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <http://localhost:7080/jsonldContexts/ctxA>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 406

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:Qctx",
  "jsonldContext": "http://localhost:7080/jsonldContexts/ctxA",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "q": "a>5;b<10;c",
  "status": "active",
  "type": "Subscription"
}



03. GET subscription with context B — B has no alias for cargo.volume: a2>5;b2<10;<encoded IRI>
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <http://localhost:7080/jsonldContexts/ctxB>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 443

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:Qctx",
  "jsonldContext": "http://localhost:7080/jsonldContexts/ctxA",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "q": "a2>5;b2<10;https://example%2Eorg/cargo%2Evolume",
  "status": "active",
  "type": "Subscription"
}



04. GET subscription without user context — q should show URL-encoded IRIs
===========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 503

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:Qctx",
  "jsonldContext": "http://localhost:7080/jsonldContexts/ctxA",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "q": "https://example%2Eorg/speed%2Emax>5;https://example%2Eorg/temp-unit<10;https://example%2Eorg/cargo%2Evolume",
  "status": "active",
  "type": "Subscription"
}



--TEARDOWN--
coraineStop
contextServerStop
