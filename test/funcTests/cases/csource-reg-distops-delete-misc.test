--NAME--
DistOps - deleteEntity: redirect, inclusive, ?local bypass, loop skip (real CP1)

--TAGS--
delete distops registration

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# Real CB + CP1 brokers — so the test sees both the SEND side on CB and
# the RECEIVE side on CP1 (CP1 actually processes the forwarded delete
# and we can query it afterward to verify).
#
# Covered:
#   01-05  redirect mode: CB forwards DELETE to CP1, CP1 really deletes it
#   06-10  inclusive mode: CB forwards + deletes local; both sides verified
#   11-14  ?local=true bypass: CSR exists but skipped, only local deleted
#   15     loop-skip: own Via alias → no forward, just 404 locally
#

# --- 01-05: redirect ---
echo "01. Seed CP1 with urn:V1"
echo "========================"
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
echo

echo "02. Register CB→CP1 redirect CSR for urn:V1 with deleteEntity op"
echo "================================================================"
payload='{
  "id": "urn:CSR:Redir",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "redirect",
  "operations": ["deleteEntity", "retrieveEntity"],
  "information": [{"entities":[{"id":"urn:V1","type":"Vehicle"}]}]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo

echo "03. DELETE urn:V1 on CB → forwarded to CP1 → 204"
echo "================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X DELETE
echo
echo

echo "04. GET urn:V1 on CP1 directly → 404 (really gone)"
echo "=================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo

echo "05. Second DELETE on CB → 404 (nothing anywhere)"
echo "================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X DELETE
echo
echo


# --- 06-10: inclusive (local + forward) ---
echo "06. Seed CP1 with urn:V2 AND local CB with urn:V2"
echo "================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
swCurl --url /ngsi-ld/v1/entities --urlParams 'local=true' --payload '{"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"red"}}'
echo
echo

echo "07. Register CB→CP1 inclusive CSR on urn:V2 with deleteEntity op"
echo "================================================================"
payload='{
  "id": "urn:CSR:Incl",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["deleteEntity", "retrieveEntity"],
  "information": [{"entities":[{"id":"urn:V2","type":"Vehicle"}]}]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo

echo "08. DELETE urn:V2 → local AND forward → 204"
echo "==========================================="
swCurl --url /ngsi-ld/v1/entities/urn:V2 -X DELETE
echo
echo

echo "09. GET urn:V2 on CB ?local=true → 404 (local gone)"
echo "==================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V2 --urlParams 'local=true'
echo
echo

echo "10. GET urn:V2 on CP1 → 404 (remote also gone)"
echo "=============================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V2
echo
echo


# --- 11-14: ?local=true bypass ---
echo "11. Seed CP1 with urn:V3, then register exclusive CSR on CB (pointing at CP1)"
echo "============================================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":1}}'
echo
payload='{
  "id": "urn:CSR:Bypass",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "operations": ["deleteEntity"],
  "information": [{"entities":[{"id":"urn:V3","type":"Vehicle"}]}]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo

echo "12. Seed CB's local urn:V3 too"
echo "=============================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'local=true' --payload '{"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"blue"}}'
echo
echo

echo "13. DELETE urn:V3 ?local=true → CSR skipped, only local deleted (204)"
echo "====================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V3 --urlParams 'local=true' -X DELETE
echo
echo

echo "14. GET urn:V3 on CP1 → still 200 (bypass did not forward)"
echo "=========================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V3
echo
echo


# --- 15: loop skip ---
echo "15. DELETE with own Via alias, no local entity, no CSR → 404"
echo "============================================================"
swCurl --url /ngsi-ld/v1/entities/urn:NeverExisted -X DELETE -H "Via: 1.1 swBroker:$CB_PORT"
echo
echo


