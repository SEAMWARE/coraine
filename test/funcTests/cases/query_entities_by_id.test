#
# FILE            query_entities_by_id.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?id= filters by entity id

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed and color
# 02. Create Building E2 with height
# 03. GET entities?id=urn:e1 - only E1 returned
#

echo "01. Create Vehicle E1 with speed and color"
echo "============================================"
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create Building E2 with height"
echo "===================================="
payload='{
  "id": "urn:e2",
  "type": "Building",
  "height": {
    "type": "Property",
    "value": 50
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. GET entities?id=urn:e1 - only E1 returned"
echo "==============================================="
swCurl --url '/ngsi-ld/v1/entities?id=urn:e1'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed and color
============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create Building E2 with height
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:e2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. GET entities?id=urn:e1 - only E1 returned
===============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
