#
# FILE            attr_single_element_array_reduction.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# An attribute value supplied as a single-element JSON array is reduced to that
# single element (the outer one-element array is unwrapped) — in both the
# simplified input form (A1: [1]) and the value-object form (A2: {value: [2]}).
# A multi-element array value is a legitimate JSON value and is kept as-is.
#
--NAME--
Attribute value — single-element array reduced to the element, multi-element kept

--TAGS--
entity attr create format

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create E1 with single-element (A1/A2/A3) and multi-element (A4) array values
# 02. GET E1 normalized — A1/A2/A3 reduced to a scalar; A4 stays an array
#

echo "01. Create E1 with single- and multi-element array attribute values"
echo "==================================================================="
payload='{
  "id": "urn:ngsi-ld:E1",
  "type": "T",
  "A1": [1],
  "A2": {"value": [2]},
  "A3": {"type": "Property", "value": ["x"]},
  "A4": {"type": "Property", "value": [1, 2]}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET E1 normalized — A1/A2/A3 reduced, A4 kept as array"
echo "=========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1
echo
echo


--EXPECT--
01. Create E1 with single- and multi-element array attribute values
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1
Content-Length: 0




02. GET E1 normalized — A1/A2/A3 reduced, A4 kept as array
==========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 285

{
  "A1": {
    "type": "Property",
    "value": 1
  },
  "A2": {
    "type": "Property",
    "value": 2
  },
  "A3": {
    "type": "Property",
    "value": "x"
  },
  "A4": {
    "type": "Property",
    "value": [
      1,
      2
    ]
  },
  "id": "urn:ngsi-ld:E1",
  "type": "T"
}



--TEARDOWN--
coraineStop
