#
# FILE            query_q_datetime_valued_property.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A Property whose VALUE is a DateTime keeps its normative JSON-LD shape:
#
#   "d": { "type": "Property", "value": { "@type": "DateTime", "@value": "..." } }
#
# so the value under "d" is an OBJECT. q therefore cannot order it directly —
# "q=d>2026-05-01T00:00:00Z" matches nothing, and that is correct, not a gap.
# Until user-defined TemporalProperty arrives (agreed in ETSI TC DATA, awaiting
# a future version of the API spec), what the query language offers for such an
# attribute is the § 4.9 value-component path "d[@value]", compared as a STRING.
#
# The RHS has to be QUOTED: an unquoted ISO literal parses as a DateTime and is
# then compared against a string member, which matches nothing. Quoted, the
# comparison is lexicographic — which for Z-normalized ISO 8601 is also
# chronological.
#
# Real temporal ordering is what "attr.observedAt" is for (covered elsewhere).
#
--NAME--
q on a DateTime-valued Property - d[@value] as a quoted string comparison

--TAGS--
q query datetime timeproperty value-type

--INIT--
swDbDrop
swBrokerStart

--RUN--

payload='{ "id": "urn:E1", "type": "T", "d": { "type": "Property", "value": { "@type": "DateTime", "@value": "2026-01-01T00:00:00Z" } } }'
echo "01. Seed urn:E1 (d = 2026-01-01)"
echo "================================"
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


payload='{ "id": "urn:E2", "type": "T", "d": { "type": "Property", "value": { "@type": "DateTime", "@value": "2026-09-01T00:00:00Z" } } }'
echo "02. Seed urn:E2 (d = 2026-09-01)"
echo "================================"
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. q=d>2026-05-01T00:00:00Z — the value is an object, so nothing matches"
echo "========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d>2026-05-01T00:00:00Z&format=simplified'
echo
echo


echo "04. q=d[@value]>2026-05-01T00:00:00Z — unquoted parses as a DateTime, still nothing"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d%5B@value%5D>2026-05-01T00:00:00Z&format=simplified'
echo
echo


echo "05. q=d[@value]>\"2026-05-01T00:00:00Z\" — quoted: string compare, selects urn:E2"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d%5B@value%5D>%222026-05-01T00:00:00Z%22&format=simplified'
echo
echo


echo "06. q=d[@value]<\"2026-05-01T00:00:00Z\" — the complement, selects urn:E1"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d%5B@value%5D<%222026-05-01T00:00:00Z%22&format=simplified'
echo
echo


echo "07. q=d[@value]==\"2026-09-01T00:00:00Z\" — equality selects urn:E2"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d%5B@value%5D==%222026-09-01T00:00:00Z%22&format=simplified'
echo
echo


echo "08. q=d[@type]==\"DateTime\" — the type member is reachable too, both match"
echo "=========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&q=d%5B@type%5D==%22DateTime%22&format=simplified'
echo
echo


--EXPECT--
01. Seed urn:E1 (d = 2026-01-01)
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1
Content-Length: 0




02. Seed urn:E2 (d = 2026-09-01)
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2
Content-Length: 0




03. q=d>2026-05-01T00:00:00Z — the value is an object, so nothing matches
=========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



04. q=d[@value]>2026-05-01T00:00:00Z — unquoted parses as a DateTime, still nothing
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



05. q=d[@value]>"2026-05-01T00:00:00Z" — quoted: string compare, selects urn:E2
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 132

[
  {
    "d": {
      "@type": "DateTime",
      "@value": "2026-09-01T00:00:00Z"
    },
    "id": "urn:E2",
    "type": "T"
  }
]



06. q=d[@value]<"2026-05-01T00:00:00Z" — the complement, selects urn:E1
=======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 132

[
  {
    "d": {
      "@type": "DateTime",
      "@value": "2026-01-01T00:00:00Z"
    },
    "id": "urn:E1",
    "type": "T"
  }
]



07. q=d[@value]=="2026-09-01T00:00:00Z" — equality selects urn:E2
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 132

[
  {
    "d": {
      "@type": "DateTime",
      "@value": "2026-09-01T00:00:00Z"
    },
    "id": "urn:E2",
    "type": "T"
  }
]



08. q=d[@type]=="DateTime" — the type member is reachable too, both match
==========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 261

[
  {
    "d": {
      "@type": "DateTime",
      "@value": "2026-01-01T00:00:00Z"
    },
    "id": "urn:E1",
    "type": "T"
  },
  {
    "d": {
      "@type": "DateTime",
      "@value": "2026-09-01T00:00:00Z"
    },
    "id": "urn:E2",
    "type": "T"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
