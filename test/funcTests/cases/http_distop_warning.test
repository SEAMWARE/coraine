#
# FILE            http_distop_warning.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
DistOps GET § 6.3.5 — abnormal source → 200 + NGSILD-Warning (299/199/111)

--TAGS--
distops error registration query warning

--INIT--
swDbDrop
swBrokerStart -dist
ftClientStart --port 7711 --status 403
ftClientStart --port 7712 --status 500
ftClientStart --port 7713 --status 200
ftClientStart --port 7714 --status 200 --delay 2000
ftClientStart --port 7715 --status 200

--RUN--

#
# § 6.3.5: an NGSILD-Warning header signals abnormal behaviour on a distributed
# HTTP GET/HEAD over /entities and /entities/{id}. The failing source's data is
# simply absent from the merged (still-2xx) response; the warning is how the
# client learns a source misbehaved. The § 6.3.5 warning codes:
#
#   299 - Miscellaneous Persistent Warning — an HTTP error status (e.g. 403)
#         was received from the endpoint.
#   199 - Miscellaneous Warning            — no response was received within the
#         timeout period.
#   111 - Revalidation Failed              — a response arrived in time but its
#         payload was invalid / non-NGSI-LD.
#   (110 - Response is Stale is a GET-cache signal; no such cache here.)
#
# ftClient mocks: 7711→403, 7712→500 (error statuses → 299),
#                 7713→200 (healthy → no warning),
#                 7714→200 but 2s slow, management.timeout 200ms → times out (199),
#                 7715→200 with an invalid (non-JSON) payload → 111.
#

echo "01. Seed a local Vehicle"
echo "========================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":80}}'
echo
echo


echo "02. Register inclusive CSR → healthy source (7713)"
echo "=================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Ok","type":"ContextSourceRegistration","endpoint":"http://localhost:7713","mode":"inclusive","operations":["retrieveEntity","queryEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "03. GET list with only a healthy source → 200, NO NGSILD-Warning"
echo "==============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "04. Register inclusive CSR → 403 source (7711)"
echo "=============================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Forbidden","type":"ContextSourceRegistration","endpoint":"http://localhost:7711","mode":"inclusive","operations":["retrieveEntity","queryEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "05. GET list → 200 + NGSILD-Warning 299 for the 403 source"
echo "=========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "06. GET single entity /entities/urn:V1 → 200 + NGSILD-Warning 299"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "07. Register inclusive CSR → 500 source (7712)"
echo "=============================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:ServerErr","type":"ContextSourceRegistration","endpoint":"http://localhost:7712","mode":"inclusive","operations":["retrieveEntity","queryEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "08. GET list → both error sources listed (comma-joined 299 warn-values)"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "09. Register inclusive CSR → slow source (7714), management.timeout 200ms"
echo "========================================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Slow","type":"ContextSourceRegistration","endpoint":"http://localhost:7714","mode":"inclusive","operations":["retrieveEntity","queryEntity"],"management":{"timeout":200},"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "10. GET list → slow source times out: NGSILD-Warning 199 for 7714 (§ 6.3.5)"
echo "==========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "11. Register inclusive CSR → invalid-payload source (7715)"
echo "=========================================================="
# Program 7715 to answer a forwarded GET /entities with HTTP 200 but a body that
# is NOT valid JSON — a non-NGSI-LD payload received within the timeout (§ 6.3.5
# warning code 111 - Revalidation Failed).
swCurl --port 7715 --url /mock/reply --payload '{"verb":"GET","path":"/entities","status":200,"raw":"this is not a valid NGSI-LD payload {["}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Invalid","type":"ContextSourceRegistration","endpoint":"http://localhost:7715","mode":"inclusive","operations":["retrieveEntity","queryEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "12. GET list → invalid-payload source → NGSILD-Warning 111 (§ 6.3.5)"
echo "===================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


echo "13. § 6.3.5: a 404 source is NOT abnormal → no NGSILD-Warning at all"
echo "===================================================================="
# Isolate the 404 case: drop the error/slow/invalid sources, leave only 7713 (→ 404).
swCurl -X DELETE --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:Forbidden > /dev/null
swCurl -X DELETE --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:ServerErr > /dev/null
swCurl -X DELETE --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:Slow > /dev/null
swCurl -X DELETE --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:Invalid > /dev/null
ftClientStop --port 7713
ftClientStart --port 7713 --status 404
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' 2>&1 | grep -iE '^(HTTP|NGSILD-Warning)'
echo
echo


--EXPECT--
01. Seed a local Vehicle
========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Register inclusive CSR → healthy source (7713)
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Ok
Content-Length: 0




03. GET list with only a healthy source → 200, NO NGSILD-Warning
===============================================================
HTTP/1.1 200 OK


04. Register inclusive CSR → 403 source (7711)
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Forbidden
Content-Length: 0




05. GET list → 200 + NGSILD-Warning 299 for the 403 source
==========================================================
HTTP/1.1 200 OK
NGSILD-Warning: 299 localhost:7711 "An error response was received from the registration endpoint"


06. GET single entity /entities/urn:V1 → 200 + NGSILD-Warning 299
=================================================================
HTTP/1.1 200 OK
NGSILD-Warning: 299 localhost:7711 "An error response was received from the registration endpoint"


07. Register inclusive CSR → 500 source (7712)
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:ServerErr
Content-Length: 0




08. GET list → both error sources listed (comma-joined 299 warn-values)
=======================================================================
HTTP/1.1 200 OK
NGSILD-Warning: 299 localhost:7711 "An error response was received from the registration endpoint", 299 localhost:7712 "An error response was received from the registration endpoint"


09. Register inclusive CSR → slow source (7714), management.timeout 200ms
=========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Slow
Content-Length: 0




10. GET list → slow source times out: NGSILD-Warning 199 for 7714 (§ 6.3.5)
===========================================================================
HTTP/1.1 200 OK
NGSILD-Warning: 299 localhost:7711 "An error response was received from the registration endpoint", 299 localhost:7712 "An error response was received from the registration endpoint", 199 localhost:7714 "No response was received from the registration endpoint within the timeout period"


11. Register inclusive CSR → invalid-payload source (7715)
==========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Length: 0


HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Invalid
Content-Length: 0




12. GET list → invalid-payload source → NGSILD-Warning 111 (§ 6.3.5)
====================================================================
HTTP/1.1 200 OK
NGSILD-Warning: 299 localhost:7711 "An error response was received from the registration endpoint", 299 localhost:7712 "An error response was received from the registration endpoint", 199 localhost:7714 "No response was received from the registration endpoint within the timeout period", 111 localhost:7715 "An invalid response payload was received from the registration endpoint"


13. § 6.3.5: a 404 source is NOT abnormal → no NGSILD-Warning at all
====================================================================
HTTP/1.1 200 OK


--TEARDOWN--
ftClientStop --port 7711
ftClientStop --port 7712
ftClientStop --port 7713
ftClientStop --port 7714
ftClientStop --port 7715
swBrokerStop
swDbDrop
