  "attributeName": "height",
  "attributeTypes": [
    "Property"
  ],
  "id": "https://uri.etsi.org/ngsi-ld/default-context/height",
  "type": "Attribute",
  "typeNames": [
    "Building",
    "Landmark"
  ]
}



06. mongoc cannot hold a GeoProperty and another type under one name - 409, both ways round
===========================================================================================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 402

{
  "attributeName": "https://uri.etsi.org/ngsi-ld/default-context/plot",
  "detail": "attribute 'https://uri.etsi.org/ngsi-ld/default-context/plot' is already in use with a conflicting Attribute type in this tenant (a GeoProperty and another type cannot share one Attribute name here)",
  "status": 409,
  "title": "Attribute Type Conflict",
  "type": "https://uri.etsi.org/ngsi-ld/errors/Conflict"
}


HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 404

{
  "attributeName": "https://uri.etsi.org/ngsi-ld/default-context/owner",
  "detail": "attribute 'https://uri.etsi.org/ngsi-ld/default-context/owner' is already in use with a conflicting Attribute type in this tenant (a GeoProperty and another type cannot share one Attribute name here)",
  "status": 409,
  "title": "Attribute Type Conflict",
  "type": "https://uri.etsi.org/ngsi-ld/errors/Conflict"
}



