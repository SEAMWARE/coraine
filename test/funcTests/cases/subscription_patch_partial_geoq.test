#
# FILE            subscription_patch_partial_geoq.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Update Subscription is the partial update of TS 104-175 § 8.4.2: each first-level member of the
# fragment replaces the stored one WHOLE - a "geoQ" in a PATCH is the new geoQ, not merged into the
# stored one (§ 8.4.3's merge "up to an arbitrary depth" is not this operation). A geoQ with only
# georel, or only coordinates, is therefore an incomplete geoQ: 400, and the stored one is kept. A
# complete geoQ replaces it. The fragment itself need not carry all of geometry/coordinates/georel -
# the complete result is what is validated - and any member it does carry is (an invalid georel: 400).
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Partial geoQ fragment merges on Update Subscription (not wrongly rejected)

--TAGS--
subscription geo validation

--INIT--
corDbDrop
coraineStart

--RUN--
EP='"notification":{"endpoint":{"uri":"http://localhost:9999/x"}}'

echo "01. Seed S1 with a complete geoQ -> 201"
echo "======================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload "{\"id\":\"urn:ngsi-ld:Subscription:S1\",\"type\":\"Subscription\",\"entities\":[{\"type\":\"T\"}],\"geoQ\":{\"geometry\":\"Point\",\"coordinates\":[1,2],\"georel\":\"near;maxDistance==1000\"},$EP}" | grep HTTP
echo
echo


echo "02. Seed S2 with NO geoQ -> 201"
echo "==============================="
corCurl --url /ngsi-ld/v1/subscriptions --payload "{\"id\":\"urn:ngsi-ld:Subscription:S2\",\"type\":\"Subscription\",\"entities\":[{\"type\":\"T\"}],$EP}" | grep HTTP
echo
echo


echo "03. PATCH S1 with a geoQ of only {georel:within} -> 400 (replaces geoQ whole: incomplete)"
echo "========================================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1 --payload '{"geoQ":{"georel":"within"}}' | grep HTTP
echo
echo


echo "04. GET S1 — the stored geoQ unchanged"
echo "======================================"
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "05. PATCH S1 with a complete geoQ (within a polygon) -> 204, it replaces the stored one"
echo "======================================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1 --payload '{"geoQ":{"geometry":"Polygon","coordinates":[[[0,0],[0,9],[9,9],[0,0]]],"georel":"within"}}' | grep HTTP
echo
echo


echo "06. PATCH S1 with a partial geoQ carrying an invalid georel -> 400"
echo "================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1 --payload '{"geoQ":{"georel":"bogusRel"}}'
echo
echo


echo "07. PATCH S2 (no stored geoQ) with a geoQ of only georel -> 400 (incomplete)"
echo "============================================================================"
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S2 --payload '{"geoQ":{"georel":"within"}}'
echo
echo


--EXPECT--
01. Seed S1 with a complete geoQ -> 201
=======================================
HTTP/1.1 201 Created


02. Seed S2 with NO geoQ -> 201
===============================
HTTP/1.1 201 Created


03. PATCH S1 with a geoQ of only {georel:within} -> 400 (replaces geoQ whole: incomplete)
=========================================================================================
HTTP/1.1 400 Bad Request


04. GET S1 — the stored geoQ unchanged
======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 521

{
  "entities": [
    {
      "type": "T"
    }
  ],
  "geoQ": {
    "coordinates": [
      1,
      2
    ],
    "geometry": "Point",
    "georel": "near;maxDistance==1000"
  },
  "id": "urn:ngsi-ld:Subscription:S1",
  "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:9999/x"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "type": "Subscription"
}



05. PATCH S1 with a complete geoQ (within a polygon) -> 204, it replaces the stored one
=======================================================================================
HTTP/1.1 204 No Content


06. PATCH S1 with a partial geoQ carrying an invalid georel -> 400
=================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 192

{
  "detail": "'geoQ.georel' is not a valid geo-relationship: 'bogusRel'",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. PATCH S2 (no stored geoQ) with a geoQ of only georel -> 400 (incomplete)
============================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 213

{
  "detail": "'geoQ' requires 'geometry', 'coordinates', and 'georel' — missing 'geometry'",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
coraineStop
