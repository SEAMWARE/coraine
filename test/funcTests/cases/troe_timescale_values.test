#
# FILE            troe_timescale_values.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE timescale value extraction: PATCH /attrs writes correct typed
# columns (v_text / v_number / v_bool / v_compound), attr_kind, and
# sub_attrs JSONB.
#
--NAME--
TRoE timescale - value extraction into typed columns

--TAGS--
troe timescale postgres

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. POST entity urn:V1 + PATCH each attr type"
echo "============================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
# number
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"speed":{"type":"Property","value":99,"unitCode":"km/h"}}' >/dev/null
# string Property
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"color":{"type":"Property","value":"red"}}' >/dev/null
# bool
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"running":{"type":"Property","value":true}}' >/dev/null
# Relationship → v_text
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"owner":{"type":"Relationship","object":"urn:Person:1"}}' >/dev/null
# GeoProperty → v_compound (GeoJSON object)
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[1.2,3.4]}}}' >/dev/null
sleep 0.2
echo "done"
echo
echo


echo "02. troe_attrs columns"
echo "======================"
psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -d "$COR_TROE_DB" -tA -F'|' \
  -c "SELECT regexp_replace(attr_name, '.*/', ''), attr_kind, v_text, v_number, v_bool, (v_compound IS NOT NULL), sub_attrs FROM troe_attrs WHERE op='modified' OR op='created' ORDER BY modified_at"
echo
echo


--EXPECT--
01. POST entity urn:V1 + PATCH each attr type
=============================================
done


02. troe_attrs columns
======================
speed|1||42||f|
speed|1||99||f|{"unitCode": "km/h"}
color|1|red|||f|
running|1|||t|f|
owner|2|urn:Person:1|||f|
location|3||||t|


--TEARDOWN--
coraineStop
corDbDrop
corTroeDrop
