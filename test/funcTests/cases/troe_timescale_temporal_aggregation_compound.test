#
# FILE            troe_timescale_temporal_aggregation_compound.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.5.19.1 — Aggregated Temporal Representation, compound and Relationship.
#
# Per spec table 4.5.19.1-1:
#   Array  → avg/sum/min/max apply to the array SIZES;
#            totalCount and distinctCount supported. stddev/sumsq are N/A.
#   Object → totalCount and distinctCount only. All numeric methods N/A.
#
# Per spec table 4.5.19.1-3:
#   Relationship → totalCount and distinctCount only, applied to the
#                  relationship's `object` URI. All numeric/lex methods
#                  are N/A — we silently drop them from the output.
#
--NAME--
TRoE timescale - aggregatedValues on Array, Object, and Relationship

--TAGS--
troe timescale postgres temporal aggregation

--INIT--
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_aggr3" >/dev/null 2>&1
psql -h localhost -p 5432 -U postgres -c "CREATE DATABASE sw_troe_aggr3" >/dev/null
swBrokerStart --troe timescale --troeName sw_troe_aggr3 --troeUser postgres

--RUN--

echo "01. Seed urn:V1 — Array Property (tags), Object Property (config), Relationship (driver)"
echo "========================================================================================"
payload='{
  "id":   "urn:V1",
  "type": "Vehicle",
  "tags":[
    {"type":"Property","value":["a"],            "observedAt":"2026-04-28T10:00:00Z"},
    {"type":"Property","value":["a","b"],        "observedAt":"2026-04-28T10:30:00Z"},
    {"type":"Property","value":["a","b","c"],    "observedAt":"2026-04-28T12:00:00Z"},
    {"type":"Property","value":["a","b","c","d"],"observedAt":"2026-04-28T12:30:00Z"}
  ],
  "config":[
    {"type":"Property","value":{"k":1},"observedAt":"2026-04-28T10:00:00Z"},
    {"type":"Property","value":{"k":1},"observedAt":"2026-04-28T10:30:00Z"},
    {"type":"Property","value":{"k":2},"observedAt":"2026-04-28T12:00:00Z"}
  ],
  "driver":[
    {"type":"Relationship","object":"urn:Alice","observedAt":"2026-04-28T10:00:00Z"},
    {"type":"Relationship","object":"urn:Alice","observedAt":"2026-04-28T10:30:00Z"},
    {"type":"Relationship","object":"urn:Bob",  "observedAt":"2026-04-28T12:00:00Z"}
  ]
}'
swCurl --url /ngsi-ld/v1/temporal/entities --payload "$payload"
echo
echo


echo "02. Array: avg/sum/min/max bucket per 2h — operates on array SIZES"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T10:00:00Z&endTimeAt=2026-04-28T14:00:00Z&format=aggregatedValues&aggrMethods=avg,sum,min,max,totalCount,distinctCount&aggrPeriodDuration=PT2H&pick=tags'
echo
echo


echo "03. Object: only totalCount + distinctCount survive (avg/min/max emit empty)"
echo "============================================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T10:00:00Z&endTimeAt=2026-04-28T14:00:00Z&format=aggregatedValues&aggrMethods=avg,min,max,totalCount,distinctCount&aggrPeriodDuration=PT2H&pick=config'
echo
echo


echo "04. Relationship: totalCount + distinctCount on object (numeric/lex methods skipped)"
echo "====================================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T10:00:00Z&endTimeAt=2026-04-28T14:00:00Z&format=aggregatedValues&aggrMethods=avg,min,max,totalCount,distinctCount&aggrPeriodDuration=PT2H&pick=driver'
echo
echo


--EXPECT--
01. Seed urn:V1 — Array Property (tags), Object Property (config), Relationship (driver)
========================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/temporal/entities/urn:V1
Content-Length: REGEX(\d+)




02. Array: avg/sum/min/max bucket per 2h — operates on array SIZES
==================================================================
HTTP/1.1 200 OK
