#
# FILE            tenant_implicit_create.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7.8.2: a tenant is created implicitly by an operation that creates an NGSI-LD object (Create
# Entity, Batch Entity Creation, Create or Update Temporal Evolution, Create Subscription, Register
# Context Source, Create Context Source Registration Subscription - plus the API's other creations).
# Any other operation on a tenant that does not exist is a 404 NonexistentTenant - and does not
# create it.
#
--NAME--
A tenant is created only by a creation - anything else on an unknown tenant is a 404 NonexistentTenant

--TAGS--
tenant troe

--INIT--
corDbDrop
for t in nx1 nx2 nx3; do corDbDrop -tenant $t; done
corTroeInit
coraineStart --troe timescale --troeSync

--RUN--

#
# 01. PATCH, DELETE, append, batch upsert, batch update, batch query on tenant nx1 - 404 NonexistentTenant each
# 02. GET /entities on nx1 - still 404: none of those created it
# 03. POST /entities on nx1 - 201, the tenant echoed; then the batch upsert - 201
# 04. POST /subscriptions on nx2, POST /temporal/entities on nx3 - 201, each tenant created
#

echo "01. PATCH, DELETE, append, batch upsert, batch update, batch query on tenant nx1 - 404 NonexistentTenant each"
echo "============================================================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs -X PATCH --payload '{"a":1}' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
corCurl --url /ngsi-ld/v1/entities/urn:E1 -X DELETE -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs --payload '{"a":1}' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
corCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[{"id":"urn:E1","type":"T","a":1}]' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
corCurl --url /ngsi-ld/v1/entityOperations/update --payload '[{"id":"urn:E1","type":"T","a":1}]' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
corCurl --url /ngsi-ld/v1/entityOperations/query --payload '{"type":"Query","entities":[{"type":"T"}]}' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
echo
echo


echo "02. GET /entities on nx1 - still 404: none of those created it"
echo "==============================================================="
corCurl --url '/ngsi-ld/v1/entities?type=T' -H "NGSILD-Tenant: nx1" | sed -n '1p;/"type"/p'
echo
echo


echo "03. POST /entities on nx1 - 201, the tenant echoed; then the batch upsert - 201"
echo "==============================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:E1","type":"T","a":1}' -H "NGSILD-Tenant: nx1" | sed -n '1p;/^NGSILD-Tenant/p'
corCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[{"id":"urn:E2","type":"T","a":1}]' -H "NGSILD-Tenant: nx1" | sed -n '1p'
echo
echo


echo "04. POST /subscriptions on nx2, POST /temporal/entities on nx3 - 201, each tenant created"
echo "========================================================================================"
corCurl --url /ngsi-ld/v1/subscriptions --payload '{"type":"Subscription","entities":[{"type":"T"}],"notification":{"endpoint":{"uri":"http://localhost:1234/n"}}}' -H "NGSILD-Tenant: nx2" | sed -n '1p;/^NGSILD-Tenant/p'
corCurl --url '/ngsi-ld/v1/entities?type=T' -H "NGSILD-Tenant: nx2" | sed -n '1p'
corCurl --url /ngsi-ld/v1/temporal/entities --payload '{"id":"urn:E3","type":"T","a":[{"type":"Property","value":1,"observedAt":"2026-10-06T12:00:00Z"}]}' -H "NGSILD-Tenant: nx3" | sed -n '1p;/^NGSILD-Tenant/p'
corCurl --url '/ngsi-ld/v1/entities?type=T' -H "NGSILD-Tenant: nx3" | sed -n '1p'
echo
echo


--EXPECT--
01. PATCH, DELETE, append, batch upsert, batch update, batch query on tenant nx1 - 404 NonexistentTenant each
============================================================================================================
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"


02. GET /entities on nx1 - still 404: none of those created it
===============================================================
HTTP/1.1 404 Not Found
  "type": "https://uri.etsi.org/ngsi-ld/errors/NonexistentTenant"


03. POST /entities on nx1 - 201, the tenant echoed; then the batch upsert - 201
===============================================================================
HTTP/1.1 201 Created
NGSILD-Tenant: nx1
HTTP/1.1 201 Created


04. POST /subscriptions on nx2, POST /temporal/entities on nx3 - 201, each tenant created
========================================================================================
HTTP/1.1 201 Created
NGSILD-Tenant: nx2
HTTP/1.1 200 OK
HTTP/1.1 201 Created
NGSILD-Tenant: nx3
HTTP/1.1 200 OK


--TEARDOWN--
coraineStop
corTroeDrop
for t in nx1 nx2 nx3; do corDbDrop -tenant $t; done
corDbDrop
