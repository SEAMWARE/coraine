#
# FILE            subscription_mqtt_user_password.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7.2 — MQTT notification with username/password authentication. Credentials
# are carried in the endpoint URI userinfo (mqtt://user:pass@host/topic); the
# broker passes them on the MQTT CONNECT (mosquitto_username_pw_set).
#
# Test rig: a private mosquitto on 11884 that REQUIRES auth (password_file,
# allow_anonymous false). The broker (publisher) and ftClient (subscriber) both
# authenticate as testuser; a wrong password is rejected by mosquitto, so a
# delivered notification proves the broker authenticated correctly.
#
--NAME--
Subscription MQTT notification — username/password authentication (§ 7.2)

--TAGS--
subscription notification mqtt

--INIT--
swDbDrop
mosquitto_passwd -b -c /tmp/mqtt-auth-pw testuser testpass 2>/dev/null
echo "listener 11884
allow_anonymous false
password_file /tmp/mqtt-auth-pw" > /tmp/mqtt-auth.conf
mosquitto -d -c /tmp/mqtt-auth.conf
sleep 0.3
ftClientStart --mqttPort 11884 --mqttTopic ngsild/notif --mqttUser testuser --mqttPassword testpass
swBrokerStart

--RUN--

echo "01. Subscribe with mqtt://testuser:testpass@localhost:11884/ngsild/notif"
echo "========================================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:mqtt-auth",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "mqtt://testuser:testpass@localhost:11884/ngsild/notif"}}
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | grep HTTP
echo
echo


echo "02. POST a Vehicle — broker authenticates + publishes"
echo "====================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99}}' | grep HTTP
echo
echo


echo "03. ftClient received one authenticated MQTT notification"
echo "========================================================="
sleep 0.6
ftClientDump | grep -cE '"verb": "MQTT"'
ftClientDump | grep -cE 'subscriptionId.*mqtt-auth'
ftClientDump | grep -cE 'urn:V1.*type.*Vehicle'
echo
echo


--EXPECT--
01. Subscribe with mqtt://testuser:testpass@localhost:11884/ngsild/notif
========================================================================
HTTP/1.1 201 Created


02. POST a Vehicle — broker authenticates + publishes
=====================================================
HTTP/1.1 201 Created


03. ftClient received one authenticated MQTT notification
=========================================================
1
1
1


--TEARDOWN--
swBrokerStop
ftClientStop
pkill -f "mosquitto -d -c /tmp/mqtt-auth.conf" 2>/dev/null
\rm -f /tmp/mqtt-auth.conf /tmp/mqtt-auth-pw
