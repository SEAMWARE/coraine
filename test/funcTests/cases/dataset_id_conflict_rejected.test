#
# FILE            dataset_id_conflict_rejected.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A single local-write payload whose multi-instance attribute carries
# conflicting instance identities is rejected (400). Per § 4.5.5, an
# attribute may have at most ONE default instance (no datasetId) and its
# datasetIds must be UNIQUE. The § 8.5.3 tiebreaker ("processing of
# conflicting Attributes") is for instances assembled from MULTIPLE
# registered Context Sources — not a single user payload, which must be
# well-formed. Orion-LD rejects the same way.
#
--NAME--
Multi-instance attribute with conflicting identities in one payload is rejected

--TAGS--
entity multi-attr datasetid validation

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Two default instances (neither has a datasetId) -> 400
# 02. Two instances with the same datasetId -> 400
# 03. One default + one dataset instance (distinct identities) -> 201
# 04. Two distinct datasetIds in one multi-attr -> 201, both kept
#

echo "01. Two default-instance speeds (no datasetId) -> 400"
echo "====================================================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": [
    {"type": "Property", "value": 10},
    {"type": "Property", "value": 99}
  ]
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Two same-datasetId speeds -> 400"
echo "===================================="
payload='{
  "id": "urn:V2",
  "type": "Vehicle",
  "speed": [
    {"type": "Property", "value": 10, "datasetId": "urn:dsA"},
    {"type": "Property", "value": 99, "datasetId": "urn:dsA"}
  ]
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. One default + one dataset instance -> 201"
echo "============================================="
payload='{
  "id": "urn:V3",
  "type": "Vehicle",
  "speed": [
    {"type": "Property", "value": 10},
    {"type": "Property", "value": 99, "datasetId": "urn:dsA"}
  ]
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" | head -1
echo
corCurl --url /ngsi-ld/v1/entities/urn:V3 | grep -E '"value"|datasetId' | sort
echo
echo


echo "04. Two distinct datasetIds -> 201, both kept"
echo "============================================="
payload='{
  "id": "urn:V4",
  "type": "Vehicle",
  "speed": [
    {"type": "Property", "value": 10, "datasetId": "urn:dsX"},
    {"type": "Property", "value": 99, "datasetId": "urn:dsY"}
  ]
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" | head -1
echo
corCurl --url /ngsi-ld/v1/entities/urn:V4 | grep -E '"value"|datasetId' | sort
echo
echo


--EXPECT--
01. Two default-instance speeds (no datasetId) -> 400
=====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 244

{
  "detail": "Attribute 'https://uri.etsi.org/ngsi-ld/default-context/speed': more than one instance without a datasetId",
  "status": 400,
  "title": "Invalid Multi-Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. Two same-datasetId speeds -> 400
====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 231

{
  "detail": "Attribute 'https://uri.etsi.org/ngsi-ld/default-context/speed': duplicate datasetId 'urn:dsA'",
  "status": 400,
  "title": "Invalid Multi-Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. One default + one dataset instance -> 201
=============================================
HTTP/1.1 201 Created

      "datasetId": "urn:dsA",
      "value": 10
      "value": 99


04. Two distinct datasetIds -> 201, both kept
=============================================
HTTP/1.1 201 Created

      "datasetId": "urn:dsX",
      "datasetId": "urn:dsY",
      "value": 10
      "value": 99


--TEARDOWN--
coraineStop
corDbDrop
