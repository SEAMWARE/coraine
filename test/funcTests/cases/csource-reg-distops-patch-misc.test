  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:V3",
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
