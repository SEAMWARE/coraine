Content-Type: application/json
Link: </ngsi-ld/v1/entities?type=T&orderBy=name&options=keyValues&limit=2&offset=2>;rel="next";type="application/json"
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 153

[
  {
    "id": "urn:ngsi-ld:T:n01",
    "name": "n01",
    "type": "T"
  },
  {
    "id": "urn:ngsi-ld:T:n02",
    "name": "n02",
    "type": "T"
  }
]



