#
# FILE            patch_partial_vs_merge_semantics.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 8.4.2 (partial update patch) vs § 8.4.3 (merge patch) — the three PATCH
# flavours differ in HOW DEEP they replace, and the difference is invisible
# unless the same fragment is applied through each of them:
#
#   PATCH /entities/{id}/attrs/{attr}  (§ 10.2.5 partial attribute update)
#       replaces the key-value pairs given → sibling sub-attributes SURVIVE
#   PATCH /entities/{id}/attrs          (§ 10.2.3 update attributes)
#       replaces the WHOLE Attribute     → sibling sub-attributes are GONE
#   PATCH /entities/{id}                (§ 10.2.9 merge entity)
#       merges to arbitrary depth        → goes INSIDE a JSON object value
#
# Steps 02 and 04 are the spec's § 8.4.2 EXAMPLE 1 and EXAMPLE 2 verbatim: the
# same fragment, the same starting Entity, and unitCode is the tell.
#
# Also pinned here, all of them normative and none of them previously covered:
#   - § 8.4.2 EXAMPLE 3   an NGSI-LD Null VALUE deletes the whole Attribute
#   - § 8.4.2 / § 8.4.3   `type` in an Entity Fragment is ADDITIVE
#   - § 8.4.3 EXAMPLE 2   merge descends into an object value (RFC 7396):
#                         one key updated, one removed by NGSI-LD Null, one kept
#   - § 8.4.2 / § 8.4.3   a fragment instance whose datasetId is NOT in the
#                         target is ADDED, never replacing another instance
#
--NAME--
PATCH semantics - partial-update vs merge, § 8.4.2 vs § 8.4.3

--TAGS--
entity patch merge partial-update multi-instance validation

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed urn:D1 - temperature 25 with unitCode CEL + observedAt"
echo "=============================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:D1",
  "type": "Device",
  "temperature": { "type": "Property", "value": 25, "unitCode": "CEL", "observedAt": "2022-03-14T01:59:26.535Z" },
  "other": { "type": "Property", "value": "untouched" }
}' | head -1
echo
echo


echo "02. § 8.4.2 EXAMPLE 1 - partial ATTRIBUTE update -> unitCode SURVIVES"
echo "===================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:D1/attrs/temperature -X PATCH --payload '{
  "type": "Property",
  "value": 100,
  "observedAt": "2022-03-14T13:00:00.000Z"
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:D1
echo
echo


echo "03. Put unitCode back"
echo "====================="
swCurl --url /ngsi-ld/v1/entities/urn:D1/attrs -X POST --urlParams 'options=overwrite' --payload '{
  "temperature": { "type": "Property", "value": 25, "unitCode": "CEL", "observedAt": "2022-03-14T01:59:26.535Z" }
}' | head -1
echo
echo


echo "04. § 8.4.2 EXAMPLE 2 - the SAME fragment as update-ATTRIBUTES -> unitCode GONE"
echo "=============================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:D1/attrs -X PATCH --payload '{
  "temperature": { "type": "Property", "value": 100, "observedAt": "2022-03-14T13:00:00.000Z" }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:D1
echo
echo


echo "05. § 8.4.2 EXAMPLE 3 - an NGSI-LD Null VALUE deletes the whole Attribute"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entities/urn:D1/attrs -X PATCH --payload '{
  "temperature": { "type": "Property", "value": "urn:ngsi-ld:null" }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:D1
echo
echo


echo "06. type in an Entity Fragment is ADDITIVE, never a replacement"
echo "=============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:D1/attrs -X PATCH --payload '{
  "type": "Sensor",
  "other": { "type": "Property", "value": "still untouched" }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:D1
echo
echo


echo "07. Seed urn:B1 - an OBJECT value + a datasetId-only instance"
echo "============================================================"
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:B1",
  "type": "Building",
  "address": { "type": "Property", "value": { "street": "Strasse des 17. Juni", "city": "Berlin", "country": "Germany" } },
  "speed": { "type": "Property", "value": 10, "datasetId": "urn:ds:A" }
}' | head -1
echo
echo


echo "08. § 8.4.3 EXAMPLE 2 - MERGE descends into the object value"
echo "==========================================================="
echo "    street updated, country removed by the NGSI-LD Null, city untouched"
echo
swCurl --url /ngsi-ld/v1/entities/urn:B1 -X PATCH --payload '{
  "address": { "type": "Property", "value": { "street": "Pariser Platz", "country": "urn:ngsi-ld:null" } }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:B1
echo
echo


echo "09. MERGE with an unknown datasetId -> ADDED as a new instance"
echo "============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:B1 -X PATCH --payload '{
  "speed": { "type": "Property", "value": 99, "datasetId": "urn:ds:B" }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:B1 --urlParams 'attrs=speed'
echo
echo


echo "10. update-ATTRIBUTES with an unknown datasetId -> ADDED too (§ 8.4.2)"
echo "====================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:B1/attrs -X PATCH --payload '{
  "speed": { "type": "Property", "value": 77, "datasetId": "urn:ds:C" }
}' | head -1
swCurl --url /ngsi-ld/v1/entities/urn:B1 --urlParams 'attrs=speed'
echo
echo


--EXPECT--
01. Seed urn:D1 - temperature 25 with unitCode CEL + observedAt
==============================================================
HTTP/1.1 201 Created


02. § 8.4.2 EXAMPLE 1 - partial ATTRIBUTE update -> unitCode SURVIVES
====================================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 238

{
  "id": "urn:D1",
  "other": {
    "type": "Property",
    "value": "untouched"
  },
  "temperature": {
    "observedAt": "2022-03-14T13:00:00Z",
    "type": "Property",
    "unitCode": "CEL",
    "value": 100
  },
  "type": "Device"
}



03. Put unitCode back
=====================
HTTP/1.1 400 Bad Request


04. § 8.4.2 EXAMPLE 2 - the SAME fragment as update-ATTRIBUTES -> unitCode GONE
==============================================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 215

{
  "id": "urn:D1",
  "other": {
    "type": "Property",
    "value": "untouched"
  },
  "temperature": {
    "observedAt": "2022-03-14T13:00:00Z",
    "type": "Property",
    "value": 100
  },
  "type": "Device"
}



05. § 8.4.2 EXAMPLE 3 - an NGSI-LD Null VALUE deletes the whole Attribute
========================================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 108

{
  "id": "urn:D1",
  "other": {
    "type": "Property",
    "value": "untouched"
  },
  "type": "Device"
}



06. type in an Entity Fragment is ADDITIVE, never a replacement
==============================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 138

{
  "id": "urn:D1",
  "other": {
    "type": "Property",
    "value": "still untouched"
  },
  "type": [
    "Device",
    "Sensor"
  ]
}



07. Seed urn:B1 - an OBJECT value + a datasetId-only instance
============================================================
HTTP/1.1 201 Created


08. § 8.4.3 EXAMPLE 2 - MERGE descends into the object value
===========================================================
    street updated, country removed by the NGSI-LD Null, city untouched

HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 251

{
  "address": {
    "type": "Property",
    "value": {
      "city": "Berlin",
      "street": "Pariser Platz"
    }
  },
  "id": "urn:B1",
  "speed": {
    "datasetId": "urn:ds:A",
    "type": "Property",
    "value": 10
  },
  "type": "Building"
}



09. MERGE with an unknown datasetId -> ADDED as a new instance
=============================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 236

{
  "id": "urn:B1",
  "speed": [
    {
      "datasetId": "urn:ds:A",
      "type": "Property",
      "value": 10
    },
    {
      "datasetId": "urn:ds:B",
      "type": "Property",
      "value": 99
    }
  ],
  "type": "Building"
}



10. update-ATTRIBUTES with an unknown datasetId -> ADDED too (§ 8.4.2)
=====================================================================
HTTP/1.1 204 No Content
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 324

{
  "id": "urn:B1",
  "speed": [
    {
      "datasetId": "urn:ds:A",
      "type": "Property",
      "value": 10
    },
    {
      "datasetId": "urn:ds:B",
      "type": "Property",
      "value": 99
    },
    {
      "datasetId": "urn:ds:C",
      "type": "Property",
      "value": 77
    }
  ],
  "type": "Building"
}



--TEARDOWN--
swBrokerStop
swDbDrop
