#
# FILE            log_secrets_masked.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A password or a token is never in the log - in its place "***":
#
#   - mongoc's connection URI (-v): built from --dbUser and --dbPwd, or given as --dbURI
#   - a notification's trace: the endpoint's user:password and a credential header (receiverInfo's
#     Authorization), on the request-line and header trace levels (230, 232)
#   - a crash report's command line: the value after a secret option (--dbPwd, --dbURI, --troePwd), as
#     GET /admin/config shows it
#
# Each password is a word of its own, and the log is searched for it: found, it is shown.
#
# Steps 01 and 02 start a broker of their own, on a port of its own: MongoDB refuses the user, and the
# start fails - after the line with the URI.
#
# Not under valgrind (-vt): step 04 crashes the broker on purpose (see crash_report_idle.test).
#
# SKIP_VALGRIND: on
# REQUIRE_DB: mongoc
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Log: a password or a token is "***" - the mongoc URI, a notification's trace, a crash report's command line

--TAGS--
security log subscription

--INIT--
corDbDrop
coraineStart --dbPwd Zq1suitepw -v -t 230,232
ftClientStart --port 7711 --status 200

--RUN--
D=/tmp/corTest_logSecretsMasked
rm -rf $D
mkdir -p $D
P=$((CB_PORT + 3260))

echo "01. mongoc: --dbUser and --dbPwd (-v) - the URI with the password as ***"
echo "========================================================================"
timeout 20 $COR_BROKER -v --port $P --database $COR_PLUGIN_DIR/db/currentState/mongoc.so --dbHost $COR_MONGO_HOST --dbPort $COR_MONGO_PORT --dbName cortestmask --dbUser cortestmask --dbPwd Zq2userpw > $D/out1 2>&1
echo "exit: $?"
grep -o "attempting to connect to mongodb://cortestmask:\*\*\*@" $D/out1
echo "password in the log: $(grep -c Zq2userpw $D/out1)"
echo
echo


echo "02. mongoc: --dbURI with user:password (-v) - the URI with the password as ***"
echo "=============================================================================="
timeout 20 $COR_BROKER -v --port $P --database $COR_PLUGIN_DIR/db/currentState/mongoc.so --dbURI "mongodb://cortestmask:Zq3uripw@$COR_MONGO_HOST:$COR_MONGO_PORT/?authSource=admin" > $D/out2 2>&1
echo "exit: $?"
grep -o "attempting to connect to mongodb://cortestmask:\*\*\*@[^,]*" $D/out2 | sed "s/@.*\/?/@HOST\/?/"
echo "password in the log: $(grep -c Zq3uripw $D/out2)"
echo
echo


echo "03. A notification to http://user:password@... with an Authorization receiverInfo - traced as ***"
echo "================================================================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:ngsi-ld:Subscription:mask",
  "type": "Subscription",
  "entities": [{"type":"T"}],
  "notification": {
    "endpoint": {
      "uri": "http://nuser:Zq4endpw@localhost:7711/notify",
      "receiverInfo": [ {"key": "Authorization", "value": "Bearer Zq5token"} ]
    }
  }
}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:E1","type":"T","p":{"type":"Property","value":1}}' | head -1
ftClientWait 1 --port 7711 > /dev/null
LOG=/tmp/coraine.CB.log
grep -o "notification request: POST http://nuser:\*\*\*@localhost:7711/notify" $LOG | head -1
grep -o "notification request header: Authorization: [^ ]*" $LOG | head -1
echo "password in the log: $(grep -c Zq4endpw $LOG)"
echo "token in the log: $(grep -c Zq5token $LOG)"
echo
echo


echo "04. A crash report - the value after --dbPwd is ***"
echo "==================================================="
PID=$(cat /tmp/coraine_CB.pid)
[ "$(cat /proc/$PID/comm 2>/dev/null)" == "coraine" ] || { echo "no broker at pid '$PID'" >&2; exit 1; }
kill -SEGV $PID
for i in $(seq 1 300); do
  [ -d /proc/$PID ] && [ "$(awk '{print $3}' /proc/$PID/stat 2>/dev/null)" != "Z" ] || break
  sleep 0.1
done
echo "after --dbPwd: $(grep -m1 '^command line:' $LOG | grep -o -- '--dbPwd [^ ]*' | cut -d' ' -f2)"
echo "password in the log: $(grep -c Zq1suitepw $LOG)"
echo


--TEARDOWN--
rm -rf /tmp/corTest_logSecretsMasked
ftClientStop --port 7711
coraineStop
corDbDrop

--EXPECT--
01. mongoc: --dbUser and --dbPwd (-v) - the URI with the password as ***
========================================================================
exit: 1
attempting to connect to mongodb://cortestmask:***@
password in the log: 0


02. mongoc: --dbURI with user:password (-v) - the URI with the password as ***
==============================================================================
exit: 1
attempting to connect to mongodb://cortestmask:***@HOST/?authSource=admin
password in the log: 0


03. A notification to http://user:password@... with an Authorization receiverInfo - traced as ***
=================================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
notification request: POST http://nuser:***@localhost:7711/notify
notification request header: Authorization: ***
password in the log: 0
token in the log: 0


04. A crash report - the value after --dbPwd is ***
===================================================
after --dbPwd: ***
password in the log: 0

