#
# FILE            subscription_notify_create.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription notification on entity create

--TAGS--
create notification subscription

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# 01. Create subscription for Vehicle entities
# 02. Create a Vehicle entity — should trigger notification
# 03. Dump ftClient — verify notification arrived
# 04. Reset ftClient
# 05. Create a Temperature entity — should NOT trigger (type mismatch)
# 06. Dump ftClient — empty (no notification)
# 07. Create paused subscription for Temperature
# 08. Create a Temperature entity — should NOT trigger (subscription paused)
# 09. Dump ftClient — empty
# 10. Retrieve subscription S1 — verify notification counters (timesSent, lastNotification, lastSuccess)
#

echo "01. Create subscription for Vehicle entities"
echo "============================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create a Vehicle entity — should trigger notification"
echo "=========================================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 120
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Dump ftClient — verify notification arrived"
echo "================================================"
ftClientDump
echo
echo


echo "04. Reset ftClient"
echo "==================="
ftClientReset
echo "done"
echo
echo


echo "05. Create a Temperature entity — should NOT trigger (type mismatch)"
echo "====================================================================="
payload='{
  "id": "urn:ngsi-ld:Temperature:T1",
  "type": "Temperature",
  "value": {
    "type": "Property",
    "value": 22.5
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "06. Dump ftClient — empty (no notification)"
echo "============================================="
ftClientDump
echo
echo


echo "07. Create paused subscription for Temperature"
echo "================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S2",
  "type": "Subscription",
  "entities": [
    {
      "type": "Temperature"
    }
  ],
  "isActive": false,
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "08. Create a Temperature entity T2 — should NOT trigger (subscription paused)"
echo "==============================================================================="
payload='{
  "id": "urn:ngsi-ld:Temperature:T2",
  "type": "Temperature",
  "value": {
    "type": "Property",
    "value": 25.0
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "09. Dump ftClient — empty"
echo "=========================="
ftClientDump
echo
echo


echo "10. Retrieve subscription S1 — verify notification counters"
echo "============================================================"
swCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


--EXPECT--
01. Create subscription for Vehicle entities
=============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)




02. Create a Vehicle entity — should trigger notification
==========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: REGEX(\d+)




03. Dump ftClient — verify notification arrived
================================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:Vehicle:V1",
          "speed": {
            "type": "Property",
            "value": 120
          },
          "type": "Vehicle"
        }
      ],
      "id": REGEX("urn:ngsi-ld:Notification:.*"),
      "notifiedAt": REGEX(".*"),
      "subscriptionId": "urn:ngsi-ld:Subscription:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": REGEX("[0-9]+"),
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "swBroker"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. Reset ftClient
===================
done


05. Create a Temperature entity — should NOT trigger (type mismatch)
=====================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Temperature:T1
Content-Length: REGEX(\d+)




06. Dump ftClient — empty (no notification)
=============================================
[]

07. Create paused subscription for Temperature
================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S2
Content-Length: REGEX(\d+)




08. Create a Temperature entity T2 — should NOT trigger (subscription paused)
===============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Temperature:T2
Content-Length: REGEX(\d+)




09. Dump ftClient — empty
==========================
[]

10. Retrieve subscription S1 — verify notification counters
============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:S1",
  "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/notify"
    },
    "lastNotification": REGEX(".*"),
    "lastSuccess": REGEX(".*"),
    "status": "ok",
    "timesSent": 1
  },
  "status": "active",
  "type": "Subscription"
}



--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
