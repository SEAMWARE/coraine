#
# FILE            query_entities_distops.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Distributed queryEntities — comprehensive coverage.
# No-split mode: each entity fully at one source.
#
--NAME--
Distributed queryEntities (comprehensive, no-split mode)

--TAGS--
entity query

--INIT--
corDbDrop
corDbDrop -role CP1
corDbDrop -role CP2
coraineStart --noSplitEntities -dist
coraineStart -role CP1 --noSplitEntities -dist
coraineStart -role CP2 --noSplitEntities -dist

--RUN--

#
# Setup:
#   CB:  V1 (speed=80, color=red), V3 (speed=30)
#   CP1: V2 (speed=120), V4 (speed=200, color=blue)
#   CP2: V5 (speed=50)
#
# Registrations on CB:
#   R1: inclusive, CB→CP1, type=Vehicle
#   R2: inclusive, CB→CP2, type=Vehicle
#
# Tests:
#   01. Seed entities on all three brokers
#   02. Register CB→CP1 and CB→CP2 (inclusive)
#   03. Basic merge: GET type=Vehicle → all 5 (ordered by speed)
#   04. local=true → only V1+V3
#   05. q filter forwarded: q=speed>100 → V2+V4
#   06. orderBy=speed;desc on merged
#   07. Pagination: limit=2 with orderBy
#   08. pick=speed on merged
#   09. Deduplication: same entity ID on CB and CP1
#   10. CP2 down → graceful fallback
#

CB="http://localhost:${CB_PORT}"
CP1="http://localhost:${CP1_PORT}"
CP2="http://localhost:${CP2_PORT}"


echo "01. Seed entities"
echo "================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":80},"color":{"type":"Property","value":"red"}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}'
echo
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":120}}'
echo
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V4","type":"Vehicle","speed":{"type":"Property","value":200},"color":{"type":"Property","value":"blue"}}'
echo
corCurl --port $CP2_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V5","type":"Vehicle","speed":{"type":"Property","value":50}}'
echo
echo


echo "02. Register CB→CP1 and CB→CP2 (inclusive)"
echo "==========================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:CP1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:CP2","type":"ContextSourceRegistration","endpoint":"'"$CP2"'","mode":"inclusive","information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "03. Basic merge: all 5 vehicles ordered by speed"
echo "================================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=speed"
echo
echo


echo "04. local=true → only CB entities"
echo "=================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&local=true&options=keyValues&orderBy=speed"
echo
echo


echo "05. q filter forwarded: speed>100"
echo "=================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&q=speed%3E100&options=keyValues&orderBy=speed"
echo
echo


echo "06. orderBy=speed;desc on merged"
echo "================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=speed;desc"
echo
echo


echo "07. Pagination: limit=2 with orderBy"
echo "====================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=speed&limit=2"
echo
echo


echo "08. pick=speed on merged"
echo "========================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&pick=speed&orderBy=speed"
echo
echo


echo "09. Dedup: create V1 on CP1 too → still only 5 entities"
echo "========================================================"
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":999}}'
echo
echo "Entity count:"
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues" | grep -c '"id"'
echo
echo


# With CP2 stopped, the forward to it gets no response — the result still
# assembles from CB+CP1 (graceful fallback), and § 6.3.5 signals the missing
# source with an NGSILD-Warning 199.
echo "10. CP2 down → graceful fallback (CB+CP1 only)"
echo "================================================"
coraineStop -role CP2
sleep 1
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=speed"
echo
echo


echo "11. Exclusive reg: CB→CP1 for Sensor → query Sensor returns CP1's data"
echo "======================================================================="
coraineStart -role CP2 -dist
sleep 1
# Re-seed CP2's V5 — ramdb wipes on restart, mongoc keeps it.
corCurl --port $CP2_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V5","type":"Vehicle","speed":{"type":"Property","value":50}}' > /dev/null 2>&1
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:S1","type":"Sensor","temp":{"type":"Property","value":25}}'
echo
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Excl","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"exclusive","information":[{"entities":[{"id":"urn:S1","type":"Sensor"}],"propertyNames":["temp"]}]}'
echo
corCurl --url "/ngsi-ld/v1/entities?type=Sensor&options=keyValues"
echo
echo


echo "12. Redirect reg: CB→CP2 for Camera → query returns CP2's data"
echo "==============================================================="
corCurl --port $CP2_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:C1","type":"Camera","res":{"type":"Property","value":"4K"}}'
echo
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Redir","type":"ContextSourceRegistration","endpoint":"'"$CP2"'","mode":"redirect","information":[{"entities":[{"type":"Camera"}]}]}'
echo
corCurl --url "/ngsi-ld/v1/entities?type=Camera&options=keyValues"
echo
echo


echo "13. Auxiliary reg: CB→CP2 for Vehicle → V5 supplemented (already in result from inclusive)"
echo "=========================================================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:Aux","type":"ContextSourceRegistration","endpoint":"'"$CP2"'","mode":"auxiliary","operations":["queryEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=speed" | grep -c '"id"'
echo
echo


echo "14. entityMap=true → response includes NGSILD-EntityMap header"
echo "=============================================================="
corCurl --url "/ngsi-ld/v1/entities?type=Vehicle&entityMap=true&options=keyValues" | grep -c 'NGSILD-EntityMap'
echo
echo


--EXPECT--
