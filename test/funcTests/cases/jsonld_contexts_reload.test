#
# FILE            jsonld_contexts_reload.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Verifies that DELETE ?reload=true on a Cached context actually re-downloads
# from the URL — i.e. when the upstream body changes, the broker's stored
# body changes too. The broader CRUD test only confirms the entry survives;
# this one checks the *body refreshes*.
#
--NAME--
DELETE /jsonldContexts/{id}?reload=true actually refreshes the body

--TAGS--
context

--INIT--
corDbDrop
corDbDrop -db coraine
contextServerStart
coraineStart

# Initial body: v1
contextServerPush /jsonldContexts/ctxR '{
  "@context": {
    "v": "v1"
  }
}'

--RUN--

#
# 01. POST Cached for ctxR — broker downloads v1
# 02. GET the stored body — confirm v1 is what's cached
# 03. Replace ctxR upstream with v2 (DELETE then POST on context-server)
# 04. GET stored body — broker still has v1 (no auto-refresh)
# 05. DELETE ?reload=true — 204
# 06. GET stored body — broker now has v2
#

echo "01. POST Cached for ctxR (broker downloads v1)"
echo "=============================================="
corCurl -X POST --url /ngsi-ld/v1/jsonldContexts \
  --payload '{"url":"http://localhost:7080/jsonldContexts/ctxR"}' | head -1
echo
echo


echo "02. GET — Cached without ?details is 422 OperationNotSupported (§ 5.13.4.4)"
echo "==========================================================================="
corCurl --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxR"
echo
echo


# Replace upstream out-of-band — context-server returns its first body on
# repeated POSTs, so use the DELETE+POST helper.
contextServerReplace /jsonldContexts/ctxR '{
  "@context": {
    "v": "v2"
  }
}'


echo "03. GET ?details=true before reload — kind=Cached, entry present"
echo "================================================================"
corCurl --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxR?details=true"
echo
echo


echo "04. DELETE ?reload=true"
echo "======================="
corCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxR?reload=true"
echo
echo


echo "05. GET ?details=true after reload — entry survived (re-downloaded body invisible per spec)"
echo "==========================================================================================="
corCurl --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxR?details=true"
echo
echo


--EXPECT--
01. POST Cached for ctxR (broker downloads v1)
==============================================
HTTP/1.1 201 Created


02. GET — Cached without ?details is 422 OperationNotSupported (§ 5.13.4.4)
===========================================================================
HTTP/1.1 422 Unprocessable Content
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 261

{
  "detail": "@context 'http://localhost:7080/jsonldContexts/ctxR' is of kind 'Cached'; only metadata (?details=true) is available",
  "status": 422,
  "title": "Operation Not Supported",
  "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}



03. GET ?details=true before reload — kind=Cached, entry present
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "URL": "http://localhost:7080/jsonldContexts/ctxR",
  "createdAt": "REGEX(.*)",
  "kind": "Cached",
  "lastUsage": "REGEX(.*)",
  "localId": "http://localhost:7080/jsonldContexts/ctxR"
}



04. DELETE ?reload=true
=======================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET ?details=true after reload — entry survived (re-downloaded body invisible per spec)
===========================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "URL": "http://localhost:7080/jsonldContexts/ctxR",
  "createdAt": "REGEX(.*)",
  "kind": "Cached",
  "lastUsage": "REGEX(.*)",
  "localId": "http://localhost:7080/jsonldContexts/ctxR"
}



--TEARDOWN--
coraineStop
contextServerStop
corDbDrop -db coraine
corDbDrop
