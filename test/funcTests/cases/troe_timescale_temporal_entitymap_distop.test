#
# FILE            troe_timescale_temporal_entitymap_distop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# /temporal/entityMaps with a Context Source (TS 104-175 § 14.6.4): a registration that supports
# createEntityMapQueryTemporal is asked for an EntityMap of its own (GET /temporal/entityMaps) - its id
# goes into linkedMaps, its entities into entityMap with the registration. A registration without the
# operation (queryTemporal only) is not asked.
#
#   CB:  urn:V1 speed 10 (09:00), 20 (10:00)    urn:V2 speed 15 (09:30), 25 (10:30)
#   CP1: urn:V1 speed 30 (11:00)                urn:V3 speed 50 (13:00)
#
# Split entities (the default): the filters are not applied - not locally, not at the source - the map
# holds the candidates. splitEntities=false: q is applied on both sides - from the URL, and from the
# body of a POST.
#
# REQUIRE_FEATURE: REGISTRATIONS
# REQUIRE_FEATURE: TEMPORAL_ENTITY_MAP
#
--NAME--
TRoE timescale - /temporal/entityMaps with a Context Source

--TAGS--
troe timescale postgres temporal entitymap distops registration

--INIT--
corDbDrop
corDbDrop -role CP1
corTroeInit
corTroeInit -role CP1
coraineStart        --troe timescale -dist --troeSync
coraineStart -role CP1 --troe timescale -dist --troeSync

--RUN--

echo "01. Register CP1 twice: urn:CSR:MAP (createEntityMapQueryTemporal), urn:CSR:QT (queryTemporal only)"
echo "===================================================================================================="
payload='{
  "id":         "urn:CSR:MAP",
  "type":       "ContextSourceRegistration",
  "endpoint":   "http://localhost:'"$CP1_PORT"'",
  "mode":       "inclusive",
  "operations": ["createEntityMapQueryTemporal"],
  "information":[ { "entities": [{"type":"Vehicle"}] } ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
payload='{
  "id":         "urn:CSR:QT",
  "type":       "ContextSourceRegistration",
  "endpoint":   "http://localhost:'"$CP1_PORT"'",
  "mode":       "inclusive",
  "operations": ["queryTemporal"],
  "information":[ { "entities": [{"type":"Vehicle"}] } ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. Seed CB (V1, V2) and CP1 (V1, V3)"
echo "====================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10,"observedAt":"2026-04-28T09:00:00Z"}}' > /dev/null
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":20,"observedAt":"2026-04-28T10:00:00Z"}' > /dev/null
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":15,"observedAt":"2026-04-28T09:30:00Z"}}' > /dev/null
corCurl --url /ngsi-ld/v1/entities/urn:V2/attrs/speed -X PATCH --payload '{"value":25,"observedAt":"2026-04-28T10:30:00Z"}' > /dev/null
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":30,"observedAt":"2026-04-28T11:00:00Z"}}' > /dev/null
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":50,"observedAt":"2026-04-28T13:00:00Z"}}' > /dev/null
echo done
echo
echo


echo "03. GET /temporal/entityMaps?type=Vehicle on CB - V1 in both, V2 local, V3 at urn:CSR:MAP, its map in linkedMaps"
echo "=================================================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entityMaps?type=Vehicle&timerel=after&timeAt=2026-04-28T08:00:00Z'
echo
echo


echo "04. The same with q=speed>22 - split entities: q is not applied, the candidates are V1, V2 and V3"
echo "================================================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entityMaps?type=Vehicle&timerel=after&timeAt=2026-04-28T08:00:00Z&q=speed>22'
echo
echo


echo "05. q=speed>22 and splitEntities=false - V2 (25) locally, V1 (30) and V3 (50) at the source"
echo "==========================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entityMaps?type=Vehicle&timerel=after&timeAt=2026-04-28T08:00:00Z&q=speed>22&splitEntities=false'
echo
echo


echo "06. POST /temporal/entityMaps, q speed>45 in the body, splitEntities=false - V3 only: the body's q reached the source"
echo "===================================================================================================================="
payload='{
  "type": "Query",
  "entities": [ { "type": "Vehicle" } ],
  "q": "speed>45",
  "temporalQ": { "timerel": "after", "timeAt": "2026-04-28T08:00:00Z" }
}'
corCurl --url '/ngsi-ld/v1/temporal/entityMaps?splitEntities=false' --payload "$payload"
echo
echo


echo "07. local=true - CP1 is not asked: V1 and V2"
echo "============================================"
corCurl --url '/ngsi-ld/v1/temporal/entityMaps?type=Vehicle&timerel=after&timeAt=2026-04-28T08:00:00Z&local=true'
echo
echo


--EXPECT--
01. Register CP1 twice: urn:CSR:MAP (createEntityMapQueryTemporal), urn:CSR:QT (queryTemporal only)
====================================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:MAP
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:QT
Content-Length: 0




02. Seed CB (V1, V2) and CP1 (V1, V3)
=====================================
done


03. GET /temporal/entityMaps?type=Vehicle on CB - V1 in both, V2 local, V3 at urn:CSR:MAP, its map in linkedMaps
==================================================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)
Content-Length: REGEX(\d+)

{
  "entityMap": {
    "urn:V1": [
      "@none",
      "urn:CSR:MAP"
    ],
    "urn:V2": [
      "@none"
    ],
    "urn:V3": [
      "urn:CSR:MAP"
    ]
  },
  "expiresAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z)",
  "id": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)",
  "linkedMaps": {
    "urn:CSR:MAP": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)"
  },
  "type": "EntityMap"
}



04. The same with q=speed>22 - split entities: q is not applied, the candidates are V1, V2 and V3
================================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)
Content-Length: REGEX(\d+)

{
  "entityMap": {
    "urn:V1": [
      "@none",
      "urn:CSR:MAP"
    ],
    "urn:V2": [
      "@none"
    ],
    "urn:V3": [
      "urn:CSR:MAP"
    ]
  },
  "expiresAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z)",
  "id": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)",
  "linkedMaps": {
    "urn:CSR:MAP": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)"
  },
  "type": "EntityMap"
}



05. q=speed>22 and splitEntities=false - V2 (25) locally, V1 (30) and V3 (50) at the source
===========================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)
Content-Length: REGEX(\d+)

{
  "entityMap": {
    "urn:V1": [
      "urn:CSR:MAP"
    ],
    "urn:V2": [
      "@none"
    ],
    "urn:V3": [
      "urn:CSR:MAP"
    ]
  },
  "expiresAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z)",
  "id": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)",
  "linkedMaps": {
    "urn:CSR:MAP": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)"
  },
  "type": "EntityMap"
}



06. POST /temporal/entityMaps, q speed>45 in the body, splitEntities=false - V3 only: the body's q reached the source
====================================================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)
Content-Length: REGEX(\d+)

{
  "entityMap": {
    "urn:V3": [
      "urn:CSR:MAP"
    ]
  },
  "expiresAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z)",
  "id": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)",
  "linkedMaps": {
    "urn:CSR:MAP": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)"
  },
  "type": "EntityMap"
}



