      "@none"
    ]
  },
  "expiresAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z)",
  "id": "REGEX(urn:ngsi-ld:EntityMap:[0-9a-f]+)",
  "linkedMaps": {},
  "type": "EntityMap"
}



--TEARDOWN--
coraineStop
coraineStop -role CP1
corDbDrop
corDbDrop -role CP1
corTroeDrop
corTroeDrop -role CP1
