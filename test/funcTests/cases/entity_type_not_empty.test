#
# FILE            entity_type_not_empty.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# An entity 'type' is an NGSI-LD Name (§ 4.6.2) — it must begin with a Letter
# and so cannot be the empty string. An empty type ("" scalar, [""] array, or a
# "" element in a type array) must be rejected with 400 on every entity write
# path. The check runs BEFORE JSON-LD term expansion, because @vocab expansion
# would otherwise launder "" into the bare context-prefix IRI (no longer empty)
# and slip it past the post-expansion validator — persisting a meaningless type.
#
--NAME--
Entity type must not be the empty string (create, batch, merge)

--TAGS--
entity validation

--INIT--
swDbDrop
swBrokerStart

--RUN--
echo "01. POST /entities scalar empty type -> 400"
echo "==========================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":""}'
echo
echo


echo "02. POST /entities array [\"\"] type -> 400"
echo "=========================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E2","type":[""]}'
echo
echo


echo "03. POST /entities mixed [\"T\",\"\"] type -> 400 (one empty element)"
echo "================================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E3","type":["T",""]}'
echo
echo


echo "04. POST /entities valid scalar type -> 201"
echo "==========================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E4","type":"T"}' | grep HTTP
echo
echo


echo "05. POST /entities valid array type -> 201"
echo "=========================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E5","type":["T1","T2"]}' | grep HTTP
echo
echo


echo "06. POST /entityOperations/create with an empty type -> 400 (not 207)"
echo "====================================================================="
swCurl --url /ngsi-ld/v1/entityOperations/create --payload '[{"id":"urn:ngsi-ld:B1","type":""}]'
echo
echo


echo "07. POST /entityOperations/create valid -> 201"
echo "=============================================="
swCurl --url /ngsi-ld/v1/entityOperations/create --payload '[{"id":"urn:ngsi-ld:B2","type":"T"}]' | grep HTTP
echo
echo


echo "08. PATCH /entities/{id} with an empty type -> 400 (merge path)"
echo "=============================================================="
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:E4 --payload '{"type":"","extra":{"type":"Property","value":1}}'
echo
echo


--EXPECT--
01. POST /entities scalar empty type -> 400
===========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 175

{
  "detail": "Entity 'type' must not be an empty string",
  "status": 400,
  "title": "Invalid Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. POST /entities array [""] type -> 400
==========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 188

{
  "detail": "Entity 'type' array elements must not be empty strings",
  "status": 400,
  "title": "Invalid Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. POST /entities mixed ["T",""] type -> 400 (one empty element)
=================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 188

{
  "detail": "Entity 'type' array elements must not be empty strings",
  "status": 400,
  "title": "Invalid Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. POST /entities valid scalar type -> 201
===========================================
HTTP/1.1 201 Created


05. POST /entities valid array type -> 201
==========================================
HTTP/1.1 201 Created


06. POST /entityOperations/create with an empty type -> 400 (not 207)
=====================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 175

{
  "detail": "Entity 'type' must not be an empty string",
  "status": 400,
  "title": "Invalid Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. POST /entityOperations/create valid -> 201
==============================================
HTTP/1.1 201 Created


08. PATCH /entities/{id} with an empty type -> 400 (merge path)
==============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 175

{
  "detail": "Entity 'type' must not be an empty string",
  "status": 400,
  "title": "Invalid Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
swBrokerStop
