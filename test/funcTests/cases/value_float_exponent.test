#
# FILE            value_float_exponent.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Numbers written with an exponent, and floats at the extremes, used to be
# silently corrupted on the way through:
#   - kjson parsed an integer mantissa with a NEGATIVE exponent as if the
#     exponent were positive: 5e-3 came back as 5000. Exponents past e18
#     overflowed: 1.234567890E+34 came back as 4941990330274940928.
#   - kbase's kFloatTrim cut every float of 1e30 or more at 30 characters
#     (1.5e30 came back one digit short, i.e. as 1.5e29) and rendered non-zero
#     values under ~5e-9 as 0.
#
# TS 104-175 § 5.2.2.4 admits all the JSON native types of RFC 8259, whose
# number grammar includes the exponent. Needs kjson >= 0.14.2, kbase >= 0.11.1.
#
--NAME--
Numbers with an exponent, and very large or very small floats, keep their value

--TAGS--
entity property value create retrieve

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create urn:X1 with values written with an exponent, and extreme floats
# 02. GET urn:X1 - every value is the number that was sent
# 03. GET with format=simplified - the same numbers on the other render path
#

echo "01. Create urn:X1 - numbers with exponents, very large and very small floats"
echo "============================================================================"
payload='{
  "id": "urn:X1",
  "type": "T",
  "negExp":     { "type": "Property", "value": 5e-3 },
  "negExpNeg":  { "type": "Property", "value": -5e-3 },
  "posExp":     { "type": "Property", "value": 5e3 },
  "twelveEm1":  { "type": "Property", "value": 12e-1 },
  "e34":        { "type": "Property", "value": 1.234567890E+34 },
  "big":        { "type": "Property", "value": 1.5e30 },
  "tiny":       { "type": "Property", "value": 1e-9 },
  "nested":     { "type": "Property", "value": { "rate": 25e-2 } }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET urn:X1 - normalized"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:X1
echo
echo


echo "03. GET urn:X1 - simplified (the other render path)"
echo "==================================================="
corCurl --url '/ngsi-ld/v1/entities/urn:X1?format=simplified'
echo
echo


--EXPECT--
01. Create urn:X1 - numbers with exponents, very large and very small floats
============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:X1
Content-Length: 0




02. GET urn:X1 - normalized
===========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 560

{
  "big": {
    "type": "Property",
    "value": 1.5e+30
  },
  "e34": {
    "type": "Property",
    "value": 1.23456789e+34
  },
  "id": "urn:X1",
  "negExp": {
    "type": "Property",
    "value": 0.005
  },
  "negExpNeg": {
    "type": "Property",
    "value": -0.005
  },
  "nested": {
    "type": "Property",
    "value": {
      "rate": 0.25
    }
  },
  "posExp": {
    "type": "Property",
    "value": 5000
  },
  "tiny": {
    "type": "Property",
    "value": 1e-09
  },
  "twelveEm1": {
    "type": "Property",
    "value": 1.2
  },
  "type": "T"
}



03. GET urn:X1 - simplified (the other render path)
===================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 212

{
  "big": 1.5e+30,
  "e34": 1.23456789e+34,
  "id": "urn:X1",
  "negExp": 0.005,
  "negExpNeg": -0.005,
  "nested": {
    "rate": 0.25
  },
  "posExp": 5000,
  "tiny": 1e-09,
  "twelveEm1": 1.2,
  "type": "T"
}



--TEARDOWN--
coraineStop
corDbDrop
