#
# FILE            patch_attr_observedat_providedby_validation.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Crash guard: observedAt / providedBy validation on a PATCH must reject
# cleanly rather than take the broker down. Compaction via a remote @context is
# deliberately not exercised here — it would make the test non-hermetic.
#
--NAME--
PATCH attribute observedAt / providedBy validation

--TAGS--
error attr patch

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create entity TemperatureSensor:001
# 02. PATCH adding batteryLevel with invalid observedAt AND invalid providedBy object -> error
# 03. GET — entity as created in step 01
# 04. PATCH adding batteryLevel with invalid providedBy object -> error
# 05. GET — entity as created in step 01
# 06. PATCH adding batteryLevel with invalid observedAt -> error
# 07. GET — entity as created in step 01, broker alive
#

echo "01. Create entity TemperatureSensor:001"
echo "======================================="
payload='{
  "id": "urn:ngsi-ld:TemperatureSensor:001",
  "type": "TemperatureSensor",
  "category": "sensor",
  "temperature": {
    "value": 25,
    "unitCode": "CEL"
  }
}'
corCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "02. PATCH batteryLevel with invalid observedAt + providedBy object"
echo "=================================================================="
payload='{
  "batteryLevel": {
    "value": 7,
    "observedAt": "1971-12-31T23:50:59.000Z",
    "providedBy": { "object" : "8" }
  }
}'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001 -X PATCH --payload "$payload"
echo
echo


echo "03. GET — entity as created"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001
echo
echo


echo "04. PATCH batteryLevel with invalid providedBy object"
echo "====================================================="
payload='{
  "batteryLevel": {
    "value": 4,
    "providedBy": { "object" : "8" }
  }
}'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001 -X PATCH --payload "$payload"
echo
echo


echo "05. GET — entity as created"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001
echo
echo


echo "06. PATCH batteryLevel with invalid observedAt"
echo "=============================================="
payload='{
  "batteryLevel": {
    "value": 6,
    "observedAt": "not-a-valid-datetime"
  }
}'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001 -X PATCH --payload "$payload"
echo
echo


echo "07. GET — entity as created, broker alive"
echo "========================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001
echo
echo


--EXPECT--
01. Create entity TemperatureSensor:001
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:TemperatureSensor:001
Content-Length: 0




02. PATCH batteryLevel with invalid observedAt + providedBy object
==================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 146

{
  "detail": "Not a valid URI: '8'",
  "status": 400,
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. GET — entity as created
===========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 233

{
  "category": {
    "type": "Property",
    "value": "sensor"
  },
  "id": "urn:ngsi-ld:TemperatureSensor:001",
  "temperature": {
    "type": "Property",
    "unitCode": "CEL",
    "value": 25
  },
  "type": "TemperatureSensor"
}



04. PATCH batteryLevel with invalid providedBy object
=====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 146

{
  "detail": "Not a valid URI: '8'",
  "status": 400,
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. GET — entity as created
===========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 233

{
  "category": {
    "type": "Property",
    "value": "sensor"
  },
  "id": "urn:ngsi-ld:TemperatureSensor:001",
  "temperature": {
    "type": "Property",
    "unitCode": "CEL",
    "value": 25
  },
  "type": "TemperatureSensor"
}



06. PATCH batteryLevel with invalid observedAt
==============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 273

{
  "detail": "Attribute 'https://uri.etsi.org/ngsi-ld/default-context/batteryLevel': 'observedAt' is not a valid ISO 8601 DateTime: 'not-a-valid-datetime'",
  "status": 400,
  "title": "Invalid observedAt",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. GET — entity as created, broker alive
=========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 233

{
  "category": {
    "type": "Property",
    "value": "sensor"
  },
  "id": "urn:ngsi-ld:TemperatureSensor:001",
  "temperature": {
    "type": "Property",
    "unitCode": "CEL",
    "value": 25
  },
  "type": "TemperatureSensor"
}



--TEARDOWN--
coraineStop
