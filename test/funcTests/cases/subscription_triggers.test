--NAME--
Subscription notificationTrigger — all trigger types

--TAGS--
subscription

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# Setup: 4 subscriptions with different triggers, same entity type
#
# S1: default (no notificationTrigger) -> entityCreated + attributeCreated + attributeModified
# S2: ["entityDeleted"] only
# S3: ["attributeDeleted"] only
# S4: ["attributeCreated"] only
#
# 01. Create S1 - default triggers
# 02. Create S2 - entityDeleted only
# 03. Create S3 - attributeDeleted only
# 04. Create S4 - attributeCreated only
# 05. Create entity -> S1 fires (entityCreated/attributeCreated), S4 fires (attributeCreated)
# 06. Dump: 2 notifications (S1 + S4)
# 07. Reset
# 08. PATCH entity - modify speed -> S1 fires (attributeModified)
# 09. Dump: 1 notification (S1)
# 10. Reset
# 11. PATCH entity - add new attr "color" -> S1 + S4 fire (attributeCreated)
# 12. Dump: 2 notifications (S1 + S4)
# 13. Reset
# 14. PATCH entity - remove color (null) -> S3 fires (attributeDeleted)
# 15. Dump: 1 notification (S3)
# 16. Reset
# 17. DELETE entity -> S2 fires (entityDeleted)
# 18. Dump: 1 notification (S2)
#

echo "01. Create S1 - default triggers"
echo "=================================="
payload='{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo

echo "02. Create S2 - entityDeleted only"
echo "===================================="
payload='{
  "id": "urn:S2",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notificationTrigger": [
    "entityDeleted"
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo

echo "03. Create S3 - attributeDeleted only"
echo "======================================="
payload='{
  "id": "urn:S3",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notificationTrigger": [
    "attributeDeleted"
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo

echo "04. Create S4 - attributeCreated only"
echo "======================================="
payload='{
  "id": "urn:S4",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notificationTrigger": [
    "attributeCreated"
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "05. Create entity"
echo "==================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo

echo "06. Dump - 2 notifications (S1 default + S4 attributeCreated)"
echo "=============================================================="
ftClientDump | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d), 'notifications')
subs = sorted([e['body']['subscriptionId'] for e in d])
for s in subs:
    print(' ', s)
"
echo
echo

echo "07. Reset"
echo "=========="
ftClientReset
echo "done"
echo
echo


echo "08. PATCH entity - modify speed"
echo "================================="
payload='{
  "speed": {
    "type": "Property",
    "value": 200
  }
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1 --payload "$payload"
echo
echo

echo "09. Dump - 1 notification (S1 attributeModified)"
echo "=================================================="
ftClientDump | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d), 'notifications')
for e in d:
    print(' ', e['body']['subscriptionId'])
"
echo
echo

echo "10. Reset"
echo "=========="
ftClientReset
echo "done"
echo
echo


echo "11. PATCH entity - add color attribute"
echo "========================================"
payload='{
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1 --payload "$payload"
echo
echo

echo "12. Dump - 2 notifications (S1 + S4 attributeCreated)"
echo "======================================================="
ftClientDump | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d), 'notifications')
subs = sorted([e['body']['subscriptionId'] for e in d])
for s in subs:
    print(' ', s)
"
echo
echo

echo "13. Reset"
echo "=========="
ftClientReset
echo "done"
echo
echo


echo "14. PATCH entity - remove color (urn:ngsi-ld:null)"
echo "====================================================="
payload='{
  "color": "urn:ngsi-ld:null"
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1 --payload "$payload"
echo
echo

echo "15. Dump - 1 notification (S3 attributeDeleted)"
echo "================================================="
ftClientDump | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d), 'notifications')
for e in d:
    print(' ', e['body']['subscriptionId'])
"
echo
echo

echo "16. Reset"
echo "=========="
ftClientReset
echo "done"
echo
echo


echo "17. DELETE entity"
echo "==================="
swCurl -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo

echo "18. Dump - 1 notification (S2 entityDeleted)"
echo "==============================================="
ftClientDump | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(len(d), 'notifications')
for e in d:
    print(' ', e['body']['subscriptionId'])
"
echo
echo


--EXPECT--
01. Create S1 - default triggers
==================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:S1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create S2 - entityDeleted only
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:S2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. Create S3 - attributeDeleted only
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:S3
Link: REGEX(.*)
Content-Length: REGEX(\d+)




04. Create S4 - attributeCreated only
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:S4
Link: REGEX(.*)
Content-Length: REGEX(\d+)




05. Create entity
===================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




06. Dump - 2 notifications (S1 default + S4 attributeCreated)
==============================================================
2 notifications
  urn:S1
  urn:S4


07. Reset
==========
done


08. PATCH entity - modify speed
=================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




09. Dump - 1 notification (S1 attributeModified)
==================================================
1 notifications
  urn:S1


10. Reset
==========
done


11. PATCH entity - add color attribute
========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




12. Dump - 2 notifications (S1 + S4 attributeCreated)
=======================================================
2 notifications
  urn:S1
  urn:S4


13. Reset
==========
done


14. PATCH entity - remove color (urn:ngsi-ld:null)
=====================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




15. Dump - 1 notification (S3 attributeDeleted)
=================================================
1 notifications
  urn:S3


16. Reset
==========
done


17. DELETE entity
===================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




18. Dump - 1 notification (S2 entityDeleted)
===============================================
1 notifications
  urn:S2


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
