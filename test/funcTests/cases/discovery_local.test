# FILE            discovery_local.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Discovery endpoints - mode 1 local (§ 5.7.5-§ 5.7.10)
--INIT--
swDbDrop
swBrokerStart

--TAGS--
query

--RUN--

#
# Seed three entities spanning two types. Types:
#   Vehicle  (V1: speed, color)  (V2: speed, brand)
#   Sensor   (S1: temp)
#
# Mode 1 (?local=true) is the default today; we exercise it via the four
# discovery HTTP resources: /types, /types/{type}, /attributes,
# /attributes/{attrId}, each with and without ?details where applicable.
#

echo "01. Seed three entities"
echo "======================="
swCurl --url /ngsi-ld/v1/entities --payload \
  '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":50},"color":{"type":"Property","value":"red"}}'
echo
swCurl --url /ngsi-ld/v1/entities --payload \
  '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":100},"brand":{"type":"Property","value":"Acme"}}'
echo
swCurl --url /ngsi-ld/v1/entities --payload \
  '{"id":"urn:S1","type":"Sensor","temp":{"type":"Property","value":22}}'
echo
echo


echo "02. GET /types → EntityTypeList"
echo "================================"
swCurl --url /ngsi-ld/v1/types
echo
echo


echo "03. GET /types?details=true → EntityType[]"
echo "==========================================="
swCurl --url /ngsi-ld/v1/types --urlParams 'details=true'
echo
echo


echo "04. GET /types/Vehicle → EntityTypeInfo"
echo "========================================"
swCurl --url /ngsi-ld/v1/types/Vehicle
echo
echo


echo "05. GET /types/NoSuch → 404"
echo "============================"
swCurl --url /ngsi-ld/v1/types/NoSuch
echo
echo


echo "06. GET /attributes → AttributeList"
echo "===================================="
swCurl --url /ngsi-ld/v1/attributes
echo
echo


echo "07. GET /attributes?details=true → Attribute[]"
echo "==============================================="
swCurl --url /ngsi-ld/v1/attributes --urlParams 'details=true'
echo
echo


echo "08. GET /attributes/speed → Attribute"
echo "======================================"
swCurl --url /ngsi-ld/v1/attributes/speed
echo
echo


echo "09. GET /attributes/noSuch → 404"
echo "================================="
swCurl --url /ngsi-ld/v1/attributes/noSuch
echo
echo


--EXPECT--
01. Seed three entities
=======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:S1
Content-Length: 0




02. GET /types → EntityTypeList
================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:EntityTypeList:local",
  "type": "EntityTypeList",
  "typeList": [
    "Vehicle",
    "Sensor"
  ]
}



03. GET /types?details=true → EntityType[]
===========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "attributeNames": [
      "speed",
      "color",
      "brand"
    ],
    "id": "https://uri.etsi.org/ngsi-ld/default-context/Vehicle",
    "type": "EntityType",
    "typeName": "Vehicle"
  },
  {
    "attributeNames": [
      "temp"
    ],
    "id": "https://uri.etsi.org/ngsi-ld/default-context/Sensor",
    "type": "EntityType",
    "typeName": "Sensor"
  }
]



04. GET /types/Vehicle → EntityTypeInfo
========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "attributeDetails": [
    {
      "attributeName": "speed",
      "attributeTypes": [
        "Property"
      ],
      "id": "https://uri.etsi.org/ngsi-ld/default-context/speed",
      "type": "Attribute"
    },
    {
      "attributeName": "color",
      "attributeTypes": [
        "Property"
      ],
      "id": "https://uri.etsi.org/ngsi-ld/default-context/color",
      "type": "Attribute"
    },
    {
      "attributeName": "brand",
      "attributeTypes": [
        "Property"
      ],
      "id": "https://uri.etsi.org/ngsi-ld/default-context/brand",
      "type": "Attribute"
    }
  ],
  "entityCount": 2,
  "id": "https://uri.etsi.org/ngsi-ld/default-context/Vehicle",
  "type": "EntityTypeInfo",
  "typeName": "Vehicle"
}



05. GET /types/NoSuch → 404
============================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity type 'NoSuch' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



06. GET /attributes → AttributeList
====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "attributeList": [
    "speed",
    "color",
    "brand",
    "temp"
  ],
  "id": "urn:ngsi-ld:AttributeList:local",
  "type": "AttributeList"
}



