#
# FILE            snapshot_async_capture.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16.1.4 — "the following is executed in the background".
#
# Broker started with --asyncSnapshot. POST /snapshots returns 201
# immediately with snapshotStatus="preparing"; a worker thread runs
# the queries, updates the cache + persists the result + fires the
# notification. The client polls /snapshots/{id} until status is
# terminal (or waits for a SnapshotNotification).
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot async background capture (§ 5.16.1.4 / Phase #144)

--TAGS--
snapshot

--INIT--
corDbDrop
corSnapDrop
ftClientStart
coraineStart -asyncSnapshot

--RUN--

echo "01. Seed two Vehicles"
echo "====================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V2","type":"Vehicle","speed":{"type":"Property","value":80}}'
echo
echo


echo "02. POST /snapshots — returns 201 immediately (capture runs in background)"
echo "=========================================================================="
corCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Bg",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "endpoint": "http://localhost:'$FT_CLIENT_PORT'/bg"
}'
echo
echo


echo "03. Poll /snapshots/Bg until status is terminal"
echo "==============================================="
#
# The poll count is machine speed, not behaviour. This used to print
# "after iteration $i" and expect iteration 1 - so under valgrind, where the
# worker thread needs a second poll, a broker that did everything right failed
# the test. Print the status alone. The deadline is what asserts: a capture
# that never leaves "preparing" prints nothing and the missing line is the
# mismatch. The valgrind ceiling follows ftClientWait's - never approached by
# a healthy run.
#
deadline=10
[ "$COR_VALGRIND" == "1" ] && deadline=50
for ((i = 0; i < deadline; i++)); do
    status=$(corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Bg 2>/dev/null \
             | grep -o '"snapshotStatus": *"[^"]*"' | head -1 | sed -E 's/.*"([^"]+)"$/\1/')
    if [ "$status" != "preparing" ] && [ -n "$status" ]; then
        echo "  status: $status"
        break
    fi
    sleep 0.5
done
echo
echo


echo "04. GET /snapshots/Bg — final state with snapshotQueriesDetails"
echo "==============================================================="
corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Bg
echo
echo


echo "05. ftClient dump — one notification fired by the worker thread"
echo "==============================================================="
ftClientDump
echo
echo


echo "06. Snapshot read works (entities captured by the worker)"
echo "========================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&orderBy=speed' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Bg'
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Seed two Vehicles
=====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
Content-Length: 0




02. POST /snapshots — returns 201 immediately (capture runs in background)
==========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Bg
Content-Length: 0




03. Poll /snapshots/Bg until status is terminal
===============================================
  status: success


04. GET /snapshots/Bg — final state with snapshotQueriesDetails
===============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "endpoint": "http://localhost:7701/bg",
  "expiresAt": "REGEX(.*)",
  "id": "urn:ngsi-ld:Snapshot:Bg",
  "lastUsedAt": "REGEX(.*)",
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "success"
    }
  ],
  "snapshotStatus": "success",
  "type": "Snapshot"
}



05. ftClient dump — one notification fired by the worker thread
===============================================================
[
  {
    "body": {
      "expiresAt": "REGEX(.*)",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "snapshotId": "urn:ngsi-ld:Snapshot:Bg",
      "snapshotPriority": 5,
      "snapshotQueriesDetails": [
        {
          "resultStatus": "success"
        }
      ],
      "snapshotStatus": "success",
      "type": "SnapshotNotification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/bg",
    "verb": "POST"
  }
]


06. Snapshot read works (entities captured by the worker)
=========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Bg
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 269

[
  {
    "id": "urn:ngsi-ld:Vehicle:V1",
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:ngsi-ld:Vehicle:V2",
    "speed": {
      "type": "Property",
      "value": 80
    },
    "type": "Vehicle"
  }
]



[]
--TEARDOWN--
coraineStop
ftClientStop
corSnapDrop
corDbDrop
