#
# FILE            post_entity_attrs_entity_level_fields.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
POST /entities/{id}/attrs - id/type/scope/timestamps in body (§ 5.6.3.4, § 5.2.2)
--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# Spec positions for Append Attributes:
#   - id        : not covered by spec — we reject with 400 (URL is authoritative)
#   - type      : § 5.6.3.4 — new type names are unioned into target.type
#   - scope     : § 5.6.3.4 — overwrite allowed → replace (default)
#   - createdAt
#     modifiedAt: § 5.2.2 common members — "shall be ignored"
#

echo "01. Create entity V1 (type=Vehicle, scope=/s1, speed=50)"
echo "========================================================"
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "scope": "/s1",
  "speed": {"type":"Property","value":50}
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. POST /attrs with id in body → 400 BadRequestData"
echo "====================================================="
swCurl -X POST --url /ngsi-ld/v1/entities/urn:V1/attrs \
  --payload '{"id":"urn:V1","foo":{"type":"Property","value":1}}'
echo
echo


echo "03. POST /attrs adding new type → unioned"
echo "========================================="
swCurl -X POST --url /ngsi-ld/v1/entities/urn:V1/attrs \
  --payload '{"type":"Car","foo":{"type":"Property","value":1}}'
echo
echo


echo "04. POST /attrs replacing scope (overwrite default) → /s2"
echo "========================================================="
swCurl -X POST --url /ngsi-ld/v1/entities/urn:V1/attrs \
  --payload '{"scope":"/s2","bar":{"type":"Property","value":2}}'
echo
echo


echo "05. POST /attrs with createdAt/modifiedAt in body → ignored (204)"
echo "================================================================="
swCurl -X POST --url /ngsi-ld/v1/entities/urn:V1/attrs \
  --payload '{"createdAt":"2000-01-01T00:00:00Z","modifiedAt":"2000-01-01T00:00:00Z","baz":{"type":"Property","value":3}}'
echo
echo


echo "06. GET V1 — type=[Vehicle,Car], scope=/s2, foo/bar/baz present"
echo "==============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


--EXPECT--
01. Create entity V1 (type=Vehicle, scope=/s1, speed=50)
========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0




02. POST /attrs with id in body → 400 BadRequestData
=====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Entity 'id' must not appear in the payload of AppendAttrs",
  "title": "Entity Id In Body",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. POST /attrs adding new type → unioned
=========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




04. POST /attrs replacing scope (overwrite default) → /s2
=========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




05. POST /attrs with createdAt/modifiedAt in body → ignored (204)
=================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




06. GET V1 — type=[Vehicle,Car], scope=/s2, foo/bar/baz present
===============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "bar": {
    "type": "Property",
    "value": 2
  },
  "baz": {
    "type": "Property",
    "value": 3
  },
  "foo": {
    "type": "Property",
    "value": 1
  },
  "id": "urn:V1",
  "scope": "/s2",
  "speed": {
    "type": "Property",
    "value": 50
  },
  "type": [
    "Vehicle",
    "Car"
  ]
}



--TEARDOWN--
swBrokerStop
swDbDrop
