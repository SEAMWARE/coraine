#
# FILE            troe_corDB_full_lifecycle.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE in corDB (--troe corDB): merge, attribute replace, attribute delete (a tombstone), entity delete.
# The history is read back through the temporal API (§ 5.7.3).
#
--NAME--
TRoE corDB - an entity's whole lifecycle in its history

--TAGS--
troe lifecycle

--INIT--
corDbDrop
coraineStart --troe corDB

--RUN--

echo "01. POST entity urn:V1 with speed=42"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' | head -1
echo
echo
echo


echo "02. PATCH /entities/urn:V1 — add color, change speed"
echo "===================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X PATCH --payload '{"speed":{"type":"Property","value":80},"color":{"type":"Property","value":"red"}}' | head -1
echo


echo "03. PUT /entities/urn:V1/attrs/speed — wholesale replace"
echo "========================================================"
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PUT --payload '{"type":"Property","value":120}' | head -1
echo


echo "04. DELETE /entities/urn:V1/attrs/color"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/color -X DELETE | head -1
echo


echo "05. DELETE /entities/urn:V1"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X DELETE | head -1
echo
echo

echo "06. GET /temporal/entities/urn:V1"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


--EXPECT--
01. POST entity urn:V1 with speed=42
====================================
HTTP/1.1 201 Created



02. PATCH /entities/urn:V1 — add color, change speed
====================================================
HTTP/1.1 204 No Content

03. PUT /entities/urn:V1/attrs/speed — wholesale replace
========================================================
HTTP/1.1 204 No Content

04. DELETE /entities/urn:V1/attrs/color
=======================================
HTTP/1.1 204 No Content

05. DELETE /entities/urn:V1
===========================
HTTP/1.1 204 No Content


06. GET /temporal/entities/urn:V1
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "color": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": "red"
    },
    {
      "deletedAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+Z)",
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": "urn:ngsi-ld:null"
    }
  ],
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 42
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 80
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 120
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
corDbDrop
