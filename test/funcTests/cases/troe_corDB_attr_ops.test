#
# FILE            troe_corDB_attr_ops.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE in corDB (--troe corDB): a PATCH appends an instance; a deleted entity keeps its history.
# The history is read back through the temporal API (§ 5.7.3).
#
--NAME--
TRoE corDB - an attribute PATCH appends, a deleted entity keeps its history

--TAGS--
troe patch delete

--INIT--
corDbDrop
coraineStart --troe corDB

--RUN--

echo "01. POST entity urn:V1 with one attr"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' | head -1
echo
echo
echo


echo "02. PATCH /entities/urn:V1/attrs/speed — value change"
echo "====================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload '{"value":99}' | head -1
echo


echo "03. DELETE /entities/urn:V1"
echo "==========================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X DELETE | head -1
echo
echo

echo "04. GET /temporal/entities/urn:V1"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


--EXPECT--
01. POST entity urn:V1 with one attr
====================================
HTTP/1.1 201 Created



02. PATCH /entities/urn:V1/attrs/speed — value change
=====================================================
HTTP/1.1 204 No Content

03. DELETE /entities/urn:V1
===========================
HTTP/1.1 204 No Content


04. GET /temporal/entities/urn:V1
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 42
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 99
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
corDbDrop
