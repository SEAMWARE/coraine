07. The notification renders the multi-attributes exactly as the GET did
=======================================================================
[
  {
    "body": {
      "data": [
        {
          "greet": [
            {
              "datasetId": "urn:ds:1",
              "languageMap": {
                "en": "hi"
              }
            },
            {
              "languageMap": {
                "es": "hola"
              }
            }
          ],
          "held": [
            {
              "datasetId": "urn:ds:1",
              "object": "urn:o:1"
            },
            {
              "object": "urn:o:2"
            }
          ],
          "id": "urn:MA:1",
          "single": "two",
          "speed": [
            {
              "datasetId": "urn:ds:1",
              "value": 55
            },
            54.5
          ],
          "type": "T",
          "withSub": [
            {
              "datasetId": "urn:ds:1",
              "note": "n",
              "value": 1
            },
            2
          ]
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:S:concise",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "Ngsild-Attribute-Format": "concise",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  },
  {
    "body": {
      "data": [
        {
          "greet": {
            "dataset": {
              "@none": {
                "languageMap": {
                  "es": "hola"
                }
              },
              "urn:ds:1": {
                "languageMap": {
                  "en": "hi"
                }
              }
            }
          },
          "held": {
            "dataset": {
              "@none": "urn:o:2",
              "urn:ds:1": "urn:o:1"
            }
          },
          "id": "urn:MA:1",
          "single": "two",
          "speed": {
            "dataset": {
              "@none": 54.5,
              "urn:ds:1": 55
            }
          },
          "type": "T",
          "withSub": {
            "dataset": {
              "@none": 2,
              "urn:ds:1": 1
            }
          }
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:S:simplified",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "Ngsild-Attribute-Format": "simplified",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
