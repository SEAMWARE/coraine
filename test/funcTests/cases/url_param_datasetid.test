# FILE            url_param_datasetid.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET entity/entities with datasetId filter returns only matching instances

--TAGS--
datasetid url-param

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with 3 speed instances: default (100), radar (98), lidar (102)
# 02. GET entity - datasetId=@none (default instance only)
# 03. GET entity - datasetId=urn:sensor:radar (named instance only)
# 04. GET entity - datasetId=@none,urn:sensor:lidar (two instances)
# 05. GET entity - datasetId=urn:nonexistent (no match, attribute dropped)
# 06. GET entities - datasetId=urn:sensor:radar (collection query)
# 07. Create entity E2 with Relationship instances (default + named datasetId)
# 08. GET entity E2 - datasetId=@none (default Relationship instance only)
# 09. GET entity E2 - datasetId=urn:source:manual (named Relationship instance)
# 10. GET entity E1 - datasetId=@none + pick=speed (combined filter)
# 11. GET entity E1 - datasetId=urn:sensor:radar + pick=id,type,speed (pick with datasetId)
# 12. GET entity E1 - datasetId=urn:sensor:radar + omit=speed (omit drops the only matching attr)
#

echo "01. Create entity with 3 speed instances: default (100), radar (98), lidar (102)"
echo "================================================================================"
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "type": "Property",
      "value": 98,
      "datasetId": "urn:sensor:radar"
    },
    {
      "type": "Property",
      "value": 102,
      "datasetId": "urn:sensor:lidar"
    }
  ]
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity - datasetId=@none (default instance only)"
echo "========================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=@none'
echo
echo


echo "03. GET entity - datasetId=urn:sensor:radar (named instance only)"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=urn:sensor:radar'
echo
echo


echo "04. GET entity - datasetId=@none,urn:sensor:lidar (two instances)"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=@none,urn:sensor:lidar'
echo
echo


echo "05. GET entity - datasetId=urn:nonexistent (no match, attribute dropped)"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=urn:nonexistent'
echo
echo


echo "06. GET entities - datasetId=urn:sensor:radar (collection query)"
echo "================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&datasetId=urn:sensor:radar'
echo
echo


echo "07. Create entity E2 with Relationship instances (default + named datasetId)"
echo "==========================================================================="
payload='{
  "id": "urn:e2",
  "type": "Vehicle",
  "isParkedAt": [
    {
      "type": "Relationship",
      "object": "urn:parking:P1"
    },
    {
      "type": "Relationship",
      "object": "urn:parking:P2",
      "datasetId": "urn:source:manual"
    }
  ]
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "08. GET entity E2 - datasetId=@none (default Relationship instance only)"
echo "========================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:e2?datasetId=@none'
echo
echo


echo "09. GET entity E2 - datasetId=urn:source:manual (named Relationship instance)"
echo "============================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e2?datasetId=urn:source:manual'
echo
echo


echo "10. GET entity E1 - datasetId=@none + pick=speed (combined filter)"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=@none&pick=speed'
echo
echo


echo "11. GET entity E1 - datasetId=urn:sensor:radar + pick=id,type,speed"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=urn:sensor:radar&pick=id,type,speed'
echo
echo


echo "12. GET entity E1 - datasetId=urn:sensor:radar + omit=speed (omit drops the only attr)"
echo "======================================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:e1?datasetId=urn:sensor:radar&omit=speed'
echo
echo


--EXPECT--
01. Create entity with 3 speed instances: default (100), radar (98), lidar (102)
================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entity - datasetId=@none (default instance only)
========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



03. GET entity - datasetId=urn:sensor:radar (named instance only)
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "datasetId": "urn:sensor:radar",
    "type": "Property",
    "value": 98
  },
  "type": "Vehicle"
}



04. GET entity - datasetId=@none,urn:sensor:lidar (two instances)
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "datasetId": "urn:sensor:lidar",
      "type": "Property",
      "value": 102
    }
  ],
  "type": "Vehicle"
}



05. GET entity - datasetId=urn:nonexistent (no match, attribute dropped)
========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "type": "Vehicle"
}



06. GET entities - datasetId=urn:sensor:radar (collection query)
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:e1",
    "speed": {
      "datasetId": "urn:sensor:radar",
      "type": "Property",
      "value": 98
    },
    "type": "Vehicle"
  }
]



07. Create entity E2 with Relationship instances (default + named datasetId)
===========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




08. GET entity E2 - datasetId=@none (default Relationship instance only)
========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e2",
  "isParkedAt": {
    "object": "urn:parking:P1",
    "type": "Relationship"
  },
  "type": "Vehicle"
}



09. GET entity E2 - datasetId=urn:source:manual (named Relationship instance)
=============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e2",
  "isParkedAt": {
    "datasetId": "urn:source:manual",
    "object": "urn:parking:P2",
    "type": "Relationship"
  },
  "type": "Vehicle"
}



10. GET entity E1 - datasetId=@none + pick=speed (combined filter)
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



11. GET entity E1 - datasetId=urn:sensor:radar + pick=id,type,speed
===================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "datasetId": "urn:sensor:radar",
    "type": "Property",
    "value": 98
  },
  "type": "Vehicle"
}



12. GET entity E1 - datasetId=urn:sensor:radar + omit=speed (omit drops the only attr)
======================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swDbDrop
