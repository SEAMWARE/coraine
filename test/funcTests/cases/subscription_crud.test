--NAME--
Subscription CRUD - create, retrieve, query, update, delete

--TAGS--
subscription

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create subscription with explicit id
# 02. Retrieve subscription by id
# 03. Create second subscription (auto-generated id)
# 04. Query all subscriptions - two subscriptions
# 05. Update subscription - change throttling
# 06. Retrieve updated subscription
# 07. Delete first subscription - 204
# 08. Query all subscriptions - only second subscription
# 09. Delete non-existing subscription - 404
# 10. Retrieve deleted subscription - 404
# 11. Create subscription with same id as S1 (deleted) - 201
# 12. Create duplicate of still-existing auto-gen sub - impossible to test without knowing id
#

echo "01. Create subscription with explicit id"
echo "========================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:1234/notify"
    }
  },
  "throttling": 5
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Retrieve subscription by id"
echo "================================"
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "03. Create second subscription with isActive=false"
echo "==================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S2",
  "type": "Subscription",
  "entities": [
    {
      "type": "Temperature"
    }
  ],
  "watchedAttributes": ["temperature"],
  "isActive": false,
  "notification": {
    "endpoint": {
      "uri": "http://localhost:1234/notify2"
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "04. Query all subscriptions - two subscriptions"
echo "================================================"
corCurl --url /ngsi-ld/v1/subscriptions
echo
echo


echo "05. Update subscription - change throttling"
echo "============================================="
payload='{
  "throttling": 10
}'
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1 --payload "$payload"
echo
echo


echo "06. Retrieve updated subscription"
echo "=================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "07. Delete first subscription - 204"
echo "===================================="
corCurl -X DELETE --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "08. Query all subscriptions - only second subscription"
echo "======================================================="
corCurl --url /ngsi-ld/v1/subscriptions
echo
echo


echo "09. Delete non-existing subscription - 404"
echo "============================================"
corCurl -X DELETE --url /ngsi-ld/v1/subscriptions/urn:doesnt:exist
echo
echo


echo "10. Retrieve deleted subscription - 404"
echo "========================================"
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
echo
echo


echo "11. Attempt to create duplicate subscription S2 - 409"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S2",
  "type": "Subscription",
  "entities": [{"type": "X"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/x"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


--EXPECT--
01. Create subscription with explicit id
=========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
Content-Length: 0




02. Retrieve subscription by id
================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 338

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:S1",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:1234/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "throttling": 5,
  "type": "Subscription"
}



03. Create second subscription with isActive=false
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S2
Content-Length: 0




04. Query all subscriptions - two subscriptions
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 822

[
  {
    "entities": [
      {
        "type": "Vehicle"
      }
    ],
    "id": "urn:ngsi-ld:Subscription:S1",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1234/notify"
      }
    },
    "notificationTrigger": [
      "attributeCreated",
      "attributeUpdated"
    ],
    "status": "active",
    "throttling": 5,
    "type": "Subscription"
  },
  {
    "entities": [
      {
        "type": "Temperature"
      }
    ],
    "id": "urn:ngsi-ld:Subscription:S2",
    "isActive": false,
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1234/notify2"
      }
    },
    "notificationTrigger": [
      "attributeCreated",
      "attributeUpdated"
    ],
    "status": "paused",
    "type": "Subscription",
    "watchedAttributes": [
      "temperature"
    ]
  }
]



05. Update subscription - change throttling
=============================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




06. Retrieve updated subscription
==================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 339

{
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:ngsi-ld:Subscription:S1",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:1234/notify"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "throttling": 10,
  "type": "Subscription"
}



07. Delete first subscription - 204
====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




08. Query all subscriptions - only second subscription
=======================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 443

[
  {
    "entities": [
      {
        "type": "Temperature"
      }
    ],
    "id": "urn:ngsi-ld:Subscription:S2",
    "isActive": false,
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1234/notify2"
      }
    },
    "notificationTrigger": [
      "attributeCreated",
      "attributeUpdated"
    ],
    "status": "paused",
    "type": "Subscription",
    "watchedAttributes": [
      "temperature"
    ]
  }
]



09. Delete non-existing subscription - 404
============================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 167

{
  "detail": "subscription 'urn:doesnt:exist' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



10. Retrieve deleted subscription - 404
========================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 178

{
  "detail": "subscription 'urn:ngsi-ld:Subscription:S1' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



11. Attempt to create duplicate subscription S2 - 409
======================================================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 185

{
  "detail": "subscription 'urn:ngsi-ld:Subscription:S2' already exists",
  "status": 409,
  "title": "Already Exists",
  "type": "https://uri.etsi.org/ngsi-ld/errors/AlreadyExists"
}



--TEARDOWN--
coraineStop
corDbDrop
