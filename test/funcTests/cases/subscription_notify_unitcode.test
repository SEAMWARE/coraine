#
# FILE            subscription_notify_unitcode.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.8.6 — a notification carries the affected attributes including their
# reserved sub-attributes. unitCode (the UN/CEFACT unit of a Property value) is
# a reserved sub-attribute; it must round-trip into the notification body just
# as it does on a GET. Here a Property with unitCode is created; the resulting
# notification must echo "unitCode": "CEL".
#
--NAME--
Subscription notification — unitCode sub-attribute round-trips into the notification body

--TAGS--
subscription notification

--INIT--
swDbDrop
swBrokerStart
ftClientStart

--RUN--

EP='{"uri":"http://localhost:7701/notify","accept":"application/json"}'

echo "01. Subscribe to T, then create an entity whose Property carries unitCode=CEL"
echo "============================================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:S1","type":"Subscription","entities":[{"type":"T"}],"notification":{"endpoint":'"$EP"'}}' | grep HTTP
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T","temperature":{"type":"Property","value":5,"unitCode":"CEL"}}' | grep HTTP
echo
echo


echo "02. Notification body echoes the unitCode sub-attribute"
echo "======================================================="
sleep 0.5
ftClientDump
echo


--EXPECT--
01. Subscribe to T, then create an entity whose Property carries unitCode=CEL
=============================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. Notification body echoes the unitCode sub-attribute
=======================================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:E1",
          "temperature": {
            "type": "Property",
            "unitCode": "CEL",
            "value": 5
          },
          "type": "T"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "248",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(swBroker/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]

--TEARDOWN--
swBrokerStop
ftClientStop
