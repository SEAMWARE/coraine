#
# FILE            subscription_notif_show_changes.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# notification.showChanges (§ 5.2.14.1 / § 5.8.6): when true, the
# previousValue / previousObject / previousLanguageMap of each changed
# Attribute is emitted alongside the current values.
#
--NAME--
notification.showChanges — previousValue rendered

--TAGS--
subscription

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

echo "01. Seed V1 {speed=10}"
echo "======================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo


echo "02. Sub S1 with notification.showChanges=true"
echo "============================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:S1","type":"Subscription","entities":[{"type":"Vehicle"}],"notification":{"showChanges":true,"endpoint":{"uri":"http://localhost:'$FT_CLIENT_PORT'/notify"}}}'
echo
echo


echo "03. PATCH V1.speed 10 -> 22"
echo "==========================="
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1/attrs --payload '{"speed":{"type":"Property","value":22}}'
echo
echo


echo "04. Dump ftClient — notification has previousValue=10 alongside value=22"
echo "========================================================================"
ftClientDump
echo
echo


--EXPECT--
01. Seed V1 {speed=10}
======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




02. Sub S1 with notification.showChanges=true
=============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:S1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




03. PATCH V1.speed 10 -> 22
===========================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json




04. Dump ftClient — notification has previousValue=10 alongside value=22
========================================================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:V1",
          "speed": {
            "previousValue": 10,
            "type": "Property",
            "value": 22
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:S1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "235",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "swBroker"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
