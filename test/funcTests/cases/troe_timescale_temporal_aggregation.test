        ],
        [
          2,
          "2026-04-28T14:00:00Z",
          "2026-04-28T16:00:00Z"
        ]
      ],
      "type": "Property"
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
swTroeDrop
