    "type": "Park",
    "scope": "/Madrid/Gardens/ParqueSur",
    "name": {
      "type": "Property",
      "value": "Parque Sur"
    }
  }
]



08. scopeQ=/Madrid/+/ParqueNorte - single-level wildcard (E1)
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 3

[]



