#
# FILE            query_entities_with_pick.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?pick= returns only specified attributes

--TAGS--
entity query

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create Vehicle E1 with speed and color
# 02. GET entities?pick=speed - only speed attribute returned
#

echo "01. Create Vehicle E1 with speed and color"
echo "=========================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entities?pick=speed - only speed attribute returned"
echo "==========================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed and color
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




02. GET entities?pick=speed - only speed attribute returned
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 78

[
  {
    "speed": {
      "type": "Property",
      "value": 100
    }
  }
]



--TEARDOWN--
coraineStop
corDbDrop
