#
# FILE            query_entities_with_pick.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?pick= returns only specified attributes

--TAGS--
entity query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed and color
# 02. GET entities?pick=speed - only speed attribute returned
#

echo "01. Create Vehicle E1 with speed and color"
echo "=========================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entities?pick=speed - only speed attribute returned"
echo "==========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed and color
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entities?pick=speed - only speed attribute returned
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
