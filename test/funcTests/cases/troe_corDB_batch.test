#
# FILE            troe_corDB_batch.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE in corDB (--troe corDB): batch create, update and delete - every entity keeps its own history.
# The history is read back through the temporal API (§ 5.7.3).
#
# --troe corDB is the history inside the corDB store:
# REQUIRE_DB: corDB
#
--NAME--
TRoE corDB - batch create, update and delete

--TAGS--
troe batch

--INIT--
corDbDrop
coraineStart --troe corDB

--RUN--

echo "01. POST /entityOperations/create — 3 entities"
echo "==============================================="
corCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}},
  {"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":50}},
  {"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":60}}
]' | head -1
echo
echo


echo "02. POST /entityOperations/update — modify 2 entities"
echo "====================================================="
corCurl --url /ngsi-ld/v1/entityOperations/update --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99}},
  {"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":100}}
]' | head -1
echo
echo


echo "03. POST /entityOperations/delete — drop 2 entities"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1","urn:V3"]' | head -1
echo
echo

echo "04. GET /temporal/entities/urn:V1"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


echo "05. GET /temporal/entities/urn:V2"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V2
echo
echo


echo "06. GET /temporal/entities/urn:V3"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V3
echo
echo


--EXPECT--
01. POST /entityOperations/create — 3 entities
===============================================
HTTP/1.1 201 Created


02. POST /entityOperations/update — modify 2 entities
=====================================================
HTTP/1.1 204 No Content


03. POST /entityOperations/delete — drop 2 entities
===================================================
HTTP/1.1 204 No Content


04. GET /temporal/entities/urn:V1
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "deletedAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+Z)",
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 42
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 99
    }
  ],
  "type": "Vehicle"
}



05. GET /temporal/entities/urn:V2
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V2",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 50
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 100
    }
  ],
  "type": "Vehicle"
}



06. GET /temporal/entities/urn:V3
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "deletedAt": "REGEX(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+Z)",
  "id": "urn:V3",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 60
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
corDbDrop
