#
# FILE            batch_merge_attribute_type_change.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Merge (§ 10.3.5) follows the JSON Merge Patch / Merge Entity
# rules per entity, so — like a single Merge Entity — it must NOT change an
# attribute's type. A fragment that tries to is rejected for that entity with a
# per-entity 400 (BatchOperationResult 207), while the other entities in the
# same batch still merge. The rejected entity is left untouched. The check runs
# in the broker's in-memory merge pass (between the single bulk read and the
# single bulk write), so it adds no database round-trips.
#
--NAME--
Batch Merge rejects an attribute type change per-entity (§ 10.3.5)

--TAGS--
entity validation

--INIT--
corDbDrop
coraineStart

--RUN--
echo "01. Seed two entities, each with a Property 'a' -> 201, 201"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:B1","type":"T","a":{"type":"Property","value":1}}' | grep HTTP
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:B2","type":"T","a":{"type":"Property","value":2}}' | grep HTTP
echo
echo


echo "02. Batch merge: B1 changes 'a' to a Relationship (forbidden), B2 valid value update -> 207"
echo "==========================================================================================="
corCurl --url /ngsi-ld/v1/entityOperations/merge --payload '[{"id":"urn:ngsi-ld:B1","type":"T","a":{"type":"Relationship","object":"urn:ngsi-ld:x"}},{"id":"urn:ngsi-ld:B2","type":"T","a":{"value":99}}]'
echo
echo


echo "03. B1 is untouched (still Property 'a' = 1)"
echo "==========================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:B1?options=keyValues
echo
echo


echo "04. B2 got its valid update ('a' = 99)"
echo "======================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:B2?options=keyValues
echo
echo


echo "05. A batch merge with no type change still succeeds -> 204"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/entityOperations/merge --payload '[{"id":"urn:ngsi-ld:B2","type":"T","a":{"value":100}}]' | grep HTTP
echo
echo


--EXPECT--
01. Seed two entities, each with a Property 'a' -> 201, 201
===========================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. Batch merge: B1 changes 'a' to a Relationship (forbidden), B2 valid value update -> 207
===========================================================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 431

{
  "errors": [
    {
      "entityId": "urn:ngsi-ld:B1",
      "error": {
        "detail": "cannot change attribute 'https://uri.etsi.org/ngsi-ld/default-context/a' type from 'Property' to 'Relationship' in a Merge Entity operation",
        "status": 400,
        "title": "Attribute Type Change",
        "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
      }
    }
  ],
  "success": [
    "urn:ngsi-ld:B2"
  ]
}



03. B1 is untouched (still Property 'a' = 1)
===========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 54

{
  "a": 1,
  "id": "urn:ngsi-ld:B1",
  "type": "T"
}



04. B2 got its valid update ('a' = 99)
======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 55

{
  "a": 99,
  "id": "urn:ngsi-ld:B2",
  "type": "T"
}



05. A batch merge with no type change still succeeds -> 204
===========================================================
HTTP/1.1 204 No Content


--TEARDOWN--
coraineStop
