#
# FILE            url_param_sysattrs.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET entity/entities with sysAttrs=true returns timestamps

--TAGS--
sysattrs url-param

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create a simple entity with speed
# 02. GET entity with sysAttrs=true - timestamps present
# 03. GET entity without sysAttrs - timestamps stripped
# 04. GET entities with sysAttrs=true - array path with timestamps
#

echo "01. Create a simple entity with speed"
echo "====================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity with sysAttrs=true - timestamps present"
echo "======================================================"
corCurl --url '/ngsi-ld/v1/entities/urn:e1?sysAttrs=true'
echo
echo


echo "03. GET entity without sysAttrs - timestamps stripped"
echo "====================================================="
corCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


echo "04. GET entities with sysAttrs=true - array path with timestamps"
echo "================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&sysAttrs=true'
echo
echo


--EXPECT--
01. Create a simple entity with speed
=====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. GET entity with sysAttrs=true - timestamps present
======================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "createdAt": REGEX(".*"),
  "id": "urn:e1",
  "modifiedAt": REGEX(".*"),
  "speed": {
    "createdAt": REGEX(".*"),
    "modifiedAt": REGEX(".*"),
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



03. GET entity without sysAttrs - timestamps stripped
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



04. GET entities with sysAttrs=true - array path with timestamps
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "createdAt": REGEX(".*"),
    "id": "urn:e1",
    "modifiedAt": REGEX(".*"),
    "speed": {
      "createdAt": REGEX(".*"),
      "modifiedAt": REGEX(".*"),
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
coraineStop
corDbDrop
