#
# FILE            health_port_bind_error.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --healthPort on a port something else listens on: the broker exits 1 saying why it cannot listen -
# "Address already in use" (strerror) - as --corPort's message does. It said only "cannot listen for
# the health probes on port N".
#
# The port is held by a listener of the test's own (python3, all addresses, as the broker's IPv4
# fallback binds), the API port + 3260 and the health port + 3261.
#
# REQUIRE_FEATURE: HEALTH
#
--NAME--
The health port busy (--healthPort): the start-up error says why (strerror)

--TAGS--
health cli

--INIT--

--RUN--
HP=$((CB_PORT + 3261))

python3 -c "import socket, time; s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(('0.0.0.0', $HP)); s.listen(); time.sleep(20)" &
echo $! > /tmp/corTest_healthBusy.pid
corAwaitPort $HP 5


echo "01. coraine --healthPort <a port in use> - exit 1, the reason in the message"
echo "============================================================================"
corRoleLookup CB   # the role's database name, for corStoreArgs
timeout 10 $COR_BROKER --port $((CB_PORT + 3260)) $(corStoreArgs CB) --healthPort $HP > /tmp/corTest_healthBusy.out 2>&1
echo "exit code: $?"
grep -o "cannot listen for the health probes on port .*" /tmp/corTest_healthBusy.out | sed "s/port $HP/port HP/"
echo
echo


--TEARDOWN--
kill $(cat /tmp/corTest_healthBusy.pid) 2> /dev/null
rm -f /tmp/corTest_healthBusy.pid /tmp/corTest_healthBusy.out

--EXPECT--
01. coraine --healthPort <a port in use> - exit 1, the reason in the message
============================================================================
exit code: 1
cannot listen for the health probes on port HP: Address already in use


