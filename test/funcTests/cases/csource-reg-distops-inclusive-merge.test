Location: urn:V1
Link: REGEX(.*)
Content-Length: 0




HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0




HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": 1000,
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop -role CB
swBrokerStop -role CP1
swBrokerStop -role CP2
swDbDrop -role CB
swDbDrop -role CP1
swDbDrop -role CP2
