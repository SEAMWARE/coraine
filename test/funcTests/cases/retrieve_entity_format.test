#
--NAME--
GET /entities/{id} with format param (simplified, concise, normalized, keyValues)

--TAGS--
entity format retrieve

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity E1 with speed and color
# 02. GET E1 with no format (default normalized)
# 03. GET E1 with format=normalized
# 04. GET E1 with format=concise
# 05. GET E1 with format=simplified
# 06. GET E1 with format=keyValues (synonym for simplified)
#

echo "01. Create entity E1 with speed and color"
echo "========================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET E1 with no format (default normalized)"
echo "=============================================="
swCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


echo "03. GET E1 with format=normalized"
echo "================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?format=normalized'
echo
echo


echo "04. GET E1 with format=concise"
echo "=============================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?format=concise'
echo
echo


echo "05. GET E1 with format=simplified"
echo "================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?format=simplified'
echo
echo


echo "06. GET E1 with format=keyValues (synonym for simplified)"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:e1?format=keyValues'
echo
echo


--EXPECT--
01. Create entity E1 with speed and color
=========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET E1 with no format (default normalized)
==============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:e1",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



03. GET E1 with format=normalized
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:e1",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "type": "Vehicle"
}



04. GET E1 with format=concise
==============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "color": {
    "value": "red"
  },
  "id": "urn:e1",
  "speed": {
    "value": 100
  },
  "type": "Vehicle"
}



05. GET E1 with format=simplified
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "color": "red",
  "id": "urn:e1",
  "speed": 100,
  "type": "Vehicle"
}



06. GET E1 with format=keyValues (synonym for simplified)
=========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "color": "red",
  "id": "urn:e1",
  "speed": 100,
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swDbDrop
