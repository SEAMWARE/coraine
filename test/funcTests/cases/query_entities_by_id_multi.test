#
# FILE            query_entities_by_id_multi.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?id=x,y filters by multiple entity ids

--TAGS--
entity query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed
# 02. Create Building E2 with height
# 03. Create Vehicle E3 with color
# 04. GET entities?id=urn:e1,urn:e3 - E1 and E3 returned, E2 excluded
#

echo "01. Create Vehicle E1 with speed"
echo "================================"
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create Building E2 with height"
echo "=================================="
payload='{
  "id": "urn:e2",
  "type": "Building",
  "height": {
    "type": "Property",
    "value": 50
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create Vehicle E3 with color"
echo "================================"
payload='{
  "id": "urn:e3",
  "type": "Vehicle",
  "color": {
    "type": "Property",
    "value": "blue"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. GET entities?id=urn:e1,urn:e3 - E1 and E3 returned, E2 excluded"
echo "==================================================================="
swCurl --url '/ngsi-ld/v1/entities?id=urn:e1,urn:e3'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create Building E2 with height
==================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:e2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. Create Vehicle E3 with color
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:e3
Link: REGEX(.*)
Content-Length: REGEX(\d+)




04. GET entities?id=urn:e1,urn:e3 - E1 and E3 returned, E2 excluded
===================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  },
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:e3",
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
