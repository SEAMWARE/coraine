#
# FILE            ftclient_smoke.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
ftClient smoke test - accumulate requests, dump, clear

--INIT--
ftClientStart

--RUN--

#
# 01. POST a notification to ftClient
# 02. POST a second notification to ftClient
# 03. Dump accumulated notifications - two entries
# 04. Reset ftClient
# 05. Dump after reset - empty array
#

echo "01. POST a notification to ftClient"
echo "===================================="
payload='{
  "id": "urn:ngsi-ld:Notification:N1",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "2026-04-12T12:00:00Z",
  "data": [
    {
      "id": "urn:ngsi-ld:Vehicle:V1",
      "type": "Vehicle",
      "speed": {
        "type": "Property",
        "value": 120
      }
    }
  ]
}'
curl -s -o /dev/null -w "%{http_code}" -X POST http://localhost:$FT_CLIENT_PORT/notify \
  -H 'Content-Type: application/json' \
  -d "$payload"
echo
echo


echo "02. POST a second notification to ftClient"
echo "============================================"
payload='{
  "id": "urn:ngsi-ld:Notification:N2",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "2026-04-12T12:00:01Z",
  "data": [
    {
      "id": "urn:ngsi-ld:Vehicle:V1",
      "type": "Vehicle",
      "speed": {
        "type": "Property",
        "value": 130
      }
    }
  ]
}'
curl -s -o /dev/null -w "%{http_code}" -X POST http://localhost:$FT_CLIENT_PORT/notify \
  -H 'Content-Type: application/json' \
  -d "$payload"
echo
echo


echo "03. Dump accumulated notifications - two entries"
echo "================================================="
ftClientDump | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d),'notifications'); [print('  -',e['verb'],e['url'],e['body'].get('subscriptionId','?')) for e in d]"
echo
echo


echo "04. Reset ftClient"
echo "==================="
ftClientReset
echo "done"
echo
echo


echo "05. Dump after reset - empty array"
echo "==================================="
ftClientDump
echo
echo


--EXPECT--
01. POST a notification to ftClient
====================================
200

02. POST a second notification to ftClient
============================================
200

03. Dump accumulated notifications - two entries
=================================================
2 notifications
  - POST /notify urn:ngsi-ld:Subscription:S1
  - POST /notify urn:ngsi-ld:Subscription:S1


04. Reset ftClient
===================
done


05. Dump after reset - empty array
===================================
[]

--TEARDOWN--
ftClientStop
