# FILE            create_entity.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Create entity and retrieve it

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with id, type, and two properties
# 02. Retrieve the entity by ID
# 03. Query all entities
# 04. Attempt to create a duplicate - 409 Already Exists
# 05. Retrieve non-existing entity - 404 Not Found
#

echo "01. Create entity with id, type, and two properties"
echo "==================================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:A001",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 120
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Retrieve the entity by ID"
echo "============================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:A001
echo
echo


echo "03. Query all entities"
echo "======================"
swCurl --url /ngsi-ld/v1/entities
echo
echo


echo "04. Attempt to create a duplicate - 409 Already Exists"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:Vehicle:A001",
  "type": "Vehicle"
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Retrieve non-existing entity - 404 Not Found"
echo "================================================="
swCurl --url /ngsi-ld/v1/entities/urn:doesnt:exist
echo
echo


--EXPECT--
01. Create entity with id, type, and two properties
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:ngsi-ld:Vehicle:A001
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




02. Retrieve the entity by ID
=============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 180

{
  "id": "urn:ngsi-ld:Vehicle:A001",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 120
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}



03. Query all entities
======================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 208

[
  {
    "id": "urn:ngsi-ld:Vehicle:A001",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 120
    },
    "color": {
      "type": "Property",
      "value": "red"
    }
  }
]



04. Attempt to create a duplicate - 409 Already Exists
======================================================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 159

{
  "type": "https://uri.etsi.org/ngsi-ld/errors/AlreadyExists",
  "title": "Already Exists",
  "detail": "entity 'urn:ngsi-ld:Vehicle:A001' already exists"
}



05. Retrieve non-existing entity - 404 Not Found
=================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 144

{
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound",
  "title": "Not Found",
  "detail": "entity 'urn:doesnt:exist' not found"
}



--TEARDOWN--
swBrokerStop
swDbDrop
