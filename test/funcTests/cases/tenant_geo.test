--NAME--
Per-tenant geo-queries with NGSILD-Tenant header

--INIT--
swDbDrop
swDbDrop -tenant t1
swDbDrop -tenant t2
swBrokerStart

--RUN--

#
# 01. Create entity E1 in Madrid on tenant t1
# 02. Create entity E2 in Paris on tenant t2
# 03. GET near Madrid on t1 - should get E1
# 04. GET near Madrid on t2 - should get nothing (Paris is far)
# 05. GET near Paris on t2 - should get E2
# 06. Create entity E3 in Barcelona on t1
# 07. GET near Madrid within 600 km on t1 - should get E1 and E3
#

echo "01. Create entity E1 in Madrid on tenant t1"
echo "==========================================="
payload='{
  "id": "urn:e1",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.703, 40.417]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'NGSILD-Tenant: t1'
echo
echo


echo "02. Create entity E2 in Paris on tenant t2"
echo "=========================================="
payload='{
  "id": "urn:e2",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.349, 48.864]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'NGSILD-Tenant: t2'
echo
echo


echo "03. GET near Madrid on t1 - should get E1"
echo "========================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[-3.703,40.417\]' -H 'NGSILD-Tenant: t1'
echo
echo


echo "04. GET near Madrid on t2 - should get nothing (Paris is far)"
echo "============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[-3.703,40.417\]' -H 'NGSILD-Tenant: t2'
echo
echo


echo "05. GET near Paris on t2 - should get E2"
echo "========================================"
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[2.349,48.864\]' -H 'NGSILD-Tenant: t2'
echo
echo


echo "06. Create entity E3 in Barcelona on t1"
echo "======================================="
payload='{
  "id": "urn:e3",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.154, 41.390]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'NGSILD-Tenant: t1'
echo
echo


echo "07. GET near Madrid within 600 km on t1 - should get E1 and E3"
echo "=============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D600000&geometry=Point&coordinates=\[-3.703,40.417\]' -H 'NGSILD-Tenant: t1'
echo
echo


--EXPECT--
01. Create entity E1 in Madrid on tenant t1
===========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t1
Location: urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create entity E2 in Paris on tenant t2
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t2
Location: urn:e2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. GET near Madrid on t1 - should get E1
=========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t1
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e1",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          -3.703,
          40.417
        ],
        "type": "Point"
      }
    },
    "type": "City"
  }
]



04. GET near Madrid on t2 - should get nothing (Paris is far)
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t2
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



05. GET near Paris on t2 - should get E2
========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t2
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e2",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          2.349,
          48.864
        ],
        "type": "Point"
      }
    },
    "type": "City"
  }
]



06. Create entity E3 in Barcelona on t1
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t1
Location: urn:e3
Link: REGEX(.*)
Content-Length: REGEX(\d+)




07. GET near Madrid within 600 km on t1 - should get E1 and E3
==============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: t1
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e1",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          -3.703,
          40.417
        ],
        "type": "Point"
      }
    },
    "type": "City"
  },
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e3",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          2.154,
          41.39
        ],
        "type": "Point"
      }
    },
    "type": "City"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
swDbDrop -tenant t1
swDbDrop -tenant t2
