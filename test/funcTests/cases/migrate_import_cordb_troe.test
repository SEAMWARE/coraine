#
# FILE            migrate_import_cordb_troe.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# coraine-import (doc/migration.md) into corDB with its history inside it (--troe corDB): the stream's
# history written as it is - the source's instanceIds, createdAt, modifiedAt and observedAt - and
# nothing recorded on top of it for the current state the import writes (corDB records history at its
# own write sites; the import's are not). P1 has no history in the stream: it gets the history a create
# writes - its created event at its createdAt, its attribute as it is, at its own times, an instanceId
# generated.
#
# The history is in corDB's history log: a restarted broker reads it back the same. A second import of
# the stream is refused - the entities are there, and a history batch would repeat instanceIds.
#
# REQUIRE_DB: corDB
#
--NAME--
Migration import into corDB with --troe corDB - the source's history as it was, nothing on top

--TAGS--
migrate troe

--INIT--
corDbDrop
rm -rf /tmp/corTest-migrate-cordb
mkdir -p /tmp/corTest-migrate-cordb
cp "$REPO_ROOT"/test/funcTests/fixtures/migrate/orionld-stream.ndjson /tmp/corTest-migrate-cordb/

--RUN--

#
# 01. Import the stream into corDB, history and all (--troe corDB)
# 02. Start the broker on the migrated store
# 03. GET the history of V1 - the source's instanceIds and times, nothing more
# 04. GET the history of V9 - deleted, its history kept
# 05. GET the history of R1 in tenant t1
# 06. GET the history of P1 - none in the stream: the created row
# 07. Restart the broker - the history comes back from corDB's history log
# 08. GET the history of V1 again - the same
# 09. Import the stream again - the entities are there, the history batches would repeat instanceIds: all refused
# 10. GET the history of V1 - unchanged
#

D=/tmp/corTest-migrate-cordb

echo "01. Import the stream into corDB, history and all (--troe corDB)"
echo "================================================================"
coraineImport --troe corDB --file $D/orionld-stream.ndjson
echo "exit code: $?"
echo
echo


echo "02. Start the broker on the migrated store"
echo "=========================================="
coraineStart --troe corDB
echo "started"
echo
echo


echo "03. GET the history of V1 - the source's instanceIds and times, nothing more"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?options=sysAttrs'
echo
echo


echo "04. GET the history of V9 - deleted, its history kept"
echo "====================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V9?options=sysAttrs'
echo
echo


echo "05. GET the history of R1 in tenant t1"
echo "======================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Room:R1?options=sysAttrs' -H "NGSILD-Tenant: t1"
echo
echo


echo "06. GET the history of P1 - none in the stream: the created row"
echo "==============================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Parking:P1?options=sysAttrs'
echo
echo


echo "07. Restart the broker - the history comes back from corDB's history log"
echo "========================================================================"
coraineStop
coraineStart --troe corDB
echo "restarted"
echo
echo


echo "08. GET the history of V1 again - the same"
echo "=========================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?options=sysAttrs'
echo
echo


echo "09. Import the stream again - the entities are there, the history batches would repeat instanceIds: all refused"
echo "==============================================================================================================="
coraineStop
coraineImport --troe corDB --file $D/orionld-stream.ndjson
echo "exit code: $?"
echo
echo


echo "10. GET the history of V1 - unchanged"
echo "====================================="
coraineStart --troe corDB
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?options=sysAttrs'
echo
echo


--EXPECT--
01. Import the stream into corDB, history and all (--troe corDB)
================================================================
import of /tmp/corTest-migrate-cordb/orionld-stream.ndjson:
  entities                        3 imported,      0 refused
  subscriptions                   3 imported,      0 refused
  registrations                   1 imported,      0 refused
  temporal entity events          4 imported,      0 refused
  temporal instances              8 imported,      0 refused
  created rows (history)          1 written,       0 failed
exit code: 0


02. Start the broker on the migrated store
==========================================
started


