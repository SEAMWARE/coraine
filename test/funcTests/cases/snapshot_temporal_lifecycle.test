#
# FILE            snapshot_temporal_lifecycle.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16.2 / § 5.16.5 — temporal lifecycle:
#   - Clone copies temporal rows from source snap-tenant to clone snap-tenant
#   - Delete drops temporal rows owned by the snap-tenant (no leak)
#
# Requires postgres + the timescale TRoE plugin.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot temporal lifecycle — clone + delete (§ 5.16.2 / § 5.16.5 / Phase #146d)

--TAGS--
snapshot troe timescale postgres

--INIT--
corDbDrop
corSnapDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. Seed Vehicle V1 + 2 patches (3 temporal instances)"
echo "======================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":50}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":55}' >/dev/null
echo "  done"
echo
echo


echo "02. Create snapshot Src capturing temporal history"
echo "=================================================="
corCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Src",
  "type": "Snapshot",
  "snapshotTemporalQueries":[{
    "type":"Query",
    "entities":[{"type":"Vehicle"}],
    "temporalQ":{"timerel":"after","timeAt":"1970-01-01T00:00:00Z","timeproperty":"modifiedAt"}
  }]
}' >/dev/null
echo "  Src created"
echo
echo


echo "03. Row count per scope after capture"
echo "====================================="
# Live rows are in $COR_TROE_DB; each snapshot owns its own "${COR_TROE_DB}_snap_<seq>" database.
sleep 0.2
echo "$(psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -d "$COR_TROE_DB" -tAc "SELECT count(*) FROM troe_attrs")|live"
snapDb=$(psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -tAc "SELECT datname FROM pg_database WHERE datname LIKE '${COR_TROE_DB}_snap_%' ORDER BY datname LIMIT 1")
echo "$(psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -d "$snapDb" -tAc "SELECT count(*) FROM troe_attrs")|snap"
echo
echo


echo "04. POST /snapshots/Src/clone — clone Src to Dst"
echo "================================================="
corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Src/clone --payload '{"id":"urn:ngsi-ld:Snapshot:Dst","type":"Snapshot"}'
echo
echo


echo "05. Distinct snap-tenants in TRoE — expect 2 (Src + Dst)"
echo "========================================================"
# Each snap-tenant owns its own database, so count the snap databases.
sleep 0.2
psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -tAc \
  "SELECT count(*) FROM pg_database WHERE datname LIKE '${COR_TROE_DB}_snap_%'"
echo
echo


echo "06. Read temporal via NGSILD-Snapshot: Dst — sees the cloned 3 instances"
echo "========================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Dst'
echo
echo


echo "07. DELETE Src — its temporal rows must be removed"
echo "=================================================="
corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Src -X DELETE | head -1
echo
echo


echo "08. Distinct snap-tenants left after Src delete — expect 1 (Dst only)"
echo "====================================================================="
# Deleting a snapshot drops its whole TRoE database (DROP DATABASE).
sleep 0.2
psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -tAc \
  "SELECT count(*) FROM pg_database WHERE datname LIKE '${COR_TROE_DB}_snap_%'"
echo
echo


echo "09. DELETE Dst — both snap-tenants gone"
echo "======================================="
corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Dst -X DELETE | head -1
echo
echo


echo "10. Final snap-tenant TRoE databases — expect 0"
echo "==============================================="
# Both snapshots deleted → both snap databases dropped.
sleep 0.2
psql -h "$COR_TROE_HOST" -p "$COR_TROE_PORT" -U postgres -tAc \
  "SELECT count(*) FROM pg_database WHERE datname LIKE '${COR_TROE_DB}_snap_%'"
echo
echo


--EXPECT--
01. Seed Vehicle V1 + 2 patches (3 temporal instances)
======================================================
  done


02. Create snapshot Src capturing temporal history
==================================================
  Src created


03. Row count per scope after capture
=====================================
3|live
3|snap


04. POST /snapshots/Src/clone — clone Src to Dst
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Dst
Content-Length: 0




05. Distinct snap-tenants in TRoE — expect 2 (Src + Dst)
========================================================
2


06. Read temporal via NGSILD-Snapshot: Dst — sees the cloned 3 instances
========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Dst
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "speed": [
    {
      "instanceId": "REGEX(.*)",
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 55
    },
    {
      "instanceId": "REGEX(.*)",
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 50
    },
    {
      "instanceId": "REGEX(.*)",
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 42
    }
  ],
  "type": "Vehicle"
}



07. DELETE Src — its temporal rows must be removed
==================================================
HTTP/1.1 204 No Content


08. Distinct snap-tenants left after Src delete — expect 1 (Dst only)
=====================================================================
1


09. DELETE Dst — both snap-tenants gone
=======================================
HTTP/1.1 204 No Content


10. Final snap-tenant TRoE databases — expect 0
===============================================
0


--TEARDOWN--
coraineStop
corSnapDrop
corDbDrop
corTroeDrop
