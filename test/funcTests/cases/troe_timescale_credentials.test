#
# FILE            troe_timescale_credentials.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE timescale plugin: the credentials.
#
#   - a user, a password and a database name with a space, a ' and a \ go to PostgreSQL as written: each
#     value is quoted in the libpq connection string. Unquoted, the password ended at its space and the
#     rest was taken as syntax - the connection string refused, the start waiting --troeConnectTimeout
#     seconds for a database that was there
#   - a password the server refuses fails the start at once, with the server's message - it was taken for
#     a database that cannot be reached and tried once a second for --troeConnectTimeout seconds (30)
#   - no password where the server asks for one: the same
#   - MongoDB alike: a user and password it refuses fail the start at once
#
# A role and a database of the test's own, dropped in the TEARDOWN. The broker is started here, in the
# background, on a port of its own: its arguments have spaces in them.
#
# Reads timescale's own tables (psql) - not a store-independent check:
# REQUIRE_TROEDB: timescale
#
--NAME--
TRoE timescale - credentials as written (quoted), a refused password fails the start at once

--TAGS--
troe timescale postgres cli

--INIT--
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d postgres -q -c 'DROP DATABASE IF EXISTS "cortest cred db" WITH (FORCE)' -c 'DROP ROLE IF EXISTS "cortest cred"' > /dev/null 2>&1
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d postgres -q -c "CREATE ROLE \"cortest cred\" LOGIN SUPERUSER PASSWORD 'a b''c\\d'"

--RUN--
D=/tmp/corTest_troeCredentials
rm -rf $D
mkdir -p $D
P=$((CB_PORT + 3250))
PW="a b'c\\d"

#
# brokerStart <args> - the broker in the background on port $P, its pid in $D/pid, its output in $D/out
#
brokerStart() {
  $COR_BROKER -fg --port $P --database $COR_PLUGIN_DIR/db/currentState/corDB.so --troe timescale --troeHost $COR_TROE_HOST --troePort $COR_TROE_PORT "$@" > $D/out 2>&1 &
  echo $! > $D/pid
}

#
# startRefused <args> - the broker started, at most 20 s given: its exit code, whether that was within 10 s
# (--troeConnectTimeout is 30), and its log lines saying why
#
startRefused() {
  local t0=$(date +%s)
  brokerStart --troeConnectTimeout 30 "$@"
  local pid=$(cat $D/pid)
  for _ in $(seq 1 200); do
    kill -0 $pid 2> /dev/null || break
    sleep 0.1
  done
  if kill -0 $pid 2> /dev/null; then
    echo "still running after 20 s"
    kill -9 $pid
  fi
  wait $pid 2> /dev/null
  echo "exit: $?"
  [ $(( $(date +%s) - t0 )) -lt 10 ] && echo "within 10 s" || echo "after 10 s or more"
  grep -c "the history database cannot be reached" $D/out
  grep -o "refused (--troeUser, --troePwd): .*" $D/out | head -1 | sed 's/: connection to server at .* failed: /: /'
  rm -f $D/pid
}


echo "01. User, database name and password with a space, a ' and a \\ - the broker serves, the history recorded"
echo "========================================================================================================"
brokerStart --troeUser "cortest cred" --troePwd "$PW" --troeName "cortest cred db" --troeConnectTimeout 3
for _ in $(seq 1 100); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' http://localhost:$P/version)" = 200 ] && break
  sleep 0.1
done
curl -s -o /dev/null -w "POST: %{http_code}\n" http://localhost:$P/ngsi-ld/v1/entities -H 'Content-Type: application/json' -d '{"id":"urn:C1","type":"T","p":{"type":"Property","value":1}}'
curl -s -o /dev/null -w "temporal GET: %{http_code}\n" http://localhost:$P/ngsi-ld/v1/temporal/entities/urn:C1
kill $(cat $D/pid)
wait $(cat $D/pid) 2> /dev/null
rm -f $D/pid
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d "cortest cred db" -tA -c "SELECT count(*) FROM troe_entities WHERE entity_id = 'urn:C1'"
grep -c "the history database cannot be reached" $D/out
echo
echo


echo "02. A wrong password - the start refused at once, with the server's message"
echo "==========================================================================="
startRefused --troeUser "cortest cred" --troePwd "a b'c" --troeName "cortest cred db"
echo
echo


echo "03. No password, PGPASSWORD unset - the server asks for one: the start refused at once"
echo "======================================================================================"
PGPASSWORD_SAVED=$PGPASSWORD
unset PGPASSWORD
startRefused --troeUser "cortest cred" --troeName "cortest cred db"
export PGPASSWORD=$PGPASSWORD_SAVED
echo
echo


echo "04. MongoDB: a user and password it refuses - the start refused at once"
echo "======================================================================="
t0=$(date +%s)
timeout 20 $COR_BROKER -fg --port $P --database $COR_PLUGIN_DIR/db/currentState/mongoc.so --dbHost $COR_MONGO_HOST --dbPort $COR_MONGO_PORT --dbName cortestcred --dbUser cortestcred --dbPwd nottheone > $D/out 2>&1
echo "exit: $?"
[ $(( $(date +%s) - t0 )) -lt 10 ] && echo "within 10 s" || echo "after 10 s or more"
grep -o "mongoc: ping failed: .*" $D/out
echo
echo


--TEARDOWN--
[ -f /tmp/corTest_troeCredentials/pid ] && kill -9 $(cat /tmp/corTest_troeCredentials/pid) 2> /dev/null
rm -rf /tmp/corTest_troeCredentials
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d postgres -tAc "SELECT datname FROM pg_database WHERE datname LIKE 'cortest cred db%'" 2> /dev/null | while read -r db; do
  [ -n "$db" ] && psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d postgres -q -c "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE)" > /dev/null 2>&1
done
psql -h $COR_TROE_HOST -p $COR_TROE_PORT -U $COR_TROE_USER -d postgres -q -c 'DROP ROLE IF EXISTS "cortest cred"' > /dev/null 2>&1

--EXPECT--
01. User, database name and password with a space, a ' and a \ - the broker serves, the history recorded
========================================================================================================
POST: 201
temporal GET: 200
1
0


02. A wrong password - the start refused at once, with the server's message
===========================================================================
exit: 1
within 10 s
0
refused (--troeUser, --troePwd): FATAL:  password authentication failed for user "cortest cred"


03. No password, PGPASSWORD unset - the server asks for one: the start refused at once
======================================================================================
exit: 1
within 10 s
0
refused (--troeUser, --troePwd): fe_sendauth: no password supplied


04. MongoDB: a user and password it refuses - the start refused at once
=======================================================================
exit: 1
within 10 s
mongoc: ping failed: Authentication failed.


