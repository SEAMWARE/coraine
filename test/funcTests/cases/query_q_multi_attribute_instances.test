#
# FILE            query_q_multi_attribute_instances.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# q against a MULTI-ATTRIBUTE (§ 8.5 — several instances of one Attribute name,
# told apart by datasetId).
#
# TS 104-175 clause 7, "target value": "If a Property has multiple instances
# (identified by its respective datasetId), and no datasetId is explicitly
# addressed, the target value shall be ANY Value of such instances." The same
# sentence is given for a Relationship's object.
#
# Both backends broke that, and each in its own way:
#   mongoc  compiled the term to the fixed path <attr>.@none.value, so only the
#           DEFAULT instance was ever compared - and an Attribute with no default
#           instance at all (urn:Q:2 below) could not be matched by any term.
#   ramdb   took wrapper->firstChild, so only the FIRST instance was compared.
# Existence (`q=speed`) was the one thing both got right, which is why nothing
# noticed. The earlier q sweep used single-instance fixtures throughout.
#
# Negative operators take the rule this codebase already applies wherever one
# term faces several candidate values (an array value, and "[*]" across a
# languageMap): positive = ANY, negative = ALL. So `speed!=10` does NOT match an
# Entity that has an instance of 10.
#
--NAME--
q addresses every instance of a multi-attribute, not just the default one (clause 7)

--TAGS--
q query multi-attr datasetId

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed: Q:1 has a datasetId instance AND a default one; Q:2 has NO default instance"
echo "===================================================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{ "id": "urn:Q:1", "type": "T",
  "speed": [ { "type": "Property", "value": 55, "datasetId": "urn:ds:1" },
             { "type": "Property", "value": 10 } ],
  "held":  [ { "type": "Relationship", "object": "urn:o:1", "datasetId": "urn:ds:1" },
             { "type": "Relationship", "object": "urn:o:2" } ] }' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{ "id": "urn:Q:2", "type": "T",
  "speed": [ { "type": "Property", "value": 77, "datasetId": "urn:ds:1" },
             { "type": "Property", "value": 88, "datasetId": "urn:ds:2" } ] }' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{ "id": "urn:Q:3", "type": "T",
  "speed": { "type": "Property", "value": 10 } }' | head -1
echo
echo


echo "02. The DEFAULT instance still matches (Q:1 default=10, Q:3 single=10)"
echo "======================================================================"
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed==10&options=keyValues'
echo
echo


echo "03. A datasetId instance matches too - this is what used to find nothing"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed==55&options=keyValues'
echo
echo


echo "04. ... including on an Entity that has NO default instance at all (Q:2)"
echo "======================================================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed==77&options=keyValues'
echo
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed==88&options=keyValues'
echo
echo


echo "05. Relational operators range over the instances as well"
echo "========================================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed>50&options=keyValues'
echo
echo


echo "06. Negative operator: EVERY instance must satisfy it, so Q:1 (which has a 10) is out"
echo "====================================================================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed!=10&options=keyValues'
echo
echo


echo "07. A value no instance holds matches nothing"
echo "============================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed==999&options=keyValues'
echo
echo


echo "08. Existence is unchanged - all three have the Attribute"
echo "========================================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=speed&options=keyValues'
echo
echo


echo "09. A Relationship's object is 'any object of such instances' too"
echo "================================================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&q=held=="urn:o:1"&options=keyValues'
echo


--TEARDOWN--
swBrokerStop

--EXPECT--
01. Seed: Q:1 has a datasetId instance AND a default one; Q:2 has NO default instance
====================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. The DEFAULT instance still matches (Q:1 default=10, Q:3 single=10)
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 311

[
  {
    "held": {
      "dataset": {
        "@none": "urn:o:2",
        "urn:ds:1": "urn:o:1"
      }
    },
    "id": "urn:Q:1",
    "speed": {
      "dataset": {
        "@none": 10,
        "urn:ds:1": 55
      }
    },
    "type": "T"
  },
  {
    "id": "urn:Q:3",
    "speed": 10,
    "type": "T"
  }
]



