#
# FILE            langprop_post_query.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# POST /entityOperations/query (§ 5.7.2) returning a LanguageProperty:
# normalized renders the full languageMap; a `lang` filter (carried in the query
# BODY) reduces it to the matching language's value, falling back to en when the
# requested language is absent.
#
--NAME--
POST query returns LanguageProperty; body lang filter reduces + falls back

--TAGS--
langProp query batch

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed entity with a LanguageProperty L"
echo "========================================="
payload='{
  "id": "urn:ngsi-ld:T:E1",
  "type": "T",
  "L": { "type":"LanguageProperty", "languageMap": { "en":"English", "es":"Spanish" } }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" | head -1
echo
echo


echo "02. POST query (normalized) — full languageMap"
echo "=============================================="
payload='{ "type": "Query", "entities": [{"type":"T"}] }'
swCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload"
echo
echo


echo "03. POST query with body lang=es — reduced to the es value"
echo "=========================================================="
payload='{ "type": "Query", "entities": [{"type":"T"}], "lang": "es" }'
swCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload"
echo
echo


echo "04. POST query with body lang=ex (absent) — falls back to en"
echo "============================================================"
payload='{ "type": "Query", "entities": [{"type":"T"}], "lang": "ex" }'
swCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload"
echo
echo


--EXPECT--
01. Seed entity with a LanguageProperty L
=========================================
HTTP/1.1 201 Created


02. POST query (normalized) — full languageMap
==============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 190

[
  {
    "L": {
      "languageMap": {
        "en": "English",
        "es": "Spanish"
      },
      "type": "LanguageProperty"
    },
    "id": "urn:ngsi-ld:T:E1",
    "type": "T"
  }
]



03. POST query with body lang=es — reduced to the es value
==========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 147

[
  {
    "L": {
      "lang": "es",
      "type": "Property",
      "value": "Spanish"
    },
    "id": "urn:ngsi-ld:T:E1",
    "type": "T"
  }
]



04. POST query with body lang=ex (absent) — falls back to en
============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 147

[
  {
    "L": {
      "lang": "en",
      "type": "Property",
      "value": "English"
    },
    "id": "urn:ngsi-ld:T:E1",
    "type": "T"
  }
]



--TEARDOWN--
swBrokerStop
