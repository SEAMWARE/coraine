#
# FILE            big_float_value_roundtrip.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Ported from orion-ld ngsild_big_integer. A large numeric Property value given
# as a float (1543924800.0) round-trips without precision loss. The entity id is
# a plain http URI. (orion checked the DB directly; here the API GET is the check.)
#
--NAME--
Large numeric (float) attribute value round-trips without precision loss

--TAGS--
entity attr value-type

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create an entity (http URI id) with a large float-valued Property
# 02. GET the entity — the value round-trips exactly
#

echo "01. Create entity with a large float value"
echo "=========================================="
corCurl --url /ngsi-ld/v1/entities -X POST --payload '{
  "id": "http://a.b.c/xxx",
  "type": "T",
  "P1": { "type": "Property", "value": 1543924800.0 }
}'
echo
echo


echo "02. GET the entity — value round-trips"
echo "======================================"
corCurl --url '/ngsi-ld/v1/entities/http://a.b.c/xxx'
echo
echo


--EXPECT--
01. Create entity with a large float value
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/http://a.b.c/xxx
Content-Length: 0




02. GET the entity — value round-trips
======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 109

{
  "P1": {
    "type": "Property",
    "value": 1543924800
  },
  "id": "http://a.b.c/xxx",
  "type": "T"
}



--TEARDOWN--
coraineStop
corDbDrop
