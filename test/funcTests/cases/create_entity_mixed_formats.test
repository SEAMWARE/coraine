#
# FILE            create_entity_mixed_formats.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
POST /ngsi-ld/v1/entities - mixed normalized/concise/simplified input

--TAGS--
create entity format

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# Mixed input format: normalized, concise, and simplified attributes in one entity
#
# 01. Create entity with mix of all three formats
# 02. GET entity E1 - verify all attributes come back normalized
#

echo "01. Create entity with mix of normalized, concise, and simplified"
echo "================================================================="
payload='{
  "id": "urn:mix:E1",
  "type": "T",
  "normalizedAttr": {
    "type": "Property",
    "value": "fully normalized"
  },
  "conciseAttr": {
    "value": 42
  },
  "simplifiedString": "hello",
  "simplifiedInt": 99,
  "simplifiedBool": false,
  "conciseRel": {
    "object": "urn:target:1"
  },
  "simplifiedGeo": {
    "type": "Point",
    "coordinates": [10.0, 20.0]
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity E1 - verify all attributes normalized"
echo "===================================================="
swCurl --url /ngsi-ld/v1/entities/urn:mix:E1
echo
echo


--EXPECT--
01. Create entity with mix of normalized, concise, and simplified
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:mix:E1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entity E1 - verify all attributes normalized
====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "conciseAttr": {
    "type": "Property",
    "value": 42
  },
  "conciseRel": {
    "object": "urn:target:1",
    "type": "Relationship"
  },
  "id": "urn:mix:E1",
  "normalizedAttr": {
    "type": "Property",
    "value": "fully normalized"
  },
  "simplifiedBool": {
    "type": "Property",
    "value": false
  },
  "simplifiedGeo": {
    "type": "GeoProperty",
    "value": {
      "coordinates": [
        10,
        20
      ],
      "type": "Point"
    }
  },
  "simplifiedInt": {
    "type": "Property",
    "value": 99
  },
  "simplifiedString": {
    "type": "Property",
    "value": "hello"
  },
  "type": "T"
}



--TEARDOWN--
swBrokerStop
swDbDrop
