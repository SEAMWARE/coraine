#
# FILE            entitymap_header_distop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 6.4.3.2 Table 6.4.3.2-2 — NGSILD-EntityMap request header on
# GET /entities is an alternative to ?entityMap=<id>.
#
# § 5.14.4.4 — when the local broker paginates a distributed EntityMap
# and the local map has linkedMaps[csr] = remote-id, the per-CSR
# entity fetch must include `NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/<remote-id>`
# so the CP serves from its frozen snapshot.
#
# Test: CB+CP1 with V1 (local), V2 (CP1). Build distributed map on CB.
# Then page with the local map id; the CP1-bound entity fetch must
# carry the corresponding remote map id in the NGSILD-EntityMap header.
# To verify, ftClient (acting as CP1) is configured to require that
# header on the entity fetch — without it, no notification arrives.
#
# Simpler approach used here: use a real CP1 broker (so we can read its
# entity map in the response of a CB pagination), and verify both:
#   (a) Request-side: GET /entities with NGSILD-EntityMap request header
#       (instead of ?entityMap=) returns the same paged result.
#   (b) Distop-side: the linkedMap on CB really points to a CP1 map id
#       that matches CP1's served EntityMap (proxy verification — the
#       header is internal; visible side-effect is correct V2 retrieval).
#
--NAME--
EntityMap NGSILD-EntityMap header — request side + linkedMaps fed to CP (§ 5.14.4.4 / § 6.4.3.2)

--TAGS--
entitymap distops query

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities
swBrokerStart -role CP1 --noSplitEntities

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Seed: V1 on CB, V2 on CP1; CSR CB→CP1 (Vehicle)"
echo "===================================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:R1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","operations":["queryEntity","retrieveEntity"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "02. Build distributed map on CB → captures local + remote (linkedMaps populated)"
echo "================================================================================"
MAP_ID=$(swCurl --url '/ngsi-ld/v1/entityMaps?type=Vehicle&orderBy=id' 2>/dev/null | grep -i '^NGSILD-EntityMap:' | sed -E 's|.*entityMaps/([^[:space:]]+)|\1|' | tr -d '\r')
echo "captured map id: ${MAP_ID:0:24}... (truncated)"
echo
echo


echo "03. Page via ?entityMap=<local-id> — both V1 (local) and V2 (CP1 via linkedMap)"
echo "==============================================================================="
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&options=keyValues&limit=10"
echo
echo


echo "04. Same page via NGSILD-EntityMap request header (alt to ?entityMap=)"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&limit=10' \
       -H "NGSILD-EntityMap: /ngsi-ld/v1/entityMaps/$MAP_ID"
echo
echo


--EXPECT--
01. Seed: V1 on CB, V2 on CP1; CSR CB→CP1 (Vehicle)
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0


HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0


HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Content-Length: 0




02. Build distributed map on CB → captures local + remote (linkedMaps populated)
================================================================================
captured map id: REGEX(.*)


03. Page via ?entityMap=<local-id> — both V1 (local) and V2 (CP1 via linkedMap)
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 139

[
  {
    "id": "urn:V1",
    "speed": 10,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 20,
    "type": "Vehicle"
  }
]



04. Same page via NGSILD-EntityMap request header (alt to ?entityMap=)
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 139

[
  {
    "id": "urn:V1",
    "speed": 10,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 20,
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
