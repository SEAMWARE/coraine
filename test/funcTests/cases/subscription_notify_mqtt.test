#
# FILE            subscription_notify_mqtt.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7 — MQTT notification binding. Subscriber's endpoint.uri starts
# with mqtt://; broker connects as MQTT client to that broker and
# publishes the wrapped { metadata, body } JSON.
#
# Test rig: a private mosquitto on port 11883 (anonymous, runtime
# config), ftClient subscribed to topic ngsild/notif. MQTT messages
# land in the same dump array as HTTP notifications, with verb="MQTT".
#
--NAME--
Subscription notification - MQTT delivery (§ 7)

--TAGS--
subscription notification mqtt

--INIT--
corDbDrop
echo "listener 11883
allow_anonymous true" > /tmp/mqtt-test-mosquitto.conf
mosquitto -d -c /tmp/mqtt-test-mosquitto.conf
mosquittoWait 11883
ftClientStart --mqttPort 11883 --mqttTopic ngsild/notif
coraineStart

--RUN--

echo "01. Create subscription with mqtt:// endpoint, QoS=0"
echo "===================================================="
payload='{
  "id":"urn:ngsi-ld:Subscription:mqtt-S1",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{
      "uri":"mqtt://localhost:11883/ngsild/notif",
      "notifierInfo":[
        {"key":"MQTT-QoS","value":"0"}
      ]
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. POST a Vehicle — should trigger an MQTT publish"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99}}'
echo
echo


echo "03. Wait briefly, then verify ftClient received one MQTT entry"
echo "=============================================================="
ftClientWait 1
# One read, several checks. A dump consumes what it returns, so asking
# ftClient five times would answer once and then four empty arrays.
notifs=$(ftClientDump)
echo "$notifs" | grep -cE '"verb": "MQTT"'
echo "$notifs" | grep -cE '"url": "ngsild/notif"'
echo "$notifs" | grep -cE 'subscriptionId.*mqtt-S1'
echo "$notifs" | grep -cE 'metadata.*Content-Type.*application/json'
echo "$notifs" | grep -cE 'urn:V1.*type.*Vehicle'
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Create subscription with mqtt:// endpoint, QoS=0
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:mqtt-S1
Content-Length: 0




02. POST a Vehicle — should trigger an MQTT publish
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. Wait briefly, then verify ftClient received one MQTT entry
==============================================================
1
1
1
1
1


[]
--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
pkill -f "mosquitto -d -c /tmp/mqtt-test-mosquitto.conf" 2>/dev/null
\rm -f /tmp/mqtt-test-mosquitto.conf
