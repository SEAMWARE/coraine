#
# FILE            jsonld_contexts_post_array.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# POST /jsonldContexts with an array @context body — the common shape in
# real-world deployments where one bundle pulls in multiple base contexts
# plus inline overrides. Each URL element is downloaded as Implicit.
#
--NAME--
POST /jsonldContexts with array @context (Hosted)

--TAGS--
context entity

--INIT--
corDbDrop
corDbDrop -db coraine
contextServerStart
coraineStart

contextServerPush /jsonldContexts/childA '{
  "@context": {
    "a": "https://example.org/a"
  }
}'

contextServerPush /jsonldContexts/childB '{
  "@context": {
    "b": "https://example.org/b"
  }
}'

--RUN--

#
# 01. POST Hosted with array: 2 URL refs + 1 inline object
# 02. LIST Hosted — the wrapper
# 03. LIST Cached — both child URLs got downloaded and (per § 5.13.2.5) tagged Cached
# 04. GET the hosted body — returns the original array body
# 05. POST Hosted with empty @context array — 201 (degenerate but legal)
#

echo "01. POST Hosted (array)"
echo "======================="
payload='{
  "@context": [
    "http://localhost:7080/jsonldContexts/childA",
    "http://localhost:7080/jsonldContexts/childB",
    {
      "local": "https://example.org/local"
    }
  ]
}'
corCurl --url /ngsi-ld/v1/jsonldContexts --in jsonld --payload "$payload"
echo
echo


echo "02. LIST Hosted"
echo "==============="
corCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Hosted"
echo
echo


echo "03. LIST Cached (child URLs downloaded)"
echo "======================================="
corCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Cached"
echo
echo


echo "04. GET hosted body — array preserved"
echo "====================================="
hostedId=$(corCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Hosted" | grep -oE 'urn:ngsi-ld:Context:[0-9]+-[0-9]+' | head -1)
corCurl --url "/ngsi-ld/v1/jsonldContexts/${hostedId}"
echo
echo


echo "05. POST Hosted with empty array"
echo "================================"
payload='{"@context":[]}'
corCurl --url /ngsi-ld/v1/jsonldContexts --in jsonld --payload "$payload" | head -1
echo
echo


--EXPECT--
01. POST Hosted (array)
=======================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: REGEX(/ngsi-ld/v1/jsonldContexts/urn:ngsi-ld:Context:.*)
Content-Length: 0




02. LIST Hosted
===============
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  REGEX("http://localhost:.*/ngsi-ld/v1/jsonldContexts/urn:ngsi-ld:Context:.*")
]



03. LIST Cached (child URLs downloaded)
=======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  "http://localhost:7080/jsonldContexts/childB",
  "http://localhost:7080/jsonldContexts/childA"
]



04. GET hosted body — array preserved
=====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "@context": [
    "http://localhost:7080/jsonldContexts/childA",
    "http://localhost:7080/jsonldContexts/childB",
    {
      "local": "https://example.org/local"
    }
  ]
}



05. POST Hosted with empty array
================================
HTTP/1.1 201 Created


--TEARDOWN--
coraineStop
contextServerStop
corDbDrop -db coraine
corDbDrop
