# REQUIRE_FEATURE: REGISTRATIONS
#
--NAME--
DistOps - replaceEntity (PUT): redirect, inclusive, ?local bypass, loop skip (real CP1)

--TAGS--
distops registration replace

--INIT--
corDbDrop
corDbDrop -role CP1
coraineStart -dist
coraineStart -role CP1 -dist

--RUN--

#
# Real CB + CP1 brokers.
#
# 01-04  redirect: CP1 owns V1, CB has redirect CSR, PUT on CB replaces V1 on CP1
# 05-09  inclusive: local V2 + remote V2, PUT replaces both
# 10-13  ?local=true bypass: CSR exists but ignored; only local replaced
# 14-15  loop-skip: own Via alias → no forward, local replace still runs
#

# --- 01-04: redirect ---
echo "01. Seed CP1 with V1 (speed=50, color=blue)"
echo "==========================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":50},"color":{"type":"Property","value":"blue"}}'
echo
echo


echo "02. Register CB→CP1 redirect CSR on V1 with replaceEntity + retrieveEntity"
echo "=========================================================================="
payload='{
  "id": "urn:CSR:ReplRedir",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "redirect",
  "operations": ["replaceEntity", "retrieveEntity"],
  "information": [{"entities":[{"id":"urn:V1","type":"Vehicle"}]}]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "03. PUT urn:V1 on CB: full new body → forwarded to CP1 → 204"
echo "============================================================"
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X PUT --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":77},"brand":{"type":"Property","value":"Zed"}}'
echo
echo


echo "04. GET urn:V1 on CP1 → speed=77, brand=Zed, color gone"
echo "======================================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


# --- 05-09: inclusive (local + forward) ---
echo "05. Seed CP1 with urn:V2, AND local CB with urn:V2"
echo "=================================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
corCurl --url /ngsi-ld/v1/entities --urlParams 'local=true' --payload '{"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"red"}}'
echo
echo


echo "06. Register CB→CP1 inclusive CSR on urn:V2 with replaceEntity"
echo "=============================================================="
payload='{
  "id": "urn:CSR:ReplIncl",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["replaceEntity", "retrieveEntity"],
  "information": [{"entities":[{"id":"urn:V2","type":"Vehicle"}]}]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "07. PUT urn:V2: new body → local AND forward → 204"
echo "=================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V2 -X PUT --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":111},"color":{"type":"Property","value":"white"}}'
echo
echo


echo "08. GET urn:V2 on CB ?local=true → speed=111, color=white (local replaced)"
echo "=========================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V2 --urlParams 'local=true'
echo
echo


echo "09. GET urn:V2 on CP1 directly → speed=111, color=white (remote replaced)"
echo "========================================================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V2
echo
echo


# --- 10-13: ?local=true bypass ---
echo "10. Seed CP1 with urn:V3, register exclusive CSR on CB claiming speed"
echo "====================================================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":1}}'
echo
payload='{
  "id": "urn:CSR:ReplBypass",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "operations": ["replaceEntity"],
  "information": [
    {
      "entities": [{"id": "urn:V3", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "11. Seed CB's local urn:V3 with color"
echo "====================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'local=true' --payload '{"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"green"}}'
echo
echo


echo "12. PUT urn:V3 ?local=true → CSR skipped, local-only replace (204)"
echo "=================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V3 --urlParams 'local=true' -X PUT --payload '{"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"gold"}}'
echo
echo


echo "13. GET urn:V3 on CP1 → still speed=1 (bypass did not forward)"
echo "=============================================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V3
echo
echo


# --- 14-15: loop skip ---
echo "14. PUT with own Via alias → forward skipped, local replace still runs"
echo "======================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:V3 -X PUT -H "Via: 1.1 localhost:$CB_PORT" --payload '{"id":"urn:V3","type":"Vehicle","brand":{"type":"Property","value":"Ghost"}}'
echo
echo


echo "15. GET urn:V3 on CB ?local=true → brand=Ghost (color wiped by Replace)"
echo "======================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V3 --urlParams 'local=true'
echo
echo


--EXPECT--
