#
# Copyright 2026 Seamware
#
--NAME--
GET /ngsi-ld/v1/entities - Type Selection Language (OR, AND, mixed)

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# Setup:
# 01. Create E1 type=Building
# 02. Create E2 type=House
# 03. Create E3 type=[Home, Vehicle]
# 04. Create E4 type=Motorhome
#
# Type selection queries:
# 05. ?type=Building - E1 only
# 06. ?type=Building,House - E1, E2 (OR with comma)
# 07. ?type=Building|House - E1, E2 (OR with pipe)
# 08. ?type=(Home;Vehicle) - E3 (AND)
# 09. ?type=(Home;Vehicle)|Motorhome - E3, E4 (mixed)
# 10. ?type=Home - E3 (multi-type entity matches on any single type)
# 11. ?type=(Building;Vehicle) - empty (no entity has both)
#
# Extended combinatorics:
# 12. Create E5 type=[Home, Vehicle, Boat]
# 13. ?type=(Building;House),(Home;Motorhome) - two AND groups OR'd with comma (no match)
# 14. ?type=(Home;Vehicle;Boat) - 3-type AND (E5 only)
# 15. ?type=Building,House,Motorhome - 3+ simple OR (E1, E2, E4)
# 16. ?type=(Home;Vehicle),Motorhome - comma as outer OR with AND group (E3, E4, E5)
# 17. ?type=Vehicle - partial match on multi-type returns E3 and E5
#

echo "01. Create E1 type=Building"
echo "==========================="
payload='{
  "id": "urn:entity:E1",
  "type": "Building",
  "name": {
    "type": "Property",
    "value": "Office"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create E2 type=House"
echo "========================"
payload='{
  "id": "urn:entity:E2",
  "type": "House",
  "name": {
    "type": "Property",
    "value": "Cottage"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create E3 type=[Home, Vehicle]"
echo "=================================="
payload='{
  "id": "urn:entity:E3",
  "type": ["Home", "Vehicle"],
  "name": {
    "type": "Property",
    "value": "Campervan"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create E4 type=Motorhome"
echo "============================"
payload='{
  "id": "urn:entity:E4",
  "type": "Motorhome",
  "name": {
    "type": "Property",
    "value": "Winnebago"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. ?type=Building - E1 only"
echo "============================"
swCurl --url '/ngsi-ld/v1/entities?type=Building'
echo
echo


echo "06. ?type=Building,House - E1, E2 (OR with comma)"
echo "================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Building,House'
echo
echo


echo "07. ?type=Building|House - E1, E2 (OR with pipe)"
echo "================================================"
swCurl --url '/ngsi-ld/v1/entities?type=Building|House'
echo
echo


echo "08. ?type=(Home;Vehicle) - E3 (AND)"
echo "==================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Home;Vehicle)'
echo
echo


echo "09. ?type=(Home;Vehicle)|Motorhome - E3, E4 (mixed)"
echo "==================================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Home;Vehicle)|Motorhome'
echo
echo


echo "10. ?type=Home - E3 (multi-type entity matches on any single type)"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Home'
echo
echo


echo "11. ?type=(Building;Vehicle) - empty (no entity has both)"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Building;Vehicle)'
echo
echo


echo "12. Create E5 type=[Home, Vehicle, Boat]"
echo "========================================"
payload='{
  "id": "urn:entity:E5",
  "type": ["Home", "Vehicle", "Boat"],
  "name": {
    "type": "Property",
    "value": "Houseboat"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "13. ?type=(Building;House),(Home;Motorhome) - two AND groups OR'd with comma (no match)"
echo "======================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Building;House),(Home;Motorhome)'
echo
echo


echo "14. ?type=(Home;Vehicle;Boat) - 3-type AND (E5 only)"
echo "===================================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Home;Vehicle;Boat)'
echo
echo


echo "15. ?type=Building,House,Motorhome - 3+ simple OR (E1, E2, E4)"
echo "=============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Building,House,Motorhome'
echo
echo


echo "16. ?type=(Home;Vehicle),Motorhome - comma as outer OR with AND group (E3, E4, E5)"
echo "=================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=(Home;Vehicle),Motorhome'
echo
echo


echo "17. ?type=Vehicle - partial match on multi-type returns E3 and E5"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


--EXPECT--
01. Create E1 type=Building
===========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:entity:E1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create E2 type=House
========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:entity:E2
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. Create E3 type=[Home, Vehicle]
