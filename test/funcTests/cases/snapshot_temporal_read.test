#
# FILE            snapshot_temporal_read.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 6.3.22 / § 5.5.15 — GET /temporal/entities and GET /temporal/
# entities/{id} honour the NGSILD-Snapshot header: when present, the
# temporal retrieve / query routes to the snap-tenant's frozen TRoE
# store. Distops are bypassed; the snap-tenant view is unaffected by
# subsequent live-tenant mutations.
#
# Requires postgres + the timescale TRoE plugin.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot temporal reads (§ 6.3.22 / Phase #146c)

--TAGS--
snapshot troe timescale postgres

--INIT--
corDbDrop
corSnapDrop
corTroeInit
coraineStart --troe timescale --troeSync

--RUN--

echo "01. Seed Vehicle V1 + 2 patches (TRoE captures three instances)"
echo "==============================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":50}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":55}' >/dev/null
echo "  seeded V1 + 2 patches"
echo
echo


echo "02. Create snapshot capturing temporal history"
echo "=============================================="
corCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Frozen",
  "type": "Snapshot",
  "snapshotTemporalQueries":[{
    "type":"Query",
    "entities":[{"type":"Vehicle"}],
    "temporalQ":{"timerel":"after","timeAt":"1970-01-01T00:00:00Z","timeproperty":"modifiedAt"}
  }]
}' >/dev/null
echo "  snapshot created"
echo
echo


echo "03. Mutate the LIVE tenant after the snapshot — adds another instance"
echo "====================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":99}' >/dev/null
echo "  live-tenant patch applied"
echo
echo


echo "04. GET /temporal/entities/V1 (no header) — sees the LIVE 4 instances"
echo "====================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt'
echo
echo


echo "05. GET /temporal/entities/V1 with NGSILD-Snapshot — sees FROZEN 3 instances"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:V1?timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "06. GET /temporal/entities (multi) with NGSILD-Snapshot — frozen view"
echo "====================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "07. GET /temporal/entities/Unknown with NGSILD-Snapshot — 404"
echo "============================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:Vehicle:Nope?timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen' | head -1
echo
echo


echo "08. GET /temporal/entities with NGSILD-Snapshot pointing at a missing snapshot — 404"
echo "====================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=1970-01-01T00:00:00Z&timeproperty=modifiedAt' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:DoesNotExist' | head -1
echo
echo


--EXPECT--
01. Seed Vehicle V1 + 2 patches (TRoE captures three instances)
===============================================================
  seeded V1 + 2 patches


02. Create snapshot capturing temporal history
==============================================
  snapshot created


03. Mutate the LIVE tenant after the snapshot — adds another instance
=====================================================================
  live-tenant patch applied


04. GET /temporal/entities/V1 (no header) — sees the LIVE 4 instances
=====================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "speed": [
    {
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 42
    },
    {
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 50
    },
    {
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 55
    },
    {
      "instanceId": "REGEX(.*)",
      "type": "Property",
      "value": 99
    }
  ],
  "type": "Vehicle"
}



