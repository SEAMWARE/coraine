#
# FILE            subscription_scopeq.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription with scopeQ filter

--TAGS--
scope subscription

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

#
# 01. Create subscription with scopeQ=/Madrid/Gardens/#
# 02. Create entity with scope=/Madrid/Gardens/ParqueNorte — should trigger
# 03. Dump ftClient — 1 notification
# 04. Reset ftClient
# 05. Create entity with scope=/Madrid/Districts/Centro — should NOT trigger
# 06. Dump ftClient — empty
#

echo "01. Create subscription with scopeQ=/Madrid/Gardens/#"
echo "======================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:Scope1",
  "type": "Subscription",
  "entities": [{"type": "Park"}],
  "scopeQ": "/Madrid/Gardens/#",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity scope=/Madrid/Gardens/ParqueNorte — should trigger"
echo "======================================================================"
payload='{
  "id": "urn:ngsi-ld:Park:PN",
  "type": "Park",
  "scope": "/Madrid/Gardens/ParqueNorte",
  "name": {
    "type": "Property",
    "value": "Parque Norte"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Dump ftClient — 1 notification"
echo "===================================="
ftClientDump
echo
echo


echo "04. Reset ftClient"
echo "==================="
echo "done"
echo
echo


echo "05. Create entity scope=/Madrid/Districts/Centro — should NOT trigger"
echo "======================================================================="
payload='{
  "id": "urn:ngsi-ld:Park:Centro",
  "type": "Park",
  "scope": "/Madrid/Districts/Centro",
  "name": {
    "type": "Property",
    "value": "Centro"
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "06. Dump ftClient — empty"
echo "=========================="
ftClientDump
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Create subscription with scopeQ=/Madrid/Gardens/#
=======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Scope1
Content-Length: REGEX(\d+)




02. Create entity scope=/Madrid/Gardens/ParqueNorte — should trigger
======================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Park:PN
Content-Length: REGEX(\d+)




03. Dump ftClient — 1 notification
====================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:Park:PN",
          "name": {
            "type": "Property",
            "value": "Parque Norte"
          },
          "scope": "/Madrid/Gardens/ParqueNorte",
          "type": "Park"
        }
      ],
      "id": REGEX("urn:ngsi-ld:Notification:.*"),
      "notifiedAt": REGEX(".*"),
      "subscriptionId": "urn:ngsi-ld:Subscription:Scope1",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": REGEX("[0-9]+"),
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": REGEX("Coraine/.*")
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. Reset ftClient
===================
done


05. Create entity scope=/Madrid/Districts/Centro — should NOT trigger
=======================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Park:Centro
Content-Length: REGEX(\d+)




06. Dump ftClient — empty
==========================
[]

[]
--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
