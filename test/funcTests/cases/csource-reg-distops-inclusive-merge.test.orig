#
--NAME--
DistOps - inclusive multi-source merge per § 4.5.5.3

--INIT--
corDbDrop -role CB
corDbDrop -role CP1
corDbDrop -role CP2
coraineStart -role CB
coraineStart -role CP1
coraineStart -role CP2

--RUN--
#
# Phase D - § 4.5.5.3 multi-source attribute conflict resolution.
#
# Three brokers (CB + CP1 + CP2) each carry their own copy of the same
# attribute on the same entity. CB has inclusive registrations pointing
# at CP1 and CP2, so a GET on CB has three candidate instances per
# (attr, datasetId) - local + CP1 + CP2 - and must pick per § 4.5.5.3:
#   1. drop expired
#   2. if any non-expired has observedAt -> newest observedAt wins
#   3. else -> newest modifiedAt wins
#
# 01. Register CB->CP1 inclusive for urn:V1
# 02. Register CB->CP2 inclusive for urn:V1
# 03. Create entity urn:V1 on CB with speed=10, observedAt 2026-01-01
# 04. Create entity urn:V1 on CP1 with speed=20, observedAt 2026-02-01
# 05. Create entity urn:V1 on CP2 with speed=30, observedAt 2026-03-01
# 06. GET urn:V1 on CB - newest observedAt wins (CP2 speed=30)
# 07. Delete urn:V1 on CB
# 08. Delete urn:V1 on CP1
# 09. Delete urn:V1 on CP2
# 10. Create entity urn:V1 on CP2 with speed=300 (no observedAt)
# 11. Create entity urn:V1 on CB with speed=100 (no observedAt)
# 12. Create entity urn:V1 on CP1 with speed=200, observedAt 2020-01-01
# 13. GET urn:V1 on CB - CP1 has observedAt so CP1 wins (speed=200)
# 14. Delete urn:V1 on CB
# 15. Delete urn:V1 on CP1
# 16. Delete urn:V1 on CP2
# 17. Create entity urn:V1 on CP2 with speed=3000 (no observedAt)
# 18. Create entity urn:V1 on CP1 with speed=2000 (no observedAt)
# 19. Create entity urn:V1 on CB with speed=1000 (no observedAt)
# 20. GET urn:V1 on CB - newest modifiedAt wins (CB speed=1000)
#


echo "01. Register CB->CP1 inclusive for urn:V1"
echo "=========================================="
corCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/csourceRegistrations \
  --payload '{
    "id": "urn:CSR:CP1",
    "type": "ContextSourceRegistration",
    "endpoint": "http://localhost:'$CP1_PORT'/ngsi-ld/v1",
    "mode": "inclusive",
    "information": [
      {
        "entities": [
          {
            "id": "urn:V1",
            "type": "Vehicle"
          }
        ]
      }
    ]
  }'
echo
echo


echo "02. Register CB->CP2 inclusive for urn:V1"
echo "=========================================="
corCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/csourceRegistrations \
  --payload '{
    "id": "urn:CSR:CP2",
    "type": "ContextSourceRegistration",
    "endpoint": "http://localhost:'$CP2_PORT'/ngsi-ld/v1",
    "mode": "inclusive",
    "information": [
      {
        "entities": [
          {
            "id": "urn:V1",
            "type": "Vehicle"
          }
        ]
      }
    ]
  }'
echo
echo


# A. All three sources have observedAt -> newest observedAt wins
# CB:  observedAt 2026-01-01  value 10  (oldest observedAt)
# CP1: observedAt 2026-02-01  value 20
# CP2: observedAt 2026-03-01  value 30  (newest observedAt - should win)

echo "03. Create entity urn:V1 on CB with speed=10, observedAt 2026-01-01"
echo "==================================================================="
corCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 10,
      "observedAt": "2026-01-01T00:00:00Z"
    }
  }'
echo
echo


echo "04. Create entity urn:V1 on CP1 with speed=20, observedAt 2026-02-01"
echo "====================================================================="
corCurl --port $CP1_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 20,
      "observedAt": "2026-02-01T00:00:00Z"
    }
  }'
echo
echo


echo "05. Create entity urn:V1 on CP2 with speed=30, observedAt 2026-03-01"
echo "====================================================================="
corCurl --port $CP2_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 30,
      "observedAt": "2026-03-01T00:00:00Z"
    }
  }'
echo
echo


echo "06. GET urn:V1 on CB - newest observedAt wins (CP2 speed=30)"
echo "============================================================="
corCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'options=keyValues'
echo
echo


# B. Only CP1 has observedAt (old); others rely on modifiedAt -> CP1 wins
# Wipe state then re-seed without observedAt on CB / CP2

echo "07. Delete urn:V1 on CB"
echo "======================="
corCurl --port $CB_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "08. Delete urn:V1 on CP1"
echo "========================"
corCurl --port $CP1_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "09. Delete urn:V1 on CP2"
echo "========================"
corCurl --port $CP2_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


# CP2 first (oldest modifiedAt), CB second, CP1 last with old observedAt

echo "10. Create entity urn:V1 on CP2 with speed=300 (no observedAt)"
echo "==============================================================="
corCurl --port $CP2_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 300
    }
  }'
echo
echo


echo "11. Create entity urn:V1 on CB with speed=100 (no observedAt)"
echo "=============================================================="
corCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 100
    }
  }'
echo
echo


echo "12. Create entity urn:V1 on CP1 with speed=200, observedAt 2020-01-01"
echo "======================================================================"
corCurl --port $CP1_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 200,
      "observedAt": "2020-01-01T00:00:00Z"
    }
  }'
echo
echo


echo "13. GET urn:V1 on CB - CP1 has observedAt so CP1 wins (speed=200)"
echo "=================================================================="
corCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'options=keyValues'
echo
echo


# C. None has observedAt -> newest modifiedAt wins (CB-local, last write)
# Reset, then CP2 -> CP1 -> CB in that order so CB has the newest modifiedAt

echo "14. Delete urn:V1 on CB"
echo "======================="
corCurl --port $CB_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "15. Delete urn:V1 on CP1"
echo "========================"
corCurl --port $CP1_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "16. Delete urn:V1 on CP2"
echo "========================"
corCurl --port $CP2_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "17. Create entity urn:V1 on CP2 with speed=3000 (no observedAt)"
echo "================================================================"
corCurl --port $CP2_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 3000
    }
  }'
echo
echo


echo "18. Create entity urn:V1 on CP1 with speed=2000 (no observedAt)"
echo "================================================================"
corCurl --port $CP1_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 2000
    }
  }'
echo
echo


echo "19. Create entity urn:V1 on CB with speed=1000 (no observedAt)"
echo "==============================================================="
corCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 1000
    }
  }'
echo
echo


echo "20. GET urn:V1 on CB - newest modifiedAt wins (CB speed=1000)"
echo "=============================================================="
corCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'options=keyValues'
echo
echo


--EXPECT--
01. Register CB->CP1 inclusive for urn:V1
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:CP1
Link: REGEX(.*)
Content-Length: 0



02. Register CB->CP2 inclusive for urn:V1
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:CP2
Link: REGEX(.*)
Content-Length: 0



03. Create entity urn:V1 on CB with speed=10, observedAt 2026-01-01
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0



04. Create entity urn:V1 on CP1 with speed=20, observedAt 2026-02-01
=====================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0



05. Create entity urn:V1 on CP2 with speed=30, observedAt 2026-03-01
=====================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
