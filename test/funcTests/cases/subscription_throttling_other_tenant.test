#
# FILE            subscription_throttling_other_tenant.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A throttled subscription's coalesced notification is sent on EVERY tenant, not only the default one.
#
# Throttling: the first change notifies at once; the changes inside the window are coalesced
# into ONE notification with the entity's latest state, sent when the window has passed. That
# flush was registered with tenant0's subscription cache alone (and fetched the latest state
# from tenant0): on any other tenant the coalesced notification never came - the changes after
# the first were silently dropped.
#
# The same sequence on both tenants: the default one is the control.
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Throttled subscription on a non-default tenant sends its coalesced notification

--TAGS--
subscription throttling tenant

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

#
# throttleRound <tenant header or ""> - entity V1, a subscription with throttling 1. speed 1:
# the first notification (wait for it). Then speed 2 and 3 at once - inside the window after
# that notification: they are coalesced into ONE notification with the latest state (3), sent
# when the window has passed. Waits up to 6 s for it.
#
throttleRound() {
  local h=("$@")
  corCurl --url /ngsi-ld/v1/entities "${h[@]}" --payload '{"id": "urn:V1", "type": "Vehicle", "speed": {"type": "Property", "value": 0}}' | head -1
  corCurl --url /ngsi-ld/v1/subscriptions "${h[@]}" --payload '{
    "id": "urn:ngsi-ld:Subscription:TH1",
    "type": "Subscription",
    "entities": [{"type": "Vehicle"}],
    "watchedAttributes": ["speed"],
    "throttling": 1,
    "notification": { "endpoint": { "uri": "http://localhost:'$FT_CLIENT_PORT'/notify" } }
  }' | head -1
  corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs "${h[@]}" -X PATCH --payload '{"speed": {"type": "Property", "value": 1}}' | head -1
  for i in $(seq 1 30); do [ "$(ftClientCount)" -ge 1 ] && break; sleep 0.2; done
  for v in 2 3; do
    corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs "${h[@]}" -X PATCH --payload '{"speed": {"type": "Property", "value": '$v'}}' | head -1
  done
  for i in $(seq 1 30); do [ "$(ftClientCount)" -ge 2 ] && break; sleep 0.2; done
  ftClientSettle
  ftClientDump > /tmp/th.$$
  echo "notifications: $(grep -c '"subscriptionId"' /tmp/th.$$)"
  echo "speed in each, in order: $(grep -o '"value": [0-9]' /tmp/th.$$ | cut -d' ' -f2 | tr '\n' ' ')"
  echo "NGSILD-Tenant in each: $(grep -o '"NGSILD-Tenant": "[^"]*"' /tmp/th.$$ | cut -d'"' -f4 | tr '\n' ' ')"
  rm -f /tmp/th.$$
}


echo "01. The default tenant (the control)"
echo "===================================="
throttleRound
echo
echo


echo "02. Tenant t1"
echo "============="
throttleRound -H 'NGSILD-Tenant: t1'
echo
echo


--EXPECT--
01. The default tenant (the control)
====================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 204 No Content
HTTP/1.1 204 No Content
HTTP/1.1 204 No Content
notifications: 2
speed in each, in order: 1 3 
NGSILD-Tenant in each: 


02. Tenant t1
=============
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 204 No Content
HTTP/1.1 204 No Content
HTTP/1.1 204 No Content
notifications: 2
speed in each, in order: 1 3 
NGSILD-Tenant in each: t1 t1 


--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
