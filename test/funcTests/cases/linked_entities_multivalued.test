==================================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 286

[
  {
    "id": "urn:ngsi-ld:Building:B",
    "locatedAt": [
      "urn:ngsi-ld:City:Paris",
      "urn:ngsi-ld:City:Lyon"
    ],
    "type": "Building"
  },
  {
    "id": "urn:ngsi-ld:City:Paris",
    "type": "City"
  },
  {
    "id": "urn:ngsi-ld:City:Lyon",
    "type": "City"
  }
]



08. GET BOT join=inline&joinLevel=1 — objectType kept alongside the entity ARRAY
=================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 402

{
  "id": "urn:ngsi-ld:Building:BOT",
  "locatedAt": {
    "entity": [
      {
        "id": "urn:ngsi-ld:City:Paris",
        "type": "City"
      },
      {
        "id": "urn:ngsi-ld:City:Lyon",
        "type": "City"
      }
    ],
    "object": [
      "urn:ngsi-ld:City:Paris",
      "urn:ngsi-ld:City:Lyon"
    ],
    "objectType": "City",
    "type": "Relationship"
  },
  "type": "Building"
}



--TEARDOWN--
swBrokerStop
swDbDrop
