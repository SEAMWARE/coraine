#
# FILE            subscription_mqtt_qos_version_user_password.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7.2 — MQTT notification combining all notifierInfo/auth knobs at once:
# MQTT-QoS, MQTT-Version (notifierInfo) plus username/password (URI userinfo).
# The broker connects with the requested protocol version + credentials and
# publishes at the requested QoS; a private auth-required mosquitto delivers it.
#
--NAME--
Subscription MQTT notification — QoS + Version + username/password combined (§ 7.2)

--TAGS--
subscription notification mqtt

--INIT--
corDbDrop
mosquitto_passwd -b -c /tmp/mqtt-qva-pw testuser testpass 2>/dev/null
echo "listener 11885
allow_anonymous false
password_file /tmp/mqtt-qva-pw" > /tmp/mqtt-qva.conf
mosquitto -d -c /tmp/mqtt-qva.conf
sleep 0.3
ftClientStart --mqttPort 11885 --mqttTopic ngsild/notif --mqttUser testuser --mqttPassword testpass
coraineStart

--RUN--

echo "01. Subscribe — mqtt://testuser:testpass@.../ngsild/notif, MQTT-QoS=1, MQTT-Version=mqtt3.1.1"
echo "============================================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:mqtt-qva",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {
    "endpoint": {
      "uri": "mqtt://testuser:testpass@localhost:11885/ngsild/notif",
      "notifierInfo": [
        {"key": "MQTT-QoS",     "value": "1"},
        {"key": "MQTT-Version", "value": "mqtt3.1.1"}
      ]
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | grep HTTP
echo
echo


echo "02. POST a Vehicle — broker connects (v3.1.1, auth) + publishes at QoS 1"
echo "========================================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99}}' | grep HTTP
echo
echo


echo "03. ftClient received the notification"
echo "======================================"
sleep 0.6
ftClientDump | grep -cE '"verb": "MQTT"'
ftClientDump | grep -cE 'subscriptionId.*mqtt-qva'
ftClientDump | grep -cE 'urn:V1.*type.*Vehicle'
echo
echo


--EXPECT--
01. Subscribe — mqtt://testuser:testpass@.../ngsild/notif, MQTT-QoS=1, MQTT-Version=mqtt3.1.1
=============================================================================================
HTTP/1.1 201 Created


02. POST a Vehicle — broker connects (v3.1.1, auth) + publishes at QoS 1
========================================================================
HTTP/1.1 201 Created


03. ftClient received the notification
======================================
1
1
1


--TEARDOWN--
coraineStop
ftClientStop
pkill -f "mosquitto -d -c /tmp/mqtt-qva.conf" 2>/dev/null
\rm -f /tmp/mqtt-qva.conf /tmp/mqtt-qva-pw
