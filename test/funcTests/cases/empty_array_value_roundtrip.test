#
# FILE            empty_array_value_roundtrip.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Empty array as a Property value is accepted and round-trips

--TAGS--
attr create

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create an entity with a Property whose value is an empty array
# 02. GET the entity — value preserved as the empty array, broker alive
#

echo "01. Create entity with an empty-array Property value"
echo "===================================================="
payload='{
  "id": "urn:ngsi-ld:T:001",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": []
  }
}'
swCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "02. GET the entity"
echo "=================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:001
echo
echo


--EXPECT--
01. Create entity with an empty-array Property value
====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 171

{
  "detail": "an empty array is not valid NGSI-LD input",
  "status": 400,
  "title": "Empty Structure",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. GET the entity
==================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 162

{
  "detail": "entity 'urn:ngsi-ld:T:001' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
swBrokerStop
