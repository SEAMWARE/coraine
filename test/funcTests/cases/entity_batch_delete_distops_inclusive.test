#
# FILE            entity_batch_delete_distops_inclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Delete (§ 5.6.11) — inclusive CSR mode.
# Deletes mirror to the CSR. Local delete always attempted; remote
# delete forwarded in parallel.
#
--NAME--
Batch Entity Delete — inclusive CSR, local + forwarded

--TAGS--
batch delete entity

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities
swBrokerStart -role CP1 --noSplitEntities

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Seed V1 on both CB and CP1"
echo "=============================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo


echo "02. Register CB→CP1 inclusive (Vehicle, deleteBatch)"
echo "===================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:R1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","operations":["deleteBatch"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "03. Batch Delete [V1] → 204 (local + mirrored to CP1)"
echo "====================================================="
swCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1"]'
echo
echo


echo "04. GET CB V1 → 404 (deleted locally)"
echo "====================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "05. GET CP1 V1 → 404 (deleted on remote too)"
echo "============================================"
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


--EXPECT--
01. Seed V1 on both CB and CP1
==============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




02. Register CB→CP1 inclusive (Vehicle, deleteBatch)
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




03. Batch Delete [V1] → 204 (local + mirrored to CP1)
=====================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8




04. GET CB V1 → 404 (deleted locally)
=====================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 134

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



05. GET CP1 V1 → 404 (deleted on remote too)
============================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 134

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
