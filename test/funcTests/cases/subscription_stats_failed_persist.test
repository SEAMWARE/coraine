#
# FILE            subscription_stats_failed_persist.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 timesFailed + lastFailure persistence. ftClient started with
# --status 503 makes every notification fail with a 5xx, so we can
# verify timesFailed/lastFailure are counted AND survive restart.
#
# REQUIRE_DB: mongoc
--NAME--
Subscription timesFailed + lastFailure persist across broker restart

--TAGS--
subscription stats persist mongoc error

--INIT--
swDbDrop
ftClientStart --status 503
swBrokerStart --apiPlugins admin

--RUN--

echo "01. Create sub matching Vehicle → always-failing ftClient"
echo "========================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/notify", "cooldown": 1}}
}' | head -1
echo
echo


echo "02. POST 2 entities → 2 failed notifs"
echo "====================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}' | head -1
echo
echo


echo "03. GET sub → timesSent=2, timesFailed=2"
echo "========================================"
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "04. POST /admin/subStats/flush"
echo "=============================="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" -X POST "http://$SW_BROKER_HOST:$SW_BROKER_PORT/admin/subStats/flush"
echo
echo


echo "05. Restart broker"
echo "=================="
swBrokerStop
swBrokerStart --apiPlugins admin
echo "restarted"
echo
echo


echo "06. GET sub after restart → timesSent=2, timesFailed=2 (both persisted)"
echo "======================================================================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "07. POST 1 more → timesSent=3, timesFailed=3"
echo "============================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}' | head -1
echo
echo


echo "08. GET sub → accumulated"
echo "========================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


--EXPECT--
01. Create sub matching Vehicle → always-failing ftClient
=========================================================
HTTP/1.1 201 Created


02. POST 2 entities → 2 failed notifs
=====================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


03. GET sub → timesSent=2, timesFailed=2
========================================
    "timesFailed": 2,
    "timesSent": 2


04. POST /admin/subStats/flush
==============================
HTTP 204


05. Restart broker
==================
restarted


06. GET sub after restart → timesSent=2, timesFailed=2 (both persisted)
=======================================================================
    "timesFailed": 2,
    "timesSent": 2


07. POST 1 more → timesSent=3, timesFailed=3
============================================
HTTP/1.1 201 Created


08. GET sub → accumulated
=========================
    "timesFailed": 3,
    "timesSent": 3


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
