#
# FILE            subscription_stats_failed_persist.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 timesFailed + lastFailure persistence. ftClient started with
# --status 503 makes every notification fail with a 5xx, so we can
# verify timesFailed/lastFailure are counted AND survive restart.
#
# REQUIRE_DB: mongoc
# REQUIRE_FEATURE: SUBSCRIPTIONS
--NAME--
Subscription timesFailed + lastFailure persist across broker restart

--TAGS--
subscription stats persist mongoc error

--INIT--
corDbDrop
ftClientStart --status 503
coraineStart --apiPlugins admin

--RUN--

echo "01. Create sub matching Vehicle → always-failing ftClient"
echo "========================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/notify", "cooldown": 1}}
}' | head -1
echo
echo


echo "02. POST 2 entities → 2 failed notifs"
echo "====================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}' | head -1
echo
echo


echo "03. GET sub → timesSent=2, timesFailed=2"
echo "========================================"
sleep 0.2           # let the async notification+stats update land (parallel-load flake)
corValgrindSleep 3   # under --vt the notification+stats updates lag; let them settle
corCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "04. POST /admin/subStats/flush"
echo "=============================="
corCurl --url /admin/subStats/flush -X POST | head -1
echo
echo


echo "05. Restart broker"
echo "=================="
coraineStop
coraineStart --apiPlugins admin
echo "restarted"
echo
echo


echo "06. GET sub after restart → timesSent=2, timesFailed=2 (both persisted)"
echo "======================================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "07. POST 1 more → timesSent=3, timesFailed=3"
echo "============================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}' | head -1
echo
echo


echo "08. GET sub → accumulated"
echo "========================="
sleep 0.2           # let the async notification+stats update land (parallel-load flake)
corValgrindSleep 3   # under --vt the 3rd notification+stats update lags; let it settle
corCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


--EXPECT--
01. Create sub matching Vehicle → always-failing ftClient
=========================================================
HTTP/1.1 201 Created


02. POST 2 entities → 2 failed notifs
=====================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


03. GET sub → timesSent=2, timesFailed=2
========================================
    "timesFailed": 2,
    "timesSent": 2


04. POST /admin/subStats/flush
==============================
HTTP/1.1 204 No Content


05. Restart broker
==================
restarted


06. GET sub after restart → timesSent=2, timesFailed=2 (both persisted)
=======================================================================
    "timesFailed": 2,
    "timesSent": 2


07. POST 1 more → timesSent=3, timesFailed=3
============================================
HTTP/1.1 201 Created


08. GET sub → accumulated
=========================
    "timesFailed": 3,
    "timesSent": 3


--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
