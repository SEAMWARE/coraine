#
# FILE            jsonld_contexts_crud.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
POST / DELETE /jsonldContexts (§ 5.13.2, 5.13.3)

--TAGS--
context

--INIT--
swDbDrop
swDbDrop -db swBroker
contextServerStart
swBrokerStart

contextServerPush /jsonldContexts/ctxT '{
  "@context": {
    "Vehicle": "https://example.org/Vehicle"
  }
}'

--RUN--

#
# 01. POST Hosted (@context body) — 201 + Location: /jsonldContexts/urn:…
# 02. LIST Hosted — the one just added
# 03. GET the hosted body — returns it
# 04. POST Cached ({"url":…}) — 201 + Location: /jsonldContexts/<url>
# 05. LIST Cached — the one just added (kind=Cached)
# 06. DELETE Cached — 204
# 07. LIST Cached — empty
# 08. POST Cached again; DELETE with reload=true — 204; entry stays
# 09. LIST Cached — still has one
# 10. DELETE with reload=true on Hosted — 400 (reload valid only for Cached)
# 11. DELETE unknown id — 404
# 12. POST with bad body (no @context, no url) — 400
# 13. POST with @context not an object — 400
# 14. POST with url not a string — 400
# 15. POST Cached with unreachable URL — 504 Context Not Available
# 16. DELETE unknown NON-URI id — 404 (id is a local identifier, § 13.5.3)
# 17. DELETE the Core @context — 400 (the core is permanent)
# 18. DELETE an older-version core URL, reload=false — 400 (same core)
# 19. GET core metadata via an older-version URL — 200 (resolves to THE core)
#     (core reload=true re-downloads from the real core URL — network-
#      dependent, so exercised by the ETSI suite, not here)
#

echo "01. POST Hosted (@context body)"
echo "==============================="
payload='{"@context":{"speed":"https://example.org/speed"}}'
swCurl --url /ngsi-ld/v1/jsonldContexts --in jsonld --payload "$payload"
echo
echo


echo "02. LIST Hosted"
echo "==============="
swCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Hosted"
echo
echo


echo "04. POST Cached ({\"url\":...})"
echo "=============================="
payload='{"url":"http://localhost:7080/jsonldContexts/ctxT"}'
swCurl --url /ngsi-ld/v1/jsonldContexts --payload "$payload"
echo
echo


echo "05. LIST Cached"
echo "==============="
swCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Cached"
echo
echo


echo "06. DELETE Cached"
echo "================="
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxT"
echo
echo


echo "07. LIST Cached (empty)"
echo "======================="
swCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Cached"
echo
echo


payload='{"url":"http://localhost:7080/jsonldContexts/ctxT"}'
swCurl --url /ngsi-ld/v1/jsonldContexts --payload "$payload" > /dev/null

echo "08. DELETE with reload=true"
echo "==========================="
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxT?reload=true"
echo
echo


echo "09. LIST Cached (still there after reload)"
echo "=========================================="
swCurl --url "/ngsi-ld/v1/jsonldContexts?kind=Cached"
echo
echo


echo "10. DELETE ?reload=true on Hosted — 400"
echo "========================================"
# Re-POST a hosted, capture its id from Location, then try reload on it.
# We use a deterministic second ?kind=Hosted list to grab whatever id swBroker
# assigned — simplest: post a fresh one and look at Location via verbose headers.
payload='{"@context":{"speed2":"https://example.org/speed2"}}'
postOut=$(swCurl --url /ngsi-ld/v1/jsonldContexts --in jsonld --payload "$payload")
hostedId=$(echo "$postOut" | awk -F '/jsonldContexts/' '/^Location:/ {print $2}' | tr -d '\r')
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/${hostedId}?reload=true"
echo
echo


echo "11. DELETE unknown id — 404"
echo "==========================="
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/urn:ngsi-ld:Context:does-not-exist"
echo
echo


echo "12. POST with no @context and no url — 400"
echo "=========================================="
payload='{}'
swCurl --url /ngsi-ld/v1/jsonldContexts --payload "$payload"
echo
echo


echo "13. POST with @context not an object — 400"
echo "==========================================="
payload='{"@context":"not-an-object"}'
swCurl --url /ngsi-ld/v1/jsonldContexts --in jsonld --payload "$payload"
echo
echo


echo "14. POST with url not a string — 400"
echo "===================================="
payload='{"url":42}'
swCurl --url /ngsi-ld/v1/jsonldContexts --payload "$payload"
echo
echo


echo "15. POST Cached unreachable URL — 504"
echo "====================================="
payload='{"url":"http://127.0.0.1:1/nope.jsonld"}'
swCurl --url /ngsi-ld/v1/jsonldContexts --payload "$payload"
echo
echo


echo "16. DELETE unknown NON-URI id — 404 (id is a local identifier, § 13.5.3)"
echo "=========================================================================="
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/not_even_a_uri"
echo
echo


echo "17. DELETE the Core @context — 400 (the core is permanent)"
echo "============================================================"
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/https%3A%2F%2Furi.etsi.org%2Fngsi-ld%2Fv1%2Fngsi-ld-core-context-v1.9.jsonld"
echo
echo


echo "18. DELETE an older-version core URL, reload=false — 400 (same core)"
echo "======================================================================"
swCurl -X DELETE --url "/ngsi-ld/v1/jsonldContexts/https%3A%2F%2Furi.etsi.org%2Fngsi-ld%2Fv1%2Fngsi-ld-core-context-v1.6.jsonld?reload=false"
echo
echo


echo "19. GET core metadata via an older-version URL — 200 (resolves to THE core)"
echo "=============================================================================="
swCurl --url "/ngsi-ld/v1/jsonldContexts/https%3A%2F%2Furi.etsi.org%2Fngsi-ld%2Fv1%2Fngsi-ld-core-context-v1.6.jsonld?details=true"
echo
echo


--EXPECT--
01. POST Hosted (@context body)
===============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: REGEX(/ngsi-ld/v1/jsonldContexts/urn:ngsi-ld:Context:.*)
Content-Length: REGEX(\d+)




02. LIST Hosted
===============
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  REGEX("http://localhost:.*/ngsi-ld/v1/jsonldContexts/urn:ngsi-ld:Context:.*")
]



04. POST Cached ({"url":...})
==============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/jsonldContexts/http://localhost:7080/jsonldContexts/ctxT
Content-Length: REGEX(\d+)




05. LIST Cached
===============
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  "http://localhost:7080/jsonldContexts/ctxT"
]



06. DELETE Cached
=================
HTTP/1.1 204 No Content
Date: REGEX(.*)




07. LIST Cached (empty)
=======================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



08. DELETE with reload=true
===========================
HTTP/1.1 204 No Content
Date: REGEX(.*)




09. LIST Cached (still there after reload)
==========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  "http://localhost:7080/jsonldContexts/ctxT"
]



10. DELETE ?reload=true on Hosted — 400
========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "reload is only valid for Cached contexts",
  "status": 400,
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



11. DELETE unknown id — 404
===========================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "JSON-LD context 'urn:ngsi-ld:Context:does-not-exist' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



12. POST with no @context and no url — 400
==========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "payload must contain either '@context' (Hosted) or 'url' (Cached)",
  "status": 400,
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



13. POST with @context not an object — 400
===========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'@context' must be a JSON object or array",
  "status": 400,
  "title": "Invalid Context",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



14. POST with url not a string — 400
====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'url' must be a non-empty string",
  "status": 400,
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



15. POST Cached unreachable URL — 504
=====================================
HTTP/1.1 504 Gateway Timeout
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unable to retrieve @context from 'http://127.0.0.1:1/nope.jsonld'",
  "status": 504,
  "title": "Context Not Available",
  "type": "https://uri.etsi.org/ngsi-ld/errors/LdContextNotAvailable"
}



16. DELETE unknown NON-URI id — 404 (id is a local identifier, § 13.5.3)
==========================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "JSON-LD context 'not_even_a_uri' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



17. DELETE the Core @context — 400 (the core is permanent)
============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "the Core @context cannot be deleted",
  "status": 400,
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



18. DELETE an older-version core URL, reload=false — 400 (same core)
======================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "the Core @context cannot be deleted",
  "status": 400,
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



19. GET core metadata via an older-version URL — 200 (resolves to THE core)
==============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "URL": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "createdAt": REGEX("[0-9T:.Z-]+"),
  "kind": "ImplicitlyCreated",
  "lastUsage": REGEX("[0-9T:.Z-]+"),
  "localId": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld"
}



--TEARDOWN--
swBrokerStop
contextServerStop
swDbDrop -db swBroker
swDbDrop
