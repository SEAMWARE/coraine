#
# FILE            subscription_notify_geojson_sysattrs.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# geo+json NOTIFICATION — entity-level non-attribute fields under the Feature
# `properties` (§ 5.3.3.3.1), and the sysAttrs distinction:
#
#   - `scope` and `expiresAt` are USER-set entity metadata — shown by default,
#     they are NOT system-generated attributes (not gated by sysAttrs).
#   - `createdAt` / `modifiedAt` ARE system-generated — present only when the
#     subscription sets notification.sysAttrs=true (entity-level under
#     `properties`, per-Attribute ones nested in each Attribute).
#
# `id` always stays at the top Feature level, never under `properties`.
# Same ldToGeoJson path as GET, exercised over the notification binding.
# Spec-doubt #103.
#
--NAME--
Subscription notification — geo+json scope/expiresAt vs sysAttrs under properties (§ 5.3.3.3.1)

--TAGS--
subscription notification geojson scope

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

echo "01. Subscription on Vehicle, geo+json, NO sysAttrs"
echo "=================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:plain",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/geo+json"
    }
  }
}'
echo
echo


echo "02. Create a Vehicle (scope + expiresAt) → notif has scope/expiresAt, NO createdAt/modifiedAt"
echo "============================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:V1",
  "type":"Vehicle",
  "scope":"/Madrid/Gardens",
  "expiresAt":"2099-12-31T23:59:59Z",
  "speed":{"type":"Property","value":50},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[10,20]}}
}'
echo
echo


echo "03. ftClient dump — scope + expiresAt under properties, no sysAttrs timestamps, raw"
echo "==================================================================================="
sleep 0.4
ftClientDump
ftClientReset
echo
echo


echo "04. Subscription on Car, geo+json, sysAttrs = true"
echo "=================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:sys",
  "type":"Subscription",
  "entities":[{"type":"Car"}],
  "notification":{
    "sysAttrs":true,
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/geo+json"
    }
  }
}'
echo
echo


echo "05. Create a Car (scope + expiresAt) → notif ALSO has entity+per-attr createdAt/modifiedAt"
echo "==========================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:C1",
  "type":"Car",
  "scope":"/Madrid/Gardens",
  "expiresAt":"2099-12-31T23:59:59Z",
  "speed":{"type":"Property","value":50},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[10,20]}}
}'
echo
echo


echo "06. ftClient dump — scope + expiresAt + createdAt/modifiedAt under properties, raw"
echo "=================================================================================="
sleep 0.4
ftClientDump
echo
echo


--EXPECT--
01. Subscription on Vehicle, geo+json, NO sysAttrs
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:plain
Content-Length: 0




02. Create a Vehicle (scope + expiresAt) → notif has scope/expiresAt, NO createdAt/modifiedAt
=============================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. ftClient dump — scope + expiresAt under properties, no sysAttrs timestamps, raw
===================================================================================
[
  {
    "body": {
      "data": {
        "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
        "features": [
          {
            "geometry": {
              "coordinates": [
                10,
                20
              ],
              "type": "Point"
            },
            "id": "urn:V1",
            "properties": {
              "expiresAt": "2099-12-31T23:59:59Z",
              "location": {
                "type": "GeoProperty",
                "value": {
                  "coordinates": [
                    10,
                    20
                  ],
                  "type": "Point"
                }
              },
              "scope": "/Madrid/Gardens",
              "speed": {
                "type": "Property",
                "value": 50
              },
              "type": "Vehicle"
            },
            "type": "Feature"
          }
        ],
        "type": "FeatureCollection"
      },
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:plain",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/geo+json",
      "Host": "localhost:7701",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. Subscription on Car, geo+json, sysAttrs = true
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:sys
Content-Length: 0




05. Create a Car (scope + expiresAt) → notif ALSO has entity+per-attr createdAt/modifiedAt
===========================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:C1
Content-Length: 0




06. ftClient dump — scope + expiresAt + createdAt/modifiedAt under properties, raw
==================================================================================
[
  {
    "body": {
      "data": {
        "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
        "features": [
          {
            "geometry": {
              "coordinates": [
                10,
                20
              ],
              "type": "Point"
            },
            "id": "urn:C1",
            "properties": {
              "createdAt": "REGEX(20[23]\d-.*Z)",
              "expiresAt": "2099-12-31T23:59:59Z",
              "location": {
                "createdAt": "REGEX(20[23]\d-.*Z)",
                "modifiedAt": "REGEX(20[23]\d-.*Z)",
                "type": "GeoProperty",
                "value": {
                  "coordinates": [
                    10,
                    20
                  ],
                  "type": "Point"
                }
              },
              "modifiedAt": "REGEX(20[23]\d-.*Z)",
              "scope": "/Madrid/Gardens",
              "speed": {
                "createdAt": "REGEX(20[23]\d-.*Z)",
                "modifiedAt": "REGEX(20[23]\d-.*Z)",
                "type": "Property",
                "value": 50
              },
              "type": "Car"
            },
            "type": "Feature"
          }
        ],
        "type": "FeatureCollection"
      },
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:sys",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/geo+json",
      "Host": "localhost:7701",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
coraineStop
ftClientStop
