#
# FILE            url_param_datasetid_validation.test
# Copyright 2026 Seamware
# Ported from orion-ld ngsild_datasetId_error_handling. A datasetId URL param is
# a URI (§ 4.5.5) — a non-URI value (or a comma-list with one) is rejected 400,
# validated before the entity lookup; a valid URI is accepted.
#
--NAME--
datasetId URL param must be a URI — non-URI rejected (400) on query and retrieve
--TAGS--
entity query datasetid error
--INIT--
corDbDrop
coraineStart
--RUN--

echo "01. Query, datasetId=14 (not a URI) -> 400"
echo "=========================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&datasetId=14'
echo
echo

echo "02. Query, datasetId=urn:a,14 (list, one not a URI) -> 400"
echo "========================================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&datasetId=urn:a,14'
echo
echo

echo "03. Retrieve by id, datasetId=14 -> 400 (validated before lookup)"
echo "================================================================"
corCurl --url '/ngsi-ld/v1/entities/urn:E1' --urlParams 'datasetId=14'
echo
echo

echo "04. Query, valid URI datasetId -> 200 (no match)"
echo "================================================"
corCurl --url /ngsi-ld/v1/entities --urlParams 'type=T&datasetId=urn:ngsi-ld:ds:1'
echo
echo

--EXPECT--
01. Query, datasetId=14 (not a URI) -> 400
==========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 147

{
  "detail": "Not a valid URI: '14'",
  "status": 400,
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. Query, datasetId=urn:a,14 (list, one not a URI) -> 400
=========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 147

{
  "detail": "Not a valid URI: '14'",
  "status": 400,
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. Retrieve by id, datasetId=14 -> 400 (validated before lookup)
================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 147

{
  "detail": "Not a valid URI: '14'",
  "status": 400,
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. Query, valid URI datasetId -> 200 (no match)
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



--TEARDOWN--
coraineStop
corDbDrop
