    "channelKind": "topic",
    "channelTarget": "P1",
    "entity": {
      "id": "urn:M:1",
      "type": "Machine"
    },
    "entityAttribute": "temperature",
    "id": "urn:ngsi-ld:Channel:loopback:P1",
    "retention": "mirror",
    "status": "available",
    "type": "Channel"
  }
]



