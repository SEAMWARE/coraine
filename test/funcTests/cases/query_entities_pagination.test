#
# Copyright 2026 Seamware
#
--NAME--
GET /entities with limit, offset, and count pagination

--TAGS--
entity pagination query

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create entity E1
# 02. Create entity E2
# 03. Create entity E3
# 04. Create entity E4
# 05. Create entity E5
# 06. GET entities?limit=2 - see E1, E2
# 07. GET entities?limit=2&offset=2 - see E3, E4
# 08. GET entities?limit=2&offset=4 - see E5
# 09. GET entities?count=true - all 5 + NGSILD-Results-Count: 5
# 10. GET entities?limit=2&count=true - E1, E2 + NGSILD-Results-Count: 5
# 11. GET entities?limit=0&count=true - empty array + NGSILD-Results-Count: 5
# 12. GET entities?limit=0 (without count) - 400 error
# 13. GET entities?offset=10 (past the end) - last element E5 (§ 6.4.7.2)
# 14. GET entities (no limit param) - all 5 (default limit 20 > 5)
# 15. GET entities?offset=10&count=true (past end) - last E5 + Results-Count 5
# 16. GET entities?type=NoSuch&offset=10 (past end on empty set) - empty array
#

echo "01. Create entity E1"
echo "===================="
payload='{
  "id": "urn:e1",
  "type": "T",
  "a": {
    "type": "Property",
    "value": 1
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create entity E2"
echo "===================="
payload='{
  "id": "urn:e2",
  "type": "T",
  "a": {
    "type": "Property",
    "value": 2
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E3"
echo "===================="
payload='{
  "id": "urn:e3",
  "type": "T",
  "a": {
    "type": "Property",
    "value": 3
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E4"
echo "===================="
payload='{
  "id": "urn:e4",
  "type": "T",
  "a": {
    "type": "Property",
    "value": 4
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E5"
echo "===================="
payload='{
  "id": "urn:e5",
  "type": "T",
  "a": {
    "type": "Property",
    "value": 5
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "06. GET entities?limit=2 - see E1, E2"
echo "====================================="
corCurl --url '/ngsi-ld/v1/entities?limit=2&type=T'
echo
echo


echo "07. GET entities?limit=2&offset=2 - see E3, E4"
echo "=============================================="
corCurl --url '/ngsi-ld/v1/entities?limit=2&offset=2&type=T'
echo
echo


echo "08. GET entities?limit=2&offset=4 - see E5"
echo "=========================================="
corCurl --url '/ngsi-ld/v1/entities?limit=2&offset=4&type=T'
echo
echo


echo "09. GET entities?count=true - all 5 + NGSILD-Results-Count: 5"
echo "============================================================="
corCurl --url '/ngsi-ld/v1/entities?count=true&type=T'
echo
echo


echo "10. GET entities?limit=2&count=true - E1, E2 + NGSILD-Results-Count: 5"
echo "======================================================================"
corCurl --url '/ngsi-ld/v1/entities?limit=2&count=true&type=T'
echo
echo


echo "11. GET entities?limit=0&count=true - empty array + NGSILD-Results-Count: 5"
echo "==========================================================================="
corCurl --url '/ngsi-ld/v1/entities?limit=0&count=true&type=T'
echo
echo


echo "12. GET entities?limit=0 (without count) - 400 error"
echo "===================================================="
corCurl --url '/ngsi-ld/v1/entities?limit=0&type=T'
echo
echo


echo "13. GET entities?offset=10 (past end) - last element E5 (§ 6.4.7.2)"
echo "=================================================================="
corCurl --url '/ngsi-ld/v1/entities?offset=10&type=T'
echo
echo


echo "14. GET entities (no limit param) - all 5 (default limit 20 > 5)"
echo "================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=T'
echo
echo


echo "15. GET entities?offset=10&count=true (past end) - last E5 + Results-Count 5"
echo "==========================================================================="
corCurl --url '/ngsi-ld/v1/entities?offset=10&count=true&type=T'
echo
echo


echo "16. GET entities?type=NoSuch&offset=10 (past end on empty set) - empty array"
echo "==========================================================================="
corCurl --url '/ngsi-ld/v1/entities?offset=10&type=NoSuch'
echo
echo


--EXPECT--
01. Create entity E1
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




02. Create entity E2
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e2
Content-Length: 0




03. Create entity E3
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e3
Content-Length: 0




04. Create entity E4
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e4
Content-Length: 0




05. Create entity E5
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:e5
Content-Length: 0




06. GET entities?limit=2 - see E1, E2
=====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: </ngsi-ld/v1/entities?type=T&limit=2&offset=2>;rel="next";type="application/json"
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 215

[
  {
    "a": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:e1",
    "type": "T"
  },
  {
    "a": {
      "type": "Property",
      "value": 2
    },
    "id": "urn:e2",
    "type": "T"
  }
]



