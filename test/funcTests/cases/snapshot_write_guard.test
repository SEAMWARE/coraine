#
# FILE            snapshot_write_guard.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 7.9.2 — a Snapshot takes the operations on Entities and their Temporal Evolution
# (snapshot_write.test); any other non-GET request that carries the NGSILD-Snapshot header
# (subscription / registration creation, the snapshot itself) is a 422 OperationNotSupported.
# GET paths pass through.
#
# REQUIRE_FEATURE: REGISTRATIONS SUBSCRIPTIONS SNAPSHOT_WRITE
--NAME--
Snapshot NGSILD-Snapshot write guard - what a Snapshot does not take (§ 7.9.2)

--TAGS--
snapshot

--INIT--
corDbDrop
corSnapDrop
coraineStart -dist

--RUN--

echo "01. Seed an entity and create a snapshot to reference"
echo "====================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
corCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Frozen",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
echo
echo


echo "02. GET /entities with NGSILD-Snapshot — passes through (200)"
echo "============================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "03. POST /subscriptions with NGSILD-Snapshot — 422 (no sub creation in a snapshot)"
echo "=================================================================================="
corCurl --url /ngsi-ld/v1/subscriptions -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen' --payload '{
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{"endpoint":{"uri":"http://localhost:9999/x"}}
}'
echo
echo


echo "04. POST /csourceRegistrations with NGSILD-Snapshot — 422"
echo "========================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen' --payload '{
  "type":"ContextSourceRegistration",
  "information":[{"entities":[{"type":"Vehicle"}]}],
  "endpoint":"http://localhost:9999/x"
}'
echo
echo


echo "05. PATCH /snapshots/{id} with NGSILD-Snapshot — 422 (can't patch a snapshot via the snapshot scope)"
echo "===================================================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Frozen -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen' --payload '{"snapshotPriority":9}'
echo
echo


--EXPECT--
01. Seed an entity and create a snapshot to reference
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Frozen
Content-Length: 0




02. GET /entities with NGSILD-Snapshot — passes through (200)
=============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 136

[
  {
    "id": "urn:ngsi-ld:Vehicle:V1",
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  }
]



03. POST /subscriptions with NGSILD-Snapshot — 422 (no sub creation in a snapshot)
==================================================================================
HTTP/1.1 422 Unprocessable Content
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 232

{
  "detail": "a Snapshot takes the operations on Entities and their Temporal Evolution - not this one",
  "status": 422,
  "title": "Operation Not Supported",
  "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}



04. POST /csourceRegistrations with NGSILD-Snapshot — 422
=========================================================
HTTP/1.1 422 Unprocessable Content
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 232

{
  "detail": "a Snapshot takes the operations on Entities and their Temporal Evolution - not this one",
  "status": 422,
  "title": "Operation Not Supported",
  "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}



05. PATCH /snapshots/{id} with NGSILD-Snapshot — 422 (can't patch a snapshot via the snapshot scope)
====================================================================================================
HTTP/1.1 422 Unprocessable Content
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 232

{
  "detail": "a Snapshot takes the operations on Entities and their Temporal Evolution - not this one",
  "status": 422,
  "title": "Operation Not Supported",
  "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}



--TEARDOWN--
coraineStop
corSnapDrop
corDbDrop
