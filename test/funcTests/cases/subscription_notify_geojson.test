#
# FILE            subscription_notify_geojson.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 — when notification.endpoint.accept = application/geo+json,
# the notification's `data` field is rendered as a GeoJSON
# FeatureCollection (each entity → Feature with id, geometry from the
# location GeoProperty, and the rest of the entity as `properties`).
# The Content-Type header reflects the negotiated MIME type.
#
--NAME--
Subscription notification — endpoint.accept rendering (§ 5.2.14)

--TAGS--
subscription notification geojson

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

echo "01. Subscription with accept = application/geo+json"
echo "==================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:geo",
  "type":"Subscription",
  "entities":[{"type":"Sensor"}],
  "notification":{
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/geo+json"
    }
  }
}'
echo
echo


echo "02. Subscription with accept = application/ld+json"
echo "=================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:ldj",
  "type":"Subscription",
  "entities":[{"type":"Drone"}],
  "notification":{
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/ld+json"
    }
  }
}'
echo
echo


echo "03. POST a Sensor with location → triggers geo+json notification"
echo "================================================================"
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:S1",
  "type":"Sensor",
  "temp":{"type":"Property","value":22},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[10,20]}}
}'
echo
echo


echo "04. POST a Drone (no GeoProperty needed) → triggers ld+json notification"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:D1",
  "type":"Drone",
  "altitude":{"type":"Property","value":120}
}'
echo
echo


echo "05. ftClient dump — verify Content-Types and FeatureCollection shape"
echo "===================================================================="
sleep 0.4
ftClientDump | python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
data.sort(key=lambda e: e.get('body', {}).get('subscriptionId', ''))
for e in data:
    ct   = e.get('headers', {}).get('Content-Type', '')
    body = e.get('body', {})
    sub  = body.get('subscriptionId', '')
    df   = body.get('data')
    if isinstance(df, dict):
        kind = 'FeatureCollection' if df.get('type') == 'FeatureCollection' else type(df).__name__
        if kind == 'FeatureCollection':
            feats = df.get('features', [])
            f0 = feats[0] if feats else {}
            geom = f0.get('geometry') or {}
            kind += f' n={len(feats)} feat0.id={f0.get(\"id\",\"\")} feat0.geometry.type={geom.get(\"type\",\"\")}'
    elif isinstance(df, list):
        kind = f'Entity[] n={len(df)} ids={[x.get(\"id\",\"\") for x in df]}'
    else:
        kind = '(missing)'
    print(f'sub={sub}')
    print(f'  Content-Type: {ct}')
    print(f'  data: {kind}')
"
echo
echo


--EXPECT--
01. Subscription with accept = application/geo+json
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:geo
Content-Length: 0




02. Subscription with accept = application/ld+json
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:ldj
Content-Length: 0




03. POST a Sensor with location → triggers geo+json notification
================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:S1
Content-Length: 0




04. POST a Drone (no GeoProperty needed) → triggers ld+json notification
========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:D1
Content-Length: 0




05. ftClient dump — verify Content-Types and FeatureCollection shape
====================================================================
sub=urn:ngsi-ld:Subscription:geo
  Content-Type: application/geo+json
  data: FeatureCollection n=1 feat0.id=urn:S1 feat0.geometry.type=Point
sub=urn:ngsi-ld:Subscription:ldj
  Content-Type: application/ld+json
  data: Entity[] n=1 ids=['urn:D1']


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
