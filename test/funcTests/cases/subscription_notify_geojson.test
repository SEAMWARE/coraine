#
# FILE            subscription_notify_geojson.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 — when notification.endpoint.accept = application/geo+json,
# the notification's `data` field is rendered as a GeoJSON
# FeatureCollection (each entity → Feature with id, geometry from the
# location GeoProperty, and the rest of the entity as `properties`).
# When accept = application/ld+json, `data` is an Entity array.
# The Content-Type header reflects the negotiated MIME type.
# (One notification per dump, ftClientReset between, so each dump is
# deterministic and shown raw.)
#
--NAME--
Subscription notification — endpoint.accept rendering (§ 5.2.14)

--TAGS--
subscription notification geojson

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

echo "01. Subscription with accept = application/geo+json"
echo "==================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:geo",
  "type":"Subscription",
  "entities":[{"type":"Sensor"}],
  "notification":{
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/geo+json"
    }
  }
}'
echo
echo


echo "02. POST a Sensor with location → geo+json notification (FeatureCollection)"
echo "==========================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:S1",
  "type":"Sensor",
  "temp":{"type":"Property","value":22},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[10,20]}}
}'
echo
echo


echo "03. ftClient dump — geo+json notification, raw"
echo "=============================================="
sleep 0.4
ftClientDump
echo
echo


echo "04. Subscription with accept = application/ld+json"
echo "=================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:ldj",
  "type":"Subscription",
  "entities":[{"type":"Drone"}],
  "notification":{
    "endpoint":{
      "uri":"http://localhost:'"$FT_CLIENT_PORT"'/notify",
      "accept":"application/ld+json"
    }
  }
}'
echo
echo


echo "05. POST a Drone → ld+json notification (Entity array)"
echo "======================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:D1",
  "type":"Drone",
  "altitude":{"type":"Property","value":120}
}'
echo
echo


echo "06. ftClient dump — ld+json notification, raw"
echo "============================================="
sleep 0.4
ftClientDump
echo
echo


--EXPECT--
01. Subscription with accept = application/geo+json
===================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:geo
Content-Length: 0




02. POST a Sensor with location → geo+json notification (FeatureCollection)
===========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:S1
Content-Length: 0




03. ftClient dump — geo+json notification, raw
==============================================
[
  {
    "body": {
      "data": {
        "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
        "features": [
          {
            "geometry": {
              "coordinates": [
                10,
                20
              ],
              "type": "Point"
            },
            "id": "urn:S1",
            "properties": {
              "location": {
                "type": "GeoProperty",
                "value": {
                  "coordinates": [
                    10,
                    20
                  ],
                  "type": "Point"
                }
              },
              "temp": {
                "type": "Property",
                "value": 22
              },
              "type": "Sensor"
            },
            "type": "Feature"
          }
        ],
        "type": "FeatureCollection"
      },
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:geo",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/geo+json",
      "Host": "localhost:7701",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. Subscription with accept = application/ld+json
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:ldj
Content-Length: 0




05. POST a Drone → ld+json notification (Entity array)
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:D1
Content-Length: 0




06. ftClient dump — ld+json notification, raw
=============================================
[
  {
    "body": {
      "data": [
        {
          "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
          "altitude": {
            "type": "Property",
            "value": 120
          },
          "id": "urn:D1",
          "type": "Drone"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:ldj",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/ld+json",
      "Host": "localhost:7701",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
coraineStop
ftClientStop
