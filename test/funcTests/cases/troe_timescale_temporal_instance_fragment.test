#
# FILE            troe_timescale_temporal_instance_fragment.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The EntityTemporal Fragment of a Modify-Attribute-instance request must
# actually describe the Attribute named in the URL (§ 11.2.5.3 / § 11.2.5.4).
#
# § 11.2.5.4: "Replace the target Attribute instance identified by the
# instanceId with the Attribute instance in the EntityTemporal Fragment" — the
# instance held under the TARGET Attribute's name. § 11.2.5.3 fixes its
# cardinality: "contained by an Array of exactly one item".
#
# Both used to go unchecked. The fragment's Attribute name was ignored and
# whichever array came first was applied, so a body of {"color":[...]} sent to
# .../attrs/speed/{instanceId} silently overwrote the speed instance with colour
# data — a 204 and a corrupted history. A second array item was dropped just as
# quietly.
#
# Names are compared expanded, so the short name and the full IRI both hit the
# same target (steps 07 and 09).
#
--NAME--
TRoE timescale - Modify Attribute instance rejects a fragment for another attribute

--TAGS--
troe timescale postgres temporal patch instance validation

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. Seed urn:V1 — speed=10, color=red"
echo "====================================="
corCurl --url /ngsi-ld/v1/temporal/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":[{"type":"Property","value":10,"observedAt":"2026-01-01T00:00:00Z"}],"color":[{"type":"Property","value":"red","observedAt":"2026-01-01T00:00:00Z"}]}' | head -1
echo
echo


echo "02. Learn the speed instanceId (broker-generated, so kept out of the expect)"
echo "==========================================================================="
INST=$(corCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?attrs=speed' | grep -o 'urn:ngsi-ld:Instance:[a-zA-Z0-9-]*' | head -1)
echo "instanceId captured: $([ -n "$INST" ] && echo yes || echo no)"
echo
echo


echo "03. Fragment names a DIFFERENT attribute (color) than the URL (speed) → 400"
echo "==========================================================================="
corCurl --url "/ngsi-ld/v1/temporal/entities/urn:V1/attrs/speed/$INST" -X PATCH --payload '{"color":[{"type":"Property","value":"blue","observedAt":"2026-04-28T12:00:00Z"}]}'
echo
echo


echo "04. Nothing was written — speed still 10, color still red"
echo "========================================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1 | grep -E '"value"|"observedAt"'
echo
echo


echo "05. Fragment carries TWO instances → 400"
echo "========================================"
corCurl --url "/ngsi-ld/v1/temporal/entities/urn:V1/attrs/speed/$INST" -X PATCH --payload '{"speed":[{"type":"Property","value":25,"observedAt":"2026-04-28T10:00:00Z"},{"type":"Property","value":26,"observedAt":"2026-04-28T11:00:00Z"}]}'
echo
echo


echo "06. Still untouched — the second instance was not silently dropped"
echo "=================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?attrs=speed' | grep -E '"value"|"observedAt"'
echo
echo


echo "07. A correct one-instance fragment → 204"
echo "========================================="
corCurl --url "/ngsi-ld/v1/temporal/entities/urn:V1/attrs/speed/$INST" -X PATCH --payload '{"speed":[{"type":"Property","value":25,"observedAt":"2026-04-28T10:00:00Z"}]}'
echo
echo


echo "08. speed is now 25"
echo "==================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?attrs=speed' | grep -E '"value"|"observedAt"'
echo
echo


echo "09. The same target named by its expanded IRI → 204"
echo "==================================================="
# Term expansion is observed (§ 8.2.4), so the fully qualified name matches
# the short name in the URL.
corCurl --url "/ngsi-ld/v1/temporal/entities/urn:V1/attrs/speed/$INST" -X PATCH --payload '{"https://uri.etsi.org/ngsi-ld/default-context/speed":[{"type":"Property","value":30,"observedAt":"2026-04-28T13:00:00Z"}]}'
echo
echo


echo "10. speed is now 30"
echo "==================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:V1?attrs=speed' | grep -E '"value"|"observedAt"'
echo
echo


--TEARDOWN--
coraineStop
corDbDrop
corTroeDrop

--EXPECT--
01. Seed urn:V1 — speed=10, color=red
=====================================
HTTP/1.1 201 Created


02. Learn the speed instanceId (broker-generated, so kept out of the expect)
===========================================================================
instanceId captured: yes


03. Fragment names a DIFFERENT attribute (color) than the URL (speed) → 400
===========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 200

{
  "detail": "EntityTemporal Fragment does not contain the target attribute 'speed'",
  "status": 400,
  "title": "Invalid Fragment",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. Nothing was written — speed still 10, color still red
=========================================================
      "observedAt": "2026-01-01T00:00:00Z",
      "value": "red"
      "observedAt": "2026-01-01T00:00:00Z",
      "value": 10


05. Fragment carries TWO instances → 400
========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 186

{
  "detail": "attribute 'speed' must hold exactly one instance, got 2",
  "status": 400,
  "title": "Invalid Fragment",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. Still untouched — the second instance was not silently dropped
==================================================================
      "observedAt": "2026-01-01T00:00:00Z",
      "value": 10


07. A correct one-instance fragment → 204
=========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




08. speed is now 25
===================
      "observedAt": "2026-04-28T10:00:00Z",
      "value": 25


09. The same target named by its expanded IRI → 204
===================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




10. speed is now 30
===================
      "observedAt": "2026-04-28T13:00:00Z",
      "value": 30


