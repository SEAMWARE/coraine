    "Sub-R": {
      "object": "urn:E2"
    },
    "languageMap": {
      "en": "el",
      "es": "ele",
      "sv": "ell"
    },
    "observedAt": "2022-04-01T18:07:00.987Z"
  },
  "id": "urn:ngsi-ld:T:E1",
  "type": "T"
}



