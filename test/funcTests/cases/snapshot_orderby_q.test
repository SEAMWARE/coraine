#
# FILE            snapshot_orderby_q.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16 Snapshot — exercise the rich query semantics that "just work"
# now that snapshot reads route through the standard entity stack
# (Phase #139: snapshot-as-tenant + DB-backed store):
#
#   - GET /entities?orderBy=speed         on a snapshot
#   - GET /entities?orderBy=!speed        on a snapshot
#   - GET /entities?q=speed>50            on a snapshot
#   - GET /entities?pick=speed            on a snapshot
#   - GET /entities?limit=2&offset=1      on a snapshot
#
# Each case verifies the snapshot's frozen view ignores subsequent
# live mutations.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot read — orderBy / q / pick / pagination (§ 5.16, Phase #139)

--TAGS--
snapshot

--INIT--
corDbDrop
corSnapDrop
coraineStart

--RUN--

echo "01. Seed five Vehicles with varying speeds"
echo "=========================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V2","type":"Vehicle","speed":{"type":"Property","value":80}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V3","type":"Vehicle","speed":{"type":"Property","value":15}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V4","type":"Vehicle","speed":{"type":"Property","value":63}}'
echo
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V5","type":"Vehicle","speed":{"type":"Property","value":25}}'
echo
echo


echo "02. Create snapshot capturing all Vehicles"
echo "=========================================="
payload='{"id":"urn:ngsi-ld:Snapshot:Frozen","type":"Snapshot","snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}]}'
corCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "03. Mutate live V1 (speed → 999) — must not affect snapshot reads"
echo "================================================================="
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs --payload '{"speed":{"type":"Property","value":999}}'
echo
echo


echo "04. Snapshot read, orderBy=speed (ascending)"
echo "============================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&orderBy=speed' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "05. Snapshot read, orderBy=speed;desc (descending)"
echo "==================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&orderBy=speed%3Bdesc' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "06. Snapshot read, q=speed>50"
echo "============================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&q=speed%3E50' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "07. Snapshot read, pick=speed (no id/type filter projection)"
echo "============================================================"
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&pick=speed&orderBy=speed' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "08. Snapshot read, paginated: limit=2 offset=1, sorted by speed"
echo "==============================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle&orderBy=speed&limit=2&offset=1' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


--EXPECT--
01. Seed five Vehicles with varying speeds
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V3
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V4
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V5
Content-Length: 0




02. Create snapshot capturing all Vehicles
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
