    "id": "urn:E1",
    "ref": {
      "entity": {
        "a": {
          "type": "Property",
          "value": 1
        },
        "b": {
          "type": "Property",
          "value": 5
        },
        "id": "urn:X",
        "type": "Tx"
      },
      "object": "urn:X",
      "objectType": "Tx",
      "type": "Relationship"
    },
    "type": "Linker"
  }
]



