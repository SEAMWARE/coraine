#
# FILE            query_entities_no_match.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /entities?type=NonExistent returns empty array

--TAGS--
entity query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create Vehicle E1 with speed
# 02. GET entities?type=NonExistent - empty array (no match)
#

echo "01. Create Vehicle E1 with speed"
echo "=================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entities?type=NonExistent - empty array (no match)"
echo "============================================================"
swCurl --url '/ngsi-ld/v1/entities?type=NonExistent'
echo
echo


--EXPECT--
01. Create Vehicle E1 with speed
==================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. GET entities?type=NonExistent - empty array (no match)
============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
swBrokerStop
swDbDrop
