#
# FILE            csource-reg-distops-retrieve-exclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
DistOps - retrieveEntity forwarded to a single exclusive registered context source

--INIT--
swDbDrop -role CB
swDbDrop -role CP1
swBrokerStart -role CB
swBrokerStart -role CP1

--RUN--
#
# 01. Sanity: GET on CB for unknown entity → 404 (no entity, no registration)
# 02. Seed CP1 with V1
# 03. Register CP1 as exclusive on CB for V1
# 04. GET V1 on CB → forwarded to CP1, returns CP1's V1
# 05. ?local=true → skip dispatcher → 404 (CB has no local V1)
# 06. CSR pointing to a dead endpoint → 502 Bad Gateway
# 07. GET an entity for which no registration matches → still 404
#

CB_PORT=1026
CP1_PORT=1027


echo "01. GET on CB for unknown entity (no reg) -> 404"
echo "================================================"
swCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "02. Seed CP1 with V1"
echo "===================="
swCurl --port $CP1_PORT -X POST --url /ngsi-ld/v1/entities \
  --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
echo


echo "03. Register CP1 as exclusive on CB for V1"
echo "=========================================="
swCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/csourceRegistrations \
  --payload '{
    "id": "urn:CSR:R1",
    "type": "ContextSourceRegistration",
    "endpoint": "http://localhost:1027/ngsi-ld/v1",
    "mode": "exclusive",
    "information": [{"entities": [{"id": "urn:V1", "type": "Vehicle"}]}]
  }'
echo
echo


echo "04. GET V1 on CB -> forwarded to CP1"
echo "===================================="
swCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "05. ?local=true -> skip dispatcher -> 404"
echo "========================================="
swCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true'
echo
echo


echo "06. Dead-endpoint registration -> 502 Bad Gateway"
echo "================================================="
swCurl --port $CB_PORT -X POST --url /ngsi-ld/v1/csourceRegistrations \
  --payload '{
    "id": "urn:CSR:Dead",
    "type": "ContextSourceRegistration",
    "endpoint": "http://localhost:6666/ngsi-ld/v1",
    "mode": "exclusive",
    "information": [{"entities": [{"id": "urn:Dead:1", "type": "Dead"}]}]
  }'
echo
echo
swCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:Dead:1
echo
echo


echo "07. GET an entity for which no registration matches -> 404"
echo "=========================================================="
swCurl --port $CB_PORT --url /ngsi-ld/v1/entities/urn:NoMatch:1
echo
echo


--EXPECT--
01. GET on CB for unknown entity (no reg) -> 404
================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



02. Seed CP1 with V1
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0




03. Register CP1 as exclusive on CB for V1
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Link: REGEX(.*)
Content-Length: 0




04. GET V1 on CB -> forwarded to CP1
====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



05. ?local=true -> skip dispatcher -> 404
=========================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



06. Dead-endpoint registration -> 502 Bad Gateway
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Dead
Link: REGEX(.*)
Content-Length: 0




HTTP/1.1 502 Bad Gateway
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": REGEX("forwarded request failed: .*"),
  "title": "Bad Gateway",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InternalError"
}



07. GET an entity for which no registration matches -> 404
==========================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:NoMatch:1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
swBrokerStop -role CB
swBrokerStop -role CP1
swDbDrop -role CB
swDbDrop -role CP1
