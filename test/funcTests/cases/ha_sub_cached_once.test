#
# FILE            ha_sub_cached_once.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# REQUIRE_HA: yes
#
# REQUIRE_FEATURE: REGISTRATIONS SUBSCRIPTIONS
#
# MongoDB-only: two brokers sharing ONE MongoDB database, synchronised by its change streams - corDB has no shared database
# REQUIRE_DB: mongoc
#
--NAME--
HA - a subscription created on a broker is in its cache once, however its own change event races the create

--TAGS--
ha mongoc subscription

--INIT--
corDbDrop
corDbDrop -role CB2
ftClientStart
coraineStart --high-availability mongo
coraineStart -role CB2 --dbName corTest --high-availability mongo

--RUN--

#
# A broker with --high-availability mongo gets the change event of every write to the database -
# its own writes too - and applies it to its cache. A create of a subscription writes it to the
# database and then puts it in the cache; when the change event of that very write is applied in
# between, the subscription is already in the cache when the create adds it. It must still be there
# once: a subscription cached twice notifies twice.
#
# The window is small: before the fix, about one create in 300 hit it on a workstation - 1600
# creates, 16 at a time, make a run without one unlikely.
#
# 01. 1000 subscriptions, 300 periodic subscriptions and 300 subscriptions to registrations on CB, 16 at a time
# 02. Each of them once on CB, and once on CB2
# 03. An entity they all match: ONE notification per subscription
# 04. All of them deleted on CB
# 05. None left on CB, none on CB2
# 06. The entity updated: no notification
#

#
# post <path> <n> <body with @N@ for the number> - n creates on CB, 16 at a time; the status codes, counted
# ids <port> <path> - how many ids the list on <port> has, and how many of them are there more than once
# notified - the notifications ftClient gets until a second goes by without one: how many, from how many subscriptions
#
post() {
  seq 1 $2 | xargs -P 16 -I@N@ curl -s -o /dev/null -w '%{http_code}\n' localhost:$CB_PORT$1 -H 'Content-Type: application/json' -d "$3" | sort | uniq -c | sed 's/^ *//'
}
ids() {
  curl -s "localhost:$1$2?limit=2000" | python3 -c '
import sys,json,collections
c=collections.Counter(s["id"] for s in json.load(sys.stdin))
print("%d listed, %d more than once" % (sum(c.values()), sum(1 for v in c.values() if v > 1)))'
}
notified() {
  local dir=$(mktemp -d)
  local n=0
  local quiet=0
  while [ $quiet -lt 10 ]; do                                     # until 1 s without a notification
    ftClientDump > $dir/$n
    if [ "$(tr -d ' \n' < $dir/$n)" == "[]" ]; then quiet=$((quiet + 1)); sleep 0.1; else quiet=0; n=$((n + 1)); fi
  done
  python3 -c '
import sys,json,collections,glob
c=collections.Counter()
for f in glob.glob(sys.argv[1] + "/*"):
    for e in json.load(open(f)):
        b=e["body"] if isinstance(e["body"], dict) else json.loads(e["body"])
        c[b["subscriptionId"]]+=1
print("%d notifications from %d subscriptions" % (sum(c.values()), len(c)))' $dir
  rm -rf $dir
}

NOTIFY='"notification":{"endpoint":{"uri":"http://localhost:'$FT_CLIENT_PORT'/notify"}}'

echo "01. 1000 subscriptions, 300 periodic subscriptions and 300 subscriptions to registrations on CB, 16 at a time"
echo "============================================================================================================="
post /ngsi-ld/v1/subscriptions        1000 '{"id":"urn:S:@N@","type":"Subscription","entities":[{"type":"Room"}],'"$NOTIFY"'}'
post /ngsi-ld/v1/subscriptions        300 '{"id":"urn:P:@N@","type":"Subscription","entities":[{"type":"Hall"}],"timeInterval":3600,'"$NOTIFY"'}'
post /ngsi-ld/v1/csourceSubscriptions 300 '{"id":"urn:C:@N@","type":"Subscription","entities":[{"type":"Room"}],'"$NOTIFY"'}'
echo
echo


echo "02. Each of them once on CB, and once on CB2"
echo "============================================"
for port in $CB_PORT $CB2_PORT; do
  for i in $(seq 1 100); do
    [ "$(curl -s "localhost:$port/ngsi-ld/v1/subscriptions?limit=1&count=true" -o /dev/null -D - | grep -i '^NGSILD-Results-Count' | tr -dc 0-9)" == 1300 ] && break
    sleep 0.1
  done
  echo "$([ $port == $CB_PORT ] && echo CB || echo CB2) subscriptions:        $(ids $port /ngsi-ld/v1/subscriptions)"
  echo "$([ $port == $CB_PORT ] && echo CB || echo CB2) csourceSubscriptions: $(ids $port /ngsi-ld/v1/csourceSubscriptions)"
done
echo
echo


echo "03. An entity they all match: ONE notification per subscription"
echo "==============================================================="
ftClientDump > /dev/null
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:Room:1","type":"Room","t":{"type":"Property","value":1}}' | grep HTTP
notified
echo
echo


echo "04. All of them deleted on CB"
echo "============================="
seq 1 1000 | xargs -P 16 -I@N@ curl -s -o /dev/null -w '%{http_code}\n' -X DELETE localhost:$CB_PORT/ngsi-ld/v1/subscriptions/urn:S:@N@        | sort | uniq -c | sed 's/^ *//'
seq 1 300 | xargs -P 16 -I@N@ curl -s -o /dev/null -w '%{http_code}\n' -X DELETE localhost:$CB_PORT/ngsi-ld/v1/subscriptions/urn:P:@N@        | sort | uniq -c | sed 's/^ *//'
seq 1 300 | xargs -P 16 -I@N@ curl -s -o /dev/null -w '%{http_code}\n' -X DELETE localhost:$CB_PORT/ngsi-ld/v1/csourceSubscriptions/urn:C:@N@ | sort | uniq -c | sed 's/^ *//'
echo
echo


echo "05. None left on CB, none on CB2"
echo "================================"
for port in $CB_PORT $CB2_PORT; do
  for i in $(seq 1 100); do
    [ "$(curl -s "localhost:$port/ngsi-ld/v1/subscriptions?limit=1&count=true" -o /dev/null -D - | grep -i '^NGSILD-Results-Count' | tr -dc 0-9)" == 0 ] && break
    sleep 0.1
  done
  echo "$([ $port == $CB_PORT ] && echo CB || echo CB2) subscriptions:        $(ids $port /ngsi-ld/v1/subscriptions)"
  echo "$([ $port == $CB_PORT ] && echo CB || echo CB2) csourceSubscriptions: $(ids $port /ngsi-ld/v1/csourceSubscriptions)"
done
echo
echo


echo "06. The entity updated: no notification"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities/urn:Room:1/attrs/t -X PATCH --payload '{"type":"Property","value":2}' | grep HTTP
notified
echo
echo

--EXPECT--
01. 1000 subscriptions, 300 periodic subscriptions and 300 subscriptions to registrations on CB, 16 at a time
=============================================================================================================
1000 201
300 201
300 201


02. Each of them once on CB, and once on CB2
============================================
CB subscriptions:        1300 listed, 0 more than once
CB csourceSubscriptions: 300 listed, 0 more than once
CB2 subscriptions:        1300 listed, 0 more than once
CB2 csourceSubscriptions: 300 listed, 0 more than once


03. An entity they all match: ONE notification per subscription
===============================================================
HTTP/1.1 201 Created
1000 notifications from 1000 subscriptions


04. All of them deleted on CB
=============================
1000 204
300 204
300 204


05. None left on CB, none on CB2
================================
CB subscriptions:        0 listed, 0 more than once
CB csourceSubscriptions: 0 listed, 0 more than once
CB2 subscriptions:        0 listed, 0 more than once
CB2 csourceSubscriptions: 0 listed, 0 more than once


06. The entity updated: no notification
=======================================
HTTP/1.1 204 No Content
0 notifications from 0 subscriptions


--TEARDOWN--
ftClientStop
coraineStop -all
