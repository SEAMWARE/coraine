#
# FILE            troe_timescale_routes_batch.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The batch routes, as troe_timescale_routes_single_entity.test does the
# single-entity ones: one fixture (P1: a default instance with a and b, and
# urn:ds:1 with x and y; P2 with s, which no write names), the current state
# and the whole history read back after each write. The newest row of each
# instance must BE that instance in the current state; an instance or an
# Attribute the write did not touch gets no row; and no row is written twice.
#
# Upsert and Update each write two entities in one request - each entity's
# history is its own.
#
--NAME--
TRoE timescale - every batch write route, history of each instance touched and of none other

--TAGS--
troe timescale postgres temporal datasetid subattrs batch

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale --troeSync

--RUN--
fixture()
{
  corCurl --url /ngsi-ld/v1/entities --payload '{
    "id": "'$1'",
    "type": "T",
    "P1": [
      { "type": "Property", "value": 1, "a": { "type": "Property", "value": "A" }, "b": { "type": "Property", "value": "B" } },
      { "type": "Property", "value": 2, "datasetId": "urn:ds:1", "x": { "type": "Property", "value": "X" }, "y": { "type": "Property", "value": "Y" } }
    ],
    "P2": { "type": "Property", "value": 9, "s": { "type": "Property", "value": "S" } }
  }'
}

current()
{
  corCurl --url /ngsi-ld/v1/entities/$1
}

history()
{
  corCurl --url /ngsi-ld/v1/temporal/entities/$1 --urlParams 'timerel=after&timeAt=2020-01-01T00:00:00Z&timeproperty=modifiedAt'
}



echo "01. POST /entityOperations/create - two entities, the fixture's shape: three rows each"
echo "======================================================================================"
corCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {
    "id": "urn:B:01a", "type": "T",
    "P1": [
      { "type": "Property", "value": 1, "a": { "type": "Property", "value": "A" }, "b": { "type": "Property", "value": "B" } },
      { "type": "Property", "value": 2, "datasetId": "urn:ds:1", "x": { "type": "Property", "value": "X" }, "y": { "type": "Property", "value": "Y" } }
    ],
    "P2": { "type": "Property", "value": 9, "s": { "type": "Property", "value": "S" } }
  },
  {
    "id": "urn:B:01b", "type": "T",
    "P1": [
      { "type": "Property", "value": 1, "a": { "type": "Property", "value": "A" }, "b": { "type": "Property", "value": "B" } },
      { "type": "Property", "value": 2, "datasetId": "urn:ds:1", "x": { "type": "Property", "value": "X" }, "y": { "type": "Property", "value": "Y" } }
    ],
    "P2": { "type": "Property", "value": 9, "s": { "type": "Property", "value": "S" } }
  }
]'
echo
current urn:B:01a
echo
history urn:B:01a
echo
current urn:B:01b
echo
history urn:B:01b
echo
echo


echo "02. POST /entityOperations/upsert (replace) - urn:B:02a to P1 default only, urn:B:02b new"
echo "=========================================================================================="
fixture urn:B:02a > /dev/null
corCurl --url /ngsi-ld/v1/entityOperations/upsert --payload '[
  { "id": "urn:B:02a", "type": "T", "P1": { "type": "Property", "value": 10, "c": { "type": "Property", "value": "C" } } },
  { "id": "urn:B:02b", "type": "T", "P1": [
      { "type": "Property", "value": 11 },
      { "type": "Property", "value": 12, "datasetId": "urn:ds:1", "x": { "type": "Property", "value": "X" } }
  ] }
]'
echo
current urn:B:02a
echo
history urn:B:02a
echo
current urn:B:02b
echo
history urn:B:02b
echo
echo


echo "03. POST /entityOperations/upsert?options=update - P1 urn:ds:1 of urn:B:03 only: one new row"
echo "============================================================================================="
fixture urn:B:03 > /dev/null
corCurl --url '/ngsi-ld/v1/entityOperations/upsert?options=update' --payload '[
  { "id": "urn:B:03", "type": "T", "P1": { "type": "Property", "value": 13, "datasetId": "urn:ds:1", "x": { "type": "Property", "value": "X3" } } }
]'
echo
current urn:B:03
echo
history urn:B:03
echo
echo


echo "04. POST /entityOperations/update - two entities: P1 default of urn:B:04a, P1 urn:ds:1 of urn:B:04b"
echo "==================================================================================================="
fixture urn:B:04a > /dev/null
fixture urn:B:04b > /dev/null
corCurl --url /ngsi-ld/v1/entityOperations/update --payload '[
  { "id": "urn:B:04a", "type": "T", "P1": { "type": "Property", "value": 14, "a": { "type": "Property", "value": "A4" } } },
  { "id": "urn:B:04b", "type": "T", "P1": { "type": "Property", "value": 15, "datasetId": "urn:ds:1", "y": { "type": "Property", "value": "Y4" } } }
]'
echo
current urn:B:04a
echo
history urn:B:04a
echo
current urn:B:04b
echo
history urn:B:04b
echo
echo


echo "05. POST /entityOperations/update?options=noOverwrite - P1 exists: nothing written, no new row"
echo "==============================================================================================="
fixture urn:B:05 > /dev/null
corCurl --url '/ngsi-ld/v1/entityOperations/update?options=noOverwrite' --payload '[
  { "id": "urn:B:05", "type": "T", "P1": { "type": "Property", "value": 16, "datasetId": "urn:ds:1" } }
]'
echo
current urn:B:05
echo
history urn:B:05
echo
echo


echo "06. POST /entityOperations/merge - P1 default to 17, urn:ds:1 to 18 with x null: two new rows, P2 none"
echo "======================================================================================================"
fixture urn:B:06 > /dev/null
corCurl --url /ngsi-ld/v1/entityOperations/merge --payload '[
  { "id": "urn:B:06", "type": "T", "P1": [
      { "type": "Property", "value": 17 },
      { "type": "Property", "value": 18, "datasetId": "urn:ds:1", "x": "urn:ngsi-ld:null" }
  ] }
]'
echo
current urn:B:06
echo
history urn:B:06
echo
echo


echo "07. POST /entityOperations/delete - the entity goes, its history stays, with its deletedAt"
echo "=========================================================================================="
fixture urn:B:07 > /dev/null
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '[ "urn:B:07" ]'
echo
current urn:B:07
echo
history urn:B:07
echo
echo


--TEARDOWN--
coraineStop


