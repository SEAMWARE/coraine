#
# FILE            query_q_sysattrs_temporal.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# q over the system temporal attributes createdAt / modifiedAt. These are stored
# as top-level nanosecond fields (not under value), so the q path compares them
# numerically against the ISO 8601 right-hand side. Works on both the entity
# query and the notification (subscription q) paths. Bounds are fixed in the far
# past / future so "now" is deterministically inside them.
#
--NAME--
q over createdAt / modifiedAt (system temporal attributes)

--TAGS--
q query subscription notification

--INIT--
corDbDrop
coraineStart
ftClientStart

--RUN--

echo "01. Seed two entities"
echo "====================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T","P":{"type":"Property","value":1}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E2","type":"T","P":{"type":"Property","value":2}}' | head -1
echo
echo


echo "02. q=modifiedAt>2000-01-01 — both (created after 2000)"
echo "======================================================"
corCurl --url '/ngsi-ld/v1/entities?type=T&q=modifiedAt%3E2000-01-01T00:00:00Z'
echo
echo


echo "03. q=modifiedAt>2099-01-01 — none (not yet)"
echo "==========================================="
corCurl --url '/ngsi-ld/v1/entities?type=T&q=modifiedAt%3E2099-01-01T00:00:00Z'
echo
echo


echo "04. q=createdAt<2099-01-01 — both"
echo "================================="
corCurl --url '/ngsi-ld/v1/entities?type=T&q=createdAt%3C2099-01-01T00:00:00Z'
echo
echo


echo "05. q=createdAt>2099-01-01 — none"
echo "================================="
corCurl --url '/ngsi-ld/v1/entities?type=T&q=createdAt%3E2099-01-01T00:00:00Z'
echo
echo


echo "06. Subscription q=modifiedAt>2000 — create E3 → notifies"
echo "========================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:Sub:Match","type":"Subscription","entities":[{"type":"U"}],"q":"modifiedAt>2000-01-01T00:00:00Z","notification":{"endpoint":{"uri":"http://localhost:7701/notify","accept":"application/json"}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E3","type":"U","P":{"type":"Property","value":3}}' | head -1
sleep 0.3
ftClientDump
echo
echo


echo "07. Subscription q=modifiedAt>2099 — create E4 → no notification"
echo "================================================================"
corCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:Sub:NoMatch","type":"Subscription","entities":[{"type":"V"}],"q":"modifiedAt>2099-01-01T00:00:00Z","notification":{"endpoint":{"uri":"http://localhost:7701/notify","accept":"application/json"}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E4","type":"V","P":{"type":"Property","value":4}}' | head -1
sleep 0.3
ftClientDump
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Seed two entities
=====================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. q=modifiedAt>2000-01-01 — both (created after 2000)
======================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 231

[
  {
    "P": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E1",
    "type": "T"
  },
  {
    "P": {
      "type": "Property",
      "value": 2
    },
    "id": "urn:ngsi-ld:E2",
    "type": "T"
  }
]



03. q=modifiedAt>2099-01-01 — none (not yet)
===========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



04. q=createdAt<2099-01-01 — both
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 231

[
  {
    "P": {
      "type": "Property",
      "value": 1
    },
    "id": "urn:ngsi-ld:E1",
    "type": "T"
  },
  {
    "P": {
      "type": "Property",
      "value": 2
    },
    "id": "urn:ngsi-ld:E2",
    "type": "T"
  }
]



05. q=createdAt>2099-01-01 — none
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



06. Subscription q=modifiedAt>2000 — create E3 → notifies
=========================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
[
  {
    "body": {
      "data": [
        {
          "P": {
            "type": "Property",
            "value": 3
          },
          "id": "urn:ngsi-ld:E3",
          "type": "U"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Sub:Match",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "228",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


07. Subscription q=modifiedAt>2099 — create E4 → no notification
================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
[]

[]
--TEARDOWN--
coraineStop
corDbDrop
ftClientStop
