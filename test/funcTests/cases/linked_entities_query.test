#
# FILE            linked_entities_query.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.5.23 — linked-entity expansion on the query side. Each result
# entity is walked the same way as retrieveEntity. Flat dedupes the
# shared-target case across the whole query (one entry in the array
# regardless of how many primaries reference it); inline embeds the
# target under each linking entity (per-primary visited-set).
#
--NAME--
Linked entities — queryEntities flat + inline expansion

--TAGS--
query linked-entities

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# Seed:
#   urn:Garage  : referenced as parking spot by both V1 and V2 (shared target).
#   V1, V2      : Vehicles, both with parking → urn:Garage.
#   V3          : Vehicle without a Relationship.
#
# Steps:
# 04. Query type=Vehicle, no join                — array of 3 vehicles.
# 05. Query type=Vehicle, join=flat&joinLevel=1  — 3 vehicles + 1 Garage (deduped).
# 06. Query type=Vehicle, join=inline&joinLevel=1 — V1+V2 each embed Garage; V3 unchanged.
#

echo "01. Seed urn:Garage"
echo "==================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:Garage","type":"Place","name":{"type":"Property","value":"Main"}}'
echo
echo


echo "02. Seed urn:V1 → Garage"
echo "========================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42},"parking":{"type":"Relationship","object":"urn:Garage"}}'
echo
echo


echo "03. Seed urn:V2 → Garage"
echo "========================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":17},"parking":{"type":"Relationship","object":"urn:Garage"}}'
echo
echo


echo "04. Seed urn:V3 (no relationship)"
echo "================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":99}}'
echo
echo


echo "05. Query type=Vehicle, no join — 3 vehicles"
echo "============================================"
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


echo "06. Query type=Vehicle, join=flat&joinLevel=1 — 3 vehicles + 1 Garage (deduped)"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&join=flat&joinLevel=1'
echo
echo


echo "07. Query type=Vehicle, join=inline&joinLevel=1 — V1+V2 embed Garage, V3 unchanged"
echo "=================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&join=inline&joinLevel=1'
echo
echo


--EXPECT--
01. Seed urn:Garage
===================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:Garage
Content-Length: 0




02. Seed urn:V1 → Garage
========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. Seed urn:V2 → Garage
========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




04. Seed urn:V3 (no relationship)
=================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V3
Content-Length: 0




05. Query type=Vehicle, no join — 3 vehicles
============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "parking": {
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "parking": {
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 17
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": {
      "type": "Property",
      "value": 99
    },
    "type": "Vehicle"
  }
]



06. Query type=Vehicle, join=flat&joinLevel=1 — 3 vehicles + 1 Garage (deduped)
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "parking": {
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "parking": {
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 17
    },
    "type": "Vehicle"
  },
  {
