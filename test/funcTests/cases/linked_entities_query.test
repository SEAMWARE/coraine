07. Query type=Vehicle, join=inline&joinLevel=1 — V1+V2 embed Garage, V3 unchanged
==================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "parking": {
      "entity": {
        "id": "urn:Garage",
        "name": {
          "type": "Property",
          "value": "Main"
        },
        "type": "Place"
      },
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "parking": {
      "entity": {
        "id": "urn:Garage",
        "name": {
          "type": "Property",
          "value": "Main"
        },
        "type": "Place"
      },
      "object": "urn:Garage",
      "type": "Relationship"
    },
    "speed": {
      "type": "Property",
      "value": 17
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": {
      "type": "Property",
      "value": 99
    },
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
