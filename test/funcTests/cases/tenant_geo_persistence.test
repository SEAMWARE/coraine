#
# REQUIRE_DB: mongoc
# FILE            tenant_geo_persistence.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Per-tenant geo-query persistence across broker restart

--TAGS--
geo tenant

--INIT--
swDbDrop
swDbDrop -tenant t1
swDbDrop -tenant t2
swBrokerStart

--RUN--

#
# 01. Create entity E1 in Madrid on tenant t1
# 02. Create entity E2 in Paris on tenant t2
# 03. Restart broker
# 04. GET near Madrid on t1 - should still get E1 (index re-created)
# 05. GET near Paris on t2 - should still get E2 (index re-created)
#

echo "01. Create entity E1 in Madrid on tenant t1"
echo "==========================================="
payload='{
  "id": "urn:e1",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.703, 40.417]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'NGSILD-Tenant: t1'
echo
echo


echo "02. Create entity E2 in Paris on tenant t2"
echo "=========================================="
payload='{
  "id": "urn:e2",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.349, 48.864]
    }
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'NGSILD-Tenant: t2'
echo
echo


echo "03. Restart broker"
echo "=================="
swBrokerStop
swBrokerStart
echo
echo


echo "04. GET near Madrid on t1 - should still get E1 (index re-created)"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[-3.703,40.417\]' -H 'NGSILD-Tenant: t1'
echo
echo


echo "05. GET near Paris on t2 - should still get E2 (index re-created)"
echo "================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=City&georel=near%3BmaxDistance%3D%3D50000&geometry=Point&coordinates=\[2.349,48.864\]' -H 'NGSILD-Tenant: t2'
echo
echo


--EXPECT--
01. Create entity E1 in Madrid on tenant t1
===========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t1
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: REGEX(\d+)




02. Create entity E2 in Paris on tenant t2
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t2
Location: /ngsi-ld/v1/entities/urn:e2
Content-Length: REGEX(\d+)




03. Restart broker
==================


04. GET near Madrid on t1 - should still get E1 (index re-created)
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t1
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e1",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          -3.703,
          40.417
        ],
        "type": "Point"
      }
    },
    "type": "City"
  }
]



05. GET near Paris on t2 - should still get E2 (index re-created)
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t2
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "geoDistance": REGEX([0-9.]+),
    "id": "urn:e2",
    "location": {
      "type": "GeoProperty",
      "value": {
        "coordinates": [
          2.349,
          48.864
        ],
        "type": "Point"
      }
    },
    "type": "City"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
swDbDrop -tenant t1
swDbDrop -tenant t2
