Content-Length: 201

{
  "attributeCount": 1,
  "attributeName": "status",
  "attributeTypes": [
    "Property"
  ],
  "id": "https://uri.etsi.org/ngsi-ld/status",
  "type": "Attribute",
  "typeNames": [
    "Robot"
  ]
}



