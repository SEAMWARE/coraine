#
# FILE            patch_attrs_datasetid_instance_update.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Ported from orion-ld ngsild_patch_existing_datasetId_instance, but testing the
# CORRECT behaviour rather than Orion's 501 (Orion-LD has not implemented
# datasetId on /attrs yet — its 501 is a known gap, not spec). sw implements it:
# PATCH /entities/{id}/attrs with a body datasetId updates exactly that instance
# and leaves the default and the other dataset instances intact.
#
--NAME--
PATCH /attrs with a body datasetId updates that instance only, no corruption

--TAGS--
patch attr attrs datasetid multi-attr

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. POST E1 with A = [ default(0), D1(1), D2(2) ]
# 02. PATCH A's D1 instance via /attrs to value 11
# 03. GET E1 — default(0) and D2(2) intact, D1 now 11
#

echo "01. POST E1 (A: default + D1 + D2)"
echo "=================================="
swCurl --url /ngsi-ld/v1/entities -X POST --payload '{
  "id": "urn:ngsi-ld:E1",
  "type": "T",
  "A": [
    { "type": "Property", "value": 0 },
    { "type": "Property", "value": 1, "datasetId": "urn:ngsi-ld:dataset:D1" },
    { "type": "Property", "value": 2, "datasetId": "urn:ngsi-ld:dataset:D2" }
  ]
}'
echo
echo


echo "02. PATCH A's D1 instance via /attrs to value 11"
echo "================================================"
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs -X PATCH --payload '{
  "A": { "type": "Property", "value": 11, "datasetId": "urn:ngsi-ld:dataset:D1" }
}'
echo
echo


echo "03. GET E1 — D1 updated to 11, default(0) and D2(2) intact"
echo "========================================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1
echo
echo


--EXPECT--
01. POST E1 (A: default + D1 + D2)
==================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1
Content-Length: 0




02. PATCH A's D1 instance via /attrs to value 11
================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET E1 — D1 updated to 11, default(0) and D2(2) intact
=========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 316

{
  "A": [
    {
      "type": "Property",
      "value": 0
    },
    {
      "datasetId": "urn:ngsi-ld:dataset:D2",
      "type": "Property",
      "value": 2
    },
    {
      "datasetId": "urn:ngsi-ld:dataset:D1",
      "type": "Property",
      "value": 11
    }
  ],
  "id": "urn:ngsi-ld:E1",
  "type": "T"
}



--TEARDOWN--
swBrokerStop
swDbDrop
