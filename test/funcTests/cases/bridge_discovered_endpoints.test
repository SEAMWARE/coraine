#
# FILE            bridge_discovered_endpoints.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# A service or an action the transport DISCOVERS, that no Channel carries, is
# carried on the bridge's catch-all entity (ABI 8, endpointDiscoveredIn) - with
# the endpoint as its attribute, as Orion-LD puts every discovered action on
# urn:ngsi-ld:dds:default. Here a discovered service is invocable too.
#
# The loopback reports four: 'calc' (configured already - nothing changes),
# 'adder' (a service), 'fib' (an action) and 'robot1/navigate' (a namespaced
# action - no short name can have a '/', so its attribute is robot1_navigate).
#
#   01  the catch-all has 'adder', 'fib' and 'robot1_navigate', "uninitialized"
#       - not 'calc'
#   02  PATCH adder, waiting: the loopback's reply is written with the value
#   03  PATCH fib: a goal, accepted - 202
#   04  PATCH robot1_navigate: a goal, accepted - 202 (sent to robot1/navigate)
#   05  a broker whose configuration says "defaultEntity": false carries
#       nothing it was not told to - the catch-all entity is not even made
#
--NAME--
Bridges: discovered services and actions are carried on the catch-all entity (ABI 8)

--TAGS--
bridge plugins service action discovery

--INIT--
corDbDrop
BRIDGE_CONFIG=$(bridgeConfig \
  --service "calc,Calculator,urn:C:1,job" \
  --discover "calc=service" \
  --discover "adder=service" \
  --discover "fib=action" \
  --discover "robot1/navigate=action")
coraineStart --bridges loopback --bridgeConfig $BRIDGE_CONFIG

--RUN--

echo "01. The catch-all entity - adder and fib, discovered; calc is a configured Channel's"
echo "==================================================================================="
for i in $(seq 1 50); do
  corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default 2>/dev/null | grep -q '"robot1_navigate"' && break
  sleep 0.1
done
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default
echo
echo


echo "02. PATCH adder ?ddsSync=true - a discovered service answers, written with the value"
echo "==================================================================================="
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default/attrs/adder?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 2, "b": 3 } }'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default/attrs/adder
echo
echo


echo "03. PATCH fib - a goal to a discovered action: accepted, 202"
echo "============================================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default/attrs/fib -X PATCH \
        --payload '{ "type": "Property", "value": { "order": 5 } }' | head -1
echo
echo


echo "04. PATCH robot1_navigate - the goal goes to the action robot1/navigate: 202"
echo "============================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default/attrs/robot1_navigate -X PATCH \
        --payload '{ "type": "Property", "value": { "x": 1 } }' | head -1
sleep 0.3
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default/attrs/robot1_navigate
echo
echo


echo "05. \"defaultEntity\": false - discovered endpoints are left alone"
echo "================================================================"
coraineStop
corDbDrop
BRIDGE_CONFIG2=$(bridgeConfig \
  --defaultEntity false \
  --discover "adder=service")
coraineStart --bridges loopback --bridgeConfig $BRIDGE_CONFIG2
sleep 0.5
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:loopback:default | head -1
echo
echo


--EXPECT--
01. The catch-all entity - adder and fib, discovered; calc is a configured Channel's
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "adder": {
    "type": "Property",
    "value": "uninitialized"
  },
  "fib": {
    "type": "Property",
    "value": "uninitialized"
  },
  "id": "urn:ngsi-ld:loopback:default",
  "robot1_navigate": {
    "type": "Property",
    "value": "uninitialized"
  },
  "type": "LOOPBACK"
}



02. PATCH adder ?ddsSync=true - a discovered service answers, written with the value
===================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)


HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "reply": {
    "type": "Property",
    "value": {
      "a": 2,
      "b": 3
    }
  },
  "type": "Property",
  "value": {
    "a": 2,
    "b": 3
  }
}



03. PATCH fib - a goal to a discovered action: accepted, 202
============================================================
HTTP/1.1 202 Accepted


04. PATCH robot1_navigate - the goal goes to the action robot1/navigate: 202
============================================================================
HTTP/1.1 202 Accepted
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "type": "Property",
  "value": {
    "x": 1
  }
}



05. "defaultEntity": false - discovered endpoints are left alone
================================================================
HTTP/1.1 404 Not Found


--TEARDOWN--
coraineStop
corDbDrop
