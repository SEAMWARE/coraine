#
# FILE            subscription_notif_join.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 notification.join + joinLevel — linked-entity retrieval
# (§ 4.5.23) applied during notification body shaping.
#
--NAME--
Subscription notification - notification.join flat / inline (§ 5.2.14, § 4.5.23)

--TAGS--
subscription notification linked-entities

--INIT--
corDbDrop
coraineStart
ftClientStart --port 7711 --status 200

--RUN--

echo "01. Seed Person urn:P1 and Vehicle urn:V1 with parking → urn:P1"
echo "==============================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:P1","type":"Person","name":{"type":"Property","value":"Alice"}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42},"parking":{"type":"Relationship","object":"urn:P1"}}' | head -1
echo
echo


echo "02. Sub on Vehicle with notification.join=flat, joinLevel=1"
echo "==========================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:Flat",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {
    "join": "flat",
    "joinLevel": 1,
    "endpoint": {
      "uri": "http://localhost:7711/notify",
      "cooldown": 1
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | head -1
echo
echo


echo "03. Trigger - update V1 → notification carries V1 + P1 (flat array)"
echo "==================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs --payload '{"speed":{"type":"Property","value":99}}' | head -1
echo
echo


echo "04. ftClient dump — data[] has both V1 and P1"
echo "============================================="
ftClientDump --port 7711 | grep -E '"id": "urn:[VP][0-9]"' | sort
echo
echo


echo "05. Replace sub with sysAttrs:true and trigger again"
echo "===================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Flat -X DELETE | head -1
payload='{
  "id": "urn:ngsi-ld:Subscription:FlatSys",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {
    "join": "flat",
    "joinLevel": 1,
    "sysAttrs": true,
    "endpoint": {
      "uri": "http://localhost:7711/notify",
      "cooldown": 1
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | head -1
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs --payload '{"speed":{"type":"Property","value":100}}' | head -1
echo
echo


echo "06. ftClient dump — both V1 and linked P1 carry createdAt + modifiedAt"
echo "======================================================================"
ftClientDump --port 7711 | grep -cE '"createdAt"'
echo
echo


--EXPECT--
01. Seed Person urn:P1 and Vehicle urn:V1 with parking → urn:P1
===============================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. Sub on Vehicle with notification.join=flat, joinLevel=1
===========================================================
HTTP/1.1 201 Created


03. Trigger - update V1 → notification carries V1 + P1 (flat array)
===================================================================
HTTP/1.1 204 No Content


04. ftClient dump — data[] has both V1 and P1
=============================================
          "id": "urn:P1",
          "id": "urn:V1",


05. Replace sub with sysAttrs:true and trigger again
====================================================
HTTP/1.1 204 No Content
HTTP/1.1 201 Created
HTTP/1.1 204 No Content


06. ftClient dump — both V1 and linked P1 carry createdAt + modifiedAt
======================================================================
5


--TEARDOWN--
ftClientStop --port 7711
coraineStop
corDbDrop
