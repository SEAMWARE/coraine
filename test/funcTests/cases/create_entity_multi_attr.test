#
# FILE            create_entity_multi_attr.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
POST entity with multi-attribute (array of instances) returns 201

--TAGS--
create entity

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with multi-instance attribute (default + named datasetId) - 201 Created
#

echo "01. Create entity with multi-instance attribute (default + named datasetId) - 201 Created"
echo "=========================================================================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "type": "Property",
      "value": 98,
      "datasetId": "urn:sensor:radar"
    }
  ]
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


--EXPECT--
01. Create entity with multi-instance attribute (default + named datasetId) - 201 Created
==========================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:e1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 0




--TEARDOWN--
swBrokerStop
swDbDrop
