#
# FILE            scopeq_exact_nonleaf_and_compose.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Two scopeQ behaviours that query_entities_scope.test does not pin down:
#
#  1. An exact (no-wildcard) scope query matches ONLY the entities carrying
#     exactly that scope — even when the scope is a non-leaf path. So
#     scopeQ=/Madrid/Gardens must NOT return entities scoped
#     /Madrid/Gardens/ParqueNorte; only the "/#" form matches the hierarchy
#     below (TS 104-175 § 4.19: the trailing "/#" wildcard is what extends a
#     scope query to the sub-hierarchy).
#
#  2. scopeQ composes (logical AND) with the other filters q and georel —
#     an entity must satisfy the scope filter AND the q filter AND the geo
#     filter to be returned.
#
--NAME--
scopeQ exact non-leaf is not a prefix match; scopeQ composes with q + geo

--TAGS--
entity query scope q geoquery

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Create G  scope=/Madrid/Gardens (exact non-leaf), name=HQ, loc [0,0]"
echo "======================================================================="
payload='{ "id": "urn:ngsi-ld:Z:G", "type": "Zone", "scope": "/Madrid/Gardens", "name": { "type": "Property", "value": "HQ" }, "location": { "type": "GeoProperty", "value": { "type": "Point", "coordinates": [0, 0] } } }'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create N  scope=/Madrid/Gardens/ParqueNorte, name=Norte, loc [10,10]"
echo "======================================================================="
payload='{ "id": "urn:ngsi-ld:Z:N", "type": "Zone", "scope": "/Madrid/Gardens/ParqueNorte", "name": { "type": "Property", "value": "Norte" }, "location": { "type": "GeoProperty", "value": { "type": "Point", "coordinates": [10, 10] } } }'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create S  scope=/Madrid/Gardens/ParqueSur, name=Sur, loc [0,0] (near G)"
echo "=========================================================================="
payload='{ "id": "urn:ngsi-ld:Z:S", "type": "Zone", "scope": "/Madrid/Gardens/ParqueSur", "name": { "type": "Property", "value": "Sur" }, "location": { "type": "GeoProperty", "value": { "type": "Point", "coordinates": [0, 0] } } }'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. scopeQ=/Madrid/Gardens (EXACT) → only G, NOT the ParqueNorte/Sur descendants"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Zone&scopeQ=/Madrid/Gardens' | grep '"id"'
echo
echo


echo "05. scopeQ=/Madrid/Gardens/# (hierarchy) → G, N, S"
echo "=================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Zone&scopeQ=/Madrid/Gardens/%23' | grep '"id"'
echo
echo


echo "06. scopeQ=/Madrid/Gardens/# AND q=name==\"Norte\" → only N"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Zone&scopeQ=/Madrid/Gardens/%23&q=name==%22Norte%22' | grep '"id"'
echo
echo


echo "07. scopeQ=/Madrid/Gardens/# AND near [0,0] within 1km → G + S (not N at [10,10])"
echo "================================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=Zone&scopeQ=/Madrid/Gardens/%23&georel=near%3BmaxDistance%3D%3D1000&geometry=Point&coordinates=%5B0%2C0%5D' | grep '"id"'

--EXPECT--
01. Create G  scope=/Madrid/Gardens (exact non-leaf), name=HQ, loc [0,0]
=======================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Z:G
Content-Length: 0




02. Create N  scope=/Madrid/Gardens/ParqueNorte, name=Norte, loc [10,10]
=======================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Z:N
Content-Length: 0




03. Create S  scope=/Madrid/Gardens/ParqueSur, name=Sur, loc [0,0] (near G)
==========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Z:S
Content-Length: 0




04. scopeQ=/Madrid/Gardens (EXACT) → only G, NOT the ParqueNorte/Sur descendants
===============================================================================
    "id": "urn:ngsi-ld:Z:G",


05. scopeQ=/Madrid/Gardens/# (hierarchy) → G, N, S
==================================================
    "id": "urn:ngsi-ld:Z:G",
    "id": "urn:ngsi-ld:Z:N",
    "id": "urn:ngsi-ld:Z:S",


06. scopeQ=/Madrid/Gardens/# AND q=name=="Norte" → only N
=========================================================
    "id": "urn:ngsi-ld:Z:N",


07. scopeQ=/Madrid/Gardens/# AND near [0,0] within 1km → G + S (not N at [10,10])
================================================================================
    "id": "urn:ngsi-ld:Z:G",
    "id": "urn:ngsi-ld:Z:S",
--TEARDOWN--
swBrokerStop
