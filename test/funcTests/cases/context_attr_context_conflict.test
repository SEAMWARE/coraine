#
# FILE            context_attr_context_conflict.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# An attribute's identity is its expanded IRI, not its short name. Two requests
# can use the same short name under different @contexts that map it to different
# IRIs — they address DIFFERENT attributes:
#   - PATCH /entities/{id}/attrs with a short name resolving (via its @context)
#     to a different IRI than the one already stored adds a SECOND attribute; the
#     original is untouched.
#   - a batch upsert whose elements each carry their own @context resolves each
#     element's attributes against that element's context.
#
--NAME--
@context attribute identity — same short name, different IRIs (PATCH conflict + per-element batch upsert)

--TAGS--
context batch

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Create P via context A (P -> https://A.example/P)"
echo "====================================================="
swCurl --url /ngsi-ld/v1/entities -H 'Content-Type: application/ld+json' --payload '{
  "@context": ["https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld", {"P": "https://A.example/P"}],
  "id": "urn:ngsi-ld:X:1", "type": "T", "P": {"type": "Property", "value": "fromA"}
}' | grep HTTP
echo
echo


echo "02. PATCH P via context B (P -> https://B.example/P) — adds a second attribute"
echo "=============================================================================="
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:X:1/attrs -H 'Content-Type: application/ld+json' --payload '{
  "@context": ["https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld", {"P": "https://B.example/P"}],
  "P": {"type": "Property", "value": "fromB"}
}' | grep HTTP
echo
echo


echo "03. GET (no @context) — BOTH A.example/P=fromA and B.example/P=fromB present"
echo "============================================================================"
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:X:1 | grep -E '"https://[AB].example/P"|"value"'
echo
echo


echo "04. Batch upsert — each element resolves its attrs against its own @context"
echo "==========================================================================="
swCurl --url /ngsi-ld/v1/entityOperations/upsert -H 'Content-Type: application/ld+json' --payload '[
  {"@context": ["https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld", {"w": "https://w.example/w"}], "id": "urn:ngsi-ld:U:1", "type": "T", "w": {"type": "Property", "value": 1}},
  {"@context": ["https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld", {"z": "https://z.example/z"}], "id": "urn:ngsi-ld:U:2", "type": "T", "z": {"type": "Property", "value": 2}}
]' | grep HTTP
echo
echo


echo "05. GET U:1 (no @context) — w.example/w ; GET U:2 — z.example/z"
echo "==============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:U:1 | grep -oE '"https://w.example/w"'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:U:2 | grep -oE '"https://z.example/z"'
echo
echo


--EXPECT--
01. Create P via context A (P -> https://A.example/P)
=====================================================
HTTP/1.1 201 Created


02. PATCH P via context B (P -> https://B.example/P) — adds a second attribute
==============================================================================
HTTP/1.1 204 No Content


03. GET (no @context) — BOTH A.example/P=fromA and B.example/P=fromB present
============================================================================
  "https://A.example/P": {
    "value": "fromA"
  "https://B.example/P": {
    "value": "fromB"


04. Batch upsert — each element resolves its attrs against its own @context
===========================================================================
HTTP/1.1 201 Created


05. GET U:1 (no @context) — w.example/w ; GET U:2 — z.example/z
===============================================================
"https://w.example/w"
"https://z.example/z"


--TEARDOWN--
swBrokerStop
