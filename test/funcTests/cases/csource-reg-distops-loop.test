--NAME--
DistOps - Via header on forward + loop detection on receive (NGSI-LD § 5.7.5)

--TAGS--
distops registration

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --csourceAlias cb-alias
swBrokerStart -role CP1 --csourceAlias cp1-alias

--RUN--
#
# Via header + loop detection (NGSI-LD § 5.7.5 / RFC 7230 § 5.7.1).
# Brokers run with explicit aliases (cb-alias / cp1-alias) so the test
# can reason about Via contents independently of the listener port.
#
# 01. Seed CP1 with entity urn:V1
# 02. Register CB->CP1 exclusive on urn:V1
# 03. Plain GET V1 on CB -> forwarded to CP1, 200
# 04. GET V1 on CB with Via: 1.1 cb-alias -> 502 loop detected
# 05. GET V1 on CB with Via: 1.1 unrelated-alias -> 200 (no loop)
# 06. Register CP1->CB exclusive on urn:Loop:1
# 07. Register CB->CP1 exclusive on urn:Loop:1
# 08. GET urn:Loop:1 on CB -> two-hop loop, 502
# 09. Tenant scoping: incoming Via cb-alias:tA -> no loop, forward proceeds
#


echo "01. Seed CP1 with entity urn:V1"
echo "================================"
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 42
  }
}'
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Register CB->CP1 exclusive on urn:V1"
echo "=========================================="
payload='{
  "id": "urn:CSR:R1",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "information": [
    {
      "entities": [
        {
          "id": "urn:V1",
          "type": "Vehicle"
        }
      ]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "03. Plain GET V1 on CB -> forwarded to CP1, 200"
echo "================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "04. GET V1 on CB with Via: 1.1 cb-alias -> loop skipped, local 404"
echo "=================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1 -H "Via: 1.1 cb-alias"
echo
echo


echo "05. GET V1 on CB with Via: 1.1 unrelated-alias -> 200 (no loop)"
echo "================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1 -H "Via: 1.1 unrelated-alias"
echo
echo


echo "06. Register CP1->CB exclusive on urn:Loop:1"
echo "=============================================="
payload='{
  "id": "urn:CSR:Back",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CB_PORT'",
  "mode": "exclusive",
  "information": [
    {
      "entities": [
        {
          "id": "urn:Loop:1",
          "type": "Vehicle"
        }
      ]
    }
  ]
}'
swCurl --port $CP1_PORT --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "07. Register CB->CP1 exclusive on urn:Loop:1"
echo "=============================================="
# Need a matching CSR on CB pointing to CP1 for urn:Loop:1 too - to start
# the chain at CB. Then CB->CP1->CB triggers CB's loop detection.
payload='{
  "id": "urn:CSR:Out",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "information": [
    {
      "entities": [
        {
          "id": "urn:Loop:1",
          "type": "Vehicle"
        }
      ]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "08. GET urn:Loop:1 on CB -> two-hop loop, inner broker returns 404"
echo "==================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:Loop:1
echo
echo


echo "09. Tenant scoping: incoming Via cb-alias:tA -> no loop, forward proceeds"
echo "=========================================================================="
# Default-tenant alias is "cb-alias"; "cb-alias:tA" identifies a different
# scope, so loop detection should not fire and the forward should proceed.
swCurl --url /ngsi-ld/v1/entities/urn:V1 -H "Via: 1.1 cb-alias:tA"
echo
echo


--EXPECT--
01. Seed CP1 with entity urn:V1
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Register CB->CP1 exclusive on urn:V1
==========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Content-Length: 0




03. Plain GET V1 on CB -> forwarded to CP1, 200
=================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



04. GET V1 on CB with Via: 1.1 cb-alias -> loop skipped, local 404
==================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:V1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



05. GET V1 on CB with Via: 1.1 unrelated-alias -> 200 (no loop)
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



06. Register CP1->CB exclusive on urn:Loop:1
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Back
Content-Length: 0




07. Register CB->CP1 exclusive on urn:Loop:1
==============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Out
Content-Length: 0




08. GET urn:Loop:1 on CB -> two-hop loop, inner broker returns 404
===================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:Loop:1' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



09. Tenant scoping: incoming Via cb-alias:tA -> no loop, forward proceeds
==========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop --csourceAlias cb-alias
swBrokerStop -role CP1 --csourceAlias cp1-alias
swDbDrop
swDbDrop -role CP1
