#
# FILE            bridge_service_sync_timeout_config.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The sync timeout from the bridge configuration: dds.ngsild.syncTimeoutMs, the
# key Orion-LD reads from the same file. A deployment moving over keeps it.
#
# The loopback answers 'slow' after 600 ms. The file says 1500:
#
#   01-02  no --ddsSyncTimeout: the file's 1500 ms - the PATCH waits for the
#          reply and writes it with the value (204). With the built-in 200 ms it
#          would have answered 202 without it.
#   03-05  --ddsSyncTimeout 100, same file: the command line wins - 202, and
#          the reply lands later (until then the attribute keeps the previous
#          reply beside the new value - a PATCH keeps what it does not name).
#
--NAME--
Bridges: the sync timeout from the bridge configuration (syncTimeoutMs), unless --ddsSyncTimeout

--TAGS--
bridge service ddsSync config

--INIT--
corDbDrop
BRIDGE_CONFIG=$(bridgeConfig \
  --syncTimeoutMs 1500 \
  --replyDelay "slow=600" \
  --service "slow,Calculator,urn:ngsi-ld:Calculator:S,job")
echo "$BRIDGE_CONFIG" > /tmp/bridgeSyncTimeoutConfig.path
coraineStart --bridges loopback --bridgeConfig $BRIDGE_CONFIG

--RUN--

echo "01. PATCH ?ddsSync=true - the file's 1500 ms outlast the 600 ms reply: 204"
echo "==========================================================================="
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S/attrs/job?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 1 } }'
echo
echo


echo "02. The reply was written with the value"
echo "========================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S
echo
echo


echo "03. Restart with --ddsSyncTimeout 100, same file - the command line wins: 202"
echo "============================================================================="
coraineStop
coraineStart --bridges loopback --bridgeConfig $(cat /tmp/bridgeSyncTimeoutConfig.path) --ddsSyncTimeout 100
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S/attrs/job?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 2 } }'
echo
echo


echo "04. The value is written; the reply is still the previous one"
echo "=============================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S
echo
echo


echo "05. The late reply has landed - it answers { a: 2 }"
echo "==================================================="
sleep 1
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S
echo
echo


--EXPECT--
01. PATCH ?ddsSync=true - the file's 1500 ms outlast the 600 ms reply: 204
===========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




02. The reply was written with the value
========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Calculator:S",
  "job": {
    "reply": {
      "type": "Property",
      "value": {
        "a": 1
      }
    },
    "type": "Property",
    "value": {
      "a": 1
    }
  },
  "type": "Calculator"
}



03. Restart with --ddsSyncTimeout 100, same file - the command line wins: 202
=============================================================================
HTTP/1.1 202 Accepted
Date: REGEX(.*)
Content-Length: REGEX(\d+)




04. The value is written; the reply is still the previous one
==============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Calculator:S",
  "job": {
    "reply": {
      "type": "Property",
      "value": {
        "a": 1
      }
    },
    "type": "Property",
    "value": {
      "a": 2
    }
  },
  "type": "Calculator"
}



05. The late reply has landed - it answers { a: 2 }
===================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Calculator:S",
  "job": {
    "reply": {
      "type": "Property",
      "value": {
        "a": 2
      }
    },
    "type": "Property",
    "value": {
      "a": 2
    }
  },
  "type": "Calculator"
}



--TEARDOWN--
coraineStop
corDbDrop
rm -f /tmp/bridgeSyncTimeoutConfig.path
