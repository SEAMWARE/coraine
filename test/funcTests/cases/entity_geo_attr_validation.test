#
# FILE            entity_geo_attr_validation.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.7 — `location`, `observationSpace`, `operationSpace` are well-known
# GeoProperty names. Entities MUST NOT use them for any other attribute
# type. The validator runs always, independently of the build-time
# feature flags that gate the dispatch-side use of these attributes.
#
--NAME--
Entity attribute validation — location/observationSpace/operationSpace must be GeoProperty (§ 4.7)

--TAGS--
entity error validation

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. location declared as Property → 400"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:1",
  "type": "T",
  "location": {"type": "Property", "value": "hello"}
}'
echo
echo


echo "02. location declared as Relationship → 400"
echo "==========================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:2",
  "type": "T",
  "location": {"type": "Relationship", "object": "urn:other"}
}'
echo
echo


echo "03. location with no explicit type → accepted (implicit-type inference is a separate gap)"
echo "==========================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:3",
  "type": "T",
  "location": {"value": {"type": "Point", "coordinates": [1, 2]}}
}'
echo
echo


echo "04. observationSpace declared as Property → 400"
echo "==============================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:4",
  "type": "T",
  "observationSpace": {"type": "Property", "value": 42}
}'
echo
echo


echo "05. operationSpace declared as JsonProperty → 400"
echo "================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:5",
  "type": "T",
  "operationSpace": {"type": "JsonProperty", "json": {"a": 1}}
}'
echo
echo


echo "06. location as proper GeoProperty → 201"
echo "========================================"
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:6",
  "type": "T",
  "location": {"type": "GeoProperty", "value": {"type": "Point", "coordinates": [10, 20]}}
}'
echo
echo


echo "07. observationSpace + operationSpace as GeoProperty → 201"
echo "=========================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:7",
  "type": "T",
  "observationSpace": {"type": "GeoProperty", "value": {"type": "Point", "coordinates": [11, 21]}},
  "operationSpace":   {"type": "GeoProperty", "value": {"type": "Point", "coordinates": [12, 22]}}
}'
echo
echo


echo "08. PATCH attempting to change location into a Property → 400"
echo "============================================================="
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:E:6/attrs --payload '{
  "location": {"type": "Property", "value": "no longer a geo"}
}'
echo
echo


echo "09. Free-form attribute named like one of these but NOT one of them → 201 (no false positive)"
echo "=============================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:E:9",
  "type": "T",
  "myLocation": {"type": "Property", "value": "free-form"}
}'
echo
echo


--EXPECT--
01. location declared as Property → 400
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 226

{
  "detail": "Attribute 'location' is reserved by spec § 4.7 and must be of type GeoProperty (got Property)",
  "status": 400,
  "title": "Invalid Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. location declared as Relationship → 400
===========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 230

{
  "detail": "Attribute 'location' is reserved by spec § 4.7 and must be of type GeoProperty (got Relationship)",
  "status": 400,
  "title": "Invalid Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. location with no explicit type → accepted (implicit-type inference is a separate gap)
===========================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E:3
Content-Length: 0




04. observationSpace declared as Property → 400
===============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 234

{
  "detail": "Attribute 'observationSpace' is reserved by spec § 4.7 and must be of type GeoProperty (got Property)",
  "status": 400,
  "title": "Invalid Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. operationSpace declared as JsonProperty → 400
=================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 236

{
  "detail": "Attribute 'operationSpace' is reserved by spec § 4.7 and must be of type GeoProperty (got JsonProperty)",
  "status": 400,
  "title": "Invalid Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. location as proper GeoProperty → 201
========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E:6
Content-Length: 0




07. observationSpace + operationSpace as GeoProperty → 201
==========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E:7
Content-Length: 0




08. PATCH attempting to change location into a Property → 400
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 226

{
  "detail": "Attribute 'location' is reserved by spec § 4.7 and must be of type GeoProperty (got Property)",
  "status": 400,
  "title": "Invalid Attribute",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



09. Free-form attribute named like one of these but NOT one of them → 201 (no false positive)
==============================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E:9
Content-Length: 0




--TEARDOWN--
coraineStop
corDbDrop
