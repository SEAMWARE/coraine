#
# FILE            attrs_path_entity_members.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# id and type are mandatory Entity members (§ 5.2.4), never Attributes: .../attrs/{attrId} with either names
# no Attribute, and Partial Attribute Update (PATCH), Replace Attribute (PUT) and Set Attribute Value (PUT
# .../value) refuse it - "the target Attribute name is not a valid name", BadRequestData - as Delete
# Attribute does (entity_member_delete_and_null). Before: PATCH and PUT took the fragment for the Entity's
# new id or type and refused it only because an object is neither (a 400 for the wrong reason), and PUT
# .../value answered 404, as if this Entity merely lacked the Attribute.
#
# A term of the request's @context that expands to @id or @type is the same: "identifier": "@id".
#
--NAME--
.../attrs/{id,type} - PATCH, PUT and PUT .../value refuse an Entity member as the target Attribute; an alias of @id too

--TAGS--
entity update attribute

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create urn:E1 - type T, scope /a, attribute p"
echo "================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{ "id": "urn:E1", "type": "T", "scope": "/a", "p": { "type": "Property", "value": 1 } }' | head -1
echo
echo


echo "02. PATCH /attrs/id -> 400, 'id' is not an Attribute"
echo "===================================================="
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:E1/attrs/id --payload '{ "value": "urn:E2" }'
echo
echo


echo "03. PATCH /attrs/type -> 400"
echo "============================"
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:E1/attrs/type --payload '{ "value": "T2" }'
echo
echo


echo "04. PUT /attrs/id -> 400"
echo "========================"
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:E1/attrs/id --payload '{ "type": "Property", "value": "urn:E2" }'
echo
echo


echo "05. PUT /attrs/type -> 400"
echo "=========================="
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:E1/attrs/type --payload '{ "type": "Property", "value": "T2" }'
echo
echo


echo "06. PUT /attrs/id/value -> 400, not a 404"
echo "========================================="
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:E1/attrs/id/value --payload '"urn:E2"'
echo
echo


echo "07. PUT /attrs/type/value -> 400, not a 404"
echo "==========================================="
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:E1/attrs/type/value --payload '"T2"'
echo
echo


echo "08. PATCH and PUT /attrs/identifier, the request's @context saying \"identifier\": \"@id\" -> 400"
echo "=============================================================================================="
corCurl -X PATCH --in jsonld --url /ngsi-ld/v1/entities/urn:E1/attrs/identifier \
        --payload '{ "value": "urn:E2", "@context": [ { "identifier": "@id" }, "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld" ] }'
echo
corCurl -X PUT --in jsonld --url /ngsi-ld/v1/entities/urn:E1/attrs/identifier \
        --payload '{ "type": "Property", "value": "urn:E2", "@context": [ { "identifier": "@id" }, "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld" ] }'
echo
echo


echo "09. The Entity is untouched by every refusal"
echo "============================================"
corCurl --url /ngsi-ld/v1/entities/urn:E1 | grep -v '^Date\|^Content-Length\|^Link\|^HTTP\|^Content-Type'
echo
echo


--TEARDOWN--
coraineStop
corDbDrop


--EXPECT--
01. Create urn:E1 - type T, scope /a, attribute p
=================================================
HTTP/1.1 201 Created


02. PATCH /attrs/id -> 400, 'id' is not an Attribute
====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 212

{
  "detail": "'id' is a mandatory Entity member, not an Attribute - it cannot be modified",
  "status": 400,
  "title": "Invalid Attribute name",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. PATCH /attrs/type -> 400
============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 214

{
  "detail": "'type' is a mandatory Entity member, not an Attribute - it cannot be modified",
  "status": 400,
  "title": "Invalid Attribute name",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



