#
# FILE            service_registration_crud.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Service Execution (doc/service-execution.md): Service Registrations - create, retrieve, list, discover
# (the registrations of one entity: its type, its id against id/idPattern, the registration's q against
# the entity), update, delete; the refusals of a malformed registration.
#
# REQUIRE_FEATURE: SERVICE_EXECUTION
#
--NAME--
Service Registration CRUD and discovery

--TAGS--
service registration create retrieve update delete

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. POST a Service Registration (setLight, every Lamp whose id starts urn:MyLamp) - 201
# 02. GET it
# 03. POST a second, no id (getModel, Lamps with model X1) - 201, a generated id
# 04. GET /serviceRegistrations - both
# 05. Two Lamps: urn:MyLamp1 (model X1), urn:Other (model X2)
# 06. Discover: type=Lamp&id=urn:MyLamp1 - both; type=Lamp&id=urn:Other - neither (id pattern, q); type=Door - none
# 07. PATCH the first: serviceInformation replaced whole (a new description, mode asynchronous); GET it
# 08. Refused: no serviceInformation, no serviceName, 'input' instead of inputSchema, a mode that is neither, an entities member without type - 400 each
# 09. POST the first again - 409
# 10. DELETE the first - 204; GET it - 404; DELETE it again - 404
# 11. With an inline @context (Dimmer, dim): stored expanded - GET without it shows the IRIs; discovered by the type's IRI
#

echo "01. POST a Service Registration (setLight, every Lamp whose id starts urn:MyLamp) - 201"
echo "======================================================================================="
payload='{
  "id": "urn:ngsi-ld:ServiceRegistration:SR1",
  "type": "ServiceRegistration",
  "endpoint": "http://localhost:9997/setLight",
  "entities": [ { "idPattern": "^urn:MyLamp", "type": "Lamp" } ],
  "serviceInformation": {
    "serviceName": "setLight",
    "title": "setLight",
    "description": "Set brightness of light, 0 means off",
    "mode": "synchronous",
    "inputSchema": { "type": "object", "properties": { "brightness": { "type": "integer", "minimum": 0, "maximum": 255 } }, "required": [ "brightness" ] },
    "outputSchema": { "type": "string" }
  }
}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload "$payload"
echo
echo


echo "02. GET it"
echo "=========="
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1
echo
echo


echo "03. POST a second, no id (getModel, Lamps with model X1) - 201, a generated id"
echo "=============================================================================="
payload='{
  "type": "ServiceRegistration",
  "endpoint": "http://localhost:9997/getModel",
  "entities": [ { "type": "Lamp" } ],
  "q": "model==\"X1\"",
  "serviceInformation": { "serviceName": "getModel", "mode": "synchronous" }
}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload "$payload"
echo
echo


echo "04. GET /serviceRegistrations - both"
echo "===================================="
corCurl --url /ngsi-ld/v1/serviceRegistrations
echo
echo


echo "05. Two Lamps: urn:MyLamp1 (model X1), urn:Other (model X2)"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:MyLamp1","type":"Lamp","model":{"type":"Property","value":"X1"}}'
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:Other","type":"Lamp","model":{"type":"Property","value":"X2"}}'
echo
echo


echo "06. Discover: type=Lamp&id=urn:MyLamp1 - both; type=Lamp&id=urn:Other - neither (id pattern, q); type=Door - none"
echo "=================================================================================================================="
corCurl --url '/ngsi-ld/v1/serviceRegistrations?type=Lamp&id=urn:MyLamp1'
corCurl --url '/ngsi-ld/v1/serviceRegistrations?type=Lamp&id=urn:Other'
corCurl --url '/ngsi-ld/v1/serviceRegistrations?type=Door'
echo
echo


echo "07. PATCH the first: serviceInformation replaced whole (a new description, mode asynchronous); GET it"
echo "====================================================================================================="
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1 -X PATCH --payload '{"serviceInformation":{"serviceName":"setLight","description":"Dims the light","mode":"asynchronous"}}'
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1
echo
echo


echo "08. Refused: no serviceInformation, no serviceName, 'input' instead of inputSchema, a mode that is neither, an entities member without type - 400 each"
echo "======================================================================================================================================================"
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"type":"ServiceRegistration","endpoint":"http://x","entities":[{"type":"Lamp"}]}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"type":"ServiceRegistration","endpoint":"http://x","entities":[{"type":"Lamp"}],"serviceInformation":{"mode":"synchronous"}}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"type":"ServiceRegistration","endpoint":"http://x","entities":[{"type":"Lamp"}],"serviceInformation":{"serviceName":"s","input":{"type":"object"}}}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"type":"ServiceRegistration","endpoint":"http://x","entities":[{"type":"Lamp"}],"serviceInformation":{"serviceName":"s","mode":"sometimes"}}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"type":"ServiceRegistration","endpoint":"http://x","entities":[{"id":"urn:X"}],"serviceInformation":{"serviceName":"s"}}'
echo
echo


echo "09. POST the first again - 409"
echo "=============================="
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload '{"id":"urn:ngsi-ld:ServiceRegistration:SR1","type":"ServiceRegistration","endpoint":"http://x","entities":[{"type":"Lamp"}],"serviceInformation":{"serviceName":"s"}}'
echo
echo


echo "10. DELETE the first - 204; GET it - 404; DELETE it again - 404"
echo "==============================================================="
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1 -X DELETE
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1 -X DELETE
echo
echo


echo "11. With an inline @context (Dimmer, dim): stored expanded - GET without it shows the IRIs; discovered by the type's IRI"
echo "========================================================================================================================"
payload='{
  "@context": [ { "Dimmer": "https://example.org/Dimmer", "dim": "https://example.org/dim" }, "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld" ],
  "id": "urn:ngsi-ld:ServiceRegistration:SR3",
  "type": "ServiceRegistration",
  "endpoint": "http://localhost:9997/dim",
  "entities": [ { "type": "Dimmer" } ],
  "serviceInformation": { "serviceName": "dim" }
}'
corCurl --url /ngsi-ld/v1/serviceRegistrations --payload "$payload" -H "Content-Type: application/ld+json"
corCurl --url /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR3
corCurl --url '/ngsi-ld/v1/serviceRegistrations?type=https://example.org/Dimmer'
echo
echo


--EXPECT--
01. POST a Service Registration (setLight, every Lamp whose id starts urn:MyLamp) - 201
=======================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/serviceRegistrations/urn:ngsi-ld:ServiceRegistration:SR1
Content-Length: 0




02. GET it
==========
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 687

{
  "endpoint": "http://localhost:9997/setLight",
  "entities": [
    {
      "idPattern": "^urn:MyLamp",
      "type": "Lamp"
    }
  ],
  "id": "urn:ngsi-ld:ServiceRegistration:SR1",
  "serviceInformation": {
    "description": "Set brightness of light, 0 means off",
    "inputSchema": {
      "properties": {
        "brightness": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "brightness"
      ],
      "type": "object"
    },
    "mode": "synchronous",
    "outputSchema": {
      "type": "string"
    },
    "serviceName": "setLight",
    "title": "setLight"
  },
  "type": "ServiceRegistration"
}



