#
# FILE            csource-reg-distops-create-loop.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
DistOps - createEntity loop detection via Via header (§ 5.7.5)

--TAGS--
create distops registration

--INIT--
corDbDrop
coraineStart -dist

--RUN--

#
# Register a redirect CSR on CB that owns the whole entity (no propertyNames).
# A POST carrying CB's own alias in the Via header is a loop (§ 9.7): the create
# can neither be forwarded (it would loop) nor stored locally (the entity is
# held by the redirect source), so it is answered with 508 Loop Detected
# (TS 104-176 § 6.3.18).
#
# We simulate the "second hop" by including a Via header matching the broker's
# own alias in the initial POST, rather than arranging a full round-trip. The
# loop therefore comes from the Via header alone and the registered endpoint is
# never contacted — it just has to be some OTHER broker, since a redirect
# registration naming this one is a § 12.2.2.4 Conflict.
#

echo "01. Register redirect CSR owning urn:V1"
echo "======================================="
payload='{
  "id": "urn:CSR:Self",
  "type": "ContextSourceRegistration",
  "endpoint": "http://cp.example.org:1026",
  "mode": "redirect",
  "operations": ["createEntity"],
  "information": [
    {
      "entities": [
        { "id": "urn:V1", "type": "Vehicle" }
      ]
    }
  ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. POST entity with Via header carrying CB's own alias → loop detected, 508"
echo "============================================================================"
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": { "type": "Property", "value": 42 }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" --header "Via: 1.1 localhost:$CB_PORT"
echo
echo


--EXPECT--
01. Register redirect CSR owning urn:V1
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Self
Content-Length: 0




02. POST entity with Via header carrying CB's own alias → loop detected, 508
============================================================================
HTTP/1.1 508 Loop Detected
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 219

{
  "detail": "loop detected: registration resolves back to this broker, so createEntity cannot be forwarded",
  "status": 508,
  "title": "Loop Detected",
  "type": "https://uri.etsi.org/ngsi-ld/errors/LoopDetected"
}



--TEARDOWN--
coraineStop
corDbDrop
