#
# FILE            snapshot_read.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16 Snapshot subsystem — Phase 2b: snapshot-aware reads via the
# NGSILD-Snapshot HTTP header (§ 6.3.22).
#
# Coverage:
#   - GET /entities/{id}  with NGSILD-Snapshot → frozen view
#   - GET /entities       with NGSILD-Snapshot → frozen list, filtered
#   - Live entity mutated AFTER snapshot creation: snapshot still shows
#     the frozen value, live read shows the mutated value.
#   - Entity deleted from live DB: still readable from snapshot.
#   - NGSILD-Snapshot response header echoed back (§ 6.3.22).
#   - Unknown snapshot id → 404 ResourceNotFound.
#   - Entity not in the snapshot → 404 ResourceNotFound.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot-aware reads (§ 5.16, Phase 2b)

--TAGS--
snapshot

--INIT--
corDbDrop
corSnapDrop
coraineStart

--RUN--

echo "01. Seed two Vehicles"
echo "====================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": {"type":"Property","value":42}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
payload='{
  "id": "urn:ngsi-ld:Vehicle:V2",
  "type": "Vehicle",
  "speed": {"type":"Property","value":80}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create snapshot capturing both Vehicles"
echo "==========================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:Frozen",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
corCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "03. Mutate live V1 (speed → 999); delete live V2"
echo "================================================"
corCurl -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs --payload '{"speed":{"type":"Property","value":999}}'
echo
corCurl -X DELETE --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
echo
echo


echo "04. GET /entities/V1 (live) → speed 999"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
echo
echo


echo "05. GET /entities/V1 with NGSILD-Snapshot → frozen speed 42"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "06. GET /entities/V2 (live) → 404 (deleted)"
echo "==========================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
echo
echo


echo "07. GET /entities/V2 with NGSILD-Snapshot → still readable, frozen"
echo "=================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2 -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "08. GET /entities?type=Vehicle with NGSILD-Snapshot → both, frozen"
echo "=================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


echo "09. GET /entities/{id} with unknown NGSILD-Snapshot → 404"
echo "========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:NoSuch'
echo
echo


echo "10. GET /entities/{id} not-in-snapshot → 404"
echo "============================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:Other -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen'
echo
echo


--EXPECT--
01. Seed two Vehicles
=====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: REGEX(\d+)



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
Content-Length: REGEX(\d+)




02. Create snapshot capturing both Vehicles
===========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Frozen
Content-Length: REGEX(\d+)




03. Mutate live V1 (speed → 999); delete live V2
================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



HTTP/1.1 204 No Content
Date: REGEX(.*)




04. GET /entities/V1 (live) → speed 999
=======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "speed": {
    "type": "Property",
    "value": 999
  },
  "type": "Vehicle"
}



05. GET /entities/V1 with NGSILD-Snapshot → frozen speed 42
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



06. GET /entities/V2 (live) → 404 (deleted)
===========================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:ngsi-ld:Vehicle:V2' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



07. GET /entities/V2 with NGSILD-Snapshot → still readable, frozen
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:ngsi-ld:Vehicle:V2",
  "speed": {
    "type": "Property",
    "value": 80
  },
  "type": "Vehicle"
}



08. GET /entities?type=Vehicle with NGSILD-Snapshot → both, frozen
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:ngsi-ld:Vehicle:V1",
    "speed": {
      "type": "Property",
      "value": 42
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:ngsi-ld:Vehicle:V2",
    "speed": {
      "type": "Property",
      "value": 80
    },
    "type": "Vehicle"
  }
]



09. GET /entities/{id} with unknown NGSILD-Snapshot → 404
=========================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Snapshot 'urn:ngsi-ld:Snapshot:NoSuch' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



10. GET /entities/{id} not-in-snapshot → 404
============================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Frozen
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:ngsi-ld:Vehicle:Other' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
coraineStop
corSnapDrop
corDbDrop
