--NAME--
GET /entities/{id} for non-existing entity returns 404

--TAGS--
entity retrieve

--INIT--
swBrokerStart

--RUN--

#
# 01. 01. GET /entities/urn:nonexistent - 404 Not Found
#

echo "01. GET /entities/urn:nonexistent - 404 Not Found"
echo "================================================="
swCurl --url /ngsi-ld/v1/entities/urn:nonexistent
echo
echo


--EXPECT--
01. GET /entities/urn:nonexistent - 404 Not Found
=================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:nonexistent' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



--TEARDOWN--
swBrokerStop
