#
# FILE            version_endpoint.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# GET /version - the broker's own version endpoint, outside the NGSI-LD API.
#
# It is deliberately NOT an NGSI-LD resource: the response bypasses @context
# expansion and compaction entirely (rawResponse), so no member is expanded.
# That is the point of the endpoint - a health probe, or an operator with
# curl, can ask what is running without speaking JSON-LD.
#
# Note what the capture below pins: the core-@context Link header IS still
# sent, exactly as it is on /admin/*. The members carried here are not core
# terms, so a JSON-LD consumer that followed that Link would @vocab-expand
# `product` and `version` into default-context IRIs that mean nothing. That
# is broker-wide behaviour for the non-NGSI-LD endpoints rather than anything
# about /version, so it is recorded here and not changed here.
#
# It also reports the resolved commit of every library linked into the broker.
# Those are most of the binary, none of them is released, and the cor* repos
# track main - so coraine's own version answers only part of "what am I talking
# to". The shas are REGEXed here: they are the whole point of the field and they
# change with every library commit, so pinning them would make this test a
# tripwire for other people's merges.
#
# The `features` object says which optional parts of the API this build carries -
# the answer a client needs when an endpoint replies 501 Not Available In This
# Build. The NAMES are pinned; the true/false values are REGEXed, for the same
# reason as the shas above: they are a property of the build, not of the broker,
# and this test has to pass against a reduced build too. Pinning them would make
# the one test that reports the feature set the first casualty of using it.
#
# The pattern is [a-z]+ and not the obvious (true|false): corDiff splices
# REGEX()'s contents into the line pattern unbracketed, so a top-level | splits
# the WHOLE line into alternatives - `<prefix>true` OR `false,` - and the second
# branch then has to match from column 1. It matches "true" and rejects "false",
# which is worse than no pattern at all because it looks right.
#
# Nothing exercised this route before. A broken or renamed member here would
# have reached a release unnoticed.
#
--NAME--
GET /version reports product and library versions

--TAGS--
version admin

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. GET /version"
echo "================"
corCurl --url /version
echo
echo


echo "02. GET /version again - the endpoint is stateless, same answer"
echo "=============================================================="
corCurl --url /version
echo
echo


--EXPECT--
01. GET /version
================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX([0-9]+)

{
  "features": {
    "ADMIN_API": REGEX([a-z]+),
    "CONTEXT_DL": REGEX([a-z]+),
    "CONTEXT_HOSTING": REGEX([a-z]+),
    "DATASETID": REGEX([a-z]+),
    "GEOQ": REGEX([a-z]+),
    "LOCATION": REGEX([a-z]+),
    "METRICS": REGEX([a-z]+),
    "MONGOC": REGEX([a-z]+),
    "MULTI_TYPE": REGEX([a-z]+),
    "OBSERVATION_SPACE": REGEX([a-z]+),
    "OPERATION_SPACE": REGEX([a-z]+),
    "REGISTRATIONS": REGEX([a-z]+),
    "SCOPES": REGEX([a-z]+),
    "SUBSCRIPTIONS": REGEX([a-z]+),
    "TENANTS": REGEX([a-z]+)
  },
  "product": "coraine",
  "stack": {
    "corJsonld": "REGEX([0-9a-f]{40})",
    "corNgsild": "REGEX([0-9a-f]{40})",
    "corPlugin": "REGEX([0-9a-f]{40})",
    "corRest": "REGEX([0-9a-f]{40})",
    "kalloc": "REGEX([0-9a-f]{40})",
    "kargs": "REGEX([0-9a-f]{40})",
    "kbase": "REGEX([0-9a-f]{40})",
    "khash": "REGEX([0-9a-f]{40})",
    "kjson": "REGEX([0-9a-f]{40})",
    "klog": "REGEX([0-9a-f]{40})",
    "kprom": "REGEX([0-9a-f]{40})",
    "ktrace": "REGEX([0-9a-f]{40})"
  },
  "version": "0.4.0"
}



