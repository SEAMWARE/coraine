#
# FILE            csource-reg-distops-create-exclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
DistOps - createEntity forwarded to exclusive registration, all attrs claimed

--TAGS--
create distops registration

--INIT--
corDbDrop
corDbDrop -role CP1
coraineStart -dist
coraineStart -role CP1 -dist

--RUN--

#
# 01. Register CP1 as exclusive on CB for Vehicle entities (with createEntity op)
# 02. POST V1 with speed → CB forwards whole payload to CP1, no local store
# 03. GET V1 on CB with ?local=true → 404 (nothing stored locally)
# 04. GET V1 on CP1 directly → 200 with speed=42
# 05. GET V1 on CB (no ?local) → 200 via retrieve-dispatch to CP1
#

echo "01. Register CP1 as exclusive on CB for V1 with createEntity op"
echo "==============================================================="
payload='{
  "id": "urn:CSR:Excl1",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "operations": ["createEntity", "retrieveEntity"],
  "information": [
    {
      "entities": [
        {
          "id": "urn:V1",
          "type": "Vehicle"
        }
      ],
      "propertyNames": ["speed"]
    }
  ]
}'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. POST V1 with speed → CB forwards to CP1"
echo "==========================================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 42
  }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. GET V1 on CB with ?local=true → 404 (nothing stored locally)"
echo "================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true'
echo
echo


echo "04. GET V1 on CP1 directly → 200 with speed=42"
echo "=============================================="
corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "05. GET V1 on CB (dispatched to CP1) → 200"
echo "=========================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


--EXPECT--
01. Register CP1 as exclusive on CB for V1 with createEntity op
===============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Excl1
Content-Length: REGEX(\d+)




02. POST V1 with speed → CB forwards to CP1
===========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: REGEX(\d+)




03. GET V1 on CB with ?local=true → 404 (nothing stored locally)
================================================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "entity 'urn:V1' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



04. GET V1 on CP1 directly → 200 with speed=42
==============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



05. GET V1 on CB (dispatched to CP1) → 200
==========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



--TEARDOWN--
coraineStop
coraineStop -role CP1
corDbDrop
corDbDrop -role CP1
