#
# FILE            troe_timescale_temporal_geoq.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# ?georel + ?geometry + ?coordinates on the multi-entity temporal GET
# (§ 4.10 / § 6.18.3.2). Per § 11.3.3 the geospatial restrictions "shall be
# checked against the GeoProperty instances that are within the interval
# defined by the temporal query" — ANY in-window instance matching the
# geoquery keeps the entity. The current state is never consulted, so
# temporal-only entities (POST /temporal/entities) are first-class targets,
# and instances outside the window can't match. The geoproperty is fetched
# for the filter even when ?attrs= excludes it, then stripped again.
#
# geoQ is NOT in § 6.19.3.1's URL-param table (single-entity retrieve)
# so this test only covers the multi-entity GET.
#
--NAME--
TRoE timescale - temporal geoQ filter

--TAGS--
troe timescale postgres temporal geo

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. Seed three Vehicles at known coords (M=Madrid, P=Paris, B=Berlin)"
echo "====================================================================="
payload='{
  "id":"urn:M",
  "type":"Vehicle",
  "speed":   {"type":"Property","value":50,"observedAt":"2026-04-28T09:00:00Z"},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[-3.7038, 40.4168]},"observedAt":"2026-04-28T09:00:00Z"}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
payload='{
  "id":"urn:P",
  "type":"Vehicle",
  "speed":   {"type":"Property","value":60,"observedAt":"2026-04-28T09:00:00Z"},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[2.3522, 48.8566]},"observedAt":"2026-04-28T09:00:00Z"}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
payload='{
  "id":"urn:B",
  "type":"Vehicle",
  "speed":   {"type":"Property","value":70,"observedAt":"2026-04-28T09:00:00Z"},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[13.4050, 52.5200]},"observedAt":"2026-04-28T09:00:00Z"}
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
#
# The Core API's TRoE write is DEFERRED to brokerPostResponseHook - it happens
# AFTER the response this test just read. Querying the temporal representation
# on the next line is therefore a race, and on the corDB shard (in-memory, so
# the response comes back sooner) CI lost it. Wait for the fact, not a guess at
# how long it takes; corAwaitBody is silent on success and returns the moment it
# is true, so a fast run pays nothing.
#
# Each seeded entity separately: the three creates are three connections, so
# their deferred writes are not ordered against one another.
corAwaitBody 10 '/ngsi-ld/v1/temporal/entities/urn:M' '"speed"'
corAwaitBody 10 '/ngsi-ld/v1/temporal/entities/urn:P' '"speed"'
corAwaitBody 10 '/ngsi-ld/v1/temporal/entities/urn:B' '"speed"'
echo done
echo
echo


echo "02. ?georel=near;maxDistance==600000 around Madrid → only urn:M"
echo "==============================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&georel=near;maxDistance==600000&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


echo "03. ?georel=near;maxDistance==1500000 around Madrid → urn:M + urn:P"
echo "==================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&georel=near;maxDistance==1500000&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


echo "04. ?georel=near;maxDistance==500 around Madrid (tiny radius) → only urn:M (at Madrid)"
echo "======================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&georel=near;maxDistance==500&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


echo "05. Temporal-only urn:T (no current state): Berlin@09:00, Madrid@11:00"
echo "======================================================================"
payload='{
  "id":"urn:T",
  "type":"Vehicle",
  "speed":   {"type":"Property","value":99,"observedAt":"2026-04-28T09:00:00Z"},
  "location":[
    {"type":"GeoProperty","value":{"type":"Point","coordinates":[13.4050, 52.5200]},"observedAt":"2026-04-28T09:00:00Z"},
    {"type":"GeoProperty","value":{"type":"Point","coordinates":[-3.7038, 40.4168]},"observedAt":"2026-04-28T11:00:00Z"}
  ]
}'
corCurl --url /ngsi-ld/v1/temporal/entities --payload "$payload" >/dev/null
echo done
echo
echo


echo "06. near;500 around Madrid → urn:M + urn:T (T matches via ANY in-window instance)"
echo "=================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&georel=near;maxDistance==500&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


echo "07. Same, but window 08:00-10:00 → only urn:M (T's Madrid fix at 11:00 is outside)"
echo "==================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T08:00:00Z&endTimeAt=2026-04-28T10:00:00Z&pick=speed&georel=near;maxDistance==500&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


echo "08. ?attrs=speed + geoquery → location fetched for the filter, stripped from response"
echo "======================================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&attrs=speed&georel=near;maxDistance==500&geometry=Point&coordinates=%5B-3.7038,40.4168%5D'
echo
echo


--EXPECT--
01. Seed three Vehicles at known coords (M=Madrid, P=Paris, B=Berlin)
=====================================================================
done


02. ?georel=near;maxDistance==600000 around Madrid → only urn:M
===============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00Z",
        "type": "Property",
        "value": 50
      }
    ]
  }
]



