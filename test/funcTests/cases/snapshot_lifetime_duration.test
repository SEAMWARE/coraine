#
# FILE            snapshot_lifetime_duration.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.41 — snapshotLifetime is an ISO 8601 duration. The broker
# parses it and computes expiresAt = now + duration. PATCHing
# snapshotLifetime recomputes expiresAt; bad durations are rejected
# with 400. Default (no snapshotLifetime) is 1h.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot snapshotLifetime ISO 8601 duration → expiresAt (§ 5.2.41 / Phase #145)

--TAGS--
snapshot

--INIT--
swDbDrop
swSnapDrop
swBrokerStart

--RUN--

# GET the snapshot — raw response goes into .out, expiresAt and
# snapshotLifetime are masked with REGEX in .expect.
showSnapshot() {
    swCurl --url "/ngsi-ld/v1/snapshots/$1"
}


echo "01. POST snapshot with snapshotLifetime=PT2H — expiresAt should be ~7200s out"
echo "============================================================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Two",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "PT2H"
}'
echo
showSnapshot urn:ngsi-ld:Snapshot:Two
echo
echo


echo "02. POST snapshot with snapshotLifetime=P1D — expiresAt should be ~86400s out"
echo "============================================================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Day",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "P1D"
}'
echo
showSnapshot urn:ngsi-ld:Snapshot:Day
echo
echo


echo "03. POST snapshot with snapshotLifetime=PT1H30M — combined (5400s)"
echo "=================================================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Mix",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "PT1H30M"
}'
echo
showSnapshot urn:ngsi-ld:Snapshot:Mix
echo
echo


echo "04. POST snapshot WITHOUT snapshotLifetime — default 1h fallback (~3600s)"
echo "========================================================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Default",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
echo
showSnapshot urn:ngsi-ld:Snapshot:Default
echo
echo


echo "05. POST with bad snapshotLifetime — expect 400"
echo "==============================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Bad",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "not-a-duration"
}'
echo
echo


echo "06. POST with non-string snapshotLifetime — expect 400"
echo "======================================================"
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Bad2",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": 3600
}'
echo
echo


echo "07. PATCH snapshotLifetime=PT3H on Two — expiresAt recomputed (~10800s out)"
echo "==========================================================================="
swCurl -X PATCH --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two --payload '{"snapshotLifetime":"PT3H"}'
echo
showSnapshot urn:ngsi-ld:Snapshot:Two
echo
echo


echo "08. PATCH bad snapshotLifetime — expect 400"
echo "==========================================="
swCurl -X PATCH --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two --payload '{"snapshotLifetime":"P-1D"}'
echo
echo


--EXPECT--
01. POST snapshot with snapshotLifetime=PT2H — expiresAt should be ~7200s out
=============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two
Content-Length: 0



HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": "REGEX(.*)",
  "id": "urn:ngsi-ld:Snapshot:Two",
  "lastUsedAt": "REGEX(.*)",
  "snapshotLifetime": "PT2H",
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "empty"
    }
  ],
  "snapshotStatus": "empty",
  "type": "Snapshot"
}



