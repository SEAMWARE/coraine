#
# FILE            snapshot_lifetime_duration.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.41 — snapshotLifetime is an ISO 8601 duration. The broker
# parses it and computes expiresAt = now + duration. PATCHing
# snapshotLifetime recomputes expiresAt; bad durations are rejected
# with 400. Default (no snapshotLifetime) is 1h.
#
--NAME--
Snapshot snapshotLifetime ISO 8601 duration → expiresAt (§ 5.2.41 / Phase #145)

--TAGS--
snapshot

--INIT--
swDbDrop
swSnapDrop
swBrokerStart

--RUN--

# Helper: extract expiresAt from a GET response and report the delta
# from a reference epoch (passed as $1) in whole seconds. Uses python3
# for ISO 8601 parsing — coreutils date -d on macOS / older glibc
# can't always parse fractional-second ISO.
checkDelta() {
    local ref_epoch=$1
    swCurl --url "/ngsi-ld/v1/snapshots/$2" 2>/dev/null | python3 -c "
import sys, re, json
from datetime import datetime, timezone
ref = $ref_epoch
b = re.split(r'\r?\n\r?\n', sys.stdin.read(), 1)[1]
d = json.loads(b)
expiresAt = d.get('expiresAt')
if not expiresAt:
    print('  expiresAt: missing')
    sys.exit(0)
exp_epoch = datetime.strptime(expiresAt, '%Y-%m-%dT%H:%M:%S.%fZ').replace(tzinfo=timezone.utc).timestamp()
delta = int(round((exp_epoch - ref) / 60.0)) * 60
print(f'  delta seconds (rounded to nearest minute): {delta}')
print(f'  snapshotLifetime: {d.get(\"snapshotLifetime\")}')
"
}


echo "01. POST snapshot with snapshotLifetime=PT2H — expiresAt should be ~7200s out"
echo "============================================================================="
NOW=$(date +%s)
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Two",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "PT2H"
}'
echo
checkDelta $NOW urn:ngsi-ld:Snapshot:Two
echo
echo


echo "02. POST snapshot with snapshotLifetime=P1D — expiresAt should be ~86400s out"
echo "============================================================================="
NOW=$(date +%s)
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Day",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "P1D"
}'
echo
checkDelta $NOW urn:ngsi-ld:Snapshot:Day
echo
echo


echo "03. POST snapshot with snapshotLifetime=PT1H30M — combined (5400s)"
echo "=================================================================="
NOW=$(date +%s)
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Mix",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "PT1H30M"
}'
echo
checkDelta $NOW urn:ngsi-ld:Snapshot:Mix
echo
echo


echo "04. POST snapshot WITHOUT snapshotLifetime — default 1h fallback (~3600s)"
echo "========================================================================="
NOW=$(date +%s)
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Default",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
echo
checkDelta $NOW urn:ngsi-ld:Snapshot:Default
echo
echo


echo "05. POST with bad snapshotLifetime — expect 400"
echo "==============================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Bad",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": "not-a-duration"
}'
echo
echo


echo "06. POST with non-string snapshotLifetime — expect 400"
echo "======================================================"
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Bad2",
  "type": "Snapshot",
  "snapshotQueries":[{"type":"Query","entities":[{"type":"Vehicle"}]}],
  "snapshotLifetime": 3600
}'
echo
echo


echo "07. PATCH snapshotLifetime=PT3H on Two — expiresAt recomputed (~10800s out)"
echo "==========================================================================="
NOW=$(date +%s)
swCurl -X PATCH --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two --payload '{"snapshotLifetime":"PT3H"}'
echo
checkDelta $NOW urn:ngsi-ld:Snapshot:Two
echo
echo


echo "08. PATCH bad snapshotLifetime — expect 400"
echo "==========================================="
swCurl -X PATCH --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two --payload '{"snapshotLifetime":"P-1D"}'
echo
echo


--EXPECT--
01. POST snapshot with snapshotLifetime=PT2H — expiresAt should be ~7200s out
=============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Two
Content-Length: 0



  delta seconds (rounded to nearest minute): 7200
  snapshotLifetime: PT2H


02. POST snapshot with snapshotLifetime=P1D — expiresAt should be ~86400s out
=============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Day
Content-Length: 0



  delta seconds (rounded to nearest minute): 86400
  snapshotLifetime: P1D


03. POST snapshot with snapshotLifetime=PT1H30M — combined (5400s)
==================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Mix
Content-Length: 0



  delta seconds (rounded to nearest minute): 5400
  snapshotLifetime: PT1H30M


04. POST snapshot WITHOUT snapshotLifetime — default 1h fallback (~3600s)
=========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Default
Content-Length: 0



  delta seconds (rounded to nearest minute): 3600
  snapshotLifetime: None


05. POST with bad snapshotLifetime — expect 400
===============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 189

{
  "detail": "'snapshotLifetime' must be a positive ISO 8601 duration (e.g. \"PT1H\", \"P1D\")",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. POST with non-string snapshotLifetime — expect 400
======================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 189

{
  "detail": "'snapshotLifetime' must be a positive ISO 8601 duration (e.g. \"PT1H\", \"P1D\")",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. PATCH snapshotLifetime=PT3H on Two — expiresAt recomputed (~10800s out)
===========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8



  delta seconds (rounded to nearest minute): 10800
  snapshotLifetime: PT3H


08. PATCH bad snapshotLifetime — expect 400
===========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 189

{
  "detail": "'snapshotLifetime' must be a positive ISO 8601 duration (e.g. \"PT1H\", \"P1D\")",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
swBrokerStop
swSnapDrop
swDbDrop
