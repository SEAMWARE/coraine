--NAME--
DistOps - retrieveEntity merges local non-registered attrs with single-exclusive forward

--TAGS--
distops merge registration retrieve

--INIT--
swDbDrop
swDbDrop -role CP1
swDbDrop -role CP2
swBrokerStart
swBrokerStart -role CP1
swBrokerStart -role CP2

--RUN--

#
# Slice 1.5: a single exclusive registration covers some attrs while local
# holds others. The retrieveEntity result must be the union (with the
# exclusive's attrs sourced from upstream).
#
# 01. Seed CP1 with V1 (speed only - the registered attribute)
# 02. Seed CB with local V1 carrying ONLY non-registered attrs (color, model)
# 03. Register CP1 as exclusive on CB for V1's "speed"
# 04. GET V1 on CB -> merged: color+model from CB, speed from CP1
# 05. GET V1 on CB ?local=true -> local only (no speed)
# 06. GET V1 on CP1 -> upstream view (speed only)
# 07. PATCH local V1 to add a stale "speed"
# 08. GET V1 on CB -> merged, stale local speed stripped (exclusive wins)
# 09. DELETE V1 on CP1
# 10. GET V1 on CB -> upstream 404, falls back to local non-registered attrs
#

echo "01. Seed CP1 with V1 (speed=42)"
echo "==============================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 42
  }
}'
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Seed CB with local V1 (color, model)"
echo "========================================"
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "color": {
    "type": "Property",
    "value": "red"
  },
  "model": {
    "type": "Property",
    "value": "X1"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Register CP1 as exclusive on CB for V1's speed"
echo "=================================================="
payload='{
  "id": "urn:CSR:R1",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "information": [
    {
      "entities": [
        {
          "id": "urn:V1",
          "type": "Vehicle"
        }
      ],
      "propertyNames": [
        "speed"
      ]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "04. GET V1 on CB -> merged (color+model local, speed from CP1)"
echo "=============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "05. GET V1 on CB ?local=true -> local only (no speed)"
echo "====================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true'
echo
echo


echo "06. GET V1 on CP1 -> upstream view (speed only)"
echo "==============================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "07. PATCH local V1 to add a stale speed ?local=true → 409 (exclusive claims speed, § 9.3.3)"
echo "============================================================================================"
payload='{
  "speed": {
    "type": "Property",
    "value": 99
  }
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true' --payload "$payload"
echo
echo


echo "08. GET V1 on CB -> merged, no stale local speed can exist (exclusive wins)"
echo "============================================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "09. DELETE V1 on CP1"
echo "====================="
swCurl --port $CP1_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "10. GET V1 on CB -> upstream 404, falls back to local non-registered attrs"
echo "==========================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "07. Two WILDCARD redirect CSRs (CP1 + CP2) — merged union, no cross-strip"
echo "============================================================================"
# urn:V2 lives only on the CPs: CP1 holds color, CP2 holds speed. Both
# CSRs claim the WHOLE entity (no propertyNames). The retrieve must merge
# BOTH upstreams — one source's wildcard claim must not strip what the
# other just contributed.
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"blue"}}' | head -1
swCurl --port $CP2_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":88}}' | head -1
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:RW1","type":"ContextSourceRegistration","endpoint":"http://localhost:'$CP1_PORT'","mode":"redirect","information":[{"entities":[{"id":"urn:V2","type":"Vehicle"}]}]}' | head -1
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:RW2","type":"ContextSourceRegistration","endpoint":"http://localhost:'$CP2_PORT'","mode":"redirect","information":[{"entities":[{"id":"urn:V2","type":"Vehicle"}]}]}' | head -1
echo
echo


echo "08. GET urn:V2 on CB — color (CP1) AND speed (CP2) both present"
echo "================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V2
echo
echo


--EXPECT--
01. Seed CP1 with V1 (speed=42)
===============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed CB with local V1 (color, model)
========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. Register CP1 as exclusive on CB for V1's speed
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Content-Length: 0




04. GET V1 on CB -> merged (color+model local, speed from CP1)
==============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:V1",
  "model": {
    "type": "Property",
    "value": "X1"
  },
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



05. GET V1 on CB ?local=true -> local only (no speed)
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:V1",
  "model": {
    "type": "Property",
    "value": "X1"
  },
  "type": "Vehicle"
}



06. GET V1 on CP1 -> upstream view (speed only)
===============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "id": "urn:V1",
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



07. PATCH local V1 to add a stale speed ?local=true → 409 (exclusive claims speed, § 9.3.3)
============================================================================================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "local update overlaps with registration 'urn:CSR:R1' (§ 9.3.3 — no local data for an exclusive/redirect scope)",
  "status": 409,
  "title": "Conflict",
  "type": "https://uri.etsi.org/ngsi-ld/errors/AlreadyExists"
}



08. GET V1 on CB -> merged, no stale local speed can exist (exclusive wins)
============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:V1",
  "model": {
    "type": "Property",
    "value": "X1"
  },
  "speed": {
    "type": "Property",
    "value": 42
  },
  "type": "Vehicle"
}



09. DELETE V1 on CP1
=====================
HTTP/1.1 204 No Content
Date: REGEX(.*)




10. GET V1 on CB -> upstream 404, falls back to local non-registered attrs
===========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "color": {
    "type": "Property",
    "value": "red"
  },
  "id": "urn:V1",
  "model": {
    "type": "Property",
    "value": "X1"
  },
  "type": "Vehicle"
}



07. Two WILDCARD redirect CSRs (CP1 + CP2) — merged union, no cross-strip
============================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


08. GET urn:V2 on CB — color (CP1) AND speed (CP2) both present
=================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 162

{
  "color": {
    "type": "Property",
    "value": "blue"
  },
  "id": "urn:V2",
  "speed": {
    "type": "Property",
    "value": 88
  },
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swBrokerStop -role CP2
swDbDrop
swDbDrop -role CP1
swDbDrop -role CP2
