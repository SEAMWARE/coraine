--NAME--
DistOps - retrieveEntity merges local non-registered attrs with single-exclusive forward

--TAGS--
distops merge registration retrieve

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# Slice 1.5: a single exclusive registration covers some attrs while local
# holds others. The retrieveEntity result must be the union (with the
# exclusive's attrs sourced from upstream).
#
# 01. Seed CP1 with V1 (speed only - the registered attribute)
# 02. Seed CB with local V1 carrying ONLY non-registered attrs (color, model)
# 03. Register CP1 as exclusive on CB for V1's "speed"
# 04. GET V1 on CB -> merged: color+model from CB, speed from CP1
# 05. GET V1 on CB ?local=true -> local only (no speed)
# 06. GET V1 on CP1 -> upstream view (speed only)
# 07. PATCH local V1 to add a stale "speed"
# 08. GET V1 on CB -> merged, stale local speed stripped (exclusive wins)
# 09. DELETE V1 on CP1
# 10. GET V1 on CB -> upstream 404, falls back to local non-registered attrs
#

echo "01. Seed CP1 with V1 (speed=42)"
echo "==============================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 42
  }
}'
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Seed CB with local V1 (color, model)"
echo "========================================"
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "color": {
    "type": "Property",
    "value": "red"
  },
  "model": {
    "type": "Property",
    "value": "X1"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Register CP1 as exclusive on CB for V1's speed"
echo "=================================================="
payload='{
  "id": "urn:CSR:R1",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "exclusive",
  "information": [
    {
      "entities": [
        {
          "id": "urn:V1",
          "type": "Vehicle"
        }
      ],
      "propertyNames": [
        "speed"
      ]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "04. GET V1 on CB -> merged (color+model local, speed from CP1)"
echo "=============================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "05. GET V1 on CB ?local=true -> local only (no speed)"
echo "====================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true'
echo
echo


echo "06. GET V1 on CP1 -> upstream view (speed only)"
echo "==============================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "07. PATCH local V1 to add a stale speed (?local bypasses dispatch)"
echo "=================================================================="
payload='{
  "speed": {
    "type": "Property",
    "value": 99
  }
}'
swCurl -X PATCH --url /ngsi-ld/v1/entities/urn:V1 --urlParams 'local=true' --payload "$payload"
echo
echo


echo "08. GET V1 on CB -> merged, stale local speed stripped (exclusive wins)"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "09. DELETE V1 on CP1"
echo "====================="
swCurl --port $CP1_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "10. GET V1 on CB -> upstream 404, falls back to local non-registered attrs"
echo "==========================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


--EXPECT--
01. Seed CP1 with V1 (speed=42)
===============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed CB with local V1 (color, model)
========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. Register CP1 as exclusive on CB for V1's speed
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Content-Length: 0




