#
# FILE            subscription_pernot.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Periodic notification subscriptions (timeInterval).
# The pernot loop fires every timeInterval seconds, querying for
# matching entities and sending a notification with all results.
#
--NAME--
Periodic notification subscription (timeInterval)

--TAGS--
pernot subscription

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# 01. Create entity V1 (Vehicle, speed=80)
# 02. Create periodic subscription (timeInterval=2, for Vehicle)
# 03. Sleep 3 seconds — at least one pernot notification should fire
# 04. Check ftClient received at least one notification containing V1
#

echo "01. Create entity V1"
echo "===================="
swCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {"type": "Property", "value": 80}
}'
echo
echo


echo "02. Create periodic subscription (timeInterval=2)"
echo "=================================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:ngsi-ld:Subscription:Pernot1",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "timeInterval": 2,
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
echo
echo


echo "03. Sleep 3 seconds for periodic notification"
echo "=============================================="
sleep 3
echo "Done sleeping"
echo
echo


echo "04. ftClient received notifications (grep for Pernot1)"
echo "======================================================"
ftClientDump | grep -c "Pernot1"
echo
echo


--EXPECT--
01. Create entity V1
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:V1
Link: REGEX(.*)
Content-Length: 0




02. Create periodic subscription (timeInterval=2)
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Pernot1
Link: REGEX(.*)
Content-Length: 0




03. Sleep 3 seconds for periodic notification
==============================================
Done sleeping


04. ftClient received notifications (grep for Pernot1)
======================================================
REGEX([1-9][0-9]*)


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
