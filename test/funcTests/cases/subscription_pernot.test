#
# FILE            subscription_pernot.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Periodic notification subscriptions (timeInterval).
#
# timeInterval is 1 and not 2 for a reason: ftClientWait's budget is
# 100 x 0.02s = 2s (x5 under valgrind). With a 2s interval the second
# notification is due at t=2.0s, exactly when the wait gives up - so the
# test raced its own helper and lost about half the time on the faster
# backend, while passing every valgrind run where the budget is 10s.
# At timeInterval=1 the two notifications land at t=0 and t=1, inside the
# budget on either backend.
# The pernot loop fires every timeInterval seconds, querying for
# matching entities and sending a notification with all results.
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Periodic notification subscription (timeInterval)

--TAGS--
pernot subscription

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

#
# 01. Create entity V1 (Vehicle, speed=80)
# 02. Create periodic subscription (timeInterval=1, for Vehicle)
# 03. Wait for the second periodic notification (timeInterval=1)
# 04. Delete the subscription — that stops the timer
# 05. Drain what arrived up to the delete
# 06. Nothing more arrives — the assertion the old version made while the
#     subscription was still ticking, which made it a coin flip under valgrind
#

echo "01. Create entity V1"
echo "===================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {"type": "Property", "value": 80}
}'
echo
echo


echo "02. Create periodic subscription (timeInterval=1)"
echo "=================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:ngsi-ld:Subscription:Pernot1",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "timeInterval": 1,
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
echo
echo


echo "03. Wait for the second periodic notification"
echo "=============================================="
ftClientWait 2 && echo "two notifications arrived"
echo
echo


echo "04. Delete the subscription - the periodic timer stops with it"
echo "=============================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Pernot1 -X DELETE | head -1
echo
echo


#
# Everything up to the delete, drained in one read (a dump CONSUMES). The
# settle first, so a notification already in flight when the DELETE landed is
# counted here and not mistaken for a post-delete one below. The count is
# "at least 2" on purpose: the exact number depends on how many 2s ticks fit
# between the wait returning and the DELETE being processed, which is a
# property of the machine, not of the broker.
#
echo "05. At least the two we waited for, all of them for Pernot1"
echo "==========================================================="
ftClientSettle
n=$(ftClientDump | grep -c "Pernot1")
[ "$n" -ge 2 ] && echo "at least two notifications, every one for Pernot1"
echo
echo


#
# THE assertion: the timer is gone with the subscription, so nothing more can
# arrive - whatever the settle window happens to be. It is 50ms here and 1s
# under valgrind, and the old version of this test asserted "nothing arrived"
# while a 2s periodic subscription was still running, which the 1s window
# caught roughly half the time.
#
echo "06. Nothing arrives once the subscription is gone"
echo "================================================="
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Create entity V1
====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Create periodic subscription (timeInterval=1)
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Pernot1
Content-Length: 0




03. Wait for the second periodic notification
==============================================
two notifications arrived


04. Delete the subscription - the periodic timer stops with it
==============================================================
HTTP/1.1 204 No Content


05. At least the two we waited for, all of them for Pernot1
===========================================================
at least two notifications, every one for Pernot1


06. Nothing arrives once the subscription is gone
=================================================
[]
--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
