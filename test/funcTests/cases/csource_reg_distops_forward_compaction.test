#
# FILE            csource_reg_distops_forward_compaction.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Write-forward body compaction: when a CSR declares no
# contextSourceInfo.jsonldContext, forward bodies must be compacted with
# the incoming request's @context (when URL-addressable) and the forward's
# Link header must point at that same context. Before the fix, forwards
# left the broker with fully-expanded IRIs and a core-context Link
# (ETSI D005_01_* / D009_01_*).
#
# Also: the name-keyed "wrapped" Attribute-Fragment form is forwarded in
# the incoming shape (the receiver unwraps for its own local processing).
#
--NAME--
DistOps write forwards — body compacted via the request @context, Link follows

--TAGS--
csource registration distops context forward

--INIT--
swDbDrop
contextServerStart
ftClientStart --port 7711 --status 204
swBrokerStart -dist

contextServerPush /jsonldContexts/veh '{
  "@context": {
    "speed":  "https://example.org/veh/speed",
    "source": "https://example.org/veh/source"
  }
}'

contextServerPush /jsonldContexts/csi '{
  "@context": {
    "velocidad": "https://example.org/veh/speed",
    "fuente":    "https://example.org/veh/source"
  }
}'

--RUN--

#
# 01. Exclusive CSR on urn:V1 claiming speed, created WITH the test
#     context (Link) so propertyNames expands like the writes below.
#     No csi.jsonldContext — the forward context must fall back to the
#     incoming request's @context.
# 02. PATCH /attrs/speed as ld+json, wrapped fragment + in-body @context
#     ARRAY of one URL → 204 (exclusive: forward only, no local apply).
# 03. ftClient dump: the forward body carries SHORT names (speed, source)
#     in the incoming wrapped shape, and the Link header points at the
#     request's context URL — not core.
# 04. PUT /attrs/speed as json + Link, bare fragment → 204.
# 05. ftClient dump: the PUT forward also carries the request context in
#     its Link header.
#

echo "01. Exclusive CSR on urn:V1 claiming speed (no csi.jsonldContext)"
echo "=================================================================="
payload='{
  "id": "urn:CSR:FwdCtx",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711",
  "mode": "exclusive",
  "operations": ["updateAttrs", "replaceAttrs"],
  "information": [
    {
      "entities": [{"id": "urn:V1", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' \
  --payload "$payload"
echo
echo


echo "02. PATCH urn:V1/attrs/speed — ld+json, wrapped fragment, @context array"
echo "========================================================================="
payload='{
  "speed": {
    "type": "Property",
    "value": 99,
    "source": {"type": "Property", "value": "Speedometer"}
  },
  "@context": ["http://localhost:7080/jsonldContexts/veh"]
}'
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH \
  --header 'Content-Type: application/ld+json' \
  --payload "$payload"
echo
echo


echo "03. ftClient dump — compacted wrapped body + request-context Link"
echo "=================================================================="
ftClientDump --port 7711
echo
echo


echo "04. PUT urn:V1/attrs/speed — json + Link, bare fragment"
echo "========================================================"
payload='{
  "type": "Property",
  "value": 77,
  "source": {"type": "Property", "value": "Radar"}
}'
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PUT \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' \
  --payload "$payload"
echo
echo


echo "05. ftClient dump — the PUT forward, request-context Link, short source"
echo "========================================================================"
ftClientDump --port 7711
echo
echo


#
# csi.jsonldContext ≠ the request context: the CSR speaks "csi" (velocidad/
# fuente) for the same IRIs the client calls speed/source. Body keys, the
# {attrId} PATH component, pick=, and the Link header must ALL come out in
# the csi vocabulary.
#

echo "06. Replace the CSR with one declaring csi.jsonldContext"
echo "========================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:FwdCtx -X DELETE | head -1
payload='{
  "id": "urn:CSR:Csi",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711",
  "mode": "exclusive",
  "operations": ["updateAttrs", "retrieveEntity", "upsertBatch", "queryEntity"],
  "contextSourceInfo": [{"key": "jsonldContext", "value": "http://localhost:7080/jsonldContexts/csi"}],
  "information": [
    {
      "entities": [{"id": "urn:V1", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' \
  --payload "$payload" | head -1
echo
echo


echo "07. PATCH urn:V1/attrs/speed (veh ctx) — forward speaks csi: /attrs/velocidad"
echo "==============================================================================="
payload='{
  "speed": {
    "type": "Property",
    "value": 42,
    "source": {"type": "Property", "value": "Lidar"}
  },
  "@context": ["http://localhost:7080/jsonldContexts/veh"]
}'
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH \
  --header 'Content-Type: application/ld+json' \
  --payload "$payload"
echo
echo


echo "08. ftClient dump — velocidad path + body, fuente sub-attr, csi Link"
echo "====================================================================="
ftClientDump --port 7711
echo
echo


echo "09. GET urn:V1 (veh ctx) — retrieve forward carries pick=type,velocidad"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V1 \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' | head -1
ftClientDump --port 7711 | grep -E '"url"|"pick"' | tail -2
echo
echo


echo "10. Batch upsert (veh ctx) — forward body compacted via csi"
echo "============================================================"
payload='[
  {
    "id": "urn:V1",
    "type": "Vehicle",
    "speed": {
      "type": "Property",
      "value": 7,
      "source": {"type": "Property", "value": "Sonar"}
    }
  }
]'
swCurl --url /ngsi-ld/v1/entityOperations/upsert \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' \
  --payload "$payload" | head -1
ftClientDump --port 7711
echo
echo


echo "11. Query ?attrs=speed&q=speed>5 (veh ctx) — attrs never forwarded: q=(velocidad>5);(velocidad)"
echo "================================================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&attrs=speed&q=speed%3E5&splitEntities=false' \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' | head -1
ftClientDump --port 7711 | grep -E '"q"|"attrs"|"pick"|"url"' | tail -4
echo
echo


echo "12. Back to a csi-less CSR — @context [veh, OLD core], the real-world array shape"
echo "===================================================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations/urn:CSR:Csi -X DELETE | head -1
payload='{
  "id": "urn:CSR:Plain",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711",
  "mode": "exclusive",
  "operations": ["updateAttrs"],
  "information": [
    {
      "entities": [{"id": "urn:V1", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations \
  --header 'Link: <http://localhost:7080/jsonldContexts/veh>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"' \
  --payload "$payload" | head -1
payload='{
  "speed": {
    "type": "Property",
    "value": 33,
    "source": {"type": "Property", "value": "GPS"}
  },
  "@context": [
    "http://localhost:7080/jsonldContexts/veh",
    "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.6.jsonld"
  ]
}'
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH \
  --header 'Content-Type: application/ld+json' \
  --payload "$payload" | head -1
ftClientDump --port 7711 | grep -E '"speed"|"source"|"Link"' | tail -3
echo
echo

--EXPECT--
01. Exclusive CSR on urn:V1 claiming speed (no csi.jsonldContext)
==================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:FwdCtx
Content-Length: 0




02. PATCH urn:V1/attrs/speed — ld+json, wrapped fragment, @context array
=========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. ftClient dump — compacted wrapped body + request-context Link
==================================================================
[
  {
    "body": {
      "speed": {
        "source": {
          "type": "Property",
          "value": "Speedometer"
        },
        "type": "Property",
        "value": 99
      }
    },
    "headers": {
      "Accept": "application/json",
      "Content-Length": "91",
