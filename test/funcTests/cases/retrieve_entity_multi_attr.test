# Copyright 2026 Seamware
#
--NAME--
GET entity with multi-attribute returns array with datasetId

--TAGS--
entity multi-attr retrieve

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity with multi-instance speed (default + urn:sensor:radar)
# 02. GET entity E1 - both instances returned
#

echo "01. Create entity with multi-instance speed (default + urn:sensor:radar)"
echo "========================================================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "type": "Property",
      "value": 98,
      "datasetId": "urn:sensor:radar"
    }
  ]
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entity E1 - both instances returned"
echo "============================================="
swCurl --url /ngsi-ld/v1/entities/urn:e1
echo
echo


--EXPECT--
01. Create entity with multi-instance speed (default + urn:sensor:radar)
=========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entity E1 - both instances returned
=============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "id": "urn:e1",
  "speed": [
    {
      "type": "Property",
      "value": 100
    },
    {
      "datasetId": "urn:sensor:radar",
      "type": "Property",
      "value": 98
    }
  ],
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swDbDrop
