#
# REQUIRE_DB: mongoc
# FILE            tenant_persistence.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Multi-tenant persistence across broker restart

--TAGS--
tenant

--INIT--
swDbDrop
swDbDrop -tenant t1
swBrokerStart

--RUN--

#
# 01. POST /entities with NGSILD-Tenant: t1 - create entity in tenant
# 02. Restart broker, GET /entities with NGSILD-Tenant: t1 - tenant rediscovered, entity persisted
#

echo "01. POST /entities with NGSILD-Tenant: t1 - create entity in tenant"
echo "==================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld"
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" -H "Content-Type: application/ld+json" -H "NGSILD-Tenant: t1"
echo
echo


echo "02. Restart broker, GET /entities with NGSILD-Tenant: t1 - tenant rediscovered"
echo "=============================================================================="
swBrokerStop
swBrokerStart
swCurl --url '/ngsi-ld/v1/entities?type=T' -H "NGSILD-Tenant: t1"
echo
echo


--EXPECT--
01. POST /entities with NGSILD-Tenant: t1 - create entity in tenant
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t1
Location: /ngsi-ld/v1/entities/urn:E1
Content-Length: 0




02. Restart broker, GET /entities with NGSILD-Tenant: t1 - tenant rediscovered
==============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
NGSILD-Tenant: t1
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 48

[
  {
    "id": "urn:E1",
    "type": "T"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
swDbDrop -tenant t1
