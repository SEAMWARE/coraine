#
# FILE            query_entities_errors.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /ngsi-ld/v1/entities - Error handling

--TAGS--
entity error query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# Limit errors:
# 01. GET entities?limit=0 (without count) - 400 error
# 02. GET entities?limit=-1 - document current behavior
# 03. GET entities?limit=abc - document current behavior (atoi gives 0, triggers limit=0 error)
#
# Type expression errors:
# 04. GET entities?type= (empty) - document current behavior
# 05. GET entities?type=(A;) - 400 empty type name
# 06. GET entities?type=(;B) - 400 empty type name
#
# Unknown/unsupported params:
# 07. GET entities?foo=bar - 400 unknown param
#
# pick+omit together:
# 08. Create entity for pick+omit test
# 09. GET entities?pick=speed&omit=color - document behavior (pick takes precedence)
#
# Known bugs (not tested - would crash broker):
# - GET entities?type=(A - unmatched paren causes segfault
#

echo "01. GET entities?limit=0 (without count) - 400 error"
echo "===================================================="
swCurl --url '/ngsi-ld/v1/entities?limit=0&type=T'
echo
echo


echo "02. GET entities?limit=-1 - document current behavior"
echo "====================================================="
swCurl --url '/ngsi-ld/v1/entities?limit=-1&type=T'
echo
echo


echo "03. GET entities?limit=abc - document current behavior"
echo "======================================================"
swCurl --url '/ngsi-ld/v1/entities?limit=abc&type=T'
echo
echo


echo "04. GET entities?type= (empty) - document current behavior"
echo "=========================================================="
swCurl --url '/ngsi-ld/v1/entities?type='
echo
echo


echo "05. GET entities?type=(A;) - 400 empty type name"
echo "================================================"
swCurl --url '/ngsi-ld/v1/entities?type=(A;)'
echo
echo


echo "06. GET entities?type=(;B) - 400 empty type name"
echo "================================================"
swCurl --url '/ngsi-ld/v1/entities?type=(;B)'
echo
echo


echo "07. GET entities?foo=bar - 400 unknown param"
echo "============================================"
swCurl --url '/ngsi-ld/v1/entities?foo=bar&type=T'
echo
echo


echo "08. Create entity for pick+omit test"
echo "===================================="
payload='{
  "id": "urn:e1",
  "type": "T",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "09. GET entities?pick=speed&omit=color - document behavior (pick takes precedence)"
echo "=================================================================================="
swCurl --url '/ngsi-ld/v1/entities?pick=speed&omit=color&type=T'
echo
echo


--EXPECT--
01. GET entities?limit=0 (without count) - 400 error
====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 150

{
  "detail": "limit=0 is only valid when count=true",
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. GET entities?limit=-1 - document current behavior
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



03. GET entities?limit=abc - document current behavior
======================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 150

{
  "detail": "limit=0 is only valid when count=true",
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. GET entities?type= (empty) - document current behavior
==========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 205

{
  "detail": "too wide query: at least one of id, idPattern, type, attrs, q, georel, or local must be supplied",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. GET entities?type=(A;) - 400 empty type name
================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 164

{
  "detail": "empty type name in type selection expression",
  "title": "Invalid type parameter",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. GET entities?type=(;B) - 400 empty type name
================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 164

{
  "detail": "empty type name in type selection expression",
  "title": "Invalid type parameter",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. GET entities?foo=bar - 400 unknown param
============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Content-Length: 151

{
  "detail": "Unknown/unsupported URL parameter: foo",
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



08. Create entity for pick+omit test
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Content-Length: 0




09. GET entities?pick=speed&omit=color - document behavior (pick takes precedence)
==================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 78

[
  {
    "speed": {
      "type": "Property",
      "value": 100
    }
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
