#
# FILE            distop_forward_auth_tenant.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Header propagation on a forwarded retrieve (§ 4.3.6.5 + § 5.2.9):
#   - a registration whose contextSourceInfo gives a header the value
#     "urn:ngsi-ld:request" copies that header FROM the triggering request — used
#     here to forward the consumer's Authorization onto the forward.
#   - the tenant on the forward: a registration's own tenant is a REWRITE (map to
#     a different tenant at the context source); when the registration carries no
#     such tenant the ORIGINAL request tenant is forwarded so the source resolves
#     it in the same tenant the consumer addressed.
# (csource-reg-distops-create-csrinfo covers STATIC contextSourceInfo values;
#  this covers the request-substitution + tenant cases.)
#
--NAME--
DistOps forward — Authorization from the request + tenant (original vs registration rewrite)

--TAGS--
distops registration tenant

--INIT--
swDbDrop
swBrokerStart
ftClientStart --port 7711 --status 200

--RUN--

dump() {  # print verb/url + the two headers of interest for each forwarded request
  ftClientDump --port 7711 | python3 -c "
import sys,json
for e in json.load(sys.stdin):
    print(e['verb'], e['url'])
    print('  Authorization:', e['headers'].get('Authorization', '<none>'))
    print('  NGSILD-Tenant:', e['headers'].get('NGSILD-Tenant', '<none>'))
"
}

echo "01. Register (default tenant) — contextSourceInfo Authorization = urn:ngsi-ld:request"
echo "===================================================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:ngsi-ld:CSR:1", "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711", "operations": ["retrieveOps"],
  "contextSourceInfo": [{"key": "Authorization", "value": "urn:ngsi-ld:request"}],
  "information": [{"entities": [{"type": "T"}]}]
}' | grep HTTP
echo
echo


echo "02. GET ?type=T with Authorization (default tenant) — forward carries Authorization, no tenant"
echo "============================================================================================="
ftClientReset --port 7711
swCurl --url '/ngsi-ld/v1/entities?type=T' -H 'Authorization: Bearer tok-xyz' > /dev/null
sleep 0.8
dump
echo
echo


echo "03. Register on tenant acme (no rewrite) + Authorization; GET ?type=T2 on acme"
echo "=============================================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations -H 'NGSILD-Tenant: acme' --payload '{
  "id": "urn:ngsi-ld:CSR:2", "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711", "operations": ["retrieveOps"],
  "contextSourceInfo": [{"key": "Authorization", "value": "urn:ngsi-ld:request"}],
  "information": [{"entities": [{"type": "T2"}]}]
}' | grep HTTP
ftClientReset --port 7711
swCurl --url '/ngsi-ld/v1/entities?type=T2' -H 'NGSILD-Tenant: acme' -H 'Authorization: Bearer tok-xyz' > /dev/null
sleep 0.8
echo "(forward carries Authorization + NGSILD-Tenant: acme — original tenant)"
dump
echo
echo


echo "04. Register on tenant beta WITH tenant rewrite (tenant=backend); GET ?type=T3 on beta"
echo "======================================================================================"
swCurl --url /ngsi-ld/v1/csourceRegistrations -H 'NGSILD-Tenant: beta' --payload '{
  "id": "urn:ngsi-ld:CSR:3", "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711", "operations": ["retrieveOps"], "tenant": "backend",
  "information": [{"entities": [{"type": "T3"}]}]
}' | grep HTTP
ftClientReset --port 7711
swCurl --url '/ngsi-ld/v1/entities?type=T3' -H 'NGSILD-Tenant: beta' > /dev/null
sleep 0.8
echo "(forward carries NGSILD-Tenant: backend — registration rewrite)"
dump
echo
echo


--EXPECT--
01. Register (default tenant) — contextSourceInfo Authorization = urn:ngsi-ld:request
====================================================================================
HTTP/1.1 201 Created


02. GET ?type=T with Authorization (default tenant) — forward carries Authorization, no tenant
=============================================================================================
GET /ngsi-ld/v1/entities
  Authorization: Bearer tok-xyz
  NGSILD-Tenant: <none>


03. Register on tenant acme (no rewrite) + Authorization; GET ?type=T2 on acme
==============================================================================
HTTP/1.1 201 Created
(forward carries Authorization + NGSILD-Tenant: acme — original tenant)
GET /ngsi-ld/v1/entities
  Authorization: Bearer tok-xyz
  NGSILD-Tenant: acme


04. Register on tenant beta WITH tenant rewrite (tenant=backend); GET ?type=T3 on beta
======================================================================================
HTTP/1.1 201 Created
(forward carries NGSILD-Tenant: backend — registration rewrite)
GET /ngsi-ld/v1/entities
  Authorization: <none>
  NGSILD-Tenant: backend


--TEARDOWN--
ftClientStop --port 7711
swBrokerStop
