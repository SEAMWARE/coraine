#
# FILE            query_entities_too_wide.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.2.4 too-wide-query rejection: GET /entities must include at least one
# of type / attrs / q / georel / local. id/idPattern alone are not enough.
#
--NAME--
Query Entities - too wide query rejected (§ 5.7.2.4)

--TAGS--
entity query error validation

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. GET /entities (no filter) - 400 too wide"
echo "============================================"
swCurl --url /ngsi-ld/v1/entities
echo
echo


echo "02. GET /entities?type=Vehicle - 200 OK (type counts)"
echo "====================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


echo "03. GET /entities?id=urn:V1 - 400 (id alone is too wide per § 5.7.2.4)"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/entities?id=urn:V1'
echo
echo


echo "04. GET /entities?local=true - 200 OK (local=true is § 5.7.2.4 (e) 'local scope')"
echo "==================================================================================="
swCurl --url '/ngsi-ld/v1/entities?local=true'
echo
echo


--EXPECT--
01. GET /entities (no filter) - 400 too wide
============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery, 'scopeQ', or 'local=true' (§ 5.7.2.4 — id / idPattern alone is too wide)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. GET /entities?type=Vehicle - 200 OK (type counts)
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



03. GET /entities?id=urn:V1 - 400 (id alone is too wide per § 5.7.2.4)
======================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery, 'scopeQ', or 'local=true' (§ 5.7.2.4 — id / idPattern alone is too wide)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. GET /entities?local=true - 200 OK (local=true is § 5.7.2.4 (e) 'local scope')
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
swBrokerStop
swDbDrop
