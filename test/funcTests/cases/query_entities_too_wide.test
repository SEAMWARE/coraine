#
# FILE            query_entities_too_wide.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 10.4.3.4 too-wide-query rejection: GET /entities must include at least one
# of type / attrs / q / GeoQuery / local. The list is CLOSED, and id/idPattern
# are not on it - the clause says so in prose too ("it is not possible to
# retrieve a set of entities by only specifying desired Entity identifiers").
#
# They were briefly accepted, on the reasoning that an explicit list of ids is
# the narrowest query there is and matches registrations precisely. True, and
# not ours to decide: ETSI 019_03_05 and 021_24 both assert the 400.
#
--NAME--
Query Entities - too wide query rejected (§ 10.4.3.4)

--TAGS--
entity query error validation

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. GET /entities (no filter) - 400 too wide"
echo "============================================"
corCurl --url /ngsi-ld/v1/entities
echo
echo


echo "02. GET /entities?type=Vehicle - 200 OK (type counts)"
echo "====================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


echo "03. GET /entities?id=urn:V1 - 400 (an id list is not on the clause's list)"
echo "=========================================================================="
corCurl --url '/ngsi-ld/v1/entities?id=urn:V1'
echo
echo


echo "04. GET /entities?idPattern=... - 400 (nor is idPattern)"
echo "========================================================"
corCurl --url '/ngsi-ld/v1/entities?idPattern=urn:V.*'
echo
echo


echo "05. GET /entities?pick=speed - 400 (pick PROJECTS, it selects nothing)"
echo "======================================================================"
corCurl --url '/ngsi-ld/v1/entities?pick=speed'
echo
echo


echo "06. GET /entities?local=true - 200 OK (local=true is § 10.4.3.4 (e) 'local scope')"
echo "==================================================================================="
corCurl --url '/ngsi-ld/v1/entities?local=true'
echo
echo


echo "07. GET /entities?scopeQ=/x - 400 (narrows the result, but is not on the list)"
echo "=============================================================================="
corCurl --url '/ngsi-ld/v1/entities?scopeQ=/x'
echo
echo


--EXPECT--
01. GET /entities (no filter) - 400 too wide
============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 285

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery or 'local=true' - a list of entity ids is not enough (§ 10.4.3.4, too wide query)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. GET /entities?type=Vehicle - 200 OK (type counts)
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



03. GET /entities?id=urn:V1 - 400 (an id list is not on the clause's list)
==========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 285

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery or 'local=true' - a list of entity ids is not enough (§ 10.4.3.4, too wide query)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. GET /entities?idPattern=... - 400 (nor is idPattern)
========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 285

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery or 'local=true' - a list of entity ids is not enough (§ 10.4.3.4, too wide query)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. GET /entities?pick=speed - 400 (pick PROJECTS, it selects nothing)
======================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 285

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery or 'local=true' - a list of entity ids is not enough (§ 10.4.3.4, too wide query)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. GET /entities?local=true - 200 OK (local=true is § 10.4.3.4 (e) 'local scope')
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



07. GET /entities?scopeQ=/x - 400 (narrows the result, but is not on the list)
==============================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 285

{
  "detail": "Query Entities requires at least one of 'type', 'attrs', 'q', a GeoQuery or 'local=true' - a list of entity ids is not enough (§ 10.4.3.4, too wide query)",
  "status": 400,
  "title": "Invalid request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
coraineStop
corDbDrop
