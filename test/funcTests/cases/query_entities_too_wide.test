#
# FILE            query_entities_too_wide.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.2.4 too-wide-query rejection: GET /entities must include at least one
# of type / attrs / q / georel / local. id/idPattern alone are not enough.
#
--NAME--
Query Entities - too wide query rejected (§ 5.7.2.4)

--TAGS--
entity query error validation

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. GET /entities (no filter) - 400 too wide"
echo "============================================"
swCurl --url /ngsi-ld/v1/entities
echo
echo


echo "02. GET /entities?type=Vehicle - 200 OK (type counts)"
echo "====================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


echo "03. GET /entities?id=urn:V1 - 200 OK (id counts)"
echo "================================================"
swCurl --url '/ngsi-ld/v1/entities?id=urn:V1'
echo
echo


echo "04. GET /entities?local=true - 200 OK (local counts)"
echo "===================================================="
swCurl --url '/ngsi-ld/v1/entities?local=true'
echo
echo


--EXPECT--
01. GET /entities (no filter) - 400 too wide
============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "too wide query: at least one of id, idPattern, type, attrs, q, georel, or local must be supplied",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. GET /entities?type=Vehicle - 200 OK (type counts)
=====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



03. GET /entities?id=urn:V1 - 200 OK (id counts)
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



04. GET /entities?local=true - 200 OK (local counts)
====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



--TEARDOWN--
swBrokerStop
swDbDrop
