#
# FILE            subscription_attributes_alias_validation.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.12 Table 5.2.12-1 — `notification.attributes` is a deprecated
# synonym for `pick`. Unlike `pick`, it must NOT contain "id", "type",
# or "scope" (those are not valid attribute names in this context).
# The broker rejects subscriptions that include any of those.
#
--NAME--
notification.attributes rejects id/type/scope (§ 5.2.12)

--TAGS--
subscription error validation

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. attributes contains 'id' — 400"
echo "==================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:bad-id",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{"uri":"http://example.org/notify"},
    "attributes":["speed","id"]
  }
}'
echo
echo


echo "02. attributes contains 'type' — 400"
echo "===================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:bad-type",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{"uri":"http://example.org/notify"},
    "attributes":["speed","type"]
  }
}'
echo
echo


echo "03. attributes contains 'scope' — 400"
echo "====================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:bad-scope",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{"uri":"http://example.org/notify"},
    "attributes":["speed","scope"]
  }
}'
echo
echo


echo "04. attributes with normal names — 201"
echo "======================================"
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:good",
  "type":"Subscription",
  "entities":[{"type":"Vehicle"}],
  "notification":{
    "endpoint":{"uri":"http://example.org/notify"},
    "attributes":["speed","color"]
  }
}'
echo
echo


--EXPECT--
01. attributes contains 'id' — 400
===================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 194

{
  "detail": "'notification.attributes' must not include 'id' (§ 5.2.12)",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. attributes contains 'type' — 400
====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 196

{
  "detail": "'notification.attributes' must not include 'type' (§ 5.2.12)",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. attributes contains 'scope' — 400
=====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 197

{
  "detail": "'notification.attributes' must not include 'scope' (§ 5.2.12)",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. attributes with normal names — 201
======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:good
Content-Length: 0




--TEARDOWN--
swBrokerStop
swDbDrop
