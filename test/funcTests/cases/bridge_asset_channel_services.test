   inputSchema {"additionalProperties": false, "properties": {"level": {"maximum": 2147483647, "minimum": -2147483648, "type": "integer"}, "note": {}, "zones": {"items": {"maximum": 2147483647, "minimum": -2147483648, "type": "integer"}, "type": "array"}}, "required": ["level", "zones", "note"], "type": "object"}
   outputSchema {"additionalProperties": false, "properties": {}, "type": "object"}
