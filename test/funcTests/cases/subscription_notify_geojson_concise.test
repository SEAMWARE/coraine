#
# FILE            subscription_notify_geojson_concise.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# geo+json notification with notification.format = concise (§ 5.2.14 + § 4.5.5).
# The entity is rendered CONCISE before the FeatureCollection is built, so each
# Feature's `properties` use the concise representation (a Property is a bare
# value or {value,observedAt,...} without the "type":"Property" tag; a
# GeoProperty keeps its structure). Geometry is still extracted correctly. The
# notification carries Ngsild-Attribute-Format: concise.
#
--NAME--
Subscription notification — geo+json + format concise (§ 5.2.14)

--TAGS--
subscription notification geojson concise

--INIT--
corDbDrop
ftClientStart
coraineStart

--RUN--

echo "01. Subscription: accept = geo+json, format = concise"
echo "====================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id":"urn:ngsi-ld:Subscription:geoc",
  "type":"Subscription",
  "entities":[{"type":"Sensor"}],
  "notification":{
    "format":"concise",
    "endpoint":{
      "uri":"http://localhost:7701/notify",
      "accept":"application/geo+json"
    }
  }
}'
echo
echo


echo "02. POST a Sensor (Property + sub-attr, GeoProperty) → geo+json concise notification"
echo "==================================================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{
  "id":"urn:S1",
  "type":"Sensor",
  "temp":{"type":"Property","value":22,"unitCode":"CEL"},
  "location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[10,20]}}
}'
echo
echo


echo "03. ftClient dump — concise properties, geometry intact, raw"
echo "==========================================================="
sleep 0.4
ftClientDump
echo
echo


#
# Nothing should have arrived since the last read. ftClientWait returns the
# instant its Nth notification lands and never looks for an N+1th, so this is
# where an unwanted one is caught.
#
ftClientSettle
ftClientDump
echo

--EXPECT--
01. Subscription: accept = geo+json, format = concise
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:geoc
Content-Length: 0




02. POST a Sensor (Property + sub-attr, GeoProperty) → geo+json concise notification
===================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:S1
Content-Length: 0




03. ftClient dump — concise properties, geometry intact, raw
===========================================================
[
  {
    "body": {
      "data": {
        "@context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
        "features": [
          {
            "geometry": {
              "coordinates": [
                10,
                20
              ],
              "type": "Point"
            },
            "id": "urn:S1",
            "properties": {
              "location": {
                "coordinates": [
                  10,
                  20
                ],
                "type": "Point"
              },
              "temp": {
                "unitCode": "CEL",
                "value": 22
              },
              "type": "Sensor"
            },
            "type": "Feature"
          }
        ],
        "type": "FeatureCollection"
      },
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:Subscription:geoc",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/geo+json",
      "Host": "localhost:7701",
      "Ngsild-Attribute-Format": "concise",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


[]
--TEARDOWN--
coraineStop
ftClientStop
