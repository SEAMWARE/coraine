#
# FILE            entity_replace_createdat_preservation.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 6.5.3.3 — Replace Entity "shall not modify the createdAt": the entity's
# createdAt is set when it first entered the system and must survive a Replace.
# modifiedAt is stamped fresh on every write.
#
# Regression: ldApiEntityToDbModel::timestampSet stamps createdAt to 'now' on
# every write (correct for create, wrong for replace); replaceEntity now copies
# the stored createdAt back over it. ETSI 054_01_01 surfaced this.
#
--NAME--
Replace Entity (PUT) preserves entity-level createdAt, bumps modifiedAt (§ 6.5.3.3)

--TAGS--
entity replace createdAt sysAttrs

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Create entity urn:V1 with speed (initial)"
echo "============================================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 50
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" | head -1
echo
echo


echo "02. GET sysAttrs=true → capture entity.createdAt"
echo "================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:V1?sysAttrs=true' > /tmp/repl_cat_initial.txt 2>&1
ENTITY_CREATED=$(grep -m1 -oE '"createdAt": "[^"]+"' /tmp/repl_cat_initial.txt | head -1)
echo "initial entity.createdAt captured: $([ -n "$ENTITY_CREATED" ] && echo OK || echo FAIL)"
echo
echo


echo "03. Sleep 1.2s so any fresh stamp would differ"
echo "=============================================="
sleep 1.2
echo
echo


echo "04. Replace entity (PUT) — new content, different speed"
echo "======================================================="
payload='{
  "id": "urn:V1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 99
  }
}'
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X PUT --payload "$payload" | head -1
echo
echo


echo "05. GET sysAttrs=true → entity.createdAt preserved"
echo "=================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?sysAttrs=true' > /tmp/repl_cat_after.txt 2>&1
ENTITY_CREATED2=$(grep -m1 -oE '"createdAt": "[^"]+"' /tmp/repl_cat_after.txt | head -1)
[ "$ENTITY_CREATED" = "$ENTITY_CREATED2" ] && echo "entity.createdAt preserved: OK" || echo "entity.createdAt CHANGED: $ENTITY_CREATED -> $ENTITY_CREATED2"
echo
echo


echo "06. modifiedAt bumped (modifiedAt != createdAt after replace)"
echo "============================================================"
ENTITY_MODIFIED=$(grep -m1 -oE '"modifiedAt": "[^"]+"' /tmp/repl_cat_after.txt | head -1)
[ "$ENTITY_MODIFIED" != "$ENTITY_CREATED2" ] && echo "entity.modifiedAt bumped: OK" || echo "entity.modifiedAt NOT bumped"
echo
echo

--EXPECT--
01. Create entity urn:V1 with speed (initial)
=============================================
HTTP/1.1 201 Created


02. GET sysAttrs=true → capture entity.createdAt
================================================
initial entity.createdAt captured: OK


03. Sleep 1.2s so any fresh stamp would differ
==============================================


04. Replace entity (PUT) — new content, different speed
=======================================================
HTTP/1.1 204 No Content


05. GET sysAttrs=true → entity.createdAt preserved
==================================================
entity.createdAt preserved: OK


06. modifiedAt bumped (modifiedAt != createdAt after replace)
============================================================
entity.modifiedAt bumped: OK


--TEARDOWN--
swBrokerStop
\rm -f /tmp/repl_cat_initial.txt /tmp/repl_cat_after.txt
