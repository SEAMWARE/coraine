--NAME--
DistOps - replaceEntity error modes (ftClient mocks): excl-no-op → 409, dead+live → 207

--TAGS--
distops error registration replace

--INIT--
swDbDrop
swBrokerStart
ftClientStart --port 7711 --status 204
ftClientStart --port 7712 --status 503

--RUN--

#
# ftClient mocks only — we're inducing error states:
#   - exclusive CSR that refuses replaceEntity → 409 Conflict
#   - dead endpoint (503) paired with a live one → 207 Multi-Status
#
# No receive-side state to verify; only the outbound behaviour matters.
#

echo "01. Register exclusive CSR without replaceEntity in operations"
echo "=============================================================="
payload='{
  "id": "urn:CSR:NoRepl",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711",
  "mode": "exclusive",
  "operations": ["retrieveEntity"],
  "information": [
    {
      "entities": [{"id": "urn:V1", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. PUT urn:V1 on CB → 409 (CSR claims speed + refuses op)"
echo "=========================================================="
swCurl --url /ngsi-ld/v1/entities/urn:V1 -X PUT --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":9}}'
echo
echo


echo "03. Register CSR_Dead (503) and CSR_Live (204) on V2, both redirect"
echo "==================================================================="
payload='{
  "id": "urn:CSR:DeadRepl",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7712",
  "mode": "redirect",
  "operations": ["replaceEntity"],
  "information": [
    {
      "entities": [{"id": "urn:V2", "type": "Vehicle"}],
      "propertyNames": ["speed"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
payload='{
  "id": "urn:CSR:LiveRepl",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:7711",
  "mode": "redirect",
  "operations": ["replaceEntity"],
  "information": [
    {
      "entities": [{"id": "urn:V2", "type": "Vehicle"}],
      "propertyNames": ["color"]
    }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "04. PUT urn:V2 → Dead fails, Live succeeds → 207"
echo "================================================"
swCurl --url /ngsi-ld/v1/entities/urn:V2 -X PUT --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":50},"color":{"type":"Property","value":"teal"}}'
echo
echo


--EXPECT--
01. Register exclusive CSR without replaceEntity in operations
==============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:NoRepl
Link: REGEX(.*)
Content-Length: 0




02. PUT urn:V1 on CB → 409 (CSR claims speed + refuses op)
==========================================================
HTTP/1.1 409 Conflict
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "errors": [
    {
      "entityId": "urn:V1",
      "error": {
        "detail": "exclusive registration does not support replaceEntity",
        "title": "Conflict",
        "type": "https://uri.etsi.org/ngsi-ld/errors/Conflict"
      },
      "registrationId": "urn:CSR:NoRepl"
    }
  ],
  "success": []
}



03. Register CSR_Dead (503) and CSR_Live (204) on V2, both redirect
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:DeadRepl
Link: REGEX(.*)
Content-Length: 0



HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:LiveRepl
Link: REGEX(.*)
Content-Length: 0




04. PUT urn:V2 → Dead fails, Live succeeds → 207
================================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "errors": [
    {
      "entityId": "urn:V2",
      "error": {
        "detail": "forward returned status 503",
        "title": "Bad Gateway",
        "type": "https://uri.etsi.org/ngsi-ld/errors/InternalError"
      },
      "registrationId": "urn:CSR:DeadRepl"
    }
  ],
  "success": [
    "urn:V2"
  ]
}



--TEARDOWN--
ftClientStop --port 7711
ftClientStop --port 7712
swBrokerStop
swDbDrop
