#
# FILE            usage.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
CLI usage output (-u and -U with various plugin combinations)

--TAGS--
usage

--INIT--

--RUN--

#
# 01. Usage with swRamDB plugin (no extra CLI args)
# 02. Usage with mongoc plugin (shows DB connection args)
# 03. Usage with non-existent plugin (error + usage)
# 04. EXTENDED usage (-U)
#
# -U used to SEGFAULT before printing a single line: its column-width helper
# ran strlen() over every longName, and a KARGS_SEPARATOR (the section headings
# in the -u listing) legitimately has none. Separators are skipped here — they
# head a section of the plain listing and have no columns to fill — and every
# field is padded as a unit, so the columns actually line up.
#

echo "01. Usage with swRamDB plugin (no extra CLI args)"
echo "=================================================="
$SW_BROKER -u -db swRamDB 2>&1
echo
echo


echo "02. Usage with mongoc plugin (shows DB connection args)"
echo "======================================================="
$SW_BROKER -u -db mongoc 2>&1
echo
echo


echo "03. Usage with non-existent plugin (error + usage)"
echo "==================================================="
$SW_BROKER -u -db dummy2 2>&1
echo
echo


echo "04. Extended usage (-U) - one aligned row per option, no separator rows"
echo "======================================================================="
$SW_BROKER -U -db swRamDB 2>&1
echo
echo


--EXPECT--
01. Usage with swRamDB plugin (no extra CLI args)
==================================================
Usage: swBroker  [--usage/-u (usage)]
                 [--Usage/-U (extended usage)]
                 [--verbose/-v (verbose mode)]
                 [--debug/-d (debug mode)]
                 [--traceLevels/-t <trace levels>]
                 [--port/-p <TCP port to listen on>]
                 [--database/-db <swRamDB|mongoc>]
                 [--troe/-troe <none|timescale|ramdb>]
                 [--apiPlugins/-api <admin>]
                 [--pretty-print/-pp <default JSON indentation (0=compact)>]
                 [--connectionPoolSize/-cps <MHD thread pool size>]
                 [--notifyValueChangeOnly/-nvco (only notify when an attribute value changed (suppress value-neutral updates))]
                 [--corsOrigin/-corsOrigin <enable CORS with allowed origin ('__ALL' for any)>]
                 [--corsMaxAge/-corsMaxAge <preflight cache max age in seconds>]
                 [--defaultUserContext/-duc <default user @context URL>]
                 [--csourceAlias/-csourceAlias <contextSourceAlias base for Via headers (default: the advertised endpoint authority)>]
                 [--httpEndpoint/-he <externally-reachable HTTP base URL (default: auto-detected LAN IP, else http://localhost:<port>)>]
                 [--contextSourceExtras/-csx <path to a JSON file rendered verbatim on /info/sourceIdentity (§ 5.2.40)>]
                 [--distributed/-dist (enable distributed operations (forward to registered Context Sources); off by default — the Registry API works either way)]
                 [--noSplitEntities/-noSplitEntities (disable split entities — each entity fully at one source)]
                 [--high-precision/-hp (render DateTime values (createdAt/modifiedAt/observedAt/expiresAt) at full nanosecond precision (9 digits); default is 6 (§5.2.2.4 µs))]
                 [--asyncSnapshot/-asyncSnapshot (run snapshotQueries in a background thread (POST returns 201 immediately, status=preparing))]
                 [--maxRequestSize/-mrs <max request body size in MiB (0 = no cap; § 6.3.2 413 threshold)>]
                 [--subStatsFlushInterval/-ssfi <sub-stats periodic flush interval (s; 0 = off)>]
                 [--distOpTimeout/-dtmo <default HTTP client request timeout (ms) — distop forwards, sub-notifs, @context downloads>]
                 [--cooldownMillis/-cms <default endpoint cooldown after a notification/forward failure (ms; 0 = only when the subscription/registration specifies one)>]
                 [--foreground/-fg (run in foreground (don't daemonize))]
                 [--insecureNotif/-insecureNotif (accept self-signed certificates on TLS notifications/forwards (endpoint inside a trusted network))]

                 Plugins are loaded from /opt/seamware/plugins


