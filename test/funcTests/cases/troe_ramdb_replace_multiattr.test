#
# FILE            troe_ramdb_replace_multiattr.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE: PUT /entities/{id} (replace) → 1 entityReplaced + N attrReplaced;
# POST /entities/{id}/attrs (append) → N attrCreated/Modified;
# PATCH /entities/{id}/attrs (multi-attr) → N attrModified/Created.
#
--NAME--
TRoE - replaceEntity + multi-attr POST/PATCH

--TAGS--
troe replace patch

--INIT--
corDbDrop
coraineStart --troe ramdb --apiPlugins admin

--RUN--

echo "01. POST entity urn:V1 with one attr"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
echo
echo
echo


echo "02. PUT /entities/urn:V1 — wholesale replace with 2 attrs"
echo "========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X PUT --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99},"color":{"type":"Property","value":"red"}}' | head -1
echo


echo "03. POST /entities/urn:V1/attrs — append two attrs"
echo "=================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs --payload '{"weight":{"type":"Property","value":1500},"brand":{"type":"Property","value":"X"}}' | head -1
echo


echo "04. PATCH /entities/urn:V1/attrs — modify two attrs"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"speed":{"type":"Property","value":120},"weight":{"type":"Property","value":1600}}' | head -1
echo
echo


echo "05. GET /admin/troe/dump — events in array order"
echo "================================================"
corCurl --url /admin/troe/dump | python3 -c "
import sys, json, re
hdr = ''
body = ''
for line in sys.stdin:
    if hdr == '' and line.strip() == '':
        hdr = 'done'
        continue
    if hdr == 'done':
        body += line
d = json.loads(body) if body.strip() else {}
events = d.get('events', [])
print('  count:', len(events))
for e in events:
    a = e.get('attrName', '')
    a = re.sub(r'https://uri\.etsi\.org/ngsi-ld/default-context/', '', a)
    print('  op=%s entityId=%s attrName=%s' % (e.get('op'), e.get('entityId'), a))
"
echo
echo


--EXPECT--
01. POST entity urn:V1 with one attr
====================================



02. PUT /entities/urn:V1 — wholesale replace with 2 attrs
=========================================================
HTTP/1.1 204 No Content

03. POST /entities/urn:V1/attrs — append two attrs
==================================================
HTTP/1.1 204 No Content

04. PATCH /entities/urn:V1/attrs — modify two attrs
===================================================
HTTP/1.1 204 No Content


05. GET /admin/troe/dump — events in array order
================================================
  count: 8
  op=entityCreated entityId=urn:V1 attrName=
  op=entityReplaced entityId=urn:V1 attrName=
  op=attrReplaced entityId=urn:V1 attrName=speed
  op=attrReplaced entityId=urn:V1 attrName=color
  op=attrCreated entityId=urn:V1 attrName=weight
  op=attrCreated entityId=urn:V1 attrName=brand
  op=attrModified entityId=urn:V1 attrName=speed
  op=attrModified entityId=urn:V1 attrName=weight


--TEARDOWN--
coraineStop
corDbDrop
