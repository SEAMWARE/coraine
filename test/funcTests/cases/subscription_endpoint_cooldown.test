#
# FILE            subscription_endpoint_cooldown.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.15 endpoint.cooldown — minimum delay (ms) before retrying after a
# failure on the same endpoint. With a long cooldown set, the second
# failing notification is suppressed.
#
--NAME--
Subscription notification - endpoint.cooldown suppresses retries after failure (§ 5.2.15)

--TAGS--
subscription notification cooldown

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Sub with cooldown=60000 (60s) → endpoint that always fails"
echo "=============================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:Cool",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:1/notify",
      "cooldown": 60000
    }
  }
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | head -1
echo
echo


echo "02. POST 3 entities — only the first fires a notification"
echo "=========================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}' | head -1
echo
echo


echo "03. Inspect counters - timesFailed=1, timesSent=1 (cooldown blocked the rest)"
echo "============================================================================="
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Cool | grep -E '"(timesSent|timesFailed)"'
echo
echo


--EXPECT--
01. Sub with cooldown=60000 (60s) → endpoint that always fails
==============================================================
HTTP/1.1 201 Created


02. POST 3 entities — only the first fires a notification
==========================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


03. Inspect counters - timesFailed=1, timesSent=1 (cooldown blocked the rest)
=============================================================================
    "timesFailed": 1,
    "timesSent": 1


--TEARDOWN--
coraineStop
corDbDrop
