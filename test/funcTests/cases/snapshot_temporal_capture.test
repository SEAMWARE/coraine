#
# FILE            snapshot_temporal_capture.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16.1.4 + § 5.7.4 — snapshotTemporalQueries are executed against the
# live tenant's TRoE store; matched EntityTemporal trees are streamed
# into the snap-tenant's TRoE store. snapshotTemporalQueriesDetails
# reports per-query result status; snapshotStatus aggregates across
# both current-state and temporal detail lists.
#
# Requires postgres + the timescale TRoE plugin.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot temporal capture (§ 5.16.1.4 / Phase #146b)

--TAGS--
snapshot troe timescale postgres

--INIT--
corDbDrop
corSnapDrop
corTroeInit
coraineStart --troe timescale

--RUN--

echo "01. Seed two Vehicle entities (TRoE captures createds)"
echo "======================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' >/dev/null
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V2","type":"Vehicle","speed":{"type":"Property","value":80}}' >/dev/null
echo "  seeded V1, V2"
echo
echo


echo "02. PATCH each speed twice — three temporal instances per entity"
echo "================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":50}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs/speed -X PATCH --payload '{"value":55}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2/attrs/speed -X PATCH --payload '{"value":85}' >/dev/null
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2/attrs/speed -X PATCH --payload '{"value":90}' >/dev/null
echo "  patched each twice"
echo
echo


echo "03. POST snapshot with snapshotTemporalQueries — capture history"
echo "================================================================"
corCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Hist",
  "type": "Snapshot",
  "snapshotTemporalQueries":[
    {
      "type":"Query",
      "entities":[{"type":"Vehicle"}],
      "temporalQ":{"timerel":"after","timeAt":"1970-01-01T00:00:00Z","timeproperty":"modifiedAt"}
    }
  ]
}'
echo
echo


echo "04. GET /snapshots/Hist — snapshotTemporalQueriesDetails populated, status=success"
echo "==================================================================================="
corCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Hist
echo
echo


echo "05. timescale: snap-tenant attr rows match the live-tenant count (3 per entity)"
echo "================================================================================"
# Each tenant — including the per-snapshot snap-tenant — owns its own physical
# TRoE database. Live rows are in $COR_TROE_DB; the snapshot's rows are in its
# own "${COR_TROE_DB}_snap_<seq>" database.
sleep 0.2
echo "$(psql -h localhost -p 5432 -U postgres -d "$COR_TROE_DB" -tAc "SELECT count(*) FROM troe_attrs")|live"
snapDb=$(psql -h localhost -p 5432 -U postgres -tAc "SELECT datname FROM pg_database WHERE datname LIKE '${COR_TROE_DB}_snap_%' ORDER BY datname LIMIT 1")
echo "$(psql -h localhost -p 5432 -U postgres -d "$snapDb" -tAc "SELECT count(*) FROM troe_attrs")|snap"
echo
echo


--EXPECT--
01. Seed two Vehicle entities (TRoE captures createds)
======================================================
  seeded V1, V2


02. PATCH each speed twice — three temporal instances per entity
================================================================
  patched each twice


03. POST snapshot with snapshotTemporalQueries — capture history
================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Hist
Content-Length: 0




04. GET /snapshots/Hist — snapshotTemporalQueriesDetails populated, status=success
===================================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": "REGEX(.*)",
  "id": "urn:ngsi-ld:Snapshot:Hist",
  "lastUsedAt": "REGEX(.*)",
  "snapshotPriority": 5,
  "snapshotStatus": "success",
  "snapshotTemporalQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "temporalQ": {
        "timeAt": "1970-01-01T00:00:00Z",
        "timeproperty": "modifiedAt",
        "timerel": "after"
      },
      "type": "Query"
    }
  ],
  "snapshotTemporalQueriesDetails": [
    {
      "resultStatus": "success"
    }
  ],
  "type": "Snapshot"
}



05. timescale: snap-tenant attr rows match the live-tenant count (3 per entity)
================================================================================
6|live
6|snap


--TEARDOWN--
coraineStop
corSnapDrop
corDbDrop
corTroeDrop
