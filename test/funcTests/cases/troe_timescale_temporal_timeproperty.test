#
# FILE            troe_timescale_temporal_timeproperty.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.3 — the ?timeproperty (and temporalQ.timeproperty) selects the time
# axis for a temporal query:
#   - observedAt (default) — the user-supplied observation time
#   - createdAt            — restricted to the creation row (op='created')
#   - modifiedAt           — every row, ordered by record time
#   - deletedAt            — restricted to the deletion row (covered elsewhere)
# It governs which instances qualify, the timerel/timeAt predicate, and the
# instance ordering. Mirrors the createdAt/modifiedAt axis across the single,
# multi, and POST-query temporal endpoints.
#
--NAME--
TRoE temporal timeproperty axis — createdAt (creation row) / modifiedAt (all) / observedAt

--TAGS--
troe timescale postgres temporal timeproperty query

--INIT--
corDbDrop
corTroeInit
coraineStart --troe timescale

--RUN--

#
# E1: P1=10 (observedAt June), then P1=20 (March), then P1=30 (September).
# Record-time (ts) order is creation order: 10 < 20 < 30. Sleeps keep ts distinct.
# E2: P1=100 (observedAt April).
#

echo "01. Create E1 P1=10 observedAt June"
echo "==================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:E1","type":"T","P1":{"type":"Property","value":10,"observedAt":"2024-06-15T12:00:00Z"}}'
echo
echo

sleep 1.1

echo "02. Update E1 P1=20 observedAt March"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs -X PATCH --payload '{"P1":{"type":"Property","value":20,"observedAt":"2024-03-15T12:00:00Z"}}'
echo
echo

sleep 1.1

echo "03. Update E1 P1=30 observedAt September"
echo "========================================"
corCurl --url /ngsi-ld/v1/entities/urn:E1/attrs -X PATCH --payload '{"P1":{"type":"Property","value":30,"observedAt":"2024-09-15T12:00:00Z"}}'
echo
echo


echo "04. Create E2 P1=100 observedAt April"
echo "====================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:E2","type":"T","P1":{"type":"Property","value":100,"observedAt":"2024-04-10T12:00:00Z"}}'
echo
echo

sleep 1

echo "05. GET E1 timeproperty=createdAt — only the creation instance (P1=10)"
echo "======================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&timeproperty=createdAt'
echo
echo


echo "06. GET E1 timeproperty=modifiedAt — all instances, record-time ordered"
echo "======================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&timeproperty=modifiedAt'
echo
echo


echo "07. GET multi timeproperty=createdAt — only creation instances for E1, E2"
echo "========================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2099-12-31T23:59:59Z&timeproperty=createdAt'
echo
echo


echo "08. POST query timeproperty=modifiedAt — all instances"
echo "======================================================"
corCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload '{"type":"Query","entities":[{"type":"T"}],"temporalQ":{"timerel":"before","timeAt":"2099-12-31T23:59:59Z","timeproperty":"modifiedAt"}}'
echo
echo


echo "09. GET E1 timeproperty=modifiedAt timerel=before timeAt=2020 — empty (record time is now)"
echo "=========================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:E1?timerel=before&timeAt=2020-01-01T00:00:00Z&timeproperty=modifiedAt'
echo
echo


echo "10. GET E1 timeproperty=modifiedAt timerel=after timeAt=2020 — all instances"
echo "============================================================================"
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:E1?timerel=after&timeAt=2020-01-01T00:00:00Z&timeproperty=modifiedAt'
echo
echo


echo "11. GET E1 default (observedAt) timerel=before timeAt=2024-07 — only June + March"
echo "================================================================================="
corCurl --url '/ngsi-ld/v1/temporal/entities/urn:E1?timerel=before&timeAt=2024-07-01T00:00:00Z'
echo
echo


--EXPECT--
01. Create E1 P1=10 observedAt June
===================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1
Content-Length: REGEX(\d+)




02. Update E1 P1=20 observedAt March
====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. Update E1 P1=30 observedAt September
========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




04. Create E2 P1=100 observedAt April
=====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2
Content-Length: REGEX(\d+)




05. GET E1 timeproperty=createdAt — only the creation instance (P1=10)
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "P1": [
    {
      "instanceId": "REGEX(.*)",
      "observedAt": "2024-06-15T12:00:00Z",
      "type": "Property",
      "value": 10
    }
  ],
  "id": "urn:E1",
  "type": "T"
}



