#
# FILE            snapshot_split_capture.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16 Snapshot — split-mode distributed capture (Phase #142).
#
# A single Entity is sharded across two CPs:
#   - CP1 holds urn:V1 with `speed`
#   - CP2 holds urn:V1 with `color`
#
# CB has CSRs to both. Default broker config (--noSplitEntities NOT
# passed) means split mode is in effect. Capture must:
#   - forward the unfiltered query to each CSR
#   - merge fragments per § 4.5.5.3 in the snap-tenant
#   - apply the post-merge filter to keep only entities matching the
#     snapshotQuery
#
# Verification:
#   - the snapshot's V1 has BOTH attrs (speed + color)
#   - mutating either CP doesn't affect the frozen view
#   - q=speed>20 on the snapshot returns the merged V1 (which it would
#     not, if the query had been forwarded as-is to the partial sources)
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot split-mode capture: per-attribute merge across CSRs (§ 5.16, Phase #142)

--TAGS--
snapshot distops

--INIT--
swDbDrop
swSnapDrop
swDbDrop -role CP1
swDbDrop -role CP2
swBrokerStart
swBrokerStart -role CP1
swBrokerStart -role CP2

--RUN--

echo "01. Seed V1 fragments — CP1 has speed, CP2 has color"
echo "===================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","speed":{"type":"Property","value":42}}'
echo
swCurl --port $CP2_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:Vehicle:V1","type":"Vehicle","color":{"type":"Property","value":"red"}}'
echo
echo


echo "02. Register CSR on CB → CP1 (inclusive, speed)"
echo "==============================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:CP1",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["retrieveOps"],
  "information": [{"entities":[{"type":"Vehicle"}],"propertyNames":["speed"]}]
}'
echo
echo


echo "03. Register CSR on CB → CP2 (inclusive, color)"
echo "==============================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:CP2",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP2_PORT'",
  "mode": "inclusive",
  "operations": ["retrieveOps"],
  "information": [{"entities":[{"type":"Vehicle"}],"propertyNames":["color"]}]
}'
echo
echo


echo "04. Snapshot in default (split) mode capturing Vehicles"
echo "======================================================="
swCurl --url /ngsi-ld/v1/snapshots --payload '{
  "id": "urn:ngsi-ld:Snapshot:Merged",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
echo
echo


echo "05. Snapshot read — V1 with BOTH speed and color (merged)"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Merged'
echo
echo


echo "06. Mutate live V1 on CP1 (speed → 999); delete on CP2"
echo "======================================================"
swCurl --port $CP1_PORT -X PATCH --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1/attrs --payload '{"speed":{"type":"Property","value":999}}'
echo
swCurl --port $CP2_PORT -X DELETE --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
echo
echo


echo "07. Snapshot still shows merged V1 with original values"
echo "======================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Merged'
echo
echo


echo "08. Snapshot q=speed>20 — V1 merged (post-filter sees full entity)"
echo "=================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&q=speed%3E20' -H 'NGSILD-Snapshot: urn:ngsi-ld:Snapshot:Merged'
echo
echo


--EXPECT--
01. Seed V1 fragments — CP1 has speed, CP2 has color
====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: REGEX(\d+)



