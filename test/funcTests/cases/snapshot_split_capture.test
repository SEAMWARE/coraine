    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop -role CP2
swBrokerStop -role CP1
swBrokerStop
swSnapDrop
swDbDrop -role CP2
swDbDrop -role CP1
swDbDrop
