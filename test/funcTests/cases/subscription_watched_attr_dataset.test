Date: REGEX(.*)


[
  {
    "body": {
      "data": [
        {
          "id": "urn:V1",
          "speed": {
            "datasetId": "urn:ds:1",
            "type": "Property",
            "value": "urn:ngsi-ld:null"
          },
          "type": "Vehicle"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:S:instance",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "REGEX(\d+)",
      "Content-Type": "application/json",
