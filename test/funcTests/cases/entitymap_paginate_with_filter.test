===================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 564

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:V1",
    "speed": {
      "type": "Property",
      "value": 10
    },
    "type": "Vehicle"
  },
  {
    "color": {
      "type": "Property",
      "value": "blue"
    },
    "id": "urn:V2",
    "speed": {
      "type": "Property",
      "value": 20
    },
    "type": "Vehicle"
  },
  {
    "color": {
      "type": "Property",
      "value": "green"
    },
    "id": "urn:V3",
    "speed": {
      "type": "Property",
      "value": 30
