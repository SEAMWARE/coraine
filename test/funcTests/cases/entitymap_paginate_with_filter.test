    "id": "urn:V2",
    "speed": {
      "type": "Property",
      "value": 20
    },
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": {
      "type": "Property",
      "value": 30
    },
    "type": "Vehicle"
  }
]



