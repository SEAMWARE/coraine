#
# FILE            entitymap_paginate_with_filter.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.7.2.4 — paginating an existing EntityMap with filter URL params.
#
# The EntityMap is a frozen "for entity X, here are the sources that
# contribute to it" snapshot. The current request's q / geoQ / scopeQ /
# type filters STILL APPLY on the assembled entities — the map only
# fixes source selection, not the result set. A page may return < limit
# entities when filters strip some (§ 5.5.9 allows this).
#
--NAME--
EntityMap pagination — filter params re-apply per spec § 5.7.2.4

--TAGS--
entitymap query pagination distops

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed urn:V1 (color=red, speed=10)"
echo "====================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","color":{"type":"Property","value":"red"},"speed":{"type":"Property","value":10}}'
echo
echo


echo "02. Seed urn:V2 (color=blue, speed=20)"
echo "======================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","color":{"type":"Property","value":"blue"},"speed":{"type":"Property","value":20}}'
echo
echo


echo "03. Seed urn:V3 (color=green, speed=30)"
echo "======================================="
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","color":{"type":"Property","value":"green"},"speed":{"type":"Property","value":30}}'
echo
echo


echo "04. Create EntityMap from broad query (?entityMap=true)"
echo "======================================================="
MAP_ID=$(swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&entityMap=true&orderBy=id' 2>/dev/null | grep -i 'NGSILD-EntityMap:' | sed -E 's|.*entityMaps/([^[:space:]]*).*|\1|' | tr -d '\r')
if [ -n "$MAP_ID" ]; then echo "Map captured (id present): yes"; else echo "Map captured (id present): no"; fi
echo
echo


echo "05. Paginate with q=color==\"blue\" — only V2 returned (V1, V3 filtered out)"
echo "==========================================================================="
echo "    Map has 3 entries; current request's q is re-applied per § 5.7.2.4."
echo "    Page returns < limit because filters stripped 2 of 3 entries."
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=color%3D%3D%22blue%22"
echo
echo


echo "06. Paginate with q=speed>15 — V2, V3 (V1 filtered out)"
echo "======================================================="
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=speed%3E15"
echo
echo


echo "07. Paginate with q that matches none — empty array"
echo "==================================================="
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=color%3D%3D%22purple%22"
echo
echo


echo "08. Paginate without filters — all 3 (sanity check)"
echo "==================================================="
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID"
echo
echo


echo "09. Paginate q=color==\"blue\"&count=true — NGSILD-Results-Count is the MAP count (3), not the 1 returned"
echo "========================================================================================================"
echo "    The count header reports the frozen map entry count, NOT a live post-filter total"
echo "    (the live total would require fetching+filtering every page)."
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=color%3D%3D%22blue%22&count=true"
echo
echo


echo "10. Page 1 (limit=2,offset=0) q=speed>15&count=true — map batch [V1,V2], V1 dropped -> only [V2]"
echo "==============================================================================================="
echo "    Page returns 1 of the batch's 2; Results-Count still 3; next link advances by limit (offset=2)."
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=speed%3E15&limit=2&offset=0&count=true"
echo
echo


echo "11. Page 2 (limit=2,offset=2) q=speed>15&count=true — map batch [V3] -> [V3]; batches stayed intact"
echo "=================================================================================================="
echo "    Despite the drop on page 1, page 2 covers the next map batch, not a re-filled one."
swCurl --url "/ngsi-ld/v1/entities?entityMap=$MAP_ID&q=speed%3E15&limit=2&offset=2&count=true"
echo
echo


--EXPECT--
01. Seed urn:V1 (color=red, speed=10)
=====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed urn:V2 (color=blue, speed=20)
======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V2
Content-Length: 0




03. Seed urn:V3 (color=green, speed=30)
=======================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V3
Content-Length: 0




04. Create EntityMap from broad query (?entityMap=true)
=======================================================
Map captured (id present): yes


