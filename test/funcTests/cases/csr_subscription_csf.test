#
# FILE            csr_subscription_csf.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.6.5.2 / § 12.4.2.4 — a Context Source Registration Subscription may
# carry a csf, and "the conditions specified by the context source filter
# match the respective Context Source Properties". The same member on an
# ENTITY subscription is explicitly ignored ("In other cases it is ignored"),
# so this test pins both halves: a CSR-sub filters on it, an entity
# subscription stores and echoes it but keeps notifying.
#
--NAME--
CSR Subscription - csf filters on the registration's own Properties

--TAGS--
csr-sub subscription registration csf

--INIT--
corDbDrop
ftClientStart
coraineStart -dist

--RUN--

echo "01. CSR-sub S1 on Vehicle with csf=organization==\"Acme\""
echo "========================================================"
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload '{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "csf": "organization==\"Acme\"",
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/s1"}}
}'
echo
echo


# S1's and S2's initial notifications are sent post-response on separate request
# threads; the dump in step 04 reads them in ARRIVAL order. Without this barrier
# /s1 and /s2 swap places whenever S1's notification loses the race - which is
# what took this test red in the valgrind nightly.
ftClientWait 1

echo "02. CSR-sub S2 on Vehicle with no csf — matches every Vehicle CSR"
echo "================================================================="
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload '{
  "id": "urn:S2",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/s2"}}
}'
echo
echo


ftClientWait 2

echo "03. Register CSR-Beta (organization=Beta) — only S2 matches"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:Beta",
  "type": "ContextSourceRegistration",
  "endpoint": "http://cp2.example",
  "mode": "inclusive",
  "organization": {"type": "Property", "value": "Beta"},
  "information": [{"entities": [{"type": "Vehicle"}]}]
}' | head -1
echo
echo


ftClientWait 3

echo "04. S1 + S2 initial (empty) notifs, then CSR:Beta to /s2 alone"
echo "=============================================================="
ftClientDump | grep -E '"url"|"id"'
echo
echo


echo "05. Register CSR-Acme (organization=Acme) — S1 and S2 both match"
echo "================================================================"
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{
  "id": "urn:CSR:Acme",
  "type": "ContextSourceRegistration",
  "endpoint": "http://cp1.example",
  "mode": "inclusive",
  "organization": {"type": "Property", "value": "Acme"},
  "information": [{"entities": [{"type": "Vehicle"}]}]
}' | head -1
echo
echo


ftClientWait 2

echo "06. CSR:Acme reaches BOTH /s1 and /s2 — S1's csf matches it"
echo "==========================================================="
ftClientDump | grep -E '"url"|"id"'
echo
echo


echo "07. GET the CSR-sub back — csf is echoed as supplied"
echo "===================================================="
corCurl --url /ngsi-ld/v1/csourceSubscriptions/urn:S1
echo
echo


echo "08. An ENTITY subscription's csf is ignored (§ 5.2.6.5.2) — stored, echoed"
echo "=========================================================================="
corCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:S3",
  "type": "Subscription",
  "entities": [{"type": "Bike"}],
  "csf": "organization==\"Nobody\"",
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/s3"}}
}' | head -1
corCurl --url /ngsi-ld/v1/subscriptions/urn:S3
echo
echo


echo "09. ... and it still notifies on a matching Entity"
echo "=================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:Bike:1","type":"Bike","gears":{"type":"Property","value":21}}' | head -1
ftClientWait 1
ftClientDump | grep -E '"url"|"id"'
echo
echo


--EXPECT--
01. CSR-sub S1 on Vehicle with csf=organization=="Acme"
========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceSubscriptions/urn:S1
Content-Length: 0




02. CSR-sub S2 on Vehicle with no csf — matches every Vehicle CSR
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceSubscriptions/urn:S2
Content-Length: 0




03. Register CSR-Beta (organization=Beta) — only S2 matches
===========================================================
HTTP/1.1 201 Created


04. S1 + S2 initial (empty) notifs, then CSR:Beta to /s2 alone
==============================================================
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s1",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s2",
          "id": "urn:CSR:Beta",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s2",


05. Register CSR-Acme (organization=Acme) — S1 and S2 both match
================================================================
HTTP/1.1 201 Created


06. CSR:Acme reaches BOTH /s1 and /s2 — S1's csf matches it
===========================================================
          "id": "urn:CSR:Acme",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s1",
          "id": "urn:CSR:Acme",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s2",


07. GET the CSR-sub back — csf is echoed as supplied
====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "csf": "organization==\"Acme\"",
  "entities": [
    {
      "type": "Vehicle"
    }
  ],
  "id": "urn:S1",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/s1"
    },
    "lastNotification": "REGEX(.*)",
    "lastSuccess": "REGEX(.*)",
    "status": "ok",
    "timesSent": 2
  },
  "status": "active",
  "type": "Subscription"
}



08. An ENTITY subscription's csf is ignored (§ 5.2.6.5.2) — stored, echoed
==========================================================================
HTTP/1.1 201 Created
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 415

{
  "csf": "organization==\"Nobody\"",
  "entities": [
    {
      "type": "Bike"
    }
  ],
  "id": "urn:S3",
  "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
  "notification": {
    "endpoint": {
      "uri": "http://localhost:7701/s3"
    }
  },
  "notificationTrigger": [
    "attributeCreated",
    "attributeUpdated"
  ],
  "status": "active",
  "type": "Subscription"
}



09. ... and it still notifies on a matching Entity
==================================================
HTTP/1.1 201 Created
          "id": "urn:Bike:1",
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
    "url": "/s3",


--TEARDOWN--
coraineStop
ftClientStop
