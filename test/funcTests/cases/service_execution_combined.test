#
# FILE            service_execution_combined.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Service Execution (doc/service-execution.md): Combined and Grouped Service Executions, Combined Service
# Templates (GR CIM-055 § 6.3.5.2-4, § 6.4.7.3-5, § 6.4.14-17). sequential: one child after another, a
# failure ends it (the rest cancelled); parallel: all at once; nested; from a template, its services
# overridden by place; grouped: the service on every entity of a selection that offers it. The parent's
# status follows its children's; cancelling it cancels them; deleting an ended one deletes them.
#
# REQUIRE_FEATURE: SERVICE_EXECUTION
#
--NAME--
Service Execution - combined (sequential, parallel, nested), templates, grouped; cancel

--TAGS--
service execution bridge

--INIT--
corDbDrop
coraineStart --bridges loopback
ftExecStart

--RUN--

#
# 01. Robots urn:R1, urn:R2: echo, fail (sync), progress, hold (async) - loopback; Lamps urn:L1, urn:L2 (model X1), urn:L3 (X2): setLight (/echo)
# 02. sequential [echo R1, progress R1 (async), echo R2] - 201; completed, its children in order
# 03. sequential [echo R1, fail R1, echo R2] - failed; the third never started: cancelled
# 04. parallel [echo R1, progress R2] - completed
# 05. nested: sequential [echo R1, parallel [echo R2, echo R1]] - completed
# 06. Refused, nothing created: combinationMethod conditional - 501; sometimes - 400; a service R1 does not have - 404
# 07. A template (parallel: setLight on a Lamp, brightness 255; echo on a Robot): POST 201, GET, PATCH its name 204
# 08. From the template: L1 (brightness overridden to 125), R1 - completed; the executor got 125; R1 in the Lamp's place - 404
# 09. DELETE the template - 204; GET it - 404
# 10. grouped, parallel: setLight on every Lamp with model X1 - L1 and L2, not L3
# 11. sequential [hold R1, echo R2] - DELETE it while running: 204, all cancelled; DELETE again: gone, children too
#

reg() {
  corCurl --url /ngsi-ld/v1/serviceRegistrations --payload "{\"type\":\"ServiceRegistration\",\"endpoint\":\"$1\",\"entities\":[{\"type\":\"$2\"}],\"serviceInformation\":{\"serviceName\":\"$3\",\"mode\":\"$4\"}}" | head -1
}
create() {
  corCurl --url /ngsi-ld/v1/services --payload "$1" > /tmp/se.out
  sed -n '1p;/"detail"/p' /tmp/se.out
}
lastId() { grep -i '^Service-Execution:' /tmp/se.out | awk '{print $2}' | tr -d '\r'; }
show() {
  for i in $(seq 1 50); do
    s=$(corCurl --url /ngsi-ld/v1/services/$1 | sed -n '/^{/,$p' | python3 -c "import json,sys; print(json.load(sys.stdin)['executionStatus'])")
    [ "$s" == "$2" ] && break
    sleep 0.1
  done
  corCurl --url /ngsi-ld/v1/services/$1 | sed -n '/^{/,$p' | python3 -c "
import json,sys
def p(e, d):
    print('  ' * d + e['type'], e.get('combinationMethod', e.get('serviceName')), e.get('entityId', ''), e['executionStatus'])
    for c in e.get('serviceExecutions', []):
        p(c, d + 1)
p(json.load(sys.stdin), 0)"
}
count() { corCurl --url /ngsi-ld/v1/services | sed -n '/^\[/,$p' | python3 -c "import json,sys; print(len(json.load(sys.stdin)), 'executions')"; }
se() { echo "{\"type\":\"ServiceExecution\",\"entityId\":\"$1\",\"serviceName\":\"$2\"}"; }

echo "01. Robots urn:R1, urn:R2: echo, fail (sync), progress, hold (async) - loopback; Lamps urn:L1, urn:L2 (model X1), urn:L3 (X2): setLight (/echo)"
echo "=========================================================================================================================================="
for e in R1 R2; do corCurl --url /ngsi-ld/v1/entities --payload "{\"id\":\"urn:$e\",\"type\":\"Robot\"}" | head -1; done
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:L1","type":"Lamp","model":{"type":"Property","value":"X1"}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:L2","type":"Lamp","model":{"type":"Property","value":"X1"}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:L3","type":"Lamp","model":{"type":"Property","value":"X2"}}' | head -1
reg loopback://echo     Robot echo     synchronous
reg loopback://fail     Robot fail     synchronous
reg loopback://progress Robot progress asynchronous
reg loopback://hold     Robot hold     asynchronous
reg "http://localhost:$FT_EXEC_PORT/echo" Lamp setLight synchronous
echo
echo


echo "02. sequential [echo R1, progress R1 (async), echo R2] - 201; completed, its children in order"
echo "==============================================================================================="
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sequential\",\"serviceExecutions\":[$(se urn:R1 echo),$(se urn:R1 progress),$(se urn:R2 echo)]}"
show $(lastId) completed
echo
echo


echo "03. sequential [echo R1, fail R1, echo R2] - failed; the third never started: cancelled"
echo "======================================================================================"
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sequential\",\"serviceExecutions\":[$(se urn:R1 echo),$(se urn:R1 fail),$(se urn:R2 echo)]}"
show $(lastId) failed
echo
echo


echo "04. parallel [echo R1, progress R2] - completed"
echo "==============================================="
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"parallel\",\"serviceExecutions\":[$(se urn:R1 echo),$(se urn:R2 progress)]}"
show $(lastId) completed
echo
echo


echo "05. nested: sequential [echo R1, parallel [echo R2, echo R1]] - completed"
echo "========================================================================="
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sequential\",\"serviceExecutions\":[$(se urn:R1 echo),{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"parallel\",\"serviceExecutions\":[$(se urn:R2 echo),$(se urn:R1 echo)]}]}"
show $(lastId) completed
echo
echo


echo "06. Refused, nothing created: combinationMethod conditional - 501; sometimes - 400; a service R1 does not have - 404"
echo "==================================================================================================================="
count
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"conditional\",\"serviceExecutions\":[$(se urn:R1 echo)]}"
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sometimes\",\"serviceExecutions\":[$(se urn:R1 echo)]}"
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sequential\",\"serviceExecutions\":[$(se urn:R1 echo),$(se urn:R1 dance)]}"
count
echo
echo


echo "07. A template (parallel: setLight on a Lamp, brightness 255; echo on a Robot): POST 201, GET, PATCH its name 204"
echo "================================================================================================================="
corCurl --url /ngsi-ld/v1/combinedServiceTemplate --payload '{"id":"urn:T1","type":"CombinedServiceTemplate","templateName":"lightsOn","combinationMethod":"parallel",
  "services":[{"serviceName":"setLight","entityType":"Lamp","executionInput":{"brightness":255}},{"serviceName":"echo","entityType":"Robot"}]}' | head -1
corCurl --url /ngsi-ld/v1/combinedServiceTemplate/urn:T1 | sed -n '/^{/,$p'
corCurl --url /ngsi-ld/v1/combinedServiceTemplate/urn:T1 -X PATCH --payload '{"templateName":"allOn"}' | head -1
corCurl --url /ngsi-ld/v1/combinedServiceTemplate/urn:T1 | sed -n '/^{/,$p' | python3 -c "import json,sys; print(json.load(sys.stdin)['templateName'])"
echo
echo


echo "08. From the template: L1 (brightness overridden to 125), R1 - completed; the executor got 125; R1 in the Lamp's place - 404"
echo "==========================================================================================================================="
create '{"type":"CombinedServiceExecution","serviceTemplateId":"urn:T1","services":[{"entityId":"urn:L1","executionInput":{"brightness":125}},{"entityId":"urn:R1"}]}'
show $(lastId) completed
ftExecLog | python3 -c "import json,sys; print([r['body'] for r in json.load(sys.stdin)][-1])"
create '{"type":"CombinedServiceExecution","serviceTemplateId":"urn:T1","services":[{"entityId":"urn:R1"},{"entityId":"urn:R2"}]}'
echo
echo


echo "09. DELETE the template - 204; GET it - 404"
echo "==========================================="
corCurl --url /ngsi-ld/v1/combinedServiceTemplate/urn:T1 -X DELETE | head -1
corCurl --url /ngsi-ld/v1/combinedServiceTemplate/urn:T1 | head -1
echo
echo


echo "10. grouped, parallel: setLight on every Lamp with model X1 - L1 and L2, not L3"
echo "==============================================================================="
create '{"type":"GroupedServiceExecution","combinationMethod":"parallel","serviceName":"setLight","entityType":"Lamp","q":"model==\"X1\"","executionInput":{"brightness":7}}'
show $(lastId) completed | sort
echo
echo


echo "11. sequential [hold R1, echo R2] - DELETE it while running: 204, all cancelled; DELETE again: gone, children too"
echo "================================================================================================================"
create "{\"type\":\"CombinedServiceExecution\",\"combinationMethod\":\"sequential\",\"serviceExecutions\":[$(se urn:R1 hold),$(se urn:R2 echo)]}"
C=$(lastId)
show $C executing
corCurl --url /ngsi-ld/v1/services/$C -X DELETE | head -1
show $C cancelled
before=$(corCurl --url /ngsi-ld/v1/services | sed -n '/^\[/,$p' | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")
corCurl --url /ngsi-ld/v1/services/$C -X DELETE | head -1
corCurl --url /ngsi-ld/v1/services/$C | head -1
after=$(corCurl --url /ngsi-ld/v1/services | sed -n '/^\[/,$p' | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")
echo "executions: $((before - after)) fewer (the parent and its two children)"
echo
echo


--EXPECT--
01. Robots urn:R1, urn:R2: echo, fail (sync), progress, hold (async) - loopback; Lamps urn:L1, urn:L2 (model X1), urn:L3 (X2): setLight (/echo)
==========================================================================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. sequential [echo R1, progress R1 (async), echo R2] - 201; completed, its children in order
===============================================================================================
HTTP/1.1 201 Created
CombinedServiceExecution sequential  completed
  ServiceExecution echo urn:R1 completed
  ServiceExecution progress urn:R1 completed
  ServiceExecution echo urn:R2 completed


03. sequential [echo R1, fail R1, echo R2] - failed; the third never started: cancelled
======================================================================================
HTTP/1.1 201 Created
CombinedServiceExecution sequential  failed
  ServiceExecution echo urn:R1 completed
  ServiceExecution fail urn:R1 failed
  ServiceExecution echo urn:R2 cancelled


04. parallel [echo R1, progress R2] - completed
===============================================
HTTP/1.1 201 Created
CombinedServiceExecution parallel  completed
  ServiceExecution echo urn:R1 completed
  ServiceExecution progress urn:R2 completed


05. nested: sequential [echo R1, parallel [echo R2, echo R1]] - completed
=========================================================================
HTTP/1.1 201 Created
CombinedServiceExecution sequential  completed
  ServiceExecution echo urn:R1 completed
  CombinedServiceExecution parallel  completed
    ServiceExecution echo urn:R2 completed
    ServiceExecution echo urn:R1 completed


06. Refused, nothing created: combinationMethod conditional - 501; sometimes - 400; a service R1 does not have - 404
===================================================================================================================
16 executions
HTTP/1.1 501 Not Implemented
  "detail": "combinationMethod 'conditional' is still to be specified (GR CIM-055 § 6.3.5.2)",
HTTP/1.1 400 Bad Request
  "detail": "combinationMethod 'sometimes' - it is sequential or parallel",
HTTP/1.1 404 Not Found
  "detail": "entity 'urn:R1' has no service 'dance'",
16 executions


07. A template (parallel: setLight on a Lamp, brightness 255; echo on a Robot): POST 201, GET, PATCH its name 204
=================================================================================================================
HTTP/1.1 201 Created
{
  "combinationMethod": "parallel",
  "id": "urn:T1",
  "services": [
    {
      "entityType": "Lamp",
      "executionInput": {
        "brightness": 255
      },
      "serviceName": "setLight"
    },
    {
      "entityType": "Robot",
      "serviceName": "echo"
    }
  ],
  "templateName": "lightsOn",
  "type": "CombinedServiceTemplate"
}

HTTP/1.1 204 No Content
allOn


08. From the template: L1 (brightness overridden to 125), R1 - completed; the executor got 125; R1 in the Lamp's place - 404
===========================================================================================================================
HTTP/1.1 201 Created
CombinedServiceExecution parallel  completed
  ServiceExecution setLight urn:L1 completed
  ServiceExecution echo urn:R1 completed
{'id': 'urn:L1', 'type': 'Lamp', 'brightness': 125}
HTTP/1.1 404 Not Found
  "detail": "entity 'urn:R1' has no service 'setLight'",


09. DELETE the template - 204; GET it - 404
===========================================
HTTP/1.1 204 No Content
HTTP/1.1 404 Not Found


10. grouped, parallel: setLight on every Lamp with model X1 - L1 and L2, not L3
===============================================================================
HTTP/1.1 201 Created
  ServiceExecution setLight urn:L1 completed
  ServiceExecution setLight urn:L2 completed
GroupedServiceExecution parallel  completed


11. sequential [hold R1, echo R2] - DELETE it while running: 204, all cancelled; DELETE again: gone, children too
================================================================================================================
HTTP/1.1 201 Created
CombinedServiceExecution sequential  executing
  ServiceExecution hold urn:R1 executing
  ServiceExecution echo urn:R2 pending
HTTP/1.1 204 No Content
CombinedServiceExecution sequential  cancelled
  ServiceExecution hold urn:R1 cancelled
  ServiceExecution echo urn:R2 cancelled
HTTP/1.1 204 No Content
HTTP/1.1 404 Not Found
executions: 3 fewer (the parent and its two children)


--TEARDOWN--
ftExecStop
coraineStop
corDbDrop
