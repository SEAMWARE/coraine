Date: REGEX(.*)
Content-Type: application/json
Content-Length: 251

{
  "detail": "distributed operation loop detected: the data is held by an exclusive/redirect registration that resolves back to this broker",
  "status": 508,
  "title": "Loop Detected",
  "type": "https://uri.etsi.org/ngsi-ld/errors/LoopDetected"
}



