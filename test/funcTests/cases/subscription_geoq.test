#
# FILE            subscription_geoq.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
Subscription with geoQ filter — near point

--INIT--
swDbDrop
ftClientStart
swBrokerStart

--RUN--

#
# 01. Create subscription with geoQ near Madrid (maxDistance 50km)
# 02. Create entity in Madrid (location inside range) — should trigger
# 03. Dump ftClient — 1 notification
# 04. Reset ftClient
# 05. Create entity in Paris (location outside range) — should NOT trigger
# 06. Dump ftClient — empty
#

echo "01. Create subscription with geoQ near Madrid (maxDistance 50000m)"
echo "==================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:GeoNear",
  "type": "Subscription",
  "entities": [{"type": "City"}],
  "geoQ": {
    "geometry": "Point",
    "coordinates": "[-3.703, 40.417]",
    "georel": "near;maxDistance==50000",
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$FT_CLIENT_PORT'/notify"
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity in Madrid — should trigger notification"
echo "==========================================================="
payload='{
  "id": "urn:ngsi-ld:City:Madrid",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.703, 40.417]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Dump ftClient — 1 notification"
echo "===================================="
ftClientDump
echo
echo


echo "04. Reset ftClient"
echo "==================="
ftClientReset
echo "done"
echo
echo


echo "05. Create entity in Paris — should NOT trigger (outside 50km)"
echo "================================================================"
payload='{
  "id": "urn:ngsi-ld:City:Paris",
  "type": "City",
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.349, 48.864]
    }
  }
}'
swCurl -X POST --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "06. Dump ftClient — empty (no notification)"
echo "============================================="
ftClientDump
echo
echo


--EXPECT--
01. Create subscription with geoQ near Madrid (maxDistance 50000m)
===================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:GeoNear
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. Create entity in Madrid — should trigger notification
===========================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:ngsi-ld:City:Madrid
Link: REGEX(.*)
Content-Length: REGEX(\d+)




03. Dump ftClient — 1 notification
====================================
[
  {
    "body": {
      "data": [
        {
          "id": "urn:ngsi-ld:City:Madrid",
          "location": {
            "type": "GeoProperty",
            "value": {
              "coordinates": [
                -3.703,
                40.417
              ],
              "type": "Point"
            }
          },
          "type": "City"
        }
      ],
      "id": REGEX("urn:ngsi-ld:Notification:.*"),
      "notifiedAt": REGEX(".*"),
      "subscriptionId": "urn:ngsi-ld:Subscription:GeoNear",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": REGEX("[0-9]+"),
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": REGEX(".*"),
      "User-Agent": "swBroker"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


04. Reset ftClient
===================
done


05. Create entity in Paris — should NOT trigger (outside 50km)
================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: urn:ngsi-ld:City:Paris
Link: REGEX(.*)
Content-Length: REGEX(\d+)




06. Dump ftClient — empty (no notification)
=============================================
[]

--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
