#
# FILE            set_attr_value_null_invalid.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TS 104-175 § 10.2.6.4 Set Attribute Value — "If the request payload body is
# not a valid JSON document or the payload body contains 'urn:ngsi-ld:null' or
# contains null (excepting for Attribute fragments representing a JsonProperty)
# then an error of type InvalidRequest shall be raised." (NOT BadRequestData —
# they are distinct registered ProblemDetails types, both HTTP 400.) A
# JsonProperty's json value may legitimately be null.
#
--NAME--
Set-Attribute-Value null body raises InvalidRequest, except JsonProperty (§ 10.2.6.4)

--TAGS--
attribute value validation

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Create entity with a Property and a JsonProperty"
echo "===================================================="
corCurl --url /ngsi-ld/v1/entities \
  --payload '{"id":"urn:ngsi-ld:E1","type":"T","temp":{"type":"Property","value":5},"doc":{"type":"JsonProperty","json":{"a":1}}}' | head -1
echo
echo


echo "02. PUT temp/value with JSON null → 400 InvalidRequest"
echo "======================================================"
corCurl -X PUT --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp/value' --payload 'null'
echo
echo


echo "03. PUT temp/value with \"urn:ngsi-ld:null\" → 400 InvalidRequest"
echo "================================================================"
corCurl -X PUT --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp/value' --payload '"urn:ngsi-ld:null"'
echo
echo


echo "04. PUT doc/value with null on a JsonProperty → 204 (allowed)"
echo "============================================================"
corCurl -X PUT --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/doc/value' --payload 'null' | head -1
echo
echo


echo "05. PUT temp/value with a real value → 204 (control)"
echo "===================================================="
corCurl -X PUT --url '/ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/temp/value' --payload '42' | head -1
echo
echo


--EXPECT--
01. Create entity with a Property and a JsonProperty
====================================================
HTTP/1.1 201 Created


02. PUT temp/value with JSON null → 400 InvalidRequest
======================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 188

{
  "detail": "a null value-only body is not allowed for attribute 'temp'",
  "status": 400,
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



03. PUT temp/value with "urn:ngsi-ld:null" → 400 InvalidRequest
================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 188

{
  "detail": "a null value-only body is not allowed for attribute 'temp'",
  "status": 400,
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



04. PUT doc/value with null on a JsonProperty → 204 (allowed)
============================================================
HTTP/1.1 204 No Content


05. PUT temp/value with a real value → 204 (control)
====================================================
HTTP/1.1 204 No Content


--TEARDOWN--
coraineStop
corDbDrop
