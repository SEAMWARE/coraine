#
# FILE            entity_replace.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
PUT /entities/{id} - Replace Entity (§ 5.6.16)

--TAGS--
entity replace

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Create the initial entity (full Vehicle, 3 attrs)
# 02. PUT full replacement — all attrs change; type stays 'Vehicle'
# 03. GET — verify the payload is exactly the replacement (no stale attrs left)
# 04. PUT without id in body — 400 (spec § 5.5.12: id and type mandatory)
# 05. PUT with body id that doesn't match the URL — 400
# 06. PUT with a different type — 400 (type shall not change)
# 07. PUT on a non-existent entity — 404
# 08. PUT with no payload — 400
# 09. PUT with missing type in body — 400
# 10. PUT with unsupported Content-Type (text/plain) — 415
#

echo "01. Create initial entity"
echo "========================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": { "type": "Property", "value": 100 },
  "color": { "type": "Property", "value": "blue" },
  "accuracy": { "type": "Property", "value": 0.9 }
}'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. PUT full replacement — different attrs, same type"
echo "====================================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "brand": { "type": "Property", "value": "Honda" },
  "fuelLevel": { "type": "Property", "value": 75 }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "03. GET — verify old attrs are gone, new ones in place"
echo "======================================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
echo
echo


echo "04. PUT without id in body — 400"
echo "================================"
payload='{
  "type": "Vehicle",
  "model": { "type": "Property", "value": "Civic" }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "05. PUT with mismatched body id — 400"
echo "====================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:OTHER",
  "type": "Vehicle",
  "speed": { "type": "Property", "value": 1 }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "06. PUT with different type — 400"
echo "================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Motorcycle",
  "speed": { "type": "Property", "value": 1 }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "07. PUT non-existent entity — 404"
echo "================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:DOES_NOT_EXIST",
  "type": "Vehicle",
  "speed": { "type": "Property", "value": 1 }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:DOES_NOT_EXIST --payload "$payload"
echo
echo


echo "08. PUT without payload — 400"
echo "============================="
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
echo
echo


echo "09. PUT with missing type in body — 400"
echo "======================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "brand": { "type": "Property", "value": "Honda" }
}'
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 --payload "$payload"
echo
echo


echo "10. PUT with unsupported Content-Type — 415"
echo "==========================================="
corCurl -X PUT --url /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1 \
       --in text --payload "not json"
echo
echo


--EXPECT--
01. Create initial entity
=========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: 0




02. PUT full replacement — different attrs, same type
=====================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET — verify old attrs are gone, new ones in place
======================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 183

{
  "brand": {
    "type": "Property",
    "value": "Honda"
  },
  "fuelLevel": {
    "type": "Property",
    "value": 75
  },
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle"
}



04. PUT without id in body — 400
================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 174

{
  "detail": "Entity 'id' is mandatory for ReplaceEntity",
  "status": 400,
  "title": "Missing Entity Id",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. PUT with mismatched body id — 400
=====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 229

{
  "detail": "entity id in payload ('urn:ngsi-ld:Vehicle:OTHER') does not match URL ('urn:ngsi-ld:Vehicle:V1')",
  "status": 400,
  "title": "Entity Id Mismatch",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. PUT with different type — 400
=================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 170

{
  "detail": "entity type cannot be changed on Replace",
  "status": 400,
  "title": "Immutable Field",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. PUT non-existent entity — 404
=================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 179

{
  "detail": "entity 'urn:ngsi-ld:Vehicle:DOES_NOT_EXIST' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



08. PUT without payload — 400
=============================
HTTP/1.1 411 Length Required
Date: REGEX(.*)
Content-Length: 0




09. PUT with missing type in body — 400
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 178

{
  "detail": "Entity 'type' is mandatory for ReplaceEntity",
  "status": 400,
  "title": "Missing Entity Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



10. PUT with unsupported Content-Type — 415
===========================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




--TEARDOWN--
coraineStop
corDbDrop
