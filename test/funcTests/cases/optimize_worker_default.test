#
# FILE            optimize_worker_default.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The worker pool's default is the same in both builds of COR_OPTIMIZE: with mongoc - a store that waits - 32
# workers. A size build changes the malloc arena only (doc/building-details.md#cor_optimize). Each worker has
# an HTTP thread beside it with libmicrohttpd, named MHD-worker, which is what is counted. The build's choice
# is read from `coraine --version` and printed, so a run says which build it tested (the nightly's valgrind
# matrix has both).
#
#   - no --connectionPoolSize: 32, whatever the build and the number of CPUs
#   - --connectionPoolSize 3: 3, whatever the build
#
# REQUIRE_DB: mongoc
# REQUIRE_HTTPSERVER: mhd
#
--NAME--
COR_OPTIMIZE: the worker pool's default with mongoc - 32 in both builds

--TAGS--
broker memory

--INIT--
corDbDrop
coraineStart

--RUN--

#
# workers - the broker's MHD-worker threads, against the number given
#
workers() {
  local pid=$(cat /tmp/coraine_CB.pid)
  local n=$(cat /proc/$pid/task/*/comm 2>/dev/null | grep -cx "MHD-worker")
  if [ "$n" = "$1" ]; then echo "workers: $2"; else echo "workers: $n, not $1 ($2)"; fi
}

echo "01. No --connectionPoolSize: 32 with mongoc, whatever the build"
echo "================================================================"
OPTIMIZE=$(coraine --version | sed -n 's/^optimize: //p')
case "$OPTIMIZE" in
  speed|size) echo "optimize: speed or size" ;;
  *)          echo "optimize: '$OPTIMIZE' - neither speed nor size" ;;
esac
workers 32 "32"
echo
echo


echo "02. --connectionPoolSize 3: three, whatever the build"
echo "====================================================="
coraineStop
coraineStart --connectionPoolSize 3
workers 3 "as given"
echo
echo


--EXPECT--
01. No --connectionPoolSize: 32 with mongoc, whatever the build
================================================================
optimize: speed or size
workers: 32


02. --connectionPoolSize 3: three, whatever the build
=====================================================
workers: as given


--TEARDOWN--
coraineStop
corDbDrop
