#
# FILE            optimize_worker_default.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# The worker pool's default follows COR_OPTIMIZE. With mongoc - a store that waits - a speed build runs 32
# workers, a size build one per CPU. Each worker has an HTTP thread beside it with libmicrohttpd, named
# MHD-worker, which is what is counted. The build's choice is read from `coraine --version`, so the test
# runs on either build (the nightly's valgrind matrix has both). One per CPU is nproc: the CPUs the process
# may run on, as the broker's corCpuCount when no cgroup quota is lower.
#
#   - no --connectionPoolSize: the build's default number of workers
#   - --connectionPoolSize 3: 3, whatever the build
#
# REQUIRE_DB: mongoc
# REQUIRE_HTTPSERVER: mhd
#
--NAME--
COR_OPTIMIZE: the worker pool's default - 32 for speed with mongoc, one per CPU for size

--TAGS--
broker memory

--INIT--
corDbDrop
coraineStart

--RUN--

#
# workers - the broker's MHD-worker threads, against the number given
#
workers() {
  local pid=$(cat /tmp/coraine_CB.pid)
  local n=$(cat /proc/$pid/task/*/comm 2>/dev/null | grep -cx "MHD-worker")
  if [ "$n" = "$1" ]; then echo "workers: $2"; else echo "workers: $n, not $1 ($2)"; fi
}

echo "01. No --connectionPoolSize: the build's default"
echo "================================================"
OPTIMIZE=$(coraine --version | sed -n 's/^optimize: //p')
case "$OPTIMIZE" in
  speed) workers 32       "the default of its build" ;;
  size)  workers $(nproc) "the default of its build" ;;
  *)     echo "optimize: '$OPTIMIZE' - neither speed nor size" ;;
esac
echo
echo


echo "02. --connectionPoolSize 3: three, whatever the build"
echo "====================================================="
coraineStop
coraineStart --connectionPoolSize 3
workers 3 "as given"
echo
echo


--EXPECT--
01. No --connectionPoolSize: the build's default
================================================
workers: the default of its build


02. --connectionPoolSize 3: three, whatever the build
=====================================================
workers: as given


--TEARDOWN--
coraineStop
corDbDrop
