#
# FILE            query_q_datetime_timezone.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.9 — a DateTime in a q filter (and in a stored observedAt) carries a
# timezone designator: 'Z' (UTC) or a '+hh:mm' / '-hh:mm' offset. The ISO 8601 →
# epoch-nanoseconds conversion must apply that offset (UTC = local - offset), on
# BOTH sides:
#   - storage: observedAt "12:00:00+02:00" and "07:00:00-03:00" are the same
#     instant as "10:00:00Z" and must compare equal.
#   - q operand: "...T18:00:00+05:00" is 13:00Z; "...T08:00:00-03:00" is 11:00Z.
# Regression: the converter used to stop at the seconds and treat the wall-clock
# as UTC, dropping the offset entirely.
#
--NAME--
Query q over observedAt — timezone offset applied on both the stored value and the q operand

--TAGS--
query q datetime timezone

--INIT--
corDbDrop
coraineStart

--RUN--

# A, B, C are the SAME instant (10:00:00Z) written three ways; D is later (20:00Z)
echo "01. Create A=10:00Z, B=12:00+02:00, C=07:00-03:00 (all 10:00Z), D=20:00Z"
echo "========================================================================"
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E:A","type":"Ev","e":{"type":"Property","value":1,"observedAt":"2025-06-01T10:00:00Z"}}' | grep HTTP
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E:B","type":"Ev","e":{"type":"Property","value":1,"observedAt":"2025-06-01T12:00:00+02:00"}}' | grep HTTP
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E:C","type":"Ev","e":{"type":"Property","value":1,"observedAt":"2025-06-01T07:00:00-03:00"}}' | grep HTTP
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E:D","type":"Ev","e":{"type":"Property","value":1,"observedAt":"2025-06-01T20:00:00Z"}}' | grep HTTP
echo
echo


echo "02. q=e.observedAt==2025-06-01T10:00:00Z — A,B,C (offset-stored = same instant)"
echo "=============================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Ev&q=e.observedAt==2025-06-01T10:00:00Z' | grep -oE 'urn:ngsi-ld:E:[A-D]' | sort
echo
echo


echo "03. q=e.observedAt>2025-06-01T18:00:00+05:00 (=13:00Z) — only D (20:00Z)"
echo "======================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Ev&q=e.observedAt%3E2025-06-01T18:00:00%2B05:00' | grep -oE 'urn:ngsi-ld:E:[A-D]' | sort
echo
echo


echo "04. q=e.observedAt<2025-06-01T08:00:00-03:00 (=11:00Z) — A,B,C (10:00Z), not D"
echo "============================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Ev&q=e.observedAt%3C2025-06-01T08:00:00-03:00' | grep -oE 'urn:ngsi-ld:E:[A-D]' | sort
echo
echo


echo "05. q=e.observedAt>=2025-06-01T13:00:00+03:00 (=10:00Z) — A,B,C,D (all >=10:00Z)"
echo "==============================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=Ev&q=e.observedAt%3E%3D2025-06-01T13:00:00%2B03:00' | grep -oE 'urn:ngsi-ld:E:[A-D]' | sort
echo
echo


--EXPECT--
01. Create A=10:00Z, B=12:00+02:00, C=07:00-03:00 (all 10:00Z), D=20:00Z
========================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. q=e.observedAt==2025-06-01T10:00:00Z — A,B,C (offset-stored = same instant)
==============================================================================
urn:ngsi-ld:E:A
urn:ngsi-ld:E:B
urn:ngsi-ld:E:C


03. q=e.observedAt>2025-06-01T18:00:00+05:00 (=13:00Z) — only D (20:00Z)
=======================================================================
urn:ngsi-ld:E:D


04. q=e.observedAt<2025-06-01T08:00:00-03:00 (=11:00Z) — A,B,C (10:00Z), not D
=============================================================================
urn:ngsi-ld:E:A
urn:ngsi-ld:E:B
urn:ngsi-ld:E:C


05. q=e.observedAt>=2025-06-01T13:00:00+03:00 (=10:00Z) — A,B,C,D (all >=10:00Z)
===============================================================================
urn:ngsi-ld:E:A
urn:ngsi-ld:E:B
urn:ngsi-ld:E:C
urn:ngsi-ld:E:D


--TEARDOWN--
coraineStop
