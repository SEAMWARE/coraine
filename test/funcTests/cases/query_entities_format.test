#
# FILE            query_entities_format.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
GET /ngsi-ld/v1/entities - format parameter (normalized, concise, simplified, keyValues)

--TAGS--
entity format query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Create entity E1 with speed and color
# 02. GET entities with no format (default normalized)
# 03. GET entities with format=normalized
# 04. GET entities with format=concise
# 05. GET entities with format=simplified
# 06. GET entities with format=keyValues (synonym for simplified)
#

echo "01. Create entity E1 with speed and color"
echo "========================================="
payload='{
  "id": "urn:e1",
  "type": "Vehicle",
  "speed": {
    "type": "Property",
    "value": 100
  },
  "color": {
    "type": "Property",
    "value": "red"
  }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET entities with no format (default normalized)"
echo "===================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle'
echo
echo


echo "03. GET entities with format=normalized"
echo "======================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&format=normalized'
echo
echo


echo "04. GET entities with format=concise"
echo "===================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&format=concise'
echo
echo


echo "05. GET entities with format=simplified"
echo "======================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&format=simplified'
echo
echo


echo "06. GET entities with format=keyValues (synonym for simplified)"
echo "==============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=Vehicle&format=keyValues'
echo
echo


--EXPECT--
01. Create entity E1 with speed and color
=========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/entities/urn:e1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




02. GET entities with no format (default normalized)
====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



03. GET entities with format=normalized
=======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "type": "Property",
      "value": "red"
    },
    "id": "urn:e1",
    "speed": {
      "type": "Property",
      "value": 100
    },
    "type": "Vehicle"
  }
]



04. GET entities with format=concise
====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": {
      "value": "red"
    },
    "id": "urn:e1",
    "speed": {
      "value": 100
    },
    "type": "Vehicle"
  }
]



05. GET entities with format=simplified
=======================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": "red",
    "id": "urn:e1",
    "speed": 100,
    "type": "Vehicle"
  }
]



06. GET entities with format=keyValues (synonym for simplified)
===============================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "color": "red",
    "id": "urn:e1",
    "speed": 100,
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
