--NAME--
Subscription creation and patch error handling

--TAGS--
error subscription

--INIT--
corDbDrop
coraineStart

--RUN--

#
# 01. Missing type — 400
# 02. Wrong type value — 400
# 03. Missing entities and watchedAttributes — 400
# 04. Missing notification — 400
# 05. Empty entities array — 400
# 06. entities item without type/id/idPattern — 400
# 07. entities[].type not a string — 400
# 08. watchedAttributes not an array — 400
# 09. watchedAttributes items not strings — 400
# 10. timeInterval + watchedAttributes conflict — 400
# 11. throttling not a number — 400
# 12. isActive not a boolean — 400
# 13. notification.endpoint.uri missing — 400
# 14. notification empty object — 400
# 15. expiresAt not valid ISO 8601 — 400
# 16. q not a string — 400
# 17. geoQ missing geometry — 400
# 18. geoQ invalid geometry value — 400
# 19. Duplicate entities field — 400
# 20. status is read-only — 400
# 21. PATCH with id — 400
# 22. PATCH with type — 400
# 23. Valid creation — 201 (sanity check)
# 24. q syntactically invalid (unbalanced paren) — 400
# 25. csourceSubscription with syntactically invalid q — 400
# 26. bare attribute path is a VALID q (existence predicate, § 4.9) — 201
#

echo "01. Missing type — 400"
echo "======================="
payload='{
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Wrong type value — 400"
echo "==========================="
payload='{
  "type": "Entity",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "03. Missing entities and watchedAttributes — 400"
echo "=================================================="
payload='{
  "type": "Subscription",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "04. Missing notification — 400"
echo "================================"
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}]
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "05. Empty entities array — 400"
echo "================================"
payload='{
  "type": "Subscription",
  "entities": [],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "06. entities item without type/id/idPattern — 400"
echo "==================================================="
payload='{
  "type": "Subscription",
  "entities": [{}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "07. entities[].type not a string — 400"
echo "========================================"
payload='{
  "type": "Subscription",
  "entities": [{"type": 123}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "08. watchedAttributes not an array — 400"
echo "=========================================="
payload='{
  "type": "Subscription",
  "watchedAttributes": "speed",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "09. watchedAttributes items not strings — 400"
echo "==============================================="
payload='{
  "type": "Subscription",
  "watchedAttributes": [123, true],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "10. timeInterval + watchedAttributes conflict — 400"
echo "====================================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "watchedAttributes": ["speed"],
  "timeInterval": 60,
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "11. throttling not a number — 400"
echo "==================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "throttling": "fast",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "12. isActive not a boolean — 400"
echo "=================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "isActive": "yes",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "13. notification.endpoint.uri missing — 400"
echo "============================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "14. notification empty object — 400"
echo "====================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "15. expiresAt not valid ISO 8601 — 400"
echo "========================================"
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "expiresAt": "tomorrow",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "16. q not a string — 400"
echo "=========================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "q": 42,
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "17. geoQ missing geometry — 400"
echo "================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "geoQ": {"coordinates": "[-3.7, 40.4]", "georel": "near;maxDistance==1000"},
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "18. geoQ invalid geometry value — 400"
echo "======================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "geoQ": {"geometry": "Hexagon", "coordinates": "[-3.7, 40.4]", "georel": "near;maxDistance==1000"},
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "19. Duplicate entities field — 400"
echo "===================================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "entities": [{"type": "Bike"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "20. status is read-only — 400"
echo "==============================="
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "status": "active",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "21. PATCH with id — 400"
echo "========================="
payload='{
  "id": "urn:ngsi-ld:Subscription:Err",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
payload='{
  "id": "urn:ngsi-ld:Subscription:Other"
}'
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Err --payload "$payload"
echo
echo


echo "22. PATCH with type — 400"
echo "==========================="
payload='{
  "type": "Subscription"
}'
corCurl -X PATCH --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:Err --payload "$payload"
echo
echo


echo "23. Valid creation — 201 (sanity check)"
echo "========================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:OK",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "24. q syntactically invalid (unbalanced paren) — 400"
echo "======================================================"
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "q": "(invalidQuery",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "25. csourceSubscription with syntactically invalid q — 400"
echo "============================================================"
payload='{
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "q": "(invalidQuery",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/csourceSubscriptions --payload "$payload"
echo
echo


echo "26. bare attribute path is a VALID q (existence predicate, § 4.9) — 201"
echo "=========================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:bareQ",
  "type": "Subscription",
  "entities": [{"type": "Vehicle"}],
  "q": "someAttr",
  "notification": {"endpoint": {"uri": "http://localhost:1234/notify"}}
}'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


--EXPECT--
01. Missing type — 400
=======================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 170

{
  "detail": "Subscription 'type' is mandatory for create",
  "status": 400,
  "title": "Missing Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. Wrong type value — 400
===========================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 169

{
  "detail": "Subscription 'type' must be 'Subscription'",
  "status": 400,
  "title": "Invalid Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. Missing entities and watchedAttributes — 400
==================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 185

{
  "detail": "Subscription must have 'entities' or 'watchedAttributes'",
  "status": 400,
  "title": "Missing Filter",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. Missing notification — 400
================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 164

{
  "detail": "Subscription::notification",
  "status": 400,
  "title": "Mandatory field missing",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. Empty entities array — 400
================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 171

{
  "detail": "an empty array is not valid NGSI-LD input",
  "status": 400,
  "title": "Empty Structure",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. entities item without type/id/idPattern — 400
===================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 172

{
  "detail": "an empty object is not valid NGSI-LD input",
  "status": 400,
  "title": "Empty Structure",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. entities[].type not a string — 400
========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 169

{
  "detail": "'entities[].type' must be a string",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



08. watchedAttributes not an array — 400
==========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 171

{
  "detail": "'watchedAttributes' must be an array",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



09. watchedAttributes items not strings — 400
===============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 176

{
  "detail": "'watchedAttributes' items must be strings",
  "status": 400,
  "title": "Invalid Subscription",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



10. timeInterval + watchedAttributes conflict — 400
=====================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 195

{
  "detail": "'timeInterval' and 'watchedAttributes' are mutually exclusive",
  "status": 400,
  "title": "Incompatible Fields",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



