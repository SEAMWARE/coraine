#
# FILE            bridge_service_sync_default.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --ddsSync - waiting for the service as the broker's DEFAULT, on the loopback
# bridge.
#
# ddsSync is off by default: a PATCH that writes a service attribute answers on
# its NGSI-LD merits and the reply lands later. --ddsSync turns that round for a
# deployment that wants every such PATCH to wait, with ?ddsSync=false left to
# opt a request out. bridge_service_sync has the behaviour itself; this pins
# only which way the default points:
#
#   01-02  no parameter now waits: a service that never answers is waited for
#          until --ddsSyncTimeout, and then accepted (202), the value written
#   03-04  ?ddsSync=false opts out: 202 at once, and the value is written
#

--NAME--
ddsSync: --ddsSync makes waiting the default, ?ddsSync=false opts out

--TAGS--
bridge service ddsSync

--INIT--
corDbDrop

BRIDGE_CONFIG=$(bridgeConfig \
  --replyDelay "mute=-1" \
  --service "mute,Calculator,urn:ngsi-ld:Calculator:M,job")

coraineStart --bridges loopback --bridgeConfig $BRIDGE_CONFIG --ddsSync --ddsSyncTimeout 800

--RUN--

echo "01. PATCH without ?ddsSync, on a service that never answers - it waits, then 202"
echo "================================================================================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:M/attrs/job -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 1 } }'
echo
echo


echo "02. The value is written"
echo "========================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:M
echo
echo


echo "03. PATCH ?ddsSync=false - 202 at once"
echo "======================================"
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:M/attrs/job?ddsSync=false" -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 2 } }'
echo
echo


echo "04. The value is written"
echo "========================"
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:M
echo
echo


--TEARDOWN--
coraineStop


--EXPECT--
01. PATCH without ?ddsSync, on a service that never answers - it waits, then 202
================================================================================
HTTP/1.1 202 Accepted
Date: REGEX(.*)
Content-Length: 0




02. The value is written
========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 137

{
  "id": "urn:ngsi-ld:Calculator:M",
  "job": {
    "type": "Property",
    "value": {
      "a": 1
    }
  },
  "type": "Calculator"
}



03. PATCH ?ddsSync=false - 202 at once
======================================
HTTP/1.1 202 Accepted
Date: REGEX(.*)
Content-Length: 0




04. The value is written
========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 137

{
  "id": "urn:ngsi-ld:Calculator:M",
  "job": {
    "type": "Property",
    "value": {
      "a": 2
    }
  },
  "type": "Calculator"
}



