#
# FILE            notify_no_fd_leak_unresponsive_endpoint.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Many notifications sent to an endpoint that accepts the connection but never
# responds is a historical file-descriptor-leak case. Coraine must close each
# notification socket after the notification
# timeout, so the open-fd count returns to its baseline. The receiver (ftClient
# --delay) holds every connection well past the broker's distOpTimeout, so each
# of the 30 notifications is a hung connection the broker must reclaim.
#
# "Next File Descriptor" (from /admin/version) is volatile, so the test computes
# the delta in the shell and asserts only that there is no leak.
#
# A leak grows with every round; what the broker creates once does not. So a first round of 30
# notifications warms the broker up, and the baseline is taken after it: the worker threads the hung
# notifications made it start (each with its loop's eventfd and two epoll fds - 32 workers, 96 fds) and
# the client pool's kept connections are there by then. The second round must leave the count where the
# first left it. (Measured before the first round, a broker that grew its worker pool during the round -
# valgrind's slowness holds the workers longer - looked like a leak of 60-77 fds: no socket among them.)
#
# REQUIRE_FEATURE: SUBSCRIPTIONS
#
--NAME--
Notifications to an unresponsive endpoint do not leak file descriptors

--TAGS--
subscription notification admin

--INIT--
corDbDrop
ftClientStart --delay 2000
coraineStart --apiPlugins admin --distOpTimeout 1000

--RUN--

#
# 01. An entity and a subscription to the unresponsive endpoint
# 02. Round 1: 30 PATCHes -> 30 hung notifications; the open-fd count, once it holds still, is the baseline
# 03. Round 2: the same - the count must come back to within 10 of that baseline (no leak)
#

fdNow() { corCurl --url /admin/version | grep -oE '"Next File Descriptor": [0-9]+' | grep -oE '[0-9]+'; }

corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E1","type":"T","a":{"type":"Property","value":0}}' > /dev/null
corCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:S1","type":"Subscription","entities":[{"type":"T"}],"notification":{"endpoint":{"uri":"http://localhost:'"$FT_CLIENT_PORT"'/noresponse"}}}' > /dev/null

#
# patch30 <n> - 30 PATCHes, 30 hung notifications
#
patch30() {
  local i=1
  while [ $i -le 30 ]; do
    corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/a -X PATCH --payload '{"type":"Property","value":'$(( $1 * 100 + i ))'}' > /dev/null
    i=$((i+1))
  done
}

#
# Round 1, the warm-up: the baseline is the count once it holds still - three equal readings, 2 s apart
# (up to 60 s)
#
patch30 1
seen=""
prev=-1
same=0
for i in $(seq 1 30); do
  sleep 2
  fd1=$(fdNow)
  seen="$seen $fd1"
  if [ "$fd1" == "$prev" ]; then same=$((same+1)); else same=0; fi
  [ $same -ge 2 ] && break
  prev=$fd1
done

#
# Round 2: back within 10 of the baseline - polled, up to 60 s: a leak never comes back down, a slow
# broker does
#
patch30 2
seen="$seen |"
for i in $(seq 1 60); do
  sleep 1
  fd2=$(fdNow)
  seen="$seen $fd2"
  [ $((fd2 - fd1)) -lt 10 ] && break
done

echo "01. No file-descriptor leak after 30 unresponsive notifications"
echo "=============================================================="
delta=$((fd2 - fd1))
if [ "$delta" -lt 10 ]; then
  echo "fd leak: no"
else
  echo "fd leak: YES (delta=$delta; counts:$seen)"
fi
echo
echo


echo "02. Broker healthy"
echo "=================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1 | grep "^HTTP/"
echo
echo


--EXPECT--
01. No file-descriptor leak after 30 unresponsive notifications
==============================================================
fd leak: no


02. Broker healthy
==================
HTTP/1.1 200 OK


--TEARDOWN--
coraineStop
ftClientStop
corDbDrop
