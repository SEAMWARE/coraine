#
# FILE            http_415_406_media_type.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# REQUIRE_FEATURE: REGISTRATIONS SUBSCRIPTIONS
#
--NAME--
HTTP media-type negotiation — unsupported Content-Type and unacceptable Accept

--TAGS--
error http format

--INIT--
corDbDrop
coraineStart -dist

--RUN--

#
# 01. POST /entities with Content-Type text/plain -> 415 Unsupported Media Type
# 02. GET /entities with Accept text/plain -> 406 Not Acceptable
#

echo "01. Create with Content-Type text/plain"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities -X POST --payload 'Just a text' -H 'Content-Type: text/plain'
echo
echo


echo "02. GET entities with Accept text/plain"
echo "======================================="
corCurl --url /ngsi-ld/v1/entities --urlParams 'prettyPrint=yes&spaces=2' -H 'Accept: text/plain'
echo
echo


echo "03. Seed an entity to PATCH"
echo "==========================="
payload='{ "id": "urn:ngsi-ld:T:E1", "type": "T", "P1": { "type": "Property", "value": 1 } }'
corCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. PATCH with Content-Type application/merge-patch+json -> accepted (RFC 7396)"
echo "==============================================================================="
payload='{ "P1": "urn:ngsi-ld:null", "P2": { "type": "Property", "value": 2 } }'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "05. GET — P1 deleted, P2 added (the merge-patch was applied)"
echo "==========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 --out application/json
echo
echo


echo "06. POST /entities with Content-Type application/merge-patch+json -> 415 (PATCH-only media type)"
echo "==============================================================================================="
payload='{ "id": "urn:ngsi-ld:T:E2", "type": "T" }'
corCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "07. PATCH with Content-Type text/plain -> 415"
echo "============================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload 'Just a text' -H 'Content-Type: text/plain'
echo
echo


# TS 104-176 § 6.2.2: application/merge-patch+json is allowed only for HTTP PATCH
# requests. Batch Merge performs the same RFC 7396 merge but is bound to POST, so
# the merge-patch media type is NOT allowed on it -> 415 (carry the merge body as
# application/json instead). [Spec doubt raised: the batch form of a merge cannot
# use the merge-patch media type because the binding is POST, not PATCH.]
echo "08. Batch Merge (POST /entityOperations/merge) with application/merge-patch+json -> 415 (PATCH-only media type)"
echo "=============================================================================================================="
payload='[ { "id": "urn:ngsi-ld:T:E1", "type": "T", "P2": { "type": "Property", "value": 3 } } ]'
corCurl --url /ngsi-ld/v1/entityOperations/merge -X POST --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


# § 6.2.2 allows application/merge-patch+json on ANY PATCH (treated as
# application/json), not only the entity-merge route — so a non-merge PATCH
# (Update Attributes, Update Registration) accepts it too.
echo "09. Update Attributes (PATCH /entities/{id}/attrs) with application/merge-patch+json -> 204"
echo "=========================================================================================="
payload='{ "P3": { "type": "Property", "value": 9 } }'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1/attrs -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "10. Seed a registration to PATCH"
echo "================================"
payload='{ "id": "urn:ngsi-ld:csr:R1", "type": "ContextSourceRegistration", "information": [ { "entities": [ { "type": "T" } ] } ], "endpoint": "http://localhost:9000" }'
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload" | grep HTTP
echo
echo


echo "11. Update Registration (PATCH /csourceRegistrations/{id}) with application/merge-patch+json -> 204"
echo "=================================================================================================="
payload='{ "description": "patched via merge-patch media type" }'
corCurl --url /ngsi-ld/v1/csourceRegistrations/urn:ngsi-ld:csr:R1 -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "12. Partial Attribute Update (PATCH /entities/{id}/attrs/{attrId}) with application/merge-patch+json -> 204"
echo "========================================================================================================="
payload='{ "value": 7 }'
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1/attrs/P2 -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "13. Seed a subscription to PATCH"
echo "================================"
payload='{ "id": "urn:ngsi-ld:Subscription:S1", "type": "Subscription", "entities": [ { "type": "T" } ], "notification": { "endpoint": { "uri": "http://localhost:9999/n" } } }'
corCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" | grep HTTP
echo
echo


echo "14. Update Subscription (PATCH /subscriptions/{id}) with application/merge-patch+json -> 204"
echo "==========================================================================================="
payload='{ "description": "patched via merge-patch media type" }'
corCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1 -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


# § 6.2.2 — an unacceptable Accept yields 406 AND the body lists the available
# representations. The 406 must NOT leak the requested resource: a Retrieve
# Entity with Accept: application/xml answers a ProblemDetails (whose detail
# enumerates the supported media types), never the entity. As a § 6.2.2 request
# precondition the 406 is raised BEFORE the retrieve runs, so even though this
# entity's type is covered by a (never-listening) registration, no forward is
# made and no § 6.3.5 NGSILD-Warning is emitted.
echo "15. GET /entities/{id} with an unacceptable Accept (application/xml) -> 406 + representation list"
echo "==============================================================================================="
corCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -H 'Accept: application/xml'
echo
echo


--EXPECT--
01. Create with Content-Type text/plain
=======================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




02. GET entities with Accept text/plain
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 176

{
  "detail": "Unknown/unsupported URL parameter: prettyPrint",
  "status": 400,
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



03. Seed an entity to PATCH
===========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1
Content-Length: 0




04. PATCH with Content-Type application/merge-patch+json -> accepted (RFC 7396)
===============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET — P1 deleted, P2 added (the merge-patch was applied)
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "P2": {
    "type": "Property",
    "value": 2
  },
  "id": "urn:ngsi-ld:T:E1",
  "type": "T"
}



06. POST /entities with Content-Type application/merge-patch+json -> 415 (PATCH-only media type)
===============================================================================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




07. PATCH with Content-Type text/plain -> 415
=============================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




08. Batch Merge (POST /entityOperations/merge) with application/merge-patch+json -> 415 (PATCH-only media type)
==============================================================================================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




09. Update Attributes (PATCH /entities/{id}/attrs) with application/merge-patch+json -> 204
==========================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




10. Seed a registration to PATCH
================================
HTTP/1.1 201 Created


11. Update Registration (PATCH /csourceRegistrations/{id}) with application/merge-patch+json -> 204
==================================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




12. Partial Attribute Update (PATCH /entities/{id}/attrs/{attrId}) with application/merge-patch+json -> 204
=========================================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




13. Seed a subscription to PATCH
================================
HTTP/1.1 201 Created


14. Update Subscription (PATCH /subscriptions/{id}) with application/merge-patch+json -> 204
===========================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




15. GET /entities/{id} with an unacceptable Accept (application/xml) -> 406 + representation list
===============================================================================================
HTTP/1.1 406 Not Acceptable
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 220

{
  "detail": "supported response media types: application/json, application/ld+json, application/geo+json",
  "status": 406,
  "title": "Not Acceptable",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



--TEARDOWN--
coraineStop
