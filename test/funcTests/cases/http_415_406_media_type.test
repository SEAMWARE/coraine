#
# FILE            http_415_406_media_type.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
--NAME--
HTTP media-type negotiation — unsupported Content-Type and unacceptable Accept

--TAGS--
error http format

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. POST /entities with Content-Type text/plain -> 415 Unsupported Media Type
# 02. GET /entities with Accept text/plain -> 406 Not Acceptable
#

echo "01. Create with Content-Type text/plain"
echo "======================================="
swCurl --url /ngsi-ld/v1/entities -X POST --payload 'Just a text' -H 'Content-Type: text/plain'
echo
echo


echo "02. GET entities with Accept text/plain"
echo "======================================="
swCurl --url /ngsi-ld/v1/entities --urlParams 'prettyPrint=yes&spaces=2' -H 'Accept: text/plain'
echo
echo


echo "03. Seed an entity to PATCH"
echo "==========================="
payload='{ "id": "urn:ngsi-ld:T:E1", "type": "T", "P1": { "type": "Property", "value": 1 } }'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. PATCH with Content-Type application/merge-patch+json -> accepted (RFC 7396)"
echo "==============================================================================="
payload='{ "P1": "urn:ngsi-ld:null", "P2": { "type": "Property", "value": 2 } }'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "05. GET — P1 deleted, P2 added (the merge-patch was applied)"
echo "==========================================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 --out application/json
echo
echo


echo "06. POST /entities with Content-Type application/merge-patch+json -> 415 (PATCH-only media type)"
echo "==============================================================================================="
payload='{ "id": "urn:ngsi-ld:T:E2", "type": "T" }'
swCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


echo "07. PATCH with Content-Type text/plain -> 415"
echo "============================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload 'Just a text' -H 'Content-Type: text/plain'
echo
echo


# TS 104-176 § 6.2.2: application/merge-patch+json is allowed only for HTTP PATCH
# requests. Batch Merge performs the same RFC 7396 merge but is bound to POST, so
# the merge-patch media type is NOT allowed on it -> 415 (carry the merge body as
# application/json instead). [Spec doubt raised: the batch form of a merge cannot
# use the merge-patch media type because the binding is POST, not PATCH.]
echo "08. Batch Merge (POST /entityOperations/merge) with application/merge-patch+json -> 415 (PATCH-only media type)"
echo "=============================================================================================================="
payload='[ { "id": "urn:ngsi-ld:T:E1", "type": "T", "P2": { "type": "Property", "value": 3 } } ]'
swCurl --url /ngsi-ld/v1/entityOperations/merge -X POST --payload "$payload" -H 'Content-Type: application/merge-patch+json'
echo
echo


--EXPECT--
01. Create with Content-Type text/plain
=======================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




02. GET entities with Accept text/plain
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 176

{
  "detail": "Unknown/unsupported URL parameter: prettyPrint",
  "status": 400,
  "title": "Invalid Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/InvalidRequest"
}



03. Seed an entity to PATCH
===========================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1
Content-Length: 0




04. PATCH with Content-Type application/merge-patch+json -> accepted (RFC 7396)
===============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET — P1 deleted, P2 added (the merge-patch was applied)
===========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "P2": {
    "type": "Property",
    "value": 2
  },
  "id": "urn:ngsi-ld:T:E1",
  "type": "T"
}



06. POST /entities with Content-Type application/merge-patch+json -> 415 (PATCH-only media type)
===============================================================================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




07. PATCH with Content-Type text/plain -> 415
=============================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




08. Batch Merge (POST /entityOperations/merge) with application/merge-patch+json -> 415 (PATCH-only media type)
==============================================================================================================
HTTP/1.1 415 Unsupported Media Type
Date: REGEX(.*)
Content-Length: 0




--TEARDOWN--
swBrokerStop
