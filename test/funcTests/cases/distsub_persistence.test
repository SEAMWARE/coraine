#
# FILE            distsub_persistence.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# REQUIRE_DB: mongoc
#
# § 5.8.1.4 — subordinate (derived-sub) mapping must survive a broker
# restart. Persisted as _subordinates / _subordinateRunNo on the
# subscription mongo doc; rehydrated by ldSubCacheItemAdd at startup.
#
# Without this, a DELETE on the parent post-restart would orphan the
# derivative because the in-memory mapping is empty.
#
--NAME--
DistSub - subordinate mapping persists across CB restart

--TAGS--
mongoc persist subscription distsub

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart
swBrokerStart -role CP1

--RUN--

#
# 01. Register CSR on CB → CP1 with the sub op set
# 02. POST sub urn:S1 on CB — fanout writes _subordinates to mongo
# 03. GET on CP1 — derived urn:S1:1 visible
# 04. Restart CB (no DB drop)
# 05. DELETE urn:S1 on CB — cascade reaches CP1 only if subordinateP was rehydrated
# 06. GET on CP1 — derivative gone
#

echo "01. Register CSR on CB → CP1"
echo "============================"
payload='{
  "id": "urn:CSR:Vehicle",
  "type": "ContextSourceRegistration",
  "endpoint": "http://localhost:'$CP1_PORT'",
  "mode": "inclusive",
  "operations": ["createEntity", "createSubscription", "retrieveSubscription", "deleteSubscription"],
  "information": [
    { "entities": [ { "type": "Vehicle" } ] }
  ]
}'
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. Create sub urn:S1 on CB → fanout"
echo "===================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:S1","type":"Subscription","entities":[{"type":"Vehicle"}],"notification":{"endpoint":{"uri":"http://example.com/notify/s1"}}}'
echo
echo


echo "03. GET /subscriptions on CP1 — derivative present"
echo "=================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/subscriptions
echo
echo


echo "04. Restart CB (no DB drop) — _subordinates rehydrate from mongo"
echo "================================================================"
swBrokerStop
swBrokerStart
echo "restarted"
echo
echo


echo "05. DELETE urn:S1 on CB → cascade DELETE to CP1"
echo "==============================================="
swCurl -X DELETE --url /ngsi-ld/v1/subscriptions/urn:S1
echo
echo


echo "06. GET /subscriptions on CP1 — derivative gone (cascade reached after restart)"
echo "==============================================================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/subscriptions
echo
echo


--EXPECT--
01. Register CSR on CB → CP1
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:Vehicle
Content-Length: 0




02. Create sub urn:S1 on CB → fanout
====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/subscriptions/urn:S1
Content-Length: 0




03. GET /subscriptions on CP1 — derivative present
==================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 370

[
  {
    "entities": [
      {
        "type": "Vehicle"
      }
    ],
    "id": "urn:S1:1",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:1026/ngsi-ld/ex/v1/notifications/urn:S1"
      }
    },
    "notificationTrigger": [
      "attributeCreated",
      "attributeUpdated"
    ],
    "status": "active",
    "type": "Subscription"
  }
]



04. Restart CB (no DB drop) — _subordinates rehydrate from mongo
================================================================
restarted


05. DELETE urn:S1 on CB → cascade DELETE to CP1
===============================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8




06. GET /subscriptions on CP1 — derivative gone (cascade reached after restart)
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 3

[]



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
