#
# FILE            daemon_detaches.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --daemon (-bg): the broker detaches from its terminal - the command returns (0) and the broker serves on
# in a session of its own, no controlling terminal, its working directory /, stdin/stdout/stderr on
# /dev/null. Its log is therefore a file: --daemon with --logTo stdout (the default) or both is refused,
# with one line on stderr, and so is --daemon with -fg.
#
--NAME--
Daemon mode (--daemon): the broker detaches and serves on; without a log file it is refused

--TAGS--
cli daemon log

--INIT--

--RUN--

D=/tmp/corTest_daemonDetaches
rm -rf $D
mkdir -p $D/log
XP=$((CB_PORT + 3230))

echo "01. --daemon with the default --logTo (stdout) - refused"
echo "========================================================"
$COR_BROKER --daemon --port $XP --database corDB --troe none 2>&1
echo "exit code: $?"
echo
echo


echo "02. -bg --logTo both - refused"
echo "=============================="
$COR_BROKER -bg --logTo both --logDir $D/log --port $XP --database corDB --troe none 2>&1
echo "exit code: $?"
echo
echo


echo "03. --daemon --logTo file with -fg - refused"
echo "============================================"
$COR_BROKER --daemon -fg --logTo file --logDir $D/log --port $XP --database corDB --troe none 2>&1
echo "exit code: $?"
echo
echo


echo "04. --daemon --logTo file - the command returns 0, the broker serves on"
echo "======================================================================="
$COR_BROKER --daemon --logTo file --logDir $D/log --port $XP --database corDB --troe none &
parent=$!
wait $parent
echo "exit code: $?"
for i in $(seq 1 100); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' "localhost:$XP/ngsi-ld/v1/entities?type=T")" = 200 ] && break
  sleep 0.1
done
curl -s -w '\nstatus: %{http_code}\n' "localhost:$XP/ngsi-ld/v1/entities?type=T"
echo
echo


echo "05. The daemon - its pid in the log, not the command's; own session, no terminal, cwd /, 0/1/2 on /dev/null"
echo "============================================================================================================"
pid=$(sed -n 's/^.*--daemon: detached, pid \([0-9]*\)$/\1/p' $D/log/coraine.log)
[ -n "$pid" ] && [ "$pid" != "$parent" ] && echo "pid in the log: yes, not the command's"
echo "session leader: $([ "$(ps -o sid= -p $pid | tr -d ' ')" = "$pid" ] && echo yes || echo no)"
echo "terminal: $(ps -o tty= -p $pid | tr -d ' ')"
echo "cwd: $(readlink /proc/$pid/cwd)"
echo "stdin: $(readlink /proc/$pid/fd/0)"
echo "stdout: $(readlink /proc/$pid/fd/1)"
echo "stderr: $(readlink /proc/$pid/fd/2)"
echo
echo


echo "06. SIGTERM - the daemon stops"
echo "=============================="
kill -TERM $pid
for i in $(seq 1 100); do
  kill -0 $pid 2> /dev/null || break
  sleep 0.1
done
kill -0 $pid 2> /dev/null && echo "still running 10 s after the signal" || echo "gone"
echo
echo


--TEARDOWN--
pid=$(sed -n 's/^.*--daemon: detached, pid \([0-9]*\)$/\1/p' /tmp/corTest_daemonDetaches/log/coraine.log 2> /dev/null)
[ -n "$pid" ] && kill -9 $pid 2> /dev/null
rm -rf /tmp/corTest_daemonDetaches

--EXPECT--
01. --daemon with the default --logTo (stdout) - refused
========================================================
coraine: --daemon with --logTo stdout: a daemon's stdout is /dev/null - use --logTo file
exit code: 1


02. -bg --logTo both - refused
==============================
coraine: --daemon with --logTo both: a daemon's stdout is /dev/null - use --logTo file
exit code: 1


03. --daemon --logTo file with -fg - refused
============================================
coraine: --daemon and -fg contradict each other
exit code: 1


04. --daemon --logTo file - the command returns 0, the broker serves on
=======================================================================
exit code: 0
[]
status: 200


05. The daemon - its pid in the log, not the command's; own session, no terminal, cwd /, 0/1/2 on /dev/null
============================================================================================================
pid in the log: yes, not the command's
session leader: yes
terminal: ?
cwd: /
stdin: /dev/null
stdout: /dev/null
stderr: /dev/null


06. SIGTERM - the daemon stops
==============================
gone


