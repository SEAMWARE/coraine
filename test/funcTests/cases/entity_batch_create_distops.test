#
# FILE            entity_batch_create_distops.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Creation (§ 5.6.7) with distops forwarding.
#
# Verifies that CSR-matching entities in a batch are forwarded to the
# target CSR via a SINGLE POST /entityOperations/create (§ 5.6.7.4),
# independent of batch size — per the "group by CSR" optimisation.
#
--NAME--
Batch Entity Creation — distops forwarding via grouped batch-POST

--TAGS--
batch create entity

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities
swBrokerStart -role CP1 --noSplitEntities

--RUN--

#
# 01. Register CB→CP1 (inclusive) for type=Vehicle with createEntity op
# 02. POST batch of 3 entities (V1, V2, V3 type=Vehicle) → 201
#     - Inclusive mode: broker keeps local copy AND forwards to CP1
# 03. GET CB?type=Vehicle → all 3 (local hits)
# 04. GET CP1?type=Vehicle → all 3 (forwarded via batch)
# 05. POST batch that mixes Vehicle + Sensor → only Vehicle forwarded,
#     Sensor stays local
# 06. GET CP1?type=Sensor → zero (not forwarded)
# 07. GET CP1?type=Vehicle → still 3 total (B1 added in step 05)
#

CP1="http://localhost:${CP1_PORT}"


echo "01. Register CB→CP1 inclusive"
echo "============================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:R1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","operations":["createBatch"],"information":[{"entities":[{"type":"Vehicle"}]}]}'
echo
echo


echo "02. POST batch of 3 Vehicles on CB → 201"
echo "========================================"
swCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}},
  {"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}},
  {"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}
]'
echo
echo


echo "03. GET CB?type=Vehicle&local=true → all 3 (local copy kept by inclusive)"
echo "========================================================================="
swCurl --url "/ngsi-ld/v1/entities?type=Vehicle&local=true&options=keyValues&orderBy=id"
echo
echo


echo "04. GET CP1?type=Vehicle → all 3 (forwarded in a single batch POST)"
echo "==================================================================="
swCurl --port $CP1_PORT --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=id"
echo
echo


echo "05. POST mixed batch (Vehicle+Sensor) on CB → 201"
echo "================================================="
swCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:B1","type":"Vehicle","speed":{"type":"Property","value":50}},
  {"id":"urn:S1","type":"Sensor","temp":{"type":"Property","value":22}}
]'
echo
echo


echo "06. GET CP1?type=Sensor → zero (not forwarded, reg is for Vehicle)"
echo "=================================================================="
swCurl --port $CP1_PORT --url "/ngsi-ld/v1/entities?type=Sensor&options=keyValues"
echo
echo


echo "07. GET CP1?type=Vehicle → now includes B1 (4 total)"
echo "===================================================="
swCurl --port $CP1_PORT --url "/ngsi-ld/v1/entities?type=Vehicle&options=keyValues&orderBy=id"
echo
echo


--EXPECT--
01. Register CB→CP1 inclusive
=============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:R1
Content-Length: REGEX(\d+)




02. POST batch of 3 Vehicles on CB → 201
========================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "errors": [],
  "success": [
    "urn:V1",
    "urn:V2",
    "urn:V3"
  ]
}



03. GET CB?type=Vehicle&local=true → all 3 (local copy kept by inclusive)
=========================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "speed": 10,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 20,
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": 30,
    "type": "Vehicle"
  }
]



04. GET CP1?type=Vehicle → all 3 (forwarded in a single batch POST)
===================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "speed": 10,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 20,
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": 30,
    "type": "Vehicle"
  }
]



05. POST mixed batch (Vehicle+Sensor) on CB → 201
=================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

{
  "errors": [],
  "success": [
    "urn:B1",
    "urn:S1"
  ]
}



06. GET CP1?type=Sensor → zero (not forwarded, reg is for Vehicle)
==================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[]



07. GET CP1?type=Vehicle → now includes B1 (4 total)
====================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json; charset=utf-8
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "speed": 10,
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": 20,
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": 30,
    "type": "Vehicle"
  },
  {
    "id": "urn:B1",
    "speed": 50,
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
