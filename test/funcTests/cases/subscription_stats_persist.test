#
# FILE            subscription_stats_persist.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.2.14 notification counters (timesSent, timesFailed, last*):
# must persist across broker restart.
#
# Flow:
#  - Create sub, send 2 matching notifs → timesSent=2
#  - Flush via POST /admin/subStats/flush → stats land in mongo
#  - Restart broker → cache reloads from mongo with stats intact
#  - Send 1 more → timesSent=3 (accumulated on top of persisted)
#
# REQUIRE_DB: mongoc
--NAME--
Subscription stats persist across broker restart (mongoc)

--TAGS--
subscription stats persist mongoc

--INIT--
swDbDrop
ftClientStart
swBrokerStart --apiPlugins /home/kz/git/swBroker/plugins/admin.so

--RUN--

echo "01. Create sub matching Vehicle → ftClient"
echo "=========================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [{"type":"Vehicle"}],
  "notification": {"endpoint": {"uri": "http://localhost:'$FT_CLIENT_PORT'/notify"}}
}' | head -1
echo
echo


echo "02. POST 2 Vehicle entities → 2 notifs"
echo "======================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}}' | head -1
echo
echo


echo "03. GET sub → timesSent=2"
echo "========================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "04. POST /admin/subStats/flush"
echo "=============================="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" -X POST "http://$SW_BROKER_HOST:$SW_BROKER_PORT/admin/subStats/flush"
echo
echo


echo "05. Restart broker (cache reload from mongo)"
echo "============================================"
swBrokerStop
swBrokerStart --apiPlugins /home/kz/git/swBroker/plugins/admin.so
echo "restarted"
echo
echo


echo "06. GET sub after restart → timesSent=2 (persisted)"
echo "==================================================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


echo "07. POST 1 more Vehicle entity → timesSent=3"
echo "============================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}' | head -1
echo
echo


echo "08. GET sub → timesSent=3 (accumulated on top of persisted 2)"
echo "============================================================="
swCurl --url /ngsi-ld/v1/subscriptions/urn:S1 | grep -E '"(timesSent|timesFailed)"'
echo
echo


--EXPECT--
01. Create sub matching Vehicle → ftClient
==========================================
HTTP/1.1 201 Created


02. POST 2 Vehicle entities → 2 notifs
======================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created


03. GET sub → timesSent=2
=========================
    "timesSent": 2


04. POST /admin/subStats/flush
==============================
HTTP 204


05. Restart broker (cache reload from mongo)
============================================
restarted


06. GET sub after restart → timesSent=2 (persisted)
===================================================
    "timesSent": 2


07. POST 1 more Vehicle entity → timesSent=3
============================================
HTTP/1.1 201 Created


08. GET sub → timesSent=3 (accumulated on top of persisted 2)
=============================================================
    "timesSent": 3


--TEARDOWN--
swBrokerStop
ftClientStop
swDbDrop
