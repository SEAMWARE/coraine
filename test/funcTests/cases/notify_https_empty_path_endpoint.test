#
# FILE            notify_https_empty_path_endpoint.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Ported from orion-ld ngsild_issue_1615 (orion crashed on an HTTPS notification
# endpoint whose URL has an empty path, "https://host:port/"). sw must accept the
# subscription, attempt the notification, and stay healthy — the delivery itself
# fails (nothing listens on the endpoint) but the broker must not be affected.
#
--NAME--
HTTPS notification endpoint with an empty URL path is handled, broker stays healthy

--TAGS--
subscription notification https tenant

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# 01. Subscribe with an HTTPS endpoint whose URL path is empty ("/")
# 02. Create a matching entity
# 03. PATCH the entity (triggers the notification to the HTTPS endpoint)
# 04. GET the entity — broker healthy after the notification attempt
#

echo "01. Create subscription with empty-path HTTPS endpoint"
echo "======================================================"
swCurl --url /ngsi-ld/v1/subscriptions -H 'NGSILD-Tenant: X' --payload '{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [ { "type": "T" } ],
  "notification": { "endpoint": { "uri": "https://127.0.0.1:9999/" } }
}'
echo
echo


echo "02. Create a matching entity"
echo "============================"
swCurl --url /ngsi-ld/v1/entities -H 'NGSILD-Tenant: X' --payload '{
  "id": "urn:ngsi-ld:E1", "type": "T", "name": { "type": "Property", "value": 1 }
}'
echo
echo


echo "03. PATCH the entity attribute (triggers the notification)"
echo "========================================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs/name -X PATCH -H 'NGSILD-Tenant: X' --payload '{ "type": "Property", "value": 2 }'
echo
echo


echo "04. GET the entity — broker healthy"
echo "==================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1 -H 'NGSILD-Tenant: X'
echo
echo


--EXPECT--
01. Create subscription with empty-path HTTPS endpoint
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
NGSILD-Tenant: x
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1
Content-Length: 0




02. Create a matching entity
============================
HTTP/1.1 201 Created
Date: REGEX(.*)
NGSILD-Tenant: x
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1
Content-Length: 0




03. PATCH the entity attribute (triggers the notification)
=========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)
NGSILD-Tenant: x




04. GET the entity — broker healthy
===================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
NGSILD-Tenant: x
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 100

{
  "id": "urn:ngsi-ld:E1",
  "name": {
    "type": "Property",
    "value": 2
  },
  "type": "T"
}



--TEARDOWN--
swBrokerStop
swDbDrop
