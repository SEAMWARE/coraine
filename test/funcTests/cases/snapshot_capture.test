#
# FILE            snapshot_capture.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 5.16 Snapshot subsystem — Phase 2a: synchronous query execution
# at create-time. Verify that snapshotQueries select the right
# entities, that snapshotQueriesDetails reflects per-query outcomes
# (success / empty), and that snapshotStatus aggregates correctly
# (success / partial / empty).
#
# Phase 2a stores the matched entities in the snapshot's frozen store.
# Reading those entities via the NGSILD-Snapshot header lands in
# Phase 2b — this test only covers create-time outcomes.
#
# REQUIRE_DB: mongoc
--NAME--
Snapshot entity capture (§ 5.16, Phase 2a)

--TAGS--
snapshot

--INIT--
swDbDrop
swSnapDrop
swBrokerStart

--RUN--

echo "01. Seed two Vehicles, one Sensor"
echo "================================="
payload='{
  "id": "urn:ngsi-ld:Vehicle:V1",
  "type": "Vehicle",
  "speed": {"type":"Property","value":42}
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
payload='{
  "id": "urn:ngsi-ld:Vehicle:V2",
  "type": "Vehicle",
  "speed": {"type":"Property","value":80}
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
payload='{
  "id": "urn:ngsi-ld:Sensor:S1",
  "type": "Sensor",
  "reading": {"type":"Property","value":12.5}
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Snapshot with one query matching Vehicles → success"
echo "======================================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:Vehicles",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"Vehicle"}]}]
}'
swCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "03. GET that snapshot → snapshotStatus=success, one query detail"
echo "================================================================"
swCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Vehicles
echo
echo


echo "04. Snapshot with two queries, one match + one no-match → partial"
echo "================================================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:Mixed",
  "type": "Snapshot",
  "snapshotQueries": [
    {"type":"Query","entities":[{"type":"Vehicle"}]},
    {"type":"Query","entities":[{"type":"Building"}]}
  ]
}'
swCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "05. GET mixed snapshot → snapshotStatus=partial, two details (success, empty)"
echo "============================================================================="
swCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Mixed
echo
echo


echo "06. Snapshot whose query selects by id → captures only that entity"
echo "=================================================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:V1Only",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"Vehicle","id":"urn:ngsi-ld:Vehicle:V1"}]}]
}'
swCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "07. GET V1Only snapshot → success"
echo "================================="
swCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:V1Only
echo
echo


echo "08. Snapshot with q-filter speed>50 → matches V2 only → success"
echo "==============================================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:Fast",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"Vehicle"}],"q":"speed>50"}]
}'
swCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "09. GET fast snapshot → success"
echo "==============================="
swCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Fast
echo
echo


echo "10. Snapshot whose only query matches nothing → empty"
echo "====================================================="
payload='{
  "id": "urn:ngsi-ld:Snapshot:Empty",
  "type": "Snapshot",
  "snapshotQueries": [{"type":"Query","entities":[{"type":"NonExistentType"}]}]
}'
swCurl --url /ngsi-ld/v1/snapshots --payload "$payload"
echo
echo


echo "11. GET empty snapshot → empty"
echo "=============================="
swCurl --url /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Empty
echo
echo


--EXPECT--
01. Seed two Vehicles, one Sensor
=================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V1
Content-Length: REGEX(\d+)



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Vehicle:V2
Content-Length: REGEX(\d+)



HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Sensor:S1
Content-Length: REGEX(\d+)




02. Snapshot with one query matching Vehicles → success
=======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Vehicles
Content-Length: REGEX(\d+)




03. GET that snapshot → snapshotStatus=success, one query detail
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": REGEX(".*"),
  "id": "urn:ngsi-ld:Snapshot:Vehicles",
  "lastUsedAt": REGEX(".*"),
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "success"
    }
  ],
  "snapshotStatus": "success",
  "type": "Snapshot"
}



04. Snapshot with two queries, one match + one no-match → partial
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Mixed
Content-Length: REGEX(\d+)




05. GET mixed snapshot → snapshotStatus=partial, two details (success, empty)
=============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": REGEX(".*"),
  "id": "urn:ngsi-ld:Snapshot:Mixed",
  "lastUsedAt": REGEX(".*"),
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "type": "Query"
    },
    {
      "entities": [
        {
          "type": "Building"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "success"
    },
    {
      "resultStatus": "empty"
    }
  ],
  "snapshotStatus": "partial",
  "type": "Snapshot"
}



06. Snapshot whose query selects by id → captures only that entity
==================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:V1Only
Content-Length: REGEX(\d+)




07. GET V1Only snapshot → success
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": REGEX(".*"),
  "id": "urn:ngsi-ld:Snapshot:V1Only",
  "lastUsedAt": REGEX(".*"),
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "id": "urn:ngsi-ld:Vehicle:V1",
          "type": "Vehicle"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "success"
    }
  ],
  "snapshotStatus": "success",
  "type": "Snapshot"
}



08. Snapshot with q-filter speed>50 → matches V2 only → success
===============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Fast
Content-Length: REGEX(\d+)




09. GET fast snapshot → success
===============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": REGEX(".*"),
  "id": "urn:ngsi-ld:Snapshot:Fast",
  "lastUsedAt": REGEX(".*"),
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "Vehicle"
        }
      ],
      "q": "speed>50",
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "success"
    }
  ],
  "snapshotStatus": "success",
  "type": "Snapshot"
}



10. Snapshot whose only query matches nothing → empty
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/snapshots/urn:ngsi-ld:Snapshot:Empty
Content-Length: REGEX(\d+)




11. GET empty snapshot → empty
==============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "expiresAt": REGEX(".*"),
  "id": "urn:ngsi-ld:Snapshot:Empty",
  "lastUsedAt": REGEX(".*"),
  "snapshotPriority": 5,
  "snapshotQueries": [
    {
      "entities": [
        {
          "type": "NonExistentType"
        }
      ],
      "type": "Query"
    }
  ],
  "snapshotQueriesDetails": [
    {
      "resultStatus": "empty"
    }
  ],
  "snapshotStatus": "empty",
  "type": "Snapshot"
}



--TEARDOWN--
swBrokerStop
swSnapDrop
swDbDrop
