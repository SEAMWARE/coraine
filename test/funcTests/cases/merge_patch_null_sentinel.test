#
# FILE            merge_patch_null_sentinel.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Merge-PATCH attribute deletion via the NGSI-LD Null sentinel "urn:ngsi-ld:null"
# (§ 5.4.1: "A member ... with value equal to an NGSI-LD Null shall cause for the
# member to be removed").  Covered forms:
#   - concise / simplified bare RHS                ("P1": "urn:ngsi-ld:null")
#   - normalized Property value                    ({type:Property, value: sentinel})
#   - Relationship object                          ({type:Relationship, object: sentinel})
#   - normalized LanguageProperty                  (languageMap: {"@none": sentinel})
#   - sentinel for a NON-existing attribute        -> no-op (RFC 7386), 204
#   - raw JSON null RHS                            -> 400 (NGSI-LD Null is the sentinel,
#                                                     not JSON null which JSON-LD strips)
#
--NAME--
Merge-PATCH attribute deletion via the urn:ngsi-ld:null sentinel (all forms)

--TAGS--
entity patch

--INIT--
swDbDrop
swBrokerStart

--RUN--

echo "01. Seed entity with P1, R1, P2, LP"
echo "==================================="
payload='{
  "id": "urn:ngsi-ld:T:E1",
  "type": "T",
  "P1": { "type": "Property", "value": 1 },
  "R1": { "type": "Relationship", "object": "urn:ngsi-ld:X" },
  "P2": { "type": "Property", "value": 2 },
  "LP": { "type": "LanguageProperty", "languageMap": { "en": "English", "es": "Spanish" } }
}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Merge-PATCH: delete P1 (concise sentinel) and R1 (Relationship object sentinel)"
echo "=================================================================================="
payload='{
  "P1": "urn:ngsi-ld:null",
  "R1": { "type": "Relationship", "object": "urn:ngsi-ld:null" }
}'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload"
echo
echo


echo "03. GET — P1 and R1 gone; P2 and LP remain"
echo "=========================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 --out application/json
echo
echo


echo "04. Merge-PATCH: delete P2 via normalized Property value sentinel"
echo "================================================================="
payload='{ "P2": { "type": "Property", "value": "urn:ngsi-ld:null" } }'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload"
echo
echo


echo "05. Merge-PATCH: delete LP via normalized LanguageProperty languageMap @none sentinel"
echo "====================================================================================="
payload='{ "LP": { "type": "LanguageProperty", "languageMap": { "@none": "urn:ngsi-ld:null" } } }'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload"
echo
echo


echo "06. GET — only id/type remain"
echo "============================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 --out application/json
echo
echo


echo "07. Merge-PATCH: sentinel for a NON-existing attribute — no-op, 204 (RFC 7386)"
echo "=============================================================================="
payload='{ "Pxxx": "urn:ngsi-ld:null" }'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload"
echo
echo


echo "08. Merge-PATCH: raw JSON null RHS is rejected (sentinel is the delete mechanism, not JSON null)"
echo "==============================================================================================="
payload='{ "P9": null }'
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1 -X PATCH --payload "$payload"
echo
echo


--EXPECT--
01. Seed entity with P1, R1, P2, LP
===================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:T:E1
Content-Length: 0




02. Merge-PATCH: delete P1 (concise sentinel) and R1 (Relationship object sentinel)
==================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET — P1 and R1 gone; P2 and LP remain
==========================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 219

{
  "LP": {
    "languageMap": {
      "en": "English",
      "es": "Spanish"
    },
    "type": "LanguageProperty"
  },
  "P2": {
    "type": "Property",
    "value": 2
  },
  "id": "urn:ngsi-ld:T:E1",
  "type": "T"
}



04. Merge-PATCH: delete P2 via normalized Property value sentinel
=================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. Merge-PATCH: delete LP via normalized LanguageProperty languageMap @none sentinel
=====================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




06. GET — only id/type remain
=============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 46

{
  "id": "urn:ngsi-ld:T:E1",
  "type": "T"
}



07. Merge-PATCH: sentinel for a NON-existing attribute — no-op, 204 (RFC 7386)
==============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




08. Merge-PATCH: raw JSON null RHS is rejected (sentinel is the delete mechanism, not JSON null)
===============================================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 222

{
  "detail": "JSON null is not allowed in NGSI-LD (field: 'https://uri.etsi.org/ngsi-ld/default-context/P9')",
  "status": 400,
  "title": "Invalid Value",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
swBrokerStop
