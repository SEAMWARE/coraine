--NAME--
Geo-query error handling (georel, geometry, coordinates validation)

--TAGS--
entity error geo query

--INIT--
swDbDrop
swBrokerStart

--RUN--

#
# georel errors:
# 01. georel= (empty)
# 02. georel=NEAR (wrong case)
# 03. georel=foo (unknown type)
# 04. georel=near without distance modifier
# 05. georel=near;foo==100 (unknown modifier)
# 06. georel=near;maxDistance=100 (single = instead of ==)
# 07. georel=near;maxDistance==abc (non-numeric)
# 08. georel=near;maxDistance==-5 (negative)
# 09. georel=within;maxDistance==100 (distance on non-near)
#
# geometry errors:
# 10. geometry= (empty)
# 11. geometry=Piont (typo)
# 12. geometry=point (wrong case)
#
# coordinates errors:
# 13. coordinates= (empty)
# 14. coordinates=notanarray (not a JSON array)
#
# Inter-parameter errors:
# 15. georel without geometry and coordinates
# 16. geometry without georel and coordinates
# 17. coordinates without georel and geometry
# 18. georel+geometry without coordinates
# 19. georel+coordinates without geometry
# 20. geometry+coordinates without georel
# 21. geoproperty alone
#

echo "01. georel= (empty) - 400 Bad Request"
echo "====================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "02. georel=NEAR (wrong case) - 400 Bad Request"
echo "=============================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=NEAR%3BmaxDistance%3D%3D100&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "03. georel=foo (unknown type) - 400 Bad Request"
echo "==============================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=foo&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "04. georel=near without distance modifier - 400 Bad Request"
echo "==========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=near&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "05. georel=near;foo==100 (unknown modifier) - 400 Bad Request"
echo "============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=near%3Bfoo%3D%3D100&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "06. georel=near;maxDistance=100 (single = instead of ==) - 400 Bad Request"
echo "=========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=near%3BmaxDistance%3D100&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "07. georel=near;maxDistance==abc (non-numeric) - 400 Bad Request"
echo "================================================================"
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=near%3BmaxDistance%3D%3Dabc&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "08. georel=near;maxDistance==-5 (negative) - 400 Bad Request"
echo "============================================================"
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=near%3BmaxDistance%3D%3D-5&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "09. georel=within;maxDistance==100 (distance on non-near) - 400 Bad Request"
echo "==========================================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within%3BmaxDistance%3D%3D100&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "10. geometry= (empty) - 400 Bad Request"
echo "======================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=&coordinates=\[0,0\]'
echo
echo


echo "11. geometry=Piont (typo) - 400 Bad Request"
echo "==========================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=Piont&coordinates=\[0,0\]'
echo
echo


echo "12. geometry=point (wrong case) - 400 Bad Request"
echo "================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=point&coordinates=\[0,0\]'
echo
echo


echo "13. coordinates= (empty) - 400 Bad Request"
echo "=========================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=Point&coordinates='
echo
echo


echo "14. coordinates=notanarray (not a JSON array) - 400 Bad Request"
echo "==============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=Point&coordinates=notanarray'
echo
echo


echo "15. georel without geometry and coordinates - 400 Bad Request"
echo "============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within'
echo
echo


echo "16. geometry without georel and coordinates - 400 Bad Request"
echo "============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&geometry=Point'
echo
echo


echo "17. coordinates without georel and geometry - 400 Bad Request"
echo "============================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&coordinates=\[0,0\]'
echo
echo


echo "18. georel+geometry without coordinates - 400 Bad Request"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&geometry=Point'
echo
echo


echo "19. georel+coordinates without geometry - 400 Bad Request"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&georel=within&coordinates=\[0,0\]'
echo
echo


echo "20. geometry+coordinates without georel - 400 Bad Request"
echo "========================================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&geometry=Point&coordinates=\[0,0\]'
echo
echo


echo "21. geoproperty alone - 400 Bad Request"
echo "======================================="
swCurl --url '/ngsi-ld/v1/entities?type=T&geoproperty=location'
echo
echo


--EXPECT--
01. georel= (empty) - 400 Bad Request
=====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "georel value is empty",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. georel=NEAR (wrong case) - 400 Bad Request
==============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unknown georel: 'NEAR'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. georel=foo (unknown type) - 400 Bad Request
===============================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unknown georel: 'foo'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. georel=near without distance modifier - 400 Bad Request
===========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "georel 'near' requires maxDistance or minDistance",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. georel=near;foo==100 (unknown modifier) - 400 Bad Request
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unknown georel modifier: 'foo==100'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. georel=near;maxDistance=100 (single = instead of ==) - 400 Bad Request
==========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unknown georel modifier: 'maxDistance=100'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. georel=near;maxDistance==abc (non-numeric) - 400 Bad Request
================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "invalid distance value in georel",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



08. georel=near;maxDistance==-5 (negative) - 400 Bad Request
============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "distance must not be negative in georel",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



09. georel=within;maxDistance==100 (distance on non-near) - 400 Bad Request
===========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "maxDistance/minDistance only valid with georel 'near'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



10. geometry= (empty) - 400 Bad Request
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "geometry value is empty",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



11. geometry=Piont (typo) - 400 Bad Request
===========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unsupported geometry type: 'Piont'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



12. geometry=point (wrong case) - 400 Bad Request
=================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "unsupported geometry type: 'point'",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



13. coordinates= (empty) - 400 Bad Request
==========================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "coordinates value is empty",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



14. coordinates=notanarray (not a JSON array) - 400 Bad Request
===============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "coordinates must be a JSON array",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



15. georel without geometry and coordinates - 400 Bad Request
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing geometry, coordinates",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



16. geometry without georel and coordinates - 400 Bad Request
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing georel, coordinates",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



17. coordinates without georel and geometry - 400 Bad Request
=============================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing georel, geometry",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



18. georel+geometry without coordinates - 400 Bad Request
=========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing coordinates",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



19. georel+coordinates without geometry - 400 Bad Request
=========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing geometry",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



20. geometry+coordinates without georel - 400 Bad Request
=========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "incomplete geo-query: missing georel",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



21. geoproperty alone - 400 Bad Request
=======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "geoproperty without georel, geometry, and coordinates",
  "status": 400,
  "title": "Invalid geo-query",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



--TEARDOWN--
swBrokerStop
swDbDrop
