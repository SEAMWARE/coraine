#
# FILE            troe_timescale_temporal_aggregation_nonnumeric.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# § 4.5.19.1 — Aggregated Temporal Representation, non-numeric Property values.
#
# Per spec table 4.5.19.1-1:
#   Boolean → all numeric methods supported (true=1, false=0 per the note)
#   String  → totalCount + distinctCount + lex min/max
# Methods that are N/A for the value's type drop their row from that
# bucket (the method's array comes out empty if no bucket qualifies).
#
--NAME--
TRoE timescale - aggregatedValues on Boolean and String

--TAGS--
troe timescale postgres temporal aggregation

--INIT--
swDbDrop
swTroeInit
swBrokerStart --troe timescale

--RUN--

echo "01. Seed urn:V1: alarm (Boolean, six samples) + status (String, six samples)"
echo "============================================================================"
payload='{
  "id":   "urn:V1",
  "type": "Vehicle",
  "alarm":[
    {"type":"Property","value":false,"observedAt":"2026-04-28T10:00:00Z"},
    {"type":"Property","value":false,"observedAt":"2026-04-28T10:30:00Z"},
    {"type":"Property","value":true, "observedAt":"2026-04-28T12:00:00Z"},
    {"type":"Property","value":false,"observedAt":"2026-04-28T12:30:00Z"},
    {"type":"Property","value":true, "observedAt":"2026-04-28T14:00:00Z"},
    {"type":"Property","value":true, "observedAt":"2026-04-28T14:30:00Z"}
  ],
  "status":[
    {"type":"Property","value":"idle",   "observedAt":"2026-04-28T10:00:00Z"},
    {"type":"Property","value":"idle",   "observedAt":"2026-04-28T10:30:00Z"},
    {"type":"Property","value":"running","observedAt":"2026-04-28T12:00:00Z"},
    {"type":"Property","value":"running","observedAt":"2026-04-28T12:30:00Z"},
    {"type":"Property","value":"error",  "observedAt":"2026-04-28T14:00:00Z"},
    {"type":"Property","value":"running","observedAt":"2026-04-28T14:30:00Z"}
  ]
}'
swCurl --url /ngsi-ld/v1/temporal/entities --payload "$payload"
echo
echo


echo "02. totalCount + distinctCount per 2h bucket — works for Bool + String"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T10:00:00Z&endTimeAt=2026-04-28T16:00:00Z&format=aggregatedValues&aggrMethods=totalCount,distinctCount&aggrPeriodDuration=PT2H'
echo
echo


echo "03. avg + min + max — Boolean works (true=1/false=0), String emits lex min/max"
echo "==============================================================================="
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=between&timeAt=2026-04-28T10:00:00Z&endTimeAt=2026-04-28T16:00:00Z&format=aggregatedValues&aggrMethods=avg,min,max&aggrPeriodDuration=PT2H'
echo
echo


--EXPECT--
01. Seed urn:V1: alarm (Boolean, six samples) + status (String, six samples)
============================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/temporal/entities/urn:V1
Content-Length: REGEX(\d+)




02. totalCount + distinctCount per 2h bucket — works for Bool + String
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "alarm": {
      "distinctCount": [
        [
          1,
          "2026-04-28T10:00:00Z",
          "2026-04-28T12:00:00Z"
        ],
        [
          2,
          "2026-04-28T12:00:00Z",
          "2026-04-28T14:00:00Z"
        ],
        [
          1,
          "2026-04-28T14:00:00Z",
          "2026-04-28T16:00:00Z"
        ]
      ],
      "totalCount": [
        [
          2,
          "2026-04-28T10:00:00Z",
          "2026-04-28T12:00:00Z"
        ],
        [
          2,
          "2026-04-28T12:00:00Z",
          "2026-04-28T14:00:00Z"
        ],
        [
          2,
          "2026-04-28T14:00:00Z",
          "2026-04-28T16:00:00Z"
        ]
      ],
      "type": "Property"
    },
    "id": "urn:V1",
    "status": {
      "distinctCount": [
        [
          1,
          "2026-04-28T10:00:00Z",
          "2026-04-28T12:00:00Z"
        ],
        [
          1,
          "2026-04-28T12:00:00Z",
          "2026-04-28T14:00:00Z"
        ],
        [
          2,
          "2026-04-28T14:00:00Z",
          "2026-04-28T16:00:00Z"
        ]
      ],
      "totalCount": [
        [
          2,
          "2026-04-28T10:00:00Z",
          "2026-04-28T12:00:00Z"
        ],
        [
          2,
          "2026-04-28T12:00:00Z",
          "2026-04-28T14:00:00Z"
        ],
        [
          2,
          "2026-04-28T14:00:00Z",
          "2026-04-28T16:00:00Z"
        ]
      ],
      "type": "Property"
    },
    "type": "Vehicle"
  }
]



03. avg + min + max — Boolean works (true=1/false=0), String emits lex min/max
===============================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

[
  {
    "alarm": {
      "avg": [
        [
          0,
