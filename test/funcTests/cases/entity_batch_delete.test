#
# FILE            entity_batch_delete.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Delete (§ 5.6.11). Local-only semantics covering:
#
#   - all-existing              -> 204 No Content
#   - mix existing + missing    -> 207 Multi-Status
#   - all missing               -> 409 Conflict
#   - non-string entry          -> per-entity 400
#   - non-URI string entry      -> per-entity 400 (input is a list of URIs)
#   - empty array / null entry / non-array body -> 400
#
--NAME--
POST /entityOperations/delete — Batch Entity Delete (§ 5.6.11)

--TAGS--
batch delete entity

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Seed — V1, V2, V3"
echo "====================="
corCurl --url /ngsi-ld/v1/entityOperations/create --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}},
  {"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":20}},
  {"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":30}}
]'
echo
echo


echo "02. Delete V1 + V2 → 204"
echo "========================"
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1","urn:V2"]'
echo
echo


echo "03. GET V1 → 404"
echo "================"
corCurl --url /ngsi-ld/v1/entities/urn:V1
echo
echo


echo "04. GET V2 → 404"
echo "================"
corCurl --url /ngsi-ld/v1/entities/urn:V2
echo
echo


echo "05. GET V3 → 200 (still there)"
echo "=============================="
corCurl --url /ngsi-ld/v1/entities/urn:V3?options=keyValues
echo
echo


echo "06. Delete V3 + VX (VX missing) → 207 partial"
echo "============================================="
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V3","urn:VX"]'
echo
echo


echo "07. GET V3 → 404"
echo "================"
corCurl --url /ngsi-ld/v1/entities/urn:V3
echo
echo


echo "08. Delete two missing → 409"
echo "============================"
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:missingA","urn:missingB"]'
echo
echo


echo "09. Non-string entry → 400 per-entity (partial)"
echo "==============================================="
# V4 seeded inline so we have a success to pair with the bad entry.
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V4","type":"Vehicle","speed":{"type":"Property","value":40}}'
echo
echo
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V4", 123]'
echo
echo


echo "10. Empty array → 400"
echo "====================="
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '[]'
echo
echo


echo "11. null element → 400"
echo "======================"
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V1",null]'
echo
echo


echo "12. Non-array body → 400"
echo "========================"
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '"urn:V1"'
echo
echo


echo "13. Invalid-URI string entry → 400 per-entity (partial)"
echo "======================================================="
# The input array is a list of Entity IDs (URIs) (§ 10.3.6.3); a non-URI string
# is malformed input (per-entity 400), not a missing entity (404). V5 seeded
# inline so a success is paired with the bad entry.
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V5","type":"Vehicle","speed":{"type":"Property","value":50}}'
echo
echo
corCurl --url /ngsi-ld/v1/entityOperations/delete --payload '["urn:V5", "not a uri"]'
echo
echo


--EXPECT--
01. Seed — V1, V2, V3
=====================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 39

[
  "urn:V1",
  "urn:V2",
  "urn:V3"
]



02. Delete V1 + V2 → 204
========================
HTTP/1.1 204 No Content
Date: REGEX(.*)




03. GET V1 → 404
================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 151

{
  "detail": "entity 'urn:V1' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



04. GET V2 → 404
================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 151

{
  "detail": "entity 'urn:V2' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



05. GET V3 → 200 (still there)
==============================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 57

{
  "id": "urn:V3",
  "speed": 30,
  "type": "Vehicle"
}



06. Delete V3 + VX (VX missing) → 207 partial
=============================================
HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 287

{
  "errors": [
    {
      "entityId": "urn:VX",
      "error": {
        "detail": "entity does not exist",
        "status": 404,
        "title": "Not Found",
        "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
      }
    }
  ],
  "success": [
    "urn:V3"
  ]
}



07. GET V3 → 404
================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 151

{
  "detail": "entity 'urn:V3' not found",
  "status": 404,
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



08. Delete two missing → 409
============================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 154

{
  "entityIds": [
    "urn:missingA",
    "urn:missingB"
  ],
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



09. Non-string entry → 400 per-entity (partial)
===============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V4
Content-Length: 0




HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 294

{
  "errors": [
    {
      "entityId": "",
      "error": {
        "detail": "entry must be a URI string",
        "status": 400,
        "title": "Invalid Array Entry",
        "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
      }
    }
  ],
  "success": [
    "urn:V4"
  ]
}



10. Empty array → 400
=====================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 171

{
  "detail": "an empty array is not valid NGSI-LD input",
  "status": 400,
  "title": "Empty Structure",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



11. null element → 400
======================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 179

{
  "detail": "Batch Entity Delete: null entry at position 1",
  "status": 400,
  "title": "Invalid Array Entry",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



12. Non-array body → 400
========================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 176

{
  "detail": "Batch Entity Delete body must be a JSON array",
  "status": 400,
  "title": "Not a JSON Array",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



13. Invalid-URI string entry → 400 per-entity (partial)
=======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V5
Content-Length: 0




HTTP/1.1 207 Multi-Status
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 301

{
  "errors": [
    {
      "entityId": "not a uri",
      "error": {
        "detail": "entry is not a valid URI",
        "status": 400,
        "title": "Invalid Array Entry",
        "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
      }
    }
  ],
  "success": [
    "urn:V5"
  ]
}



--TEARDOWN--
coraineStop
corDbDrop
