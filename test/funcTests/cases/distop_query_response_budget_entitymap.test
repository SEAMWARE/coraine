#
# FILE            distop_query_response_budget_entitymap.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --maxResponseSize on a distributed query with automatic EntityMaps (roadmap § 13) - the variant of
# distop_query_response_budget.test, which runs without them (--entityMapMemory 0).
#
# A distributed query of more than one page is paged through an EntityMap: a page is a slice of the
# frozen ids, each entity fetched from where the map says it lives. The byte budget can only shorten
# the slice - the page ends before the entity that would pass it, and rel="next" continues at the
# map position after the last one on it. Following the links returns every entity exactly once.
#
# So a split-entity query (the default) larger than the budget, refused without maps because it
# would need every match assembled at once, is paged. orderBy is not paged through a map (ordering by
# values is a Snapshot's job): over the budget it is still 403 TooManyResults.
#
# 1 MiB budget. Three local entities urn:L:1..3 and three at CP1 urn:R:1..3, ~300 000 bytes each.
#
# REQUIRE_FEATURE: RESPONSE_BUDGET REGISTRATIONS AUTO_ENTITY_MAP
#
--NAME--
Byte budget of a distributed query paged through an automatic EntityMap

--TAGS--
distop distops query pagination link-header registration forwarding entitymap

--INIT--
corDbDrop
corDbDrop -role CP1
coraineStart -dist --maxResponseSize 1
coraineStart -role CP1

--RUN--
CP1="http://localhost:${CP1_PORT}"

#
# page - GET a page, show its status, its Link header and the ids it holds
#
page() {
  corCurl --url "$1" > /tmp/budgetDist.out 2>&1
  python3 - <<'EOF'
import json
txt = open('/tmp/budgetDist.out').read()
head, _, body = txt.partition('\n\n')
lines = head.split('\n')
print(lines[0])
for l in lines[1:]:
  k = l.split(':', 1)[0].lower()
  if (k == 'link' and 'json-ld#context' not in l) or k == 'ngsild-warning':
    print(l)
b = body.strip()
if b.startswith('['):
  print('ids:', ' '.join(e['id'] for e in json.loads(b)))
elif b:
  e = json.loads(b)
  print('error:', e.get('type'), '-', e.get('detail'))
EOF
}

echo "01. Three local entities urn:L:1..3 and three at CP1 urn:R:1..3, ~300 000 bytes each"
echo "===================================================================================="
for i in 1 2 3; do
  python3 -c "import json; print(json.dumps({'id':'urn:L:$i','type':'Blob','blob':{'type':'Property','value':'L'*300000}}))" > /tmp/budgetDistEntity.json
  corCurl --url /ngsi-ld/v1/entities --payload /tmp/budgetDistEntity.json | grep '^HTTP/1.1 2'
  python3 -c "import json; print(json.dumps({'id':'urn:R:$i','type':'Blob','blob':{'type':'Property','value':'R'*300000}}))" > /tmp/budgetDistEntity.json
  corCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload /tmp/budgetDistEntity.json | grep '^HTTP/1.1 2'
done
\rm -f /tmp/budgetDistEntity.json
echo
echo


echo "02. Register CP1 for type Blob (inclusive)"
echo "=========================================="
corCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:CP1","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"inclusive","information":[{"entities":[{"type":"Blob"}]}]}' | head -1
echo
echo


echo "03. GET type=Blob, splitEntities=false - more than a page: an EntityMap; L1..L3 fit, R1 would not - next at map position 3"
echo "=========================================================================================================================="
page '/ngsi-ld/v1/entities?type=Blob&limit=100&splitEntities=false'
echo
echo


echo "04. Following the next links returns every local and remote entity exactly once"
echo "==============================================================================="
url='/ngsi-ld/v1/entities?type=Blob&limit=100&splitEntities=false'
all=""
pages=0
while [ -n "$url" ]; do
  page "$url" > /tmp/budgetDistWalk.out
  all="$all $(grep '^ids:' /tmp/budgetDistWalk.out | cut -c5-)"
  url=$(grep -i '^link:' /tmp/budgetDistWalk.out | grep -o '<[^>]*>;rel="next"' | sed 's/^<//; s/>;rel="next"$//')
  pages=$((pages + 1))
  [ $pages -gt 10 ] && break
done
echo "pages: $pages"
echo "ids:  $(echo $all | tr ' ' '\n' | sort | uniq -c | awk '{ print $2 "x" $1 }' | tr '\n' ' ')"
\rm -f /tmp/budgetDistWalk.out
echo
echo


echo "05. limit=1 - an EntityMap; limit binds before the budget: one entity, next at map position 1"
echo "============================================================================================="
page '/ngsi-ld/v1/entities?type=Blob&limit=1&splitEntities=false'
echo
echo


echo "06. orderBy=id - all six at once (1.8 MB) do not fit: 403"
echo "========================================================="
page '/ngsi-ld/v1/entities?type=Blob&limit=100&orderBy=id&splitEntities=false'
echo
echo


echo "07. Split entities (the default) - more than the budget at once: paged through an EntityMap, L1..L3 first"
echo "========================================================================================================="
page '/ngsi-ld/v1/entities?type=Blob&limit=100'
echo
echo


echo "08. local=true - the three local entities fit, no forward"
echo "=========================================================="
page '/ngsi-ld/v1/entities?type=Blob&limit=100&local=true'
echo
echo


\rm -f /tmp/budgetDist.out


--EXPECT--
01. Three local entities urn:L:1..3 and three at CP1 urn:R:1..3, ~300 000 bytes each
====================================================================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created
HTTP/1.1 201 Created


02. Register CP1 for type Blob (inclusive)
==========================================
HTTP/1.1 201 Created


03. GET type=Blob, splitEntities=false - more than a page: an EntityMap; L1..L3 fit, R1 would not - next at map position 3
==========================================================================================================================
HTTP/1.1 200 OK
REGEX(Link:\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&splitEntities=false\&limit=100\&offset=3>;rel="next";type="application/json",\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&splitEntities=false\&limit=100\&offset=3>;rel="last";type="application/json")
ids: urn:L:1 urn:L:2 urn:L:3


04. Following the next links returns every local and remote entity exactly once
===============================================================================
pages: 2
ids:  urn:L:1x1 urn:L:2x1 urn:L:3x1 urn:R:1x1 urn:R:2x1 urn:R:3x1 


05. limit=1 - an EntityMap; limit binds before the budget: one entity, next at map position 1
=============================================================================================
HTTP/1.1 200 OK
REGEX(Link:\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&splitEntities=false\&limit=1\&offset=1>;rel="next";type="application/json",\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&splitEntities=false\&limit=1\&offset=5>;rel="last";type="application/json")
ids: urn:L:1


06. orderBy=id - all six at once (1.8 MB) do not fit: 403
=========================================================
HTTP/1.1 403 Forbidden
error: https://uri.etsi.org/ngsi-ld/errors/TooManyResults - the set of matches of this broker and its Context Sources, which this query needs all at once (orderBy, or split entities without an EntityMap), exceeds the response size budget of 1 MiB (--maxResponseSize) - narrow the query


07. Split entities (the default) - more than the budget at once: paged through an EntityMap, L1..L3 first
=========================================================================================================
HTTP/1.1 200 OK
REGEX(Link:\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&limit=100\&offset=3>;rel="next";type="application/json",\ </ngsi\-ld/v1/entities\?entityMap=urn:ngsi\-ld:EntityMap:[0-9a-f]+\&type=Blob\&limit=100\&offset=3>;rel="last";type="application/json")
ids: urn:L:1 urn:L:2 urn:L:3


08. local=true - the three local entities fit, no forward
==========================================================
HTTP/1.1 200 OK
ids: urn:L:1 urn:L:2 urn:L:3


--TEARDOWN--
coraineStop
coraineStop -role CP1
corDbDrop
corDbDrop -role CP1
