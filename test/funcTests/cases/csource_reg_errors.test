echo "50. GET with discovery filter type=Vehicle - 501"
echo "================================================"
swCurl --url '/ngsi-ld/v1/csourceRegistrations?type=Vehicle'
echo
echo


echo "51. GET with discovery filter q=foo==1 - 501"
echo "============================================"
swCurl --url '/ngsi-ld/v1/csourceRegistrations?q=foo==1'
echo
echo


echo "52. GET with limit only - 200"
echo "============================="
swCurl --url '/ngsi-ld/v1/csourceRegistrations?limit=5'
echo
echo


--EXPECT--
01. POST without payload - 400
==============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "no payload",
  "title": "Bad Request",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



02. POST array (not object) - 400
=================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration payload must be a JSON object",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



03. POST missing type - 400
===========================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration 'type' is mandatory for create",
  "title": "Missing Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



04. POST wrong type value - 400
===============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration 'type' must be 'ContextSourceRegistration'",
  "title": "Invalid Type",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



05. POST missing endpoint - 400
===============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration 'endpoint' is mandatory for create",
  "title": "Missing Endpoint",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



06. POST endpoint not a URI - 400
=================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Not a valid URI: 'not-a-uri'",
  "title": "Invalid URI",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



07. POST missing information - 400
==================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration 'information' is mandatory for create",
  "title": "Missing Information",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



08. POST information empty array - 400
======================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'information' must have at least one element",
  "title": "Empty Array",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



09. POST information element with no entities/propertyNames/relationshipNames - 400
===================================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'information' element must have at least one of 'entities', 'propertyNames', 'relationshipNames'",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



10. POST entities without type - 400
====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'entities[].type' is mandatory",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



11. POST mode invalid value - 400
=================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "Registration 'mode' must be one of: inclusive, exclusive, redirect, auxiliary (got 'magic')",
  "title": "Invalid Mode",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



12. POST expiresAt in the past - 400
====================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'expiresAt' must be a DateTime in the future",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



13. POST expiresAt malformed - 400
==================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "'expiresAt' is not a valid ISO 8601 DateTime",
  "title": "Invalid DateTime",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



14. POST auxiliary mode with disallowed operations - 400
========================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "auxiliary registration 'operations' must be one of: retrieveOps, retrieveEntity, queryEntity (got 'createEntity')",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



15. POST auxiliary mode with allowed operations - 201
=====================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Content-Type: application/json
Location: /ngsi-ld/v1/csourceRegistrations/urn:ngsi-ld:CSR:Aux1
Link: REGEX(.*)
Content-Length: REGEX(\d+)




16. POST contextSourceInfo with bad accept value - 400
======================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "contextSourceInfo 'accept' must be 'application/json' or 'application/ld+json'",
  "title": "Invalid Registration",
  "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}



17. PATCH non-existing registration - 404
=========================================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{
  "detail": "registration 'urn:doesnt:exist' not found",
  "title": "Not Found",
  "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}



18. POST id not a string - 400
==============================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

