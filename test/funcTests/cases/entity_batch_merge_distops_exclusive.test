#
# FILE            entity_batch_merge_distops_exclusive.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Batch Entity Merge (§ 5.6.10) — exclusive CSR mode.
#
# An exclusive registration OWNS the claimed attributes. A batch
# merge on the broker must:
#   - chop the claimed attrs off the local fragment;
#   - forward them (in array order) to the CSR in a single
#     POST /entityOperations/merge;
#   - merge anything left over into the local state surgically
#     (unrelated local attrs untouched).
#
--NAME--
Batch Entity Merge — exclusive CSR chops attrs, local keeps the rest

--TAGS--
batch entity merge

--INIT--
swDbDrop
swDbDrop -role CP1
swBrokerStart --noSplitEntities -dist
swBrokerStart -role CP1 --noSplitEntities -dist

--RUN--

CP1="http://localhost:${CP1_PORT}"


echo "01. Seed V1 locally on CB with {color, size}"
echo "============================================"
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","color":{"type":"Property","value":"red"},"size":{"type":"Property","value":"large"}}'
echo
echo


echo "02. Seed V1 on CP1 — owner of 'speed'"
echo "====================================="
swCurl --port $CP1_PORT --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10}}'
echo
echo


echo "03. Register CB→CP1 exclusive claiming 'speed' (mergeBatch op)"
echo "=============================================================="
swCurl --url /ngsi-ld/v1/csourceRegistrations --payload '{"id":"urn:CSR:EX","type":"ContextSourceRegistration","endpoint":"'"$CP1"'","mode":"exclusive","operations":["mergeBatch"],"information":[{"entities":[{"id":"urn:V1","type":"Vehicle"}],"propertyNames":["speed"]}]}'
echo
echo


echo "04. Batch Merge V1 {speed,color} — speed→CP1, color→local. 204 (surgical)"
echo "========================================================================="
# V1.size stays intact (surgical), V1.color gets updated locally, V1.speed gets
# merged onto CP1.
swCurl --url /ngsi-ld/v1/entityOperations/merge --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99},"color":{"type":"Property","value":"blue"}}
]'
echo
echo


echo "05. GET CB V1 — color=blue, size=large (untouched), no speed (chopped)"
echo "======================================================================"
swCurl --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues&local=true'
echo
echo


echo "06. GET CP1 V1 — speed=99 (forwarded)"
echo "====================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues'
echo
echo


echo "07. Batch Merge V1 with only speed — 100% chopped, nothing touches local"
echo "========================================================================"
swCurl --url /ngsi-ld/v1/entityOperations/merge --payload '[
  {"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":199}}
]'
echo
echo


echo "08. GET CB V1 — color=blue, size=large unchanged (local wasn't touched)"
echo "======================================================================="
swCurl --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues&local=true'
echo
echo


echo "09. GET CP1 V1 — speed=199 (merged on remote)"
echo "============================================="
swCurl --port $CP1_PORT --url '/ngsi-ld/v1/entities/urn:V1?options=keyValues'
echo
echo


--EXPECT--
01. Seed V1 locally on CB with {color, size}
============================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




02. Seed V1 on CP1 — owner of 'speed'
=====================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:V1
Content-Length: 0




03. Register CB→CP1 exclusive claiming 'speed' (mergeBatch op)
==============================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:CSR:EX
Content-Length: 0




04. Batch Merge V1 {speed,color} — speed→CP1, color→local. 204 (surgical)
=========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




05. GET CB V1 — color=blue, size=large (untouched), no speed (chopped)
======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 80

{
  "color": "blue",
  "id": "urn:V1",
  "size": "large",
  "type": "Vehicle"
}



06. GET CP1 V1 — speed=99 (forwarded)
=====================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 57

{
  "id": "urn:V1",
  "speed": 99,
  "type": "Vehicle"
}



07. Batch Merge V1 with only speed — 100% chopped, nothing touches local
========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




08. GET CB V1 — color=blue, size=large unchanged (local wasn't touched)
=======================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 80

{
  "color": "blue",
  "id": "urn:V1",
  "size": "large",
  "type": "Vehicle"
}



09. GET CP1 V1 — speed=199 (merged on remote)
=============================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: 58

{
  "id": "urn:V1",
  "speed": 199,
  "type": "Vehicle"
}



--TEARDOWN--
swBrokerStop
swBrokerStop -role CP1
swDbDrop
swDbDrop -role CP1
