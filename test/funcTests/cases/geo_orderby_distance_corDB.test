#
# FILE            geo_orderby_distance_corDB.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TS 104-175 § 7.6.2.2 / § 7.6.2.3 — orderBy=<geoproperty>;dist-asc|dist-desc
# ranks entities by distance from the ?orderFrom reference Point to that
# GeoProperty. Entities that convey the GeoProperty rank ahead of those that do
# not (which have no distance and sort last). Each result carries geoDistance
# (metres). orderFrom is required: the coordinates of the reference geometry, of the
# type orderGeometry names (any but a GeometryCollection; Point when absent). The
# distance is the shortest one between the reference and the entity's GeoProperty.
# A distance order beside a georel: the georel filters, the order's distances are
# from orderFrom.
#
# This variant pins the corDB backend (in-memory haversine + sort); the mongoc
# $geoNear/$unionWith path is covered by geo_orderby_distance.test.
#
# REQUIRE_DB: corDB
#
# REQUIRE_FEATURE: GEOQ
#
--NAME--
orderBy dist-asc/dist-desc on the corDB backend (§ 7.6.2.2)

--TAGS--
geoquery orderBy distance query

--INIT--
corDbDrop
coraineStart

--RUN--

echo "01. Seed A(near),C(mid),B(far) with location; D with no location"
echo "==============================================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:A","type":"P","location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[8.05,40.0]}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:C","type":"P","location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[8.1,40.0]}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:B","type":"P","location":{"type":"GeoProperty","value":{"type":"Point","coordinates":[9.0,41.0]}}}' | head -1
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:D","type":"P","name":{"type":"Property","value":"noloc"}}' | head -1
echo
echo


echo "02. orderBy=location;dist-asc — nearest first: A, C, B, then D (no location) last"
echo "================================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B8,40%5D&options=keyValues'
echo
echo


echo "03. orderBy=location;dist-desc — farthest first: B, C, A, then D last"
echo "===================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-desc&orderFrom=%5B8,40%5D&options=keyValues'
echo
echo


echo "04. dist-asc limit=2 — the two nearest: A, C"
echo "============================================"
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B8,40%5D&limit=2&options=keyValues'
echo
echo


echo "05. dist-asc offset=2 limit=5 — pages into the non-geo tail: B, D"
echo "================================================================"
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B8,40%5D&offset=2&limit=5&options=keyValues'
echo
echo


echo "06. dist-asc without orderFrom — 400 BadRequestData"
echo "==================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc'
echo
echo


echo "07. orderGeometry=LineString near B - B (on it), C, A, then D"
echo "=============================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B%5B9,40.9%5D,%5B9,41.1%5D%5D&orderGeometry=LineString&options=keyValues'
echo
echo


echo "08. orderGeometry=Polygon around A - A (inside, 0 m), C, B, then D"
echo "=================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B%5B%5B8.0,39.9%5D,%5B8.07,39.9%5D,%5B8.07,40.1%5D,%5B8.0,40.1%5D,%5B8.0,39.9%5D%5D%5D&orderGeometry=Polygon&options=keyValues'
echo
echo


echo "09. dist-desc beside georel=within (A and C inside) - C, A: the georel filters, the order orders"
echo "==============================================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&georel=within&geometry=Polygon&coordinates=%5B%5B%5B7.9,39.9%5D,%5B8.2,39.9%5D,%5B8.2,40.1%5D,%5B7.9,40.1%5D,%5B7.9,39.9%5D%5D%5D&orderBy=location;dist-desc&orderFrom=%5B8,40%5D&options=keyValues'
echo
echo


echo "10. dist-asc from [8,40] beside georel=near [9,41] - A, C, B: the distances are from orderFrom, not from the georel's point"
echo "========================================================================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&georel=near;maxDistance==200000&geometry=Point&coordinates=%5B9,41%5D&orderBy=location;dist-asc&orderFrom=%5B8,40%5D&options=keyValues'
echo
echo


echo "11. orderFrom=[8,invalid] - 400 BadRequestData (not JSON)"
echo "========================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderFrom=%5B8,invalid%5D'
echo
echo


echo "12. orderGeometry=Point, orderFrom=[8] - 400 BadRequestData (a position has two or three numbers)"
echo "================================================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderGeometry=Point&orderFrom=%5B8%5D'
echo
echo


echo "13. orderGeometry=LineString, orderFrom=[8,40] - 400 BadRequestData (a position, not a LineString's)"
echo "===================================================================================================="
corCurl --url '/ngsi-ld/v1/entities?type=P&orderBy=location;dist-asc&orderGeometry=LineString&orderFrom=%5B8,40%5D'
echo
echo


--EXPECT--
