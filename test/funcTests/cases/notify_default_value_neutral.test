#
# FILE            notify_default_value_neutral.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# Default (NGSI-LD compliant) notification behaviour: notificationTrigger is
# operation-based (§ 5.2.6), so an Update Attributes operation notifies even when
# the attribute value is unchanged — the update still bumps modifiedAt, which is
# real information. (The opt-in suppression is covered by
# notify_value_change_only.)
#
--NAME--
Default notification — a value-neutral update still notifies

--TAGS--
subscription notification

--INIT--
swDbDrop
swBrokerStart
ftClientStart

--RUN--

echo "01. Subscribe + create E with P=5"
echo "================================="
swCurl --url /ngsi-ld/v1/subscriptions --payload '{"id":"urn:ngsi-ld:S","type":"Subscription","entities":[{"type":"T"}],"notification":{"endpoint":{"uri":"http://localhost:7701/notify","accept":"application/json"}}}' | head -1
swCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:ngsi-ld:E","type":"T","P":{"type":"Property","value":5}}' | head -1
sleep 0.3
ftClientReset
echo done
echo
echo


echo "02. PATCH P value 5->5 (no value change) — still NOTIFIES by default"
echo "==================================================================="
swCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E/attrs/P -X PATCH --payload '{"value":5}' | head -1
sleep 0.3
ftClientDump
ftClientReset
echo
echo


--EXPECT--
01. Subscribe + create E with P=5
=================================
HTTP/1.1 201 Created
HTTP/1.1 201 Created
done


02. PATCH P value 5->5 (no value change) — still NOTIFIES by default
===================================================================
HTTP/1.1 204 No Content
[
  {
    "body": {
      "data": [
        {
          "P": {
            "type": "Property",
            "value": 5
          },
          "id": "urn:ngsi-ld:E",
          "type": "T"
        }
      ],
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "notifiedAt": "REGEX(.*)",
      "subscriptionId": "urn:ngsi-ld:S",
      "type": "Notification"
    },
    "headers": {
      "Content-Length": "219",
      "Content-Type": "application/json",
      "Host": "localhost:7701",
      "Link": "<https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel=\"http://www.w3.org/ns/json-ld#context\"; type=\"application/ld+json\"",
      "User-Agent": "REGEX(Coraine/.*)"
    },
    "url": "/notify",
    "verb": "POST"
  }
]


--TEARDOWN--
swBrokerStop
swDbDrop
ftClientStop
