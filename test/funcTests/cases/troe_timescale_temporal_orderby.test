#
# FILE            troe_timescale_temporal_orderby.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# ?orderBy= on the multi-entity temporal GET (§ 4.23). For the temporal
# response shape (each attr is an array of instances), the sort key per
# entity is the value of the most recent instance of the named attr.
#
# Single-entity GET has no orderBy — there's only one entity to return.
#
--NAME--
TRoE timescale - temporal orderBy

--TAGS--
troe timescale postgres temporal orderby

--INIT--
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_orderby" >/dev/null 2>&1
psql -h localhost -p 5432 -U postgres -c "CREATE DATABASE sw_troe_orderby" >/dev/null
swBrokerStart --troe timescale --troeName sw_troe_orderby --troeUser postgres

--RUN--

echo "01. Seed three vehicles (V1=10, V2=99, V3=55)"
echo "============================================="
payload='{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":10,"observedAt":"2026-04-28T09:00:00Z"}}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
payload='{"id":"urn:V2","type":"Vehicle","speed":{"type":"Property","value":99,"observedAt":"2026-04-28T09:00:00Z"}}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
payload='{"id":"urn:V3","type":"Vehicle","speed":{"type":"Property","value":55,"observedAt":"2026-04-28T09:00:00Z"}}'
swCurl --url /ngsi-ld/v1/entities --payload "$payload" >/dev/null
echo done
echo
echo


echo "02. ?orderBy=speed — ascending: V1(10), V3(55), V2(99)"
echo "======================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&orderBy=speed'
echo
echo


echo "03. ?orderBy=speed;desc — descending: V2(99), V3(55), V1(10)"
echo "========================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&orderBy=speed;desc'
echo
echo


echo "04. PATCH urn:V1 speed=200 (newer instance) — orderBy uses the most recent"
echo "=========================================================================="
payload='{"value":200,"observedAt":"2026-04-28T15:00:00Z"}'
swCurl --url /ngsi-ld/v1/entities/urn:V1/attrs/speed -X PATCH --payload "$payload" >/dev/null
echo done
echo
echo


echo "05. ?orderBy=speed — V1 now newest=200 → V3(55), V2(99), V1(200)"
echo "================================================================"
swCurl --url '/ngsi-ld/v1/temporal/entities?type=Vehicle&timerel=after&timeAt=2026-01-01T00:00:00Z&pick=speed&orderBy=speed'
echo
echo


--EXPECT--
01. Seed three vehicles (V1=10, V2=99, V3=55)
=============================================
done


02. ?orderBy=speed — ascending: V1(10), V3(55), V2(99)
======================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V1",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 10
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 55
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 99
      }
    ],
    "type": "Vehicle"
  }
]



03. ?orderBy=speed;desc — descending: V2(99), V3(55), V1(10)
========================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V2",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 99
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V3",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 55
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V1",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 10
      }
    ],
    "type": "Vehicle"
  }
]



04. PATCH urn:V1 speed=200 (newer instance) — orderBy uses the most recent
==========================================================================
done


05. ?orderBy=speed — V1 now newest=200 → V3(55), V2(99), V1(200)
================================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: REGEX(.*)
Content-Length: REGEX(\d+)

[
  {
    "id": "urn:V3",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 55
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V2",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 99
      }
    ],
    "type": "Vehicle"
  },
  {
    "id": "urn:V1",
    "speed": [
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T09:00:00.000Z",
        "type": "Property",
        "value": 10
      },
      {
        "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f-]{36})",
        "observedAt": "2026-04-28T15:00:00.000Z",
        "type": "Property",
        "value": 200
      }
    ],
    "type": "Vehicle"
  }
]



--TEARDOWN--
swBrokerStop
swDbDrop
psql -h localhost -p 5432 -U postgres -c "DROP DATABASE IF EXISTS sw_troe_orderby" >/dev/null 2>&1
