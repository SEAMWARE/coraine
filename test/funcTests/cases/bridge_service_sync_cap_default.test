#
# FILE            bridge_service_sync_cap_default.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# --ddsSyncWaitMax's default - a quarter of the workers, at least one.
#
# A request waiting for a service holds a corRest worker; the cap keeps three
# quarters of them for everything else. A fixed number would not: 8 waiters on a
# broker of 4 workers (corDB on 4 CPUs, a COR_OPTIMIZE=size build) is every
# worker, and a DDS network that answers nothing would stop the broker.
#
# 4 workers here and no --ddsSyncWaitMax: one slot. The requests are those of
# bridge_service_sync_cap.test, which sets the one slot itself. Request A waits
# on 'slow' and holds the slot; request B, on 'fast', is not waited for: 202.
#
--NAME--
Bridges: --ddsSyncWaitMax's default is a quarter of the workers - 4 workers, one waits, the rest answer 202

--TAGS--
bridge channel plugins service ddsSync

--INIT--
corDbDrop

BRIDGE_CONFIG=$(bridgeConfig \
  --replyDelay "slow=1500" \
  --service "fast,Calculator,urn:ngsi-ld:Calculator:F,job" \
  --service "slow,Calculator,urn:ngsi-ld:Calculator:S,job")

coraineStart --bridges loopback --bridgeConfig $BRIDGE_CONFIG --ddsSyncTimeout 800 --connectionPoolSize 4

--RUN--

echo "01. Request A waits on 'slow' and holds the one slot of 4 workers - request B, on 'fast', does not wait: 202"
echo "============================================================================================================"
REQUEST_A_OUT=/tmp/claude-cap-requestA.out
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:S/attrs/job?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "a": 1 } }' > $REQUEST_A_OUT 2>&1 &
REQUEST_A_PID=$!
bridgeChannelAtLeast loopback slow requestsWaiting 1 5
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:F/attrs/job?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "b": 2 } }'
echo
echo


echo "02. Request A - it waited its 800 ms, and was accepted: 202"
echo "==========================================================="
wait $REQUEST_A_PID
cat $REQUEST_A_OUT
rm -f $REQUEST_A_OUT
echo
echo


echo "03. The slot is free again - the same request on 'fast' is waited for, and answered: 204"
echo "========================================================================================"
corCurl --url "/ngsi-ld/v1/entities/urn:ngsi-ld:Calculator:F/attrs/job?ddsSync=true" -X PATCH \
        --payload '{ "type": "Property", "value": { "c": 3 } }'
echo
echo


echo "04. The Channels say why B did not wait - one request was waiting (on 'slow') when it came"
echo "==========================================================================================="
echo "fast requestsNotWaited: $(bridgeChannelGet loopback fast requestsNotWaited)"
echo "slow requestsNotWaited: $(bridgeChannelGet loopback slow requestsNotWaited)"
echo "requestsWaiting now:    $(bridgeChannelGet loopback fast requestsWaiting) + $(bridgeChannelGet loopback slow requestsWaiting)"
echo


--TEARDOWN--
coraineStop


--EXPECT--
01. Request A waits on 'slow' and holds the one slot of 4 workers - request B, on 'fast', does not wait: 202
============================================================================================================
HTTP/1.1 202 Accepted
Date: REGEX(.*)
Content-Length: 0




02. Request A - it waited its 800 ms, and was accepted: 202
===========================================================
HTTP/1.1 202 Accepted
Date: REGEX(.*)
Content-Length: 0




03. The slot is free again - the same request on 'fast' is waited for, and answered: 204
========================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)




04. The Channels say why B did not wait - one request was waiting (on 'slow') when it came
===========================================================================================
fast requestsNotWaited: 1
slow requestsNotWaited: 0
requestsWaiting now:    0 + 0

