#
# FILE            troe_corDB_replace_multiattr.test
#
# AUTHOR          Ken Zangelin
#
# Copyright 2026 Seamware
#
# TRoE in corDB (--troe corDB): replace, append and PATCH of several attributes - only what each write wrote is recorded.
# The history is read back through the temporal API (§ 5.7.3).
#
--NAME--
TRoE corDB - replace, append and PATCH of several attributes

--TAGS--
troe replace append

--INIT--
corDbDrop
coraineStart --troe corDB

--RUN--

echo "01. POST entity urn:V1 with one attr"
echo "===================================="
corCurl --url /ngsi-ld/v1/entities --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":42}}' | head -1
echo
echo
echo


echo "02. PUT /entities/urn:V1 — wholesale replace with 2 attrs"
echo "========================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1 -X PUT --payload '{"id":"urn:V1","type":"Vehicle","speed":{"type":"Property","value":99},"color":{"type":"Property","value":"red"}}' | head -1
echo


echo "03. POST /entities/urn:V1/attrs — append two attrs"
echo "=================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs --payload '{"weight":{"type":"Property","value":1500},"brand":{"type":"Property","value":"X"}}' | head -1
echo


echo "04. PATCH /entities/urn:V1/attrs — modify two attrs"
echo "==================================================="
corCurl --url /ngsi-ld/v1/entities/urn:V1/attrs -X PATCH --payload '{"speed":{"type":"Property","value":120},"weight":{"type":"Property","value":1600}}' | head -1
echo
echo

echo "05. GET /temporal/entities/urn:V1"
echo "================================="
corCurl --url /ngsi-ld/v1/temporal/entities/urn:V1
echo
echo


--EXPECT--
01. POST entity urn:V1 with one attr
====================================
HTTP/1.1 201 Created



02. PUT /entities/urn:V1 — wholesale replace with 2 attrs
=========================================================
HTTP/1.1 204 No Content

03. POST /entities/urn:V1/attrs — append two attrs
==================================================
HTTP/1.1 204 No Content

04. PATCH /entities/urn:V1/attrs — modify two attrs
===================================================
HTTP/1.1 204 No Content


05. GET /temporal/entities/urn:V1
=================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"
Content-Length: REGEX(\d+)

{
  "brand": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": "X"
    }
  ],
  "color": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": "red"
    }
  ],
  "id": "urn:V1",
  "speed": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 42
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 99
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 120
    }
  ],
  "type": "Vehicle",
  "weight": [
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 1500
    },
    {
      "instanceId": "urn:ngsi-ld:Instance:REGEX([0-9a-f]+:[0-9a-f]+)",
      "type": "Property",
      "value": 1600
    }
  ]
}



--TEARDOWN--
coraineStop
corDbDrop
