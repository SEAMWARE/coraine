# valgrind suppressions for the coraine functest suite (--vt).
#
# Scope: only genuinely-unavoidable noise from third-party libraries that the
# broker links but does not own (mongo C driver / libbson, OpenSSL, libpq,
# libmicrohttpd, glibc loader). Add an entry ONLY after confirming the stack is
# entirely in library code and not reachable from broker allocations.
#
# Generate candidates with:  valgrind ... --gen-suppressions=all
#
# glibc per-thread resolver state (resolv_conf) cached during a DNS lookup in
# the mongo C driver's background server-monitor thread. That thread is torn
# down at process exit before glibc frees its thread-local resolver config, so
# valgrind reports the cached config as lost. Entirely inside glibc/mongoc — not
# reachable from broker allocations.
{
   mongoc-server-monitor-getaddrinfo-resolv
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:getaddrinfo
   ...
   fun:_server_monitor_thread
}

# Same glibc per-thread resolver state (resolv_conf), cached by ANY getaddrinfo
# the broker makes on a worker thread that is not joined at exit — remote
# @context download (corLdContextFromUrl), CSR source-identity probe
# (ldProbeSourceIdentity), distributed-op / notification forwarding, etc. The
# lost block is always glibc's __resolv_conf_allocate, never a broker
# allocation, so key on that frame (any caller) rather than one code path.
{
   glibc-getaddrinfo-resolv-conf
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:__resolv_conf_allocate
   ...
   fun:getaddrinfo
   ...
}

# libmongoc / libbson / OpenSSL one-time library initialisation, run lazily via
# pthread_once during the first DB operation (mongoc_init / SSL ctx / etc.) under
# dbStart. These are process-lifetime globals the driver never frees; valgrind
# reports them lost at exit. Entirely inside the driver/SSL libraries — not
# reachable from broker allocations.
{
   db-driver-onetime-init-pthread-once
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:*pthread_once*
   ...
   fun:dbStart
   fun:main
}
