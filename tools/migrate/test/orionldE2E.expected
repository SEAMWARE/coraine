== GET /ngsi-ld/v1/csourceRegistrations/urn:ngsi-ld:ContextSourceRegistration:R1?options=sysAttrs 
{
  "id": "urn:ngsi-ld:ContextSourceRegistration:R1",
  "type": "ContextSourceRegistration",
  "registrationName": "R1",
  "description": "remote vehicles",
  "information": [
    {
      "entities": [
        {
          "idPattern": "urn:ngsi-ld:Vehicle:A.*",
          "type": "Vehicle"
        }
      ],
      "attributeNames": [
        "speed",
        "isParked"
      ]
    }
  ],
  "endpoint": "http://my.csource.org:1026",
  "observationInterval": {
    "startAt": "2018-12-31T10:00:00.123Z",
    "endAt": "2028-12-31T10:00:00.456Z"
  },
  "expiresAt": "2028-12-31T10:00:01.234Z",
  "contextSourceInfo": [
    {
      "key": "H1",
      "value": "H1 value"
    }
  ],
  "scope": [
    "/s1",
    "/s2"
  ],
  "mode": "inclusive",
  "operations": [
    "retrieveEntity",
    "queryEntity"
  ],
  "management": {
    "localOnly": true,
    "timeout": 5000,
    "cooldown": 60000
  },
  "P1": 1,
  "createdAt": "2024-01-01T00:00:00Z",
  "modifiedAt": "2024-01-02T00:00:00Z"
}

