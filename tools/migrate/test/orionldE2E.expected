== GET /ngsi-ld/v1/subscriptions?options=sysAttrs 
[
  {
    "id": "urn:ngsi-ld:Subscription:S1",
    "type": "Subscription",
    "subscriptionName": "S1",
    "description": "speeding",
    "entities": [
      {
        "id": "urn:ngsi-ld:Vehicle:V1",
        "type": "Vehicle"
      }
    ],
    "watchedAttributes": [
      "speed"
    ],
    "q": "speed>40",
    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:9997/notify",
        "accept": "application/json"
      },
      "format": "normalized",
      "attributes": [
        "speed"
      ],
      "timesSent": 5,
      "timesFailed": 1,
      "lastNotification": "2024-01-23T08:53:20Z",
      "lastSuccess": "2024-01-23T06:06:40Z",
      "lastFailure": "2024-01-23T08:53:20Z",
      "status": "failed"
    },
    "status": "active",
    "createdAt": "2024-01-01T00:00:00.5Z",
    "modifiedAt": "2024-01-11T19:06:40.25Z",
    "notificationTrigger": [
      "attributeCreated",
      "attributeUpdated"
    ]
  },
  {
    "id": "urn:ngsi-ld:Subscription:S2",
    "type": "Subscription",
    "entities": [
      {
        "type": "Vehicle"
      }
    ],
