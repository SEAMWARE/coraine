    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld",
    "notification": {
      "endpoint": {
        "uri": "http://localhost:9997/notify2",
        "accept": "application/json",
        "receiverInfo": [
          {
            "key": "X-Auth-Token",
            "value": "abc"
          }
        ]
      },
      "format": "keyValues"
    },
    "status": "paused",
    "createdAt": "2024-01-01T00:00:00Z",
    "modifiedAt": "2024-01-01T00:00:00Z",
