# coraine-dds — the coraine broker with the DDS bridge
#
# The same broker as the ordinary image, plus one plugin. That is the whole
# difference, and it is deliberately visible here: this file does not rebuild
# coraine, it starts FROM it and adds a shared object.
#
# The reason there are two images at all is size. The eProsima stack is 21.4 MiB
# across nine libraries - libfastdds alone is 16 MiB - against the broker's own
# 4.28 MiB over three. So DDS is roughly five times the thing it plugs into, and
# a deployment that does not speak DDS should not carry it. ARISE does; most do
# not.
#
# Build from the REPO ROOT, having built or pulled the base image first:
#   ./docker/vendor-libs.sh
#   docker build -f docker/Dockerfile     -t coraine:local .
#   docker build -f docker/Dockerfile.dds -t coraine-dds:local \
#                --build-arg CORAINE_IMAGE=coraine:local .
#
# Run it:
#   docker run --rm -p 1026:1026 -v /etc/dds.json:/etc/dds.json coraine-dds:local \
#              --database corDB --bridges dds --bridgeConfig /etc/dds.json
#
# Copyright 2026 Seamware

#
# ⚠ BEFORE THE FIRST FROM, and it has to be.
#
# An ARG declared after a FROM belongs to that stage, and a later FROM cannot
# see it - it resolves to blank and the build fails with "base name should not
# be blank", naming a line that looks perfectly correct. Only an ARG in the
# global scope, above every FROM, is visible to a FROM.
#
ARG CORAINE_IMAGE=quay.io/seamware/coraine:latest

# --------------------------------------------------------------------------- #
# Stage 1 — the eProsima stack, and the bridge built against it
#
# This is the expensive stage: Fast CDR, Fast DDS, ddspipe and the DDS Enabler
# are built from source with colcon, which is where all the minutes go. It is
# also the stage that almost never changes, so it caches well - pin the
# branches below and a rebuild of the bridge costs seconds.
# --------------------------------------------------------------------------- #
FROM ubuntu:24.04 AS ddsbuilder

ARG DEBIAN_FRONTEND=noninteractive
ARG TZ=Etc/UTC

#
# Only the Enabler's branch is a knob here. Which Fast CDR, Fast DDS, ddspipe
# and devutils go with it is stated by that branch's own ddsenabler.repos, and
# pinning them separately would mean asserting a combination eProsima has not.
#
ARG DDSENABLER_BRANCH=main

SHELL ["/bin/bash", "-c"]

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates cmake curl g++ git libasio-dev libssl-dev libtinyxml2-dev \
      libyaml-cpp-dev make nlohmann-json3-dev python3 python3-pip wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages colcon-common-extensions colcon-mixin vcstool

#
# The Enabler's own repos file is the source of truth for which repositories
# make up the stack - following it rather than listing them here means this
# does not drift from what eProsima ships.
#
WORKDIR /dds

#
# Only the repos FILE, fetched - not the repository it lives in.
#
# Cloning the Enabler here and then importing its repos into src/ puts the same
# packages under two roots, and colcon crawls recursively: "Duplicate package
# names not supported", which is how the first attempt failed.
#
RUN curl -fsSL "https://raw.githubusercontent.com/eProsima/FIWARE-DDS-Enabler/${DDSENABLER_BRANCH}/ddsenabler.repos" \
      -o ddsenabler.repos \
    && mkdir src \
    && vcs import src < ddsenabler.repos

#
# --merge-install puts everything under one install/lib and install/include
# instead of install/<pkg>/..., which makes the copy below a copy rather than a
# glob that has to be right about colcon's layout.
#
# Its own RUN, so that a build failure is a build failure. Chained after a `cp
# ... || true` it was not: the || caught colcon's failure, the chain carried on,
# and the first sign of trouble was a missing header two steps later.
#
RUN colcon build --merge-install --packages-skip ddsenabler_docs \
      --event-handlers console_direct+ \
      --cmake-args -DLOG_INFO=ON -DSECURITY=ON

RUN cp -a /dds/install/lib/. /usr/local/lib/ \
    && cp -a /dds/install/include/. /usr/local/include/ \
    && ldconfig

#
# And say so out loud. A copy that lands in the wrong place is otherwise
# discovered by the NEXT stage, as "the DDS Enabler must be installed", which
# points at the innocent party.
#
RUN test -f /usr/local/include/ddsenabler/DDSEnabler.hpp \
    && test -f /usr/local/lib/libddsenabler.so \
    && echo "DDS Enabler installed:" \
    && ls /usr/local/lib/libfastdds.so* /usr/local/lib/libddsenabler*.so*

#
# The bridge itself. It links the stack above and resolves ktrace, kjson and the
# rest from the broker at dlopen, so the broker's headers are all it needs from
# coraine's side - never its libraries.
#
WORKDIR /root/git
COPY docker/vendor/ /tmp/vendor/
RUN set -eux; \
    test -f /tmp/vendor/MANIFEST.txt || { echo "run ./docker/vendor-libs.sh first"; exit 1; }; \
    tar -xf /tmp/vendor/corBridge.tar    -C /root/git; \
    tar -xf /tmp/vendor/corDdsBridge.tar -C /root/git; \
    rm -rf /tmp/vendor

#
# COR_BRIDGE_DDS=ON, not auto. In an image built for DDS a missing Enabler is an
# error and not something to shrug at - auto's job is to let a developer without
# the stack still get a working build, and that is not this.
#
RUN make -C /root/git/corDdsBridge COR_BRIDGE_DDS=ON


# --------------------------------------------------------------------------- #
# Stage 2 — the broker image, plus the bridge
#
# FROM the ordinary coraine image on purpose. coraine-dds is not a different
# broker and must never become one: same binary, same plugins, same entrypoint,
# with one more shared object in the plugin directory and the libraries it
# needs beside it.
# --------------------------------------------------------------------------- #
FROM ${CORAINE_IMAGE}

LABEL org.opencontainers.image.title="coraine-dds" \
      org.opencontainers.image.description="coraine NGSI-LD Context Broker with the DDS bridge plugin"

COPY --from=ddsbuilder /usr/local/lib/libfastdds.so*   /usr/local/lib/
COPY --from=ddsbuilder /usr/local/lib/libfastcdr.so*   /usr/local/lib/
COPY --from=ddsbuilder /usr/local/lib/libcpp_utils.so* /usr/local/lib/
COPY --from=ddsbuilder /usr/local/lib/libddspipe*.so*  /usr/local/lib/
COPY --from=ddsbuilder /usr/local/lib/libddsenabler*.so* /usr/local/lib/
COPY --from=ddsbuilder /root/git/corDdsBridge/dds.so   /opt/seamware/plugins/bridge/

#
# libyaml-cpp, tinyxml2 and foonathan_memory come from the stack above rather
# than from apt: the versions have to match what Fast DDS was built against.
#
COPY --from=ddsbuilder /usr/local/lib/libfoonathan_memory*.so* /usr/local/lib/
RUN apt-get update && apt-get install -y --no-install-recommends \
      libyaml-cpp0.8 libtinyxml2-10 \
    && rm -rf /var/lib/apt/lists/* \
    && ldconfig

#
# A default configuration, so the image starts.
#
# The bridge needs a configuration file - the Enabler is handed a path and will
# not come up without one - and a container started with --bridges dds and no
# --bridgeConfig would therefore exit immediately. An image that cannot start is
# worse than one that starts without DDS, so a minimal file ships with it:
# domain 0, no topics. That joins the domain and carries nothing, which is the
# honest default, and a deployment mounts its own over it.
#
COPY etc/dds-default.json /opt/seamware/etc/dds.json

#
# The two things a deployment supplies, and where it puts them.
#
# The MAPPING FILE is the user's: which DDS topic becomes which entity
# attribute is something only the deployment knows. It is mounted straight over
# the placeholder above -
#
#     volumes: [ ./dds.json:/opt/seamware/etc/dds.json:ro ]
#
# - so nothing on the command line has to change, which is how the same image
# serves every deployment.
#
# The TYPES DIRECTORY is the broker's, and it is written to: types are
# announced by the participants on the domain and kept so that a restarted
# broker is not blind until each of them happens to announce itself again. A
# VOLUME rather than a bind mount by default, because losing it costs only
# rediscovery.
#
RUN mkdir -p /opt/seamware/etc/dds-types
VOLUME ["/opt/seamware/etc/dds-types"]

#
# ⚠ AND ONE THING THE IMAGE CANNOT DO FOR ITSELF: ipc: host.
#
# Fast DDS reaches another participant on the same machine over SHARED MEMORY,
# and a container gets its own IPC namespace by default - so a broker without
# it sees nothing from a ROS 2 node beside it, with no error anywhere. It
# simply never discovers a topic, which looks exactly like a mapping that is
# wrong. See docker/docker-compose-dds.yml.
#

#
# The entrypoint is inherited unchanged. The default command is not: an image
# built to speak DDS that did not load the bridge would be a puzzle.
#
CMD ["--database", "mongoc", "--troe", "none", "--apiPlugins", "admin", \
     "--bridges", "dds", "--bridgeConfig", "/opt/seamware/etc/dds.json"]
